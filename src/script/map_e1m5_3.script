namespace map_e1m5_3
{	
	float hideSubTime = 0;
	void SubtitlesRunning()
	{
		while(hideSubTime > sys.getTime())
		{			
			sys.waitFrame();
		}
		sys.hideSubtitles();
	}

	void ShowSubtitles(string name, string titles, float duration)
	{
		PhobosShowSubtitle_e1m5_3(name, titles);
		hideSubTime = sys.getTime() + duration;
		sys.wait(duration);
		if(hideSubTime <= sys.getTime())
		{
			sys.hideSubtitles();
		}
		else
		{
			thread SubtitlesRunning();
		}
	}

	void mister_move2()
	{
		//start decon1 computer voice
		thread ShowSubtitles("PA", "Purification process initiated.", 3.15);
		sys.trigger ($decon1_start_speaker);
		sys.wait (1.5);
		
		thread crossFadeEnt ($misterlight_white1, '1 1 1', '1 0 0', 1.0);
		thread crossFadeEnt ($decontop_fade1, '1 1 1', '1 0 0', 1.0);
		thread crossFadeEnt ($decon_toplight_red1, '0 0 0', '1 0 0', 1.0);		
		
		sys.trigger ($decon1_mister1start_spkr);
		sys.trigger ($decon1_mister2start_spkr);
		sys.wait (.15);
		sys.trigger ($decon1_mister1loop_spkr);
		sys.trigger ($decon1_mister2loop_spkr);
		
		$mister1_anchor.moveTo ($mister1_spot2);
		$mister2_anchor.moveTo ($mister2_spot2);
		sys.waitFor ($mister2_anchor);
		
		$mister1_anchor.rotateOnce ('0 0 -60');
		$mister2_anchor.rotateOnce ('0 0 60');
		sys.waitFor ($mister2_anchor);
		
		$mister1_anchor.rotateOnce ('0 0 60');
		$mister2_anchor.rotateOnce ('0 0 -60');
		sys.waitFor ($mister2_anchor);
		
		$mister1_anchor.moveTo ($mister1_spot1);
		$mister2_anchor.moveTo ($mister2_spot1);
		sys.waitFor ($mister2_anchor);
		
		sys.trigger ($decon1_mister1stop_spkr);
		sys.trigger ($decon1_mister2stop_spkr);
		//trigger looping speaker again to turn off
		sys.trigger ($decon1_mister1loop_spkr);
		sys.trigger ($decon1_mister2loop_spkr);
		
		//turn off emitter
		sys.trigger($mister1_emitter);
		sys.trigger($mister2_emitter);
		
		sys.wait (.5);
		thread crossFadeEnt ($misterlight_white1, '1 0 0', '1 1 1', 1.0);
		thread crossFadeEnt ($decontop_fade1, '1 0 0', '1 1 1', 1.0);
		thread crossFadeEnt ($decon_toplight_red1, '1 0 0', '0 0 0', 1.0);		
	}
	
	void mister2()
	{		
		sys.trigger($decondoor1);
		sys.trigger($decondoor1_aas);

		$decon_trigger1.disable ();
		
		//turn on emitter
		sys.trigger($mister1_emitter);
		sys.trigger($mister2_emitter);
		
		float i;
			i = thread mister_move2();
			sys.waitForThread (i);
		
		//complete decon1 computer voice
		thread ShowSubtitles("PA", "Purification complete.", 2.15);
		sys.trigger ($decon1_complete_speaker);
		
		sys.wait (.25);

			sys.trigger($decondoor2);
			sys.trigger($decondoor2_aas);
			$trig_exit_decon1.enable();
			$drfrm4.setColor(1, 0.823529, 0.521569);
	}

	void decon_cycle1 ()
	{		
		$decon_trigger1.enable ();
		$trig_exit_decon1.enable();
		sys.trigger($decondoor1);
		sys.trigger($decondoor1_aas);
		$trig_enter_decon1.disable();
	}

	void seal_decon1 ()
	{		
		sys.trigger($decondoor2);
		sys.trigger($decondoor2_aas);
		$trig_enter_decon1.enable();
		$trig_exit_decon1.disable();
		$drfrm4.setColor(0.5, 0, 0);
	}

	void OpenSomaDoor(float number)
	{
		entity door = sys.getEntity("somadoor_round_" + number);
		entity door_aas = sys.getEntity("soma_aas_obstacle_" + number);
		entity portal = sys.getEntity("somadoor_portal_" + number);

		entity switch_a = sys.getEntity("somadoor" + number + "_gui_a");
		entity switch_b = sys.getEntity("somadoor" + number + "_gui_b");
		
		entity somaguis_off = sys.getEntity("disable_soma" + number + "_guis");
		entity somaguis_on = sys.getEntity("enable_soma" + number + "_guis");
		entity somaguis_blue = sys.getEntity("soma" + number + "_guilights_blue");
		entity somaguis_green = sys.getEntity("soma" + number + "_guilights_green");
		
		float state = door.getFloatKey("state");
		float openDir = door.getFloatKey("openDir");
		float closeDir = door.getFloatKey("closeDir");
		vector rv = door.getVectorKey("rotateVector");

		if( state == 0)
		{
			door.setKey("state", 2);

			sys.trigger(portal);
			
			sys.trigger(somaguis_off);
			
			sys.trigger(door_aas);
			
			if(debug)
				sys.println("AAS triggered");
			
			switch_a.setShaderParm( 7, 2 );
			switch_b.setShaderParm( 7, 2 );
			sys.trigger(somaguis_blue);
			
			door.accelTime(1);
			door.decelTime(1);
			door.time(2.5);

			door.startSoundShader ("al4_openslats_2s", SND_CHANNEL_VOICE);
			door.rotateOnce(rv * 135);
			sys.waitFor(door);
			
			door.accelTime(1);
			door.decelTime(.5);
			door.time(3.5);

			door.startSoundShader ("sound/doors/large/hugedoor_01_open.wav", SND_CHANNEL_VOICE);
			
			door.move(openDir, 128);
			door.rotateOnce(rv * 90);
		
			sys.waitFor(door);			

			door.setKey("state", 1);

			sys.wait(5);

			door.setKey("state", 2);
			
			sys.trigger(door_aas);
			
			if(debug)
				sys.println("AAS triggered");

			door.startSoundShader ("sound/doors/large/hugedoor_01_close.wav", SND_CHANNEL_VOICE);
			door.move(closeDir, 128);
			door.rotateOnce(rv * -90);

			sys.waitFor(door);

			door.accelTime(1);
			door.decelTime(1);
			door.time(2.5);

			door.startSoundShader ("al4_openslats_2s", SND_CHANNEL_VOICE);
			door.rotateOnce(rv * -135);
			sys.waitFor(door);

			sys.trigger(portal);

			switch_a.setShaderParm( 7, 1 );
			switch_b.setShaderParm( 7, 1 );
			sys.trigger(somaguis_green);
			
			sys.trigger(somaguis_on);
			
			door.setKey("state", 0);
		}
	}

	void OpenSomaDoor1()
	{
		OpenSomaDoor(1);
	}

	void OpenSomaDoor2()
	{
		OpenSomaDoor(2);
	}	

	float lobbySpeaking = 0;
	void LockedLobbyElevator()
	{
		if(lobbySpeaking == 0)
		{
			lobbySpeaking = 1;
			thread ShowSubtitles("PA", "Surface access offline.", 2.25);
			$lobby_callstation_locked.startSoundShader("sound/shav/e1m5_3/surfaceaccessoffline.ogg", SND_CHANNEL_ANY);

			sys.wait(5);
			lobbySpeaking = 0;
		}
	}

	void OldPlatform1()
	{
		$old_platform_1_handle.time(0.15);
		$old_platform_1_handle.rotateOnce('0 0 90');
		$old_platform_1_handle.startSoundShader("sound/shav/e1m5_3/large_switch.ogg", SND_CHANNEL_ANY);

		sys.wait(.5);

		$old_platform_1_handle.time(12);

		$old_platform_1_handle.rotateOnce('0 0 -90');

		$old_platform_1.move(DOWN, 256);
		sys.waitFor($old_platform_1);
		sys.wait(2);
		$old_platform_1.move(UP, 256);

		sys.waitFor($old_platform_1);
		sys.waitFor($old_platform_1_handle);

		sys.wait(1);

		$func_static_100810.setKey("click_item", 1);
	}

	void OldPlatform1Lower()
	{
		$old_platform_1_lower_handle.time(0.15);
		$old_platform_1_lower_handle.rotateOnce('0 0 -90');
		$old_platform_1_lower_handle.startSoundShader("sound/shav/e1m5_3/large_switch.ogg", SND_CHANNEL_ANY);

		sys.wait(.5);

		$old_platform_1_lower_handle.time(12);

		$old_platform_1_lower_handle.rotateOnce('0 0 90');

		$old_platform_1.move(DOWN, 256);
		sys.waitFor($old_platform_1);
		sys.wait(2);
		$old_platform_1.move(UP, 256);

		sys.waitFor($old_platform_1);
		sys.waitFor($old_platform_1_lower_handle);

		sys.wait(1);

		$func_static_101773.setKey("click_item", 1);
	}
	
	void floorhatch_open()
	{
		$office_floor_panel_1.move(-2, 1);
		sys.waitFor($office_floor_panel_1);
		$office_floor_panel_1.move(270, 60);
	}

	void RunElecSounds(float runTime, entity emitter1, entity emitter2, entity emitter3, entity emitter4)
	{
		float t = 0.0;
		float tD = 1;
		float tDH = tD / 2.0;

		while(t < runTime)
		{
			emitter1.startSoundShader("electrical_sparks", SND_CHANNEL_ANY);
			emitter3.startSoundShader("electrical_sparks", SND_CHANNEL_ANY);

			sys.wait(tDH);

			emitter2.startSoundShader("electrical_sparks", SND_CHANNEL_ANY);
			emitter4.startSoundShader("electrical_sparks", SND_CHANNEL_ANY);

			sys.wait(tDH);

			t += tD;
		}		
	}

	void RunElecs()
	{		
		while(1)
		{
			$elec_west_rod.move(0, 128);
			$elec_east_rod.move(180, 128);

			sys.waitFor($elec_east_rod);

			sys.wait(1);

			// Turn on elec
			sys.trigger($elec_top_trighurt_1);
			sys.trigger($elec_top_trighurt_2);
			sys.trigger($elec_bottom_trighurt_1);
			sys.trigger($elec_bottom_trighurt_2);
			
			sys.trigger($elec_top_rod_emitter_1);
			sys.trigger($elec_top_rod_emitter_2);
			sys.trigger($elec_top_emitter_1);
			sys.trigger($elec_top_emitter_2);
			sys.trigger($elec_top_light);
			sys.trigger($elec_east_rod_emitter_1);
			sys.trigger($elec_east_rod_emitter_2);

			thread RunElecSounds(6, $elec_top_rod_emitter_1, $elec_top_rod_emitter_2, $elec_east_rod_emitter_1, $elec_east_rod_emitter_2);
			$elec_top_emitter_1.startSoundShader("loop_hum_03", SND_CHANNEL_ANY);
			$elec_top_emitter_2.startSoundShader("loop_hum_02", SND_CHANNEL_ANY);

			sys.trigger($elec_bottom_rod_emitter_1);
			sys.trigger($elec_bottom_rod_emitter_2);
			sys.trigger($elec_bottom_emitter_1);
			sys.trigger($elec_bottom_emitter_2);
			sys.trigger($elec_bottom_light);
			sys.trigger($elec_west_rod_emitter_1);
			sys.trigger($elec_west_rod_emitter_2);

			thread RunElecSounds(6, $elec_bottom_rod_emitter_1, $elec_bottom_rod_emitter_2, $elec_west_rod_emitter_1, $elec_west_rod_emitter_2);
			$elec_bottom_emitter_1.startSoundShader("loop_hum_03", SND_CHANNEL_ANY);
			$elec_bottom_emitter_2.startSoundShader("loop_hum_02", SND_CHANNEL_ANY);
			
			sys.trigger($elec_relay_topbot);
			
			sys.wait(6);

			$elec_top_emitter_1.stopSound(SND_CHANNEL_ANY, false);
			$elec_top_emitter_2.stopSound(SND_CHANNEL_ANY, false);
			$elec_bottom_emitter_1.stopSound(SND_CHANNEL_ANY, false);
			$elec_bottom_emitter_2.stopSound(SND_CHANNEL_ANY, false);

			$elec_west_rod.startSoundShader("al4_pounder_point2seconds", SND_CHANNEL_ANY);
			$elec_east_rod.startSoundShader("al4_pounder_point2seconds", SND_CHANNEL_ANY);

			// Turn off elec
			sys.trigger($elec_top_rod_emitter_1);
			sys.trigger($elec_top_rod_emitter_2);
			sys.trigger($elec_top_emitter_1);
			sys.trigger($elec_top_emitter_2);
			sys.trigger($elec_top_light);
			sys.trigger($elec_east_rod_emitter_1);
			sys.trigger($elec_east_rod_emitter_2);

			sys.trigger($elec_bottom_rod_emitter_1);
			sys.trigger($elec_bottom_rod_emitter_2);
			sys.trigger($elec_bottom_emitter_1);
			sys.trigger($elec_bottom_emitter_2);
			sys.trigger($elec_bottom_light);
			sys.trigger($elec_west_rod_emitter_1);
			sys.trigger($elec_west_rod_emitter_2);
			
			sys.trigger($elec_relay_topbot);

			sys.wait(1);
			
			sys.trigger($elec_top_trighurt_1);
			sys.trigger($elec_top_trighurt_2);
			sys.trigger($elec_bottom_trighurt_1);
			sys.trigger($elec_bottom_trighurt_2);

			$elec_west_rod.move(180, 128);
			$elec_east_rod.move(0, 128);

			sys.waitFor($elec_east_rod);

			sys.wait(1);

			$elec_west.move(UP, 624);
			$elec_east.move(DOWN, 624);
			sys.trigger($elec_east_down_aas);
			sys.trigger($elec_east_up_aas);
			sys.trigger($elec_west_down_aas);
			sys.trigger($elec_west_up_aas);

			sys.waitFor($elec_east);
			sys.wait(1);

			$elec_west_rod.move(0, 128);
			$elec_east_rod.move(180, 128);

			sys.waitFor($elec_east_rod);
			sys.wait(1);

			// Turn on elec
			sys.trigger($elec_middle_trighurt_1);
			sys.trigger($elec_middle_trighurt_2);
			
			sys.trigger($elec_east_rod_emitter_1);
			sys.trigger($elec_east_rod_emitter_2);
			sys.trigger($elec_middle_emitter_1);
			sys.trigger($elec_middle_emitter_2);
			sys.trigger($elec_middle_light);
			sys.trigger($elec_west_rod_emitter_1);
			sys.trigger($elec_west_rod_emitter_2);

			thread RunElecSounds(6, $elec_east_rod_emitter_1, $elec_east_rod_emitter_2, $elec_west_rod_emitter_1, $elec_west_rod_emitter_2);
			$elec_middle_emitter_1.startSoundShader("loop_hum_03", SND_CHANNEL_ANY);
			$elec_middle_emitter_2.startSoundShader("loop_hum_02", SND_CHANNEL_ANY);

			sys.trigger($elec_relay_mid);

			sys.wait(6);

			// Turn off elec
			sys.trigger($elec_east_rod_emitter_1);
			sys.trigger($elec_east_rod_emitter_2);
			sys.trigger($elec_middle_emitter_1);
			sys.trigger($elec_middle_emitter_2);
			sys.trigger($elec_middle_light);
			sys.trigger($elec_west_rod_emitter_1);
			sys.trigger($elec_west_rod_emitter_2);

			$elec_middle_emitter_1.stopSound(SND_CHANNEL_ANY, false);
			$elec_middle_emitter_2.stopSound(SND_CHANNEL_ANY, false);
			
			sys.trigger($elec_relay_mid);

			$elec_west_rod.startSoundShader("al4_pounder_point2seconds", SND_CHANNEL_ANY);
			$elec_east_rod.startSoundShader("al4_pounder_point2seconds", SND_CHANNEL_ANY);

			sys.wait(1);
			
			sys.trigger($elec_middle_trighurt_1);
			sys.trigger($elec_middle_trighurt_2);

			// Move elec rods back in
			$elec_west_rod.move(180, 128);
			$elec_east_rod.move(0, 128);

			sys.waitFor($elec_east_rod);
			sys.wait(1);

			// Move them back to their initial positions
			$elec_west.move(DOWN, 624);
			$elec_east.move(UP, 624);
			sys.trigger($elec_east_down_aas);
			sys.trigger($elec_east_up_aas);
			sys.trigger($elec_west_down_aas);
			sys.trigger($elec_west_up_aas);

			sys.waitFor($elec_east);
			sys.wait(1);
		}
	}
	
	
	void calculateArchHealth(float arch_num)
		{
			
				entity archvile = sys.getEntity("monster_demon_archvile_" + arch_num);
				entity archdoll = sys.getEntity("monster_demon_archvile_" + arch_num + "_healthdoll");
				
				float archdoll_health = archdoll.getHealth();
				
				float arch_health = archdoll_health / 5;
				
				if(debug)
					sys.println(archdoll_health);
		
					if (arch_health <= 100) 
						{				
							archvile.setHealth(100);
						}	
						else
						{
							archvile.setHealth(arch_health);
						}
					
				if(debug)
					sys.println(arch_health);
					
		}
	
		
	void calculateArchHealth1()
	{
		calculateArchHealth(1);
	}
	
