namespace map_e1m3_1
{	
	float hideSubTime = 0;

	void SubtitlesRunning()
	{
		while(hideSubTime > sys.getTime())		
		{			
			sys.waitFrame();
		}
		sys.hideSubtitles();
	}

	void ShowNPCSubtitles(string name, string titles, float duration)
	{
		PhobosShowSubtitle_e1m3_1(name, titles);
		hideSubTime = sys.getTime() + duration;
		sys.wait(duration);
		if(hideSubTime <= sys.getTime())
		{
			sys.hideSubtitles();
		}
		else
		{
			thread SubtitlesRunning();
		}
	}

	void CharacterSays(entity characterEntity, string line)
	{
		sys.wait(characterEntity.startSoundShader(line, SND_CHANNEL_ANY));
	}
	
	void Beat(float delay)
	{
		sys.wait(delay);
	}		
	
	float callMilesCompleted = 0;

	void CallMilesCSInterupt(entity characterEntity, string line, float interrupt)
    {
		if(callMilesCompleted == 0)
		{
			sys.wait(characterEntity.startSoundShader(line, SND_CHANNEL_ANY) - interrupt);
		}		
    }	

	void CompleteCallMiles()
	{
		if(callMilesCompleted == 0)
		{
			callMilesCompleted = 1;			
		}
	}

	void CallMilesCS(entity entity, string line)
	{
		if(callMilesCompleted == 0)
		{
			CharacterSays(entity, line);
		}
	}	

	void CallMilesBeat(float amount)
	{
		if(callMilesCompleted == 0)
		{
			Beat(amount);
		}
	}

	//rack server states
	//0 = in
	//1 = out
	float rack_server1 = 0;
	float rack_server2 = 0;
	float rack_server3 = 0;
	float rack_server4 = 0;
	float rack_server5 = 0;
	float rack_server6 = 0;
	float rack_server7 = 0;
