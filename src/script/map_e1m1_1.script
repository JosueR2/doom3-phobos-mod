	float ring1Status = 0;
	float ring2Status = 0;
	float ring3Status = 0;

	void RunRing(entity ring, float direction, float isStarting)
	{
		float i,v,t,blendtime,velmult,final;
		vector rotvector;
		
		blendtime = 25;
		velmult = .3;			

		if( isStarting == 0)
		{
			blendtime /= 2;
			velmult *= 2;
		}
		else
		{
			blendtime /= 5;
			velmult *= 5;
		}

		t = blendtime * GAME_FPS;
		final = (t-1) * velmult;

		for ( i = 0; i < t; i++ )
		{
			if(isStarting == 1)
			{
				v = (i * velmult);
			}
			else
			{
				v = final - (i * velmult);				
			}
			
			rotvector_x=v * direction ;rotvector_y=0 ; rotvector_z=0;
			
			ring.rotate ( rotvector );
			
			sys.wait( GAME_FRAMETIME );
		}
	}
	
	void RunRing1(float isStarting)
	{
		ring1Status = 1;
		RunRing($scanner_ring_1, -1, isStarting);
		ring1Status = 2;
	}

	void RunRing2(float isStarting)
	{
		ring2Status = 1;
		RunRing($scanner_ring_2, 1, isStarting);
		ring2Status = 2;
	}

	void RunRing3(float isStarting)
	{
		ring3Status = 1;
		RunRing($scanner_ring_3, -1, isStarting);
		ring3Status = 2;

		sys.wait(3);

		ring3Status = 3;		
	}

	void StartScannerRings()
	{
		sys.trigger($scanner_ring_1_lamp_1_activator);
		sys.trigger($scanner_ring_2_lamp_1_activator);
		sys.trigger($scanner_ring_3_lamp_1_activator);			
		
		thread RunRing1(1);
		sys.wait(.5);
		thread RunRing2(1);
		sys.wait(.5);
		thread RunRing3(1);
	}

	void StopScannerRings()
	{
		thread RunRing1(0);
		sys.wait(.5);
		thread RunRing2(0);
		sys.wait(.5);
		thread RunRing3(0);

		float l = 1;
		while(l < 9)
		{
			thread crossFadeEnt (sys.getEntity("scanner_ring_1_lamp_" + l), '1 0.65 0.3', '0 0 0', 2);
			thread crossFadeEnt (sys.getEntity("scanner_ring_1_lamp_" + l + "_flare"), '1 0.65 0.3', '0 0 0', 2);

			thread crossFadeEnt (sys.getEntity("scanner_ring_2_lamp_" + l), '1 0.65 0.3', '0 0 0', 2);
			thread crossFadeEnt (sys.getEntity("scanner_ring_2_lamp_" + l + "_flare"), '1 0.65 0.3', '0 0 0', 2);
			
			thread crossFadeEnt (sys.getEntity("scanner_ring_3_lamp_" + l), '1 0.65 0.3', '0 0 0', 2);
			thread crossFadeEnt (sys.getEntity("scanner_ring_3_lamp_" + l + "_flare"), '1 0.65 0.3', '0 0 0', 2);

			l++;
		}
		
		thread crossFadeEnt ($scanner_ring_1_light, '1 0.65 0.3','0 0 0', 2);
		thread crossFadeEnt ($scanner_ring_2_light, '1 0.65 0.3','0 0 0', 2);
		thread crossFadeEnt ($scanner_ring_3_light, '1 0.65 0.3','0 0 0', 2);
	}

	void MoveIntoScanner()
	{
		$scanner_bed.move(90, 136);			

		sys.waitFor($scanner_bed);
	}
	
	void UpdateCameraAngle()
	{	
		scannerActive = 1;
		while(scannerActive == 1)
		{						
			$scanner_camera.setAngles($player1.getHead().getAngles());
			sys.wait(GAME_FRAMETIME);
		}
	}
	
	void Doctor6Sub()
	{
		PhobosShowSubtitle_e1m1_1("Dr. Nielsen", "You were gone for a minute there.");
		
		sys.wait(2);
		
		PhobosShowSubtitle_e1m1_1("Dr. Nielsen", "We found nothing to be concerned about.");
		
		sys.wait(2.25);
		
		PhobosShowSubtitle_e1m1_1("Dr. Nielsen", "Your head injury doesn't appear to be new.\nBut has merely opened up again.");
		
		sys.wait(4.5);
		
		PhobosShowSubtitle_e1m1_1("Dr. Nielsen", "Most likely due to a recent blow to the temple.");
		
		sys.wait(4);
		
		PhobosShowSubtitle_e1m1_1("Dr. Nielsen", "Do you still not recollect what happened or any details about your person?");
	}
	
	void Doctor7Sub()
	{
		PhobosShowSubtitle_e1m1_1("Dr. Nielsen", "You will. In time.");
		
		sys.wait(2.25);
		
		PhobosShowSubtitle_e1m1_1("Dr. Nielsen", "I closed the wound and you're free to go.");
		
		sys.wait(3.25);
		
		PhobosShowSubtitle_e1m1_1("Dr. Nielsen", "Take it easy for a while.\nLet your body recuperate at its own pace.");
		
		sys.wait(5);
		
		PhobosShowSubtitle_e1m1_1("Dr. Nielsen", "Special Agent Miles had to rush off.\nBut might be able to help you with your identity.");
		
		sys.wait(5);
		
		ShowNPCSubtitles("Dr. Nielsen", "She'll be busy for a while. But if you want you can catch her at the Landing Terminal.\nJust through the lobby.", 6);
	}

	void ScannerSceneEnd()
	{
		thread UpdateCameraAngle();

		sys.wait(6);

		sys.trigger($scanner_camera);
		sys.trigger($info_player_teleport_3);		

		$scanner_headlight.startSoundShader("sound/shav/e1m1/scanner4.ogg", SND_CHANNEL_BODY);
		sys.fadeTo('1 1 1', 0, 5);
		
		sys.wait(3);
		
		StopScannerRings();

		sys.wait(2);

		PhobosShowSubtitle_e1m1_1("...", "Hello.");
		CharacterSays(playerC, "sound/vo/player/general/Hello.ogg");

		sys.wait(.75);

		thread Doctor6Sub();
		CharacterSays(doctorC, "sound/vo/e1m1/doctorsappointment/Doctor6.ogg");

		thread MoveOutOfScanner();

		sys.wait(.3);
						
		PhobosShowSubtitle_e1m1_1("...", "I only see flashes. Other people.\nI dont remember anything substantial about myself.");
		CharacterSays(playerC, "sound/vo/e1m1/doctorsappointment/Player7.ogg");

		Beat(.7);

		thread Doctor7Sub();
		CharacterSays(doctorC, "sound/vo/e1m1/doctorsappointment/Doctor7.ogg");
		
		sys.wait(.5);
			
		RotateBed();

		sys.wait(.7);

		sys.fadeTo('1 1 1', 1, .0625);
		sys.wait(0.0625);
		sys.trigger($scanner_camera);				
		sys.fadeTo('1 1 1', 0, .125);
		
		$scanner_playerbody.hide();
		sys.trigger($target_setinfluence_4);		

		sys.trigger($target_setkeyval_8);
		sys.trigger($target_setshaderparm_4);
		$doctordoor.lock(0);

		sys.trigger($e1m1_doctor_walking_medwing_3);
		sys.trigger($relay_miles);
		$e1m1_doctor_walking_medwing_3.show();
		$e1m1_doctor_walking_medwing_1.hide();
		
		sys.trigger($trigger_once_11);
		
		scannerActive = 0;

		sys.wait(1);

		sys.trigger($relay_objective_doctor_complete);
		hospitalActive = 0;
	}

	void SetupScanner()
	{
		float l = 1;
		while(l < 9)
		{
			thread crossFadeEnt (sys.getEntity("scanner_ring_1_lamp_" + l), '0 0 0', '1 0.65 0.3', .1);
			thread crossFadeEnt (sys.getEntity("scanner_ring_1_lamp_" + l + "_flare"), '0 0 0', '1 0.65 0.3', .1);

			thread crossFadeEnt (sys.getEntity("scanner_ring_2_lamp_" + l), '0 0 0', '1 0.65 0.3', .1);
			thread crossFadeEnt (sys.getEntity("scanner_ring_2_lamp_" + l + "_flare"), '0 0 0', '1 0.65 0.3', .1);
			
			thread crossFadeEnt (sys.getEntity("scanner_ring_3_lamp_" + l), '0 0 0', '1 0.65 0.3', .1);
			thread crossFadeEnt (sys.getEntity("scanner_ring_3_lamp_" + l + "_flare"), '0 0 0', '1 0.65 0.3', .1);

			l++;
		}
		thread crossFadeEnt ($scanner_ring_1_light, '0 0 0', '1 0.65 0.3', .1);
		thread crossFadeEnt ($scanner_ring_2_light, '0 0 0', '1 0.65 0.3', .1);
		thread crossFadeEnt ($scanner_ring_3_light, '0 0 0', '1 0.65 0.3', .1);
		thread MoveIntoScanner();
		thread StartScannerRings();
	}

