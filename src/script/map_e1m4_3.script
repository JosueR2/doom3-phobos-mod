	float fourRooms = 0;
	float fourRooms1Target = 1;
	float fourRooms2Target = 1;
	float fourRooms3Target = 1;
	float fourRooms4Target = 1;

	void FourRoomsRotateDoor(string doorChar, vector rot, float newState)
	{
		entity door = sys.getEntity("outro_boxroom_" + doorChar + "_door_hinge");

		float doorState = door.getFloatKey("doorState");

		if(doorState == 2)
		{
			sys.waitFor(door);
			sys.wait(.1);
			doorState = door.getFloatKey("doorState");
		}

		if(doorState == newState)
		{			
			return;
		}

		door.setKey("doorState", 2);

		door.rotateOnce(rot);
		sys.waitFor(door);

		door.setKey("doorState", newState);
	}
	
	void FourRoomsOpenDoor(string door)
	{		
		FourRoomsRotateDoor(door, '0 -85 0', 1);
	}

	void FourRoomsCloseDoor(string door)
	{
		FourRoomsRotateDoor(door, '0 85 0', 0);
	}

	float FourRoomsIncrement(string room, float step, float target)
	{		
		if(fourRooms % 4 == step)
		{
			entity wall = sys.getEntity("outro_boxroom_" + room + "_wall_" + target);			
			entity relay = sys.getEntity("outro_boxroom_" + room + "_wall_" + target + "_relay");
			wall.show();
			sys.trigger(relay);

			string dtOpen = "a";
			string dtClose = "b";

			if(room == "a")
			{				
				dtOpen = "a";
				dtClose = "b";
			}
			else if(room == "b")
			{				
				dtOpen = "b";
				dtClose = "c";
			}
			else if(room == "c")
			{				
				dtOpen = "c";
				dtClose = "d";
			}
			else
			{				
				dtOpen = "d";
				dtClose = "a";
			}

			thread FourRoomsCloseDoor(dtClose);
			thread FourRoomsOpenDoor(dtOpen);

			fourRooms++;
			target++;
		}

		return target;
	}

	void FourRoomsEnd()
	{
		clockRunning = 0;
		sys.waitFor($outro_clock_smallhand);
