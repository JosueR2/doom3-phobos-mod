	void StartMotelStruggleBarnScene()
	{		
		$outro_secret_hatch.rotateOnce('95 0 0');
		$outro_secret_hatch.startSoundShader("e1m3_1_hatchclose", SND_CHANNEL_ANY);
		
		sys.wait(2);
		
		sys.showTextMessage("The box is in position! Call me!", 1);

		sys.wait(2);

		sys.fadeTo('0 0 0', 1, 0);
		$Speaker_TheLastCall.fadeSound(SND_CHANNEL_ANY, -30, 10);

		sys.wait(6);

		$motel_phone.hide();
		$motel_phone_gui.hide();
		$motel_phone_corners.hide();

		//$func_mover_9.unbind();
		$portalview_barnmotel.show();
		$portalview_barnmotel.bind($func_mover_9);
		sys.trigger($portalsky_motel);
		$func_mover_8.moveTo($target_null_2);
		sys.trigger($func_cameraview_1);

		sys.wait(1);
		
		sys.wait($player1.startSoundShader("sound/shav/e1m3/phonering.ogg", SND_CHANNEL_ANY));
				
		$func_mover_117.move(90, 256);
		$func_mover_9.rotateOnce('0 -90 0');
		$func_mover_10.rotateOnce('0 75 0');		
		
		sys.wait(.5);
		$player1.startSoundShader("sound/shav/e1m3/pickupphone.ogg", SND_CHANNEL_ANY);

		sys.fadeTo('0 0 0', 0, 0.25);

		sys.wait(.25);

		$player1.startSoundShader("sound/shav/e1m5_4/looming.ogg", SND_CHANNEL_ANY);

		thread ShowSubtitles("Sam", "Hey. How did it go?\nIs it done?", 3);
		CharacterSays($player1, "sound/vo/e1m5_4/Barn/Player1.ogg");
		
		Beat(.5);

		thread LeeBarnSub1();
		float lee1duration = CharacterSaysNoWait ($player1, "sound/vo/e1m5_4/Barn/Lee1.ogg");		

		sys.wait(5.5);
		lee1duration -= 5.5;
				
		$speaker_intro_generator.fadeSound(SND_CHANNEL_ANY, -100, 3);
		$func_mover_9.rotateOnce('0 -90 0');
		sys.trigger($info_player_teleport_lee);

		$motel_phone.show();
		$motel_phone_gui.show();
		$motel_phone_corners.show();

		sys.wait(4.5);
		lee1duration -= 4.5;

		$motel_phone_gui.setGuiParm("gui_parm1", 1);
		sys.trigger($motel_phone_gui);
		$motel_phone_light.show();

		$speaker_intro_generator.fadeSound(SND_CHANNEL_ANY, 0, 3);

		sys.trigger($leemotel_camera_1);

		sys.wait(lee1duration);		

		$motel_phone_gui.setGuiParm("gui_parm1", 2);
		sys.trigger($motel_phone_gui);

		$portalview_barnmotel.hide();

		Beat(.25);

		sys.trigger($sam_cam_1);

		thread ShowSubtitles("Sam", "You can't get here fast enough!\nAre you at the motel?", 4);
		CharacterSays($player1, "sound/vo/e1m5_4/Barn/Player2.ogg");

		Beat(.5);

		vector angles = $leemotel_camera_2.getAngles();
		
		$leemotel_bag.show();
		$leemotel_bag_mover.move(DOWN, 16);
		$player1.startSoundShader("sound/shav/e1m5_4/bagdown.ogg", SND_CHANNEL_ANY);
		
		$player1.setViewAngles(angles);
		sys.trigger($sam_cam_1);

		$speaker_intro_generator.fadeSound(SND_CHANNEL_ANY, -20, 3);
	}

	float knock_camera_updating = 1;
	void UpdateStruggleKnockCamera(float fov_from, float fov_to, float total_time)
	{
		knock_camera_updating = 1;
				
		float now = sys.getTime();
		float then = now + total_time;
				
		float fov_travel = fov_to - fov_from;

		float tsec = 1.0 / total_time;

		while(knock_camera_updating)
		{
			now = sys.getTime();

			if(now >= then)
			{				
				$cam_knock_on_door.setKey("fov", fov_to);	
				
				knock_camera_updating = 0;
				
				break;
			}

			float t = (total_time - (then - now)) * tsec;

			t = EaseInOutCubic(t);

			$cam_knock_on_door.setKey("fov", fov_from + fov_travel * t);

			sys.waitFrame();
		}
	}	

	void bang_door_03()
	{
		float n = 0;
		while(n < 5)
