	float fork1State = 0;
	float fork2State = 0;
	
	void ToggleFork1()
	{
		if( fork1State != 2 )
		{
			$CarForkSwitch1.setKey("click_item", "0");			

			if( fork1State == 0 )
			{
				fork1State = 2;
				
				$CarForkSwitch1Handle.rotateOnce('0 0 -90');
				$CarForkSwitch1.startSoundShader("one_shot_electrical_switch_heavy_1", SND_CHANNEL_ANY);

				sys.wait(.75);

				$Fork1.move(UP, 24);
				sys.waitFor($Fork1);
				
				$forkRover.bind($Fork1);
				
				$Fork1.move(UP, 152);
				sys.trigger($func_aas_obstacle_3);
				sys.waitFor($Fork1);
				
				$forkRover.unbind();
				
				fork1State = 1;
			}
			else if( fork1State == 1 )
			{
				fork1State = 2;
				
				$CarForkSwitch1Handle.rotateOnce('0 0 90');
				$CarForkSwitch1.startSoundShader("one_shot_electrical_switch_heavy_1", SND_CHANNEL_ANY);		

				sys.wait(.75);

				$forkRover.bind($Fork1);
				sys.trigger($func_aas_obstacle_3);
				$Fork1.move(DOWN, 152);
				
				sys.waitFor($Fork1);
				
				$forkRover.unbind();
				
				$Fork1.move(DOWN, 24);
				sys.waitFor($Fork1);
				
				fork1State = 0;
			}

			$CarForkSwitch1.setKey("click_item", "1");
		}		
	}
	
	void ToggleFork2()
	{
		if( fork2State != 2 )
		{
			$CarForkSwitch2.setKey("click_item", "0");

			if( fork2State == 0 )
