	void PrepareScene()
	{
		sys.trigger($sewer_target_setinfluence_1);

		$skyportal_mover.rotateOnce('0 180 0');
		sys.waitFor($skyportal_mover);
		$skyportal_mover.rotateOnce('0 0 10');					
	}
	
	void ShippingCrates(float crate_num)
	{
		entity crate = sys.getEntity("crate_mover" + crate_num);
	
		crate.move(270, 120);
		sys.waitFor(crate);
		crate.bind($crate_pivot1);
		$crate_pivot1.rotateOnce( '0 -90 0' );
		sys.waitFor($crate_pivot1);
		crate.unbind();
		$crate_pivot1.restorePosition();
		crate.time(3.4);
		crate.move(180, 220);
		sys.waitFor(crate);
		crate.bind($crate_pivot2);
		$crate_pivot2.rotateOnce( '45 0 0' );
		sys.waitFor($crate_pivot2);
		crate.unbind();
		$crate_pivot2.restorePosition();
		crate.time(1.5);
		crate.moveTo($ship_crate_dest1);
		sys.waitFor(crate);
		crate.bind($crate_pivot3);
		$crate_pivot3.rotateOnce( '-45 0 0' );
		sys.waitFor($crate_pivot3);
		crate.unbind();
		$crate_pivot3.restorePosition();
		crate.time(.8);
		crate.move(180, 64);
		sys.waitFor(crate);
		crate.bind($crate_pivot4);
		$crate_pivot4.rotateOnce( '0 -90 0' );
		sys.waitFor($crate_pivot4);
		crate.unbind();
		$crate_pivot4.restorePosition();
		crate.time(.75);
		crate.move(90, 60);
		sys.waitFor(crate);
		crate.restorePosition();
	}
	
	void ShippingCratesLoop()
	{
	while(1)
		{
			thread ShippingCrates(1);
			sys.wait(4);
			thread ShippingCrates(2);
			sys.wait(4);
			thread ShippingCrates(3);
			sys.wait(4);
			thread ShippingCrates(4);
			sys.wait(4);
		}
	}
	
