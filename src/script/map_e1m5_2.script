			$pist2.startSoundShader ("rec1_pump_endclack_01", SND_CHANNEL_ITEM );
		}
	}

	float CheckBigDoor(float doorNum)
	{
		entity door = sys.getEntity("fuel_bigdoor_0" + doorNum);
		float doorStatus = door.getFloatKey("DoorStatus");
		return doorStatus;
	}

	float CheckNextBigDoor(float doorNum)
	{
		if(doorNum == 9)
			return 0;

		return CheckBigDoor(doorNum + 1);
	}

	float CheckPrevBigDoor(float doorNum)
	{
		if(doorNum == 1)
			return 0;

		return CheckBigDoor(doorNum - 1);
	}

	void OpenBigDoor(float doorNum, float handleNum)
	{		
		float handleDis = 6;
		float otherHandleNum = 3 - handleNum;

		entity handle = sys.getEntity("fuel_bigdoor_0" + doorNum + "_handle_" + handleNum);
		entity otherClicker= sys.getEntity("fuel_bigdoor_0" + doorNum + "_handle_" + otherHandleNum + "_clicker");
		otherClicker.setKey("click_item", 0);

		vector handleRv = handle.getVectorKey("rotateVector");
		float handleOut = handle.getFloatKey("outDir");

		entity door = sys.getEntity("fuel_bigdoor_0" + doorNum);
		entity door_aas_relay_open = sys.getEntity("fuel_bigdoor_0" + doorNum + "_aas_relay_open");
		entity door_aas_relay_close = sys.getEntity("fuel_bigdoor_0" + doorNum + "_aas_relay_close");
		entity door_relay_var1 = sys.getEntity("fuel_bigdoor_0" + doorNum + "_relay_var1");
		entity door_relay_var2 = sys.getEntity("fuel_bigdoor_0" + doorNum + "_relay_var2");
		entity crusher = sys.getEntity("fuel_bigdoor_0" + doorNum + "_crusher");
		entity crusher_off = sys.getEntity("fuel_bigdoor_0" + doorNum + "_crusher_off");
		vector doorRv = door.getVectorKey("rotateVector");
		entity switch_blinkya = sys.getEntity("fuel_bigdoor_0" + doorNum + "_switch_lighta");
		entity switch_blinkyb = sys.getEntity("fuel_bigdoor_0" + doorNum + "_switch_lightb");
		entity switch_blinky_deco = sys.getEntity("fuel_bigdoor_0" + doorNum + "_switch_light_deco");
		entity switch_blinky_decy = sys.getEntity("fuel_bigdoor_0" + doorNum + "_switch_light_decy");
		entity switch_blinky_decg = sys.getEntity("fuel_bigdoor_0" + doorNum + "_switch_light_decg");
		float doorStatus = door.getFloatKey("DoorStatus");

		entity speaker = sys.getEntity("fuel_bigdoor_0" + doorNum + "_speaker");
		entity portal = sys.getEntity("fuel_bigdoor_0" + doorNum + "_portal");
		entity clicker = sys.getEntity("fuel_bigdoor_0" + doorNum + "_handle_" + handleNum + "_clicker");
		entity step1 = sys.getEntity("fuel_bigdoor_0" + doorNum + "_step_1");
		entity step2 = sys.getEntity("fuel_bigdoor_0" + doorNum + "_step_2");
		float step1Out = step1.getFloatKey("outDir");
		float step2Out = (180 + step1Out) % 360;
			
		handle.move(handleOut, handleDis);
		handle.startSoundShader ("sound/shav/e1m5_2/handleout.ogg", SND_CHANNEL_ANY);
		
		sys.waitFor(handle);

		float locked = CheckPrevBigDoor(doorNum);
		if(!locked)
		{		
			locked = CheckNextBigDoor(doorNum);
		}
		
		if(locked == 1)
		{			
			clicker.startSoundShader ("sound/shav/general/alarm4.ogg", SND_CHANNEL_ANY);
			sys.wait(1);
			handle.time(2);
			handle.move(handleOut, -handleDis);
			handle.startSoundShader ("sound/shav/e1m5_2/handlein.ogg", SND_CHANNEL_ANY);
			sys.waitFor(handle);
			handle.time(0.3);
		}
		else
		{
			door.setKey("DoorStatus", 1);

			sys.wait(.25);

			if(doorStatus == 0)
			{
				handle.rotateOnce(handleRv * 90);
			}
			else
			{
				handle.rotateOnce(handleRv * -90);				
			}
			
			handle.startSoundShader ("sound/shav/e1m5_2/handlerot.ogg", SND_CHANNEL_ANY);
			sys.waitFor(handle);
			sys.wait(.25);

			handle.move(handleOut, -handleDis);
			handle.startSoundShader ("sound/shav/e1m5_2/handleout2.ogg", SND_CHANNEL_ANY);
		
			sys.waitFor(handle);
			sys.wait(1);

			if(doorStatus == 0)
			{
				sys.trigger(portal);
				sys.trigger(door_aas_relay_open);
				sys.trigger(door_relay_var1);
				switch_blinkya.setColor(1, 1, 0);
				switch_blinkyb.setColor(1, 1, 0);
				switch_blinky_deco.hide();
				switch_blinky_decy.show();				
			}
			else if(doorStatus == 1)
			{
				step1.move(step1Out, 24);
				step2.move(step2Out, 24);
				sys.trigger(door_aas_relay_close);
				sys.trigger(door_relay_var2);
				switch_blinkya.setColor(1, 1, 0);
				switch_blinkyb.setColor(1, 1, 0);
				switch_blinky_decg.hide();
				switch_blinky_decy.show();
				sys.trigger(crusher);
				sys.trigger(crusher_off);
			}

			door.rotateOnce(doorRv * 180);
			sys.wait(.1);
			sys.trigger(speaker);

			if(doorStatus == 0)
			{
				sys.wait(8);

				step1.move(step2Out, 24);
				step2.move(step1Out, 24);
			}

			sys.waitFor(door);

			if(doorStatus == 1)
			{
				sys.trigger(portal);
				switch_blinkya.setColor(1, 0.5, 0);
				switch_blinkyb.setColor(1, 0.5, 0);
				switch_blinky_decy.hide();
				switch_blinky_deco.show();
				doorStatus = 0;
			}
			else
			{			
				switch_blinkya.setColor(0, 1, 0.5);
				switch_blinkyb.setColor(0, 1, 0.5);
				switch_blinky_decy.hide();
				switch_blinky_decg.show();	
				doorStatus = 1;
			}
		
			door.setKey("DoorStatus", doorStatus);
			sys.wait(4);
		}
		clicker.setKey("click_item", 1);
		otherClicker.setKey("click_item", 1);
	}

