	float drainToggle = 0;

	void DrainPuzzle_Reset()
	{
		if(drainToggle == 0)
		{
			$drainpuzzleconsole.setGuiParm("gui_parm1", 1);
			$drainpuzzleconsole.setGuiParm("gui_parm2", 0);
			$drainpuzzleconsole.setGuiParm("gui_parm3", 1);
			$drainpuzzleconsole.setGuiParm("gui_parm4", 1);
			$drainpuzzleconsole.setGuiParm("gui_parm5", 0);
			$drainpuzzleconsole.setGuiParm("gui_parm6", 1);
			$drainpuzzleconsole.setGuiParm("gui_parm7", 1);
			$drainpuzzleconsole.setGuiParm("gui_parm8", 0);
			$drainpuzzleconsole.setGuiParm("gui_parm9", 1);			
		}
		else if(drainToggle == 1)
		{
			$drainpuzzleconsole.setGuiParm("gui_parm1", 1);
			$drainpuzzleconsole.setGuiParm("gui_parm2", 0);
			$drainpuzzleconsole.setGuiParm("gui_parm3", 0);
			$drainpuzzleconsole.setGuiParm("gui_parm4", 0);
			$drainpuzzleconsole.setGuiParm("gui_parm5", 0);
			$drainpuzzleconsole.setGuiParm("gui_parm6", 1);
			$drainpuzzleconsole.setGuiParm("gui_parm7", 1);
			$drainpuzzleconsole.setGuiParm("gui_parm8", 0);
			$drainpuzzleconsole.setGuiParm("gui_parm9", 0);			
		}
		else
		{
			$drainpuzzleconsole.setGuiParm("gui_parm1", 1);
			$drainpuzzleconsole.setGuiParm("gui_parm2", 0);
			$drainpuzzleconsole.setGuiParm("gui_parm3", 0);
			$drainpuzzleconsole.setGuiParm("gui_parm4", 0);
			$drainpuzzleconsole.setGuiParm("gui_parm5", 1);
			$drainpuzzleconsole.setGuiParm("gui_parm6", 0);
			$drainpuzzleconsole.setGuiParm("gui_parm7", 1);
			$drainpuzzleconsole.setGuiParm("gui_parm8", 0);
			$drainpuzzleconsole.setGuiParm("gui_parm9", 1);			
		}

		drainToggle = (drainToggle + 1) % 3;

		sys.trigger($drainpuzzleconsole);
	}

