	void PowerCargo()
	{
		$cargolift_power_junction_handle.time(0.15);
		$cargolift_power_junction_handle.rotateOnce('-90 0 0');
		$cargolift_power_junction_handle.startSoundShader("sound/shav/e1m5_3/large_switch.ogg", SND_CHANNEL_ANY);

		sys.wait(.5);

		if(power1_state && power2_state && power3_state)
		{
			sys.trigger($liftcable_current);
			thread crossFadeEnt ($liftcable_current, '0 0 0', '0.33 0.33 0.85', 0.75);
			thread crossFadeEnt ($cargoliftlights_redtogreen, '1 0 0', '0 1 0', 0.65);
			thread crossFadeEnt ($cargoliftlights_blacktogreen, '0 0 0', '0.3 0.71 0.3', 0.85);
			power4 = 1;
			sys.wait(1);
			sys.trigger($trigger_count_26);
			sys.trigger($trigger_count_24);
			sys.trigger($func_forcefield_12);
			sys.trigger($endlevel_archvile_aas);
			sys.trigger($levelexit_archvile_relay);
			sys.trigger($levelendsave_relay);
		}
		else
		{
			$cargolift_power_junction_handle.time(2);
			$cargolift_power_junction_handle.rotateOnce('90 0 0');			
			sys.waitFor($cargolift_power_junction_handle);

			sys.wait(1);

			$cargolift_power_junction_handle_clicker.setKey("click_item", 1);
		}
	}

	void CargoLift()
	{
		$cargolift_handle.time(0.35);
		$cargolift_handle.move(UP, 12);
		$cargolift_handle.startSoundShader("sound/shav/e1m5_3/large_switch.ogg", SND_CHANNEL_ANY);

		sys.waitFor($cargolift_handle);

		sys.wait(.5);

		if(power4)
		{
			sys.trigger($cargo_lift_player_clip);
		
			$func_static_58415.setColor(0, 0.494118, 0.090196);
			$func_static_58408.setColor(0, 0.5, 0);
			$func_static_58411.setColor(0.5, 0, 0);
			$func_static_58412.setColor(0.5, 0, 0);
			
			sys.wait(1);

			$tension_leg_top_cargo_lift.move(UP, 192);
			sys.wait(3);
			sys.trigger($target_endlevel_1);
		}
		else
		{
			$cargolift_handle.time(2);
			$cargolift_handle.move(DOWN, 12);
			sys.waitFor($cargolift_handle);

			sys.wait(1);

			$cargolift_handle_clicker.setKey("click_item", 1);
		}
	}
	
