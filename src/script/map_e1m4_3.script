		}		
	}

	float ring1Status = 0;
	float ring2Status = 0;
	float ring3Status = 0;

	void RunRing(entity ring, float direction, float isStarting)
	{
		float i,v,t,blendtime,velmult,final;
		vector rotvector;
		½
		blendtime = 10;
		velmult = .3;

		if( isStarting == 0)
		{
			blendtime /= 2;
			velmult *= 2;			
		}		

		t = blendtime * GAME_FPS;
		final = (t-1) * velmult;

		for ( i = 0; i < t; i++ )
		{
			if(isStarting == 1)
			{
				v = (i * velmult);
			}
			else
			{
				v = final - (i * velmult);				
			}
			
			rotvector_x=0;
			rotvector_y=0; 
			rotvector_z=v * direction;
			
			ring.rotate ( rotvector );
			
			sys.wait( GAME_FRAMETIME );
		}		
	}

	void RunRing1(float isStarting)
	{
		ring1Status = 1;
		RunRing($dejcrook01, 1, isStarting);
		ring1Status = 2;
	}

	void RunRing2(float isStarting)
	{
		ring2Status = 1;
		RunRing($dejcrook02, -1, isStarting);
		ring2Status = 2;
	}

	void RunRing3(float isStarting)
	{
		ring3Status = 1;
		RunRing($dejcrook03, 1, isStarting);
		ring3Status = 2;

		sys.wait(3);

		ring3Status = 3;		
	}

	void StartScannerRings()
	{
		thread RunRing1(1);
		//sys.wait(.5);
		thread RunRing2(1);
		//sys.wait(.5);
		thread RunRing3(1);
	}

	void StopScannerRings()
	{
		thread RunRing1(0);
		//sys.wait(.5);
		thread RunRing2(0);
		//sys.wait(.5);
		RunRing3(0);
	}

	void TurnOffScreen(entity screen, entity flare)
	{
		screen.setColor(0, 0, 0);
		flare.setColor(0, 0, 0 );
		screen.setGuiParm ("gui_parm91", 1);
		screen.startSoundShader("guisounds_close", SND_CHANNEL_ANY);
		sys.trigger(screen);
	}
	
	void TurnOnScreen(entity screen, entity flare)
	{		
		screen.setColor(1, 1, 1);
		flare.setColor(0.05, 0.08, 0.14);
		screen.setGuiParm ("gui_parm91", 0);
		screen.startSoundShader("guisounds_open", SND_CHANNEL_ANY);
		sys.trigger(screen);
	}

	float PrintDejCrooks()
	{
		vector dc = $dejcrook01.getWorldOrigin();
		vector anchor = $dejcrook01_anchor.getWorldOrigin();
		vector spinner = $dejcrook01_spinner.getWorldOrigin();

		vector v1 = sys.vecNormalize(spinner - dc);
		vector v2 = sys.vecNormalize(anchor - dc);

		float dot = sys.DotProduct(v1, v2);

		return dot;
	}
	
	void OpenDejCrooksPanel()
	{
		$dejcrook_lever_hinge.rotateOnce('-99 0 0');
		$dejcrook_lever_hinge.startSoundShader("e1m5_3_large_switch", SND_CHANNEL_ANY);

		sys.waitFor($dejcrook_lever_hinge);
		sys.wait(.5);

		$dejcrook_panel_hinge.rotateOnce('-160 0 0');
		$dejcrook_panel_hinge.startSoundShader("e1m4_3_hinge_creak", SND_CHANNEL_ANY);

		sys.waitFor($dejcrook_panel_hinge);
		sys.wait(.5);

		sys.wait(1);

		TurnOnScreen($dejcrooks_panel_gui, $dejcrooks_panel_gui_flare);

		sys.wait(.5);

		sys.trigger($dejcrooks_panel_setinteractive);
	}

	void ClickCacheButton(entity button)
	{
		float direction = button.getFloatKey("direction");
		button.move(direction, 1);
		button.startSoundShader("e1m1_intercomclick1", SND_CHANNEL_ANY);
		sys.waitFor(button);

		sys.wait(.125);
		button.startSoundShader("e1m1_intercomclick2", SND_CHANNEL_ANY);
		button.move(direction + 180, 1);
	}

	void StopDejcrooks()
	{
		ClickCacheButton($func_mover_102);

		float dot = PrintDejCrooks();
		
		if(dot > 0 && dot < 1)
		{
			sys.wait(.5);			
		}
	
		$whirly_fan_spkr.fadeSound (SND_CHANNEL_ANY, -30, 3);
		StopScannerRings();		
		$func_static_101239.setKey ("click_item", "1");
	}

