	void MoveBear()
	{
		sys.wait(1.25);
			
		$LeeStepSpeaker.startSoundShader("e1m3_1_Leestep5", SND_CHANNEL_ANY);		

		thread ShowNPCSubtitles("Lee", "Watch out below!", 2);
		Intro_CharacterSays($LeeAtticSpeaker, "e1m3_1_intro_Lee15");		
		
		sys.wait(1.25);
		
		sys.trigger($bear_moveable);
		
		sys.wait(1.5);
		
		thread ShowNPCSubtitles("Lee", "Find a nice spot to hang it.", 2.15);
		Intro_CharacterSays($LeeAtticSpeaker, "e1m3_1_intro_Lee16");
		
		sys.wait(1.25);
		
		$bear_moveable.setKey("click_item", 1);
	}	
	
