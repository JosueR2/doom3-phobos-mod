	void StartMilesTalkPostMuseum()
	{
		$func_door_188811.lock(2);
		$func_static_107785.setColor(0.5,0,0);	
		StopMuseumSpeak(-1);


		thread Miles1Subs();
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkPostMuseum/Miles1.ogg");

		Beat(.5);

		thread ShowSubtitles("Sam", "What do you mean, last seen?\nDid I disappear?", 3.5);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkPostMuseum/Player1.ogg");

		Beat(.5);

		thread Miles2Subs();
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkPostMuseum/Miles2.ogg");

		Beat(.5);

		thread ShowSubtitles("Sam", "Listening station? I erm...\nThere were a lot of machines and a suspended or floating...cube...of sorts.", 11.5);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkPostMuseum/Player2.ogg");

		Beat(.5);

		thread ShowSubtitles("Samantha", "Bingo.", 2);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkPostMuseum/Miles3.ogg");

		Beat(.5);

		thread Player3Subs();
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkPostMuseum/Player3.ogg");

		Beat(.5);
		
		thread ShowSubtitles("Samantha", "So...what are you going to do now?\n...and...what should I call you? Sam or Ethan?", 10);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkPostMuseum/Miles4.ogg");

		Beat(.5);

		thread Player4Subs();
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkPostMuseum/Player4.ogg");

		Beat(.5);

		thread ShowSubtitles("Samantha", "So Sam.\n Are we okay?", 6);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkPostMuseum/Miles5.ogg");

		Beat(.5);

		thread ShowSubtitles("Sam", "Let's see.", 2);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkPostMuseum/Player5.ogg");
	}

	float redKeyFound = 0;

	float ScanExitDoorDetention()
	{		
		sys.disableItemGroup("exitdoor_detention");

		sys.trigger($exitdoor_keypanelscanner_detention);

		sys.wait(1);

		if(redKeyFound == 0)
		{
			sys.trigger($exitdoor_keypanelscanner_detention);
			
			$exitdoor_keypanel_detention.startSoundShader("shav_general_alarm5", SND_CHANNEL_ANY);
			
			sys.wait(2.5);
			
			sys.enableItemGroups();
			
		}
		else
		{
			sys.trigger($redkey_relay);
			
			sys.wait(1);
			
			sys.trigger($exitdoor_keypanelscanner_detention);
			
			sys.trigger($exitdoor_keypanel_detention);
			$exitdoor_keypanel_detention.startSoundShader("shav_general_accepted", SND_CHANNEL_ANY);

			$func_static_107788.setColor(0,1,0);			
		}
	}
	
	void keyscan_red()
	{
		$redkey_insert.show();
		$redkey_insert.move(0, 10);
		sys.waitFor($redkey_insert);
			
		sys.trigger($keyinsert_spkr_red);
		
		sys.trigger($exitguis_detention_blue);
		
		sys.wait(.35);
			
		$redkey_insert.move(180, 8);
		sys.waitFor($redkey_insert);
		$redkey_insert.hide();
		
		sys.trigger($exitguis_detention_green);
		
		sys.trigger($ExitDoor);
	}

	void RedKeyInspected()
	{
		redKeyFound = 1;
		$KeyCard_Red.hide();
	}

	void setup()
	{
		sys.trigger($func_static_77865);
		sys.trigger($trigger_relay_1232);
		thread select_monsterconfig1();
		sys.wait(1);
		thread select_monsterconfig2();
		sys.wait(5);
		thread select_monsterconfig3();
		sys.wait(4);
		thread select_monsterconfig4();
		sys.wait(3);
		thread select_monsterconfig5();
		sys.wait(3.5);
		thread select_lostsouls();
		sys.wait(2.5);
		thread select_archvile_config1();
		sys.wait(4);
		thread select_archvile_teleportdest();
		SetupMallLights();
		SetupMuseumLights();
		SetupGondola();
		top_apartment_shutters_open();
		sys.trigger($trigger_relay_895);
		
		sys.wait(1);
		thread shippingcrates1();
		thread arch_fight_soundlevels();

	}

	void Intro_Chapter_Text()
	{
		sys.fadeTo('0 0 0', 1, .01);
		sys.wait(.01);

		sys.trigger($cam_chapter_text);
		
		sys.wait(2);
		
		//sys.trigger($speaker_chapter_text);

		sys.fadeTo('0 0 0', 0, 2);

		sys.wait(4);

		sys.fadeTo('0 0 0', 1, 2);

		sys.wait(3);
	}

	

	void Back_To_Level()
	{
		Intro_Chapter_Text();

		sys.trigger($info_player_teleport_level);
		sys.trigger($cam_chapter_text);

		//sys.fadeTo('0 0 0', 0, 2);

		sys.wait(2);

		sys.trigger($trigger_relay_gear);
		sys.trigger($setinfluence_motel);
		
		sys.wait(1.5);
		
		post_intro_checkpoint();

		sys.wait(4);

		thread ShowSubtitles("Samantha", "I want the best for you.\nI hope you know that.", 4);
		CharacterSays($player1, "sound/vo/e1m5_4/MilesCall/Miles9.ogg");
		
		sys.trigger($trigger_relay_867);

		sys.trigger($info_portalsky_1);
		
		$ghostskull_orbit_tilt1.rotateOnce('12 0 0');
		$ghostskull_orbit_tilt2.rotateOnce('-18 0 0');
		$ghostskull_orbit_tilt3.rotateOnce('25 0 0');
		
		sys.wait(2);
		
		$ghostskull_orbit1.rotate( '0 165 0' );
		$ghostskull_orbit2.rotate( '0 -205 0' );
		$ghostskull_orbit3.rotate( '0 195 0' );
		thread ghostskulls_axial_tilt();
		
		$arch_repel_trig1.disable();
		$arch_repel_trig2.disable();
		$arch_repel_trig3.disable();
		$arch_repel_trig4.disable();
		$arch_repel_trig5.disable();
		$arch_repel_trig6.disable();
		
		$speaker_95.fadeSound (SND_CHANNEL_ANY, -50, 3);
		$speaker_183.fadeSound (SND_CHANNEL_ANY, -31, 3);
		$speaker_182.fadeSound (SND_CHANNEL_ANY, -31, 3);
		$speaker_184.fadeSound (SND_CHANNEL_ANY, -40, 3);
		$speaker_181.fadeSound (SND_CHANNEL_ANY, -34, 3);
		$speaker_180.fadeSound (SND_CHANNEL_ANY, -32, 3);
		$speaker_179.fadeSound (SND_CHANNEL_ANY, -57, 3);
	}

	// Source: https://easings.net/#easeInOutCubic
	// We use this because we don't get any of the accel/decel stuff
	// because we do the updates manually
	float EaseInOutCubic(float x)
	{
		if(x < 0.5)
			return 4 * x * x * x;

		return 1 - sys.pow(-2 * x + 2, 3) * 0.5;
	}

	float motel_camera_updating = 1;
	void UpdateMotelFrontCamera(vector angles_from, vector angles_to, float fov_from, float fov_to)
	{
		motel_camera_updating = 1;
		vector final_angles = angles_to;
		vector initial_angles = angles_from;			

		vector travel = final_angles - initial_angles;			

		float total_time = 6.0;
		float now = sys.getTime();
		float then = now + total_time;
				
		float fov_travel = fov_to - fov_from;

		float tsec = 1.0 / total_time;

		while(motel_camera_updating)
		{
			now = sys.getTime();

			if(now >= then)
			{
				$motel_front_door_cam_mover.setAngles(final_angles);
				$motel_front_door_cam.setKey("fov", fov_to);	
				
				motel_camera_updating = 0;
				
				break;
			}

			float t = (total_time - (then - now)) * tsec;

			t = EaseInOutCubic(t);

			$motel_front_door_cam_mover.setAngles(initial_angles + travel * t);

			$motel_front_door_cam.setKey("fov", fov_from + fov_travel * t);

			sys.waitFrame();
		}
	}
	

