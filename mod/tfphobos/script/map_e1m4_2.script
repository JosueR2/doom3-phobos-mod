	vector darkBlue = '0.05 0.1 0.3';
	vector lightBlue = '0.05 0.2 0.6';

	void fuel_rods()		
	{
		thread crossFadeEnt ($fog_light, '0.26 0.55 1', '0.26 0.19 1', 1);
		thread crossFadeEnt ($fog_light2, '0.26 0.55 1', '0.26 0.19 1', 1);
		thread crossFadeEnt ($sin_light, '0 0.62 1', '0 0.22 1', 1);
		thread crossFadeEnt ($sin_light2, '0 0.62 1', '0 0.22 1', 1);
		thread crossFadeEnt ($fuel_light_1, lightBlue, darkBlue, 1);		
		thread crossFadeEnt ($fuel_light_2, lightBlue, darkBlue, 1);		
		//thread crossFadeEnt ($fuel_light_21, lightBlue, darkBlue, 1);
		thread crossFadeEnt ($fuel_rod, '0.1 0.78 1', '0.1 0.27 1', 1);
		thread crossFadeEnt ($fuel_rodflare, '0.18 0.67 1', '0.8 0.88 1', 1);		
		sys.wait(2.5);
		sys.trigger($fuel_rods_darkblue);
	}
		
	void fuel_rods2()		
	{
		thread crossFadeEnt ($fog_light, '0.26 0.19 1', '0.26 0.55 1', 1);
		thread crossFadeEnt ($fog_light2, '0.26 0.19 1', '0.26 0.55 1', 1);
		thread crossFadeEnt ($sin_light, '0 0.22 1', '0 0.62 1', 1);
		thread crossFadeEnt ($sin_light2, '0 0.22 1', '0 0.62 1', 1);
		thread crossFadeEnt ($fuel_light_1, darkBlue, lightBlue, 1);
		thread crossFadeEnt ($fuel_light_2, darkBlue, lightBlue, 1);
		//thread crossFadeEnt ($fuel_light_21, darkBlue, lightBlue, 1);
		thread crossFadeEnt ($fuel_rod, '0.1 0.27 1', '0.1 0.78 1', 1);
		thread crossFadeEnt ($fuel_rodflare, '0.8 0.88 1', '0.18 0.67 1', 1);
		sys.wait(2.5);
		sys.trigger($fuel_rods_lightblue);
	}	

	float northToggle = 0;
	float northToggling = 0;
	float centerToggle = 0;
	float centerToggling = 0;
	float southToggle = 0;
	float southToggling = 0;

	void SetLightPanel(string locality, float num, float state)
	{		
		entity e = sys.getEntity("fuel_pipe_" + locality + "_light_" + num);

		if(state == 0)
		{
			thread crossFadeEnt (e, '0 0 0', '0 0 0', .0125);
		}
		else if(state == 1)
		{
			thread crossFadeEnt (e, '.125 .125 .125', '.125 .125 .125', .0125);
		}
		else if(state == 2)
		{
			thread crossFadeEnt (e, '0.125 0.125 .75', '0.125 0.125 .75', .0125);			
		}		
		else if(state == 3)
		{
			thread crossFadeEnt (e, '0.75 0.125 .125', '0.75 0.125 .125', .0125);
		}
		else
		{
			thread crossFadeEnt (e, '0.125 0.75 .125', '0.125 0.75 .125', .0125);
		}
	}

	void CheckDrainConfiguration()
	{
		float correct = 0;

		if(northToggle == 2)
		{
			$fuel_indicator_north_light.show();
			$fuel_indicator_north_liquid.show();
			$fuel_indicator_north_flare.show();
		}
		else
		{
			$fuel_indicator_north_light.hide();
			$fuel_indicator_north_liquid.hide();
			$fuel_indicator_north_flare.hide();
		}

		if(centerToggle == 2)
		{
			$fuel_indicator_center_light.show();
			$fuel_indicator_center_liquid.show();
			$fuel_indicator_center_flare.show();
		}
		else
		{
			$fuel_indicator_center_light.hide();
			$fuel_indicator_center_liquid.hide();
			$fuel_indicator_center_flare.hide();
		}

		if(southToggle == 1)
		{
			$fuel_indicator_south_light.show();
			$fuel_indicator_south_liquid.show();
			$fuel_indicator_south_flare.show();
		}
		else
		{
			$fuel_indicator_south_light.hide();
			$fuel_indicator_south_liquid.hide();
			$fuel_indicator_south_flare.hide();
		}


		if(northToggle == 2 && centerToggle == 2 && southToggle == 1)
		{
			correct = 1;	

			// Disable the togglers
			$func_static_99284.setKey ("click_item", "0");
			$func_static_99283.setKey ("click_item", "0");
			$func_static_99176.setKey ("click_item", "0");

			$player1.startSoundShader("e1m4_3_success", SND_CHANNEL_BODY);

			sys.wait(1);

			// Show final
			SetLightPanel("south", 1, 4);
			SetLightPanel("center", 1, 4);
			SetLightPanel("north", 1, 4);

			SetLightPanel("north", 6, 3);
			SetLightPanel("north", 3, 3);
			SetLightPanel("center", 6, 3);
			SetLightPanel("center", 3, 3);
			SetLightPanel("south", 6, 3);
			SetLightPanel("south", 3, 3);

			SetLightPanel("north", 5, 2);
			SetLightPanel("north", 8, 2);			
			SetLightPanel("north", 4, 2);			
			SetLightPanel("center", 5, 2);
			SetLightPanel("center", 8, 2);			
			SetLightPanel("center", 4, 2);			
			SetLightPanel("south", 5, 2);
			SetLightPanel("south", 8, 2);			
			SetLightPanel("south", 4, 2);			

			SetLightPanel("south", 7, 0);
			SetLightPanel("center", 7, 0);
			SetLightPanel("north", 7, 0);
			SetLightPanel("south", 9, 0);
			SetLightPanel("center", 9, 0);
			SetLightPanel("north", 9, 0);
			SetLightPanel("south", 2, 0);
			SetLightPanel("center", 2, 0);
			SetLightPanel("north", 2, 0);			
		}
		
		$drainpuzzleconsole.setGuiParm("gui_parm41", correct);
		sys.trigger($drainpuzzleconsole);
	}

	void MoveLightPanelToggler(string locality, float toNum)
	{
		entity toggler = sys.getEntity("fuel_pipe_" + locality + "_toggler");
		entity to = sys.getEntity("fuel_pipe_" + locality + "_toggler_" + toNum);

		toggler.moveTo(to);
	}

	void TogglePipeNorth()
	{
		if(northToggling == 0)
		{
			northToggling = 1;

			$player1.startSoundShader("sound/gui_simpleout.ogg", SND_CHANNEL_BODY);

			if(northToggle == 0)
			{
				MoveLightPanelToggler("north", 3);

				SetLightPanel("north", 1, 1);
				SetLightPanel("north", 2, 1);
				SetLightPanel("north", 8, 1);
				SetLightPanel("north", 9, 1);

				SetLightPanel("north", 7, 3);
				SetLightPanel("north", 4, 3);
				SetLightPanel("north", 5, 3);
				SetLightPanel("north", 6, 3);
				SetLightPanel("north", 3, 3);				
			}
			else if(northToggle == 1)
			{
				MoveLightPanelToggler("north", 2);

				SetLightPanel("north", 1, 1);
				SetLightPanel("north", 2, 1);
				SetLightPanel("north", 4, 1);
				SetLightPanel("north", 5, 1);
				SetLightPanel("north", 7, 1);
				SetLightPanel("north", 8, 1);
				SetLightPanel("north", 9, 1);

				SetLightPanel("north", 6, 3);
				SetLightPanel("north", 3, 3);				
			}
			else if(northToggle == 2)
			{
				MoveLightPanelToggler("north", 1);

				SetLightPanel("north", 2, 1);
				SetLightPanel("north", 3, 1);
				SetLightPanel("north", 5, 1);
				SetLightPanel("north", 6, 1);
				SetLightPanel("north", 8, 1);
				SetLightPanel("north", 9, 1);

				SetLightPanel("north", 4, 3);
				SetLightPanel("north", 1, 3);
				SetLightPanel("north", 7, 3);								
			}

			northToggle = (northToggle + 1) % 3;

			sys.wait(.0125);

			CheckDrainConfiguration();

			//sys.wait(.2);

			northToggling = 0;			
		}
	}	

