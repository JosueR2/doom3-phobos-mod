	void Lee17Subs()
	{
		ShowSubtitles("Lee", "So you know. Maybe I'm repeating my mistakes.", 4);
		ShowSubtitles("Lee", "I just..for once..wanted to act upon life instead of having it act upon me.", 7);
		ShowSubtitles("Lee", "But if leaving this place in any way means losing you or what we have, I do not want it.", 9.75);
		ShowSubtitles("Lee", "I choose you.", 3);
	}

	void BarnLightning(float fadeInTime, float fadeOutTime, float staying, float intensity)
	{		
		thread crossFadeEnt ($Barn_Lightning, '0 0 0', '0.51 0.56 0.62' * intensity, fadeInTime);
		thread crossFadeEnt ($Barn_Lightning2, '0 0 0', '0.51 0.56 0.62' * intensity, fadeInTime);		
		thread crossFadeEnt ($outside_barn_lightning, '0 0 0', '0.51 0.56 0.62' * intensity, fadeInTime);				

		sys.wait(staying);
		
		thread crossFadeEnt ($Barn_Lightning, '0.51 0.56 0.62' * intensity, '0 0 0', fadeOutTime);
		thread crossFadeEnt ($Barn_Lightning2, '0.51 0.56 0.62' * intensity, '0 0 0', fadeOutTime);		
		thread crossFadeEnt ($outside_barn_lightning, '0.51 0.56 0.62' * intensity, '0 0 0', fadeOutTime);		
	}

	void BarnLightningSession()
	{
		sys.wait(1);		
		BarnLightning(0.1, .25, .3, .7);

		float times = 7;
	
		float j = 0;
		while(j < 3)
		{

		float i = 0;
		while(i < times - 1)
		{			
			sys.wait(GetRandom(0.05, 0.15));
			BarnLightning(GetRandom(0.01, .0625), GetRandom(0.01, .0625), GetRandom(0.01, .125), GetRandom(.1, 1));
			 
			i++;
		}

		sys.wait(GetRandom(0.05, 0.3));

		BarnLightning(GetRandom(0.1, .0625), GetRandom(0.3, .35), GetRandom(.2, .3), GetRandom(.5, .7));	

		sys.wait(3);		
	
		i = 0;
		while(i < times - 1)
		{			
			sys.wait(GetRandom(0.05, 0.15));
			BarnLightning(GetRandom(0.01, .0625), GetRandom(0.01, .0625), GetRandom(0.01, .125), GetRandom(.1, 1));
			 
			i++;
		}

		sys.wait(7);		
	
		i = 0;
		while(i < times - 1)
		{			
			sys.wait(GetRandom(0.05, 0.15));
			BarnLightning(GetRandom(0.01, .0625), GetRandom(0.01, .0625), GetRandom(0.01, .125), GetRandom(.1, 1));
			 
			i++;
		}

		i = 0;
		while(i < times - 1)
		{			
			sys.wait(GetRandom(0.05, 0.15));
			BarnLightning(GetRandom(0.01, .0625), GetRandom(0.01, .0625), GetRandom(0.01, .125), GetRandom(.1, 1));
			 
			i++;
		}

		sys.wait(GetRandom(0.05, 0.3));

		BarnLightning(GetRandom(0.1, .0625), GetRandom(0.3, .35), GetRandom(.2, .3), GetRandom(.5, .7));	

		sys.wait(3);		
	
		i = 0;
		while(i < times - 1)
		{			
			sys.wait(GetRandom(0.05, 0.15));
			BarnLightning(GetRandom(0.01, .0625), GetRandom(0.01, .0625), GetRandom(0.01, .125), GetRandom(.1, 1));
			 
			i++;
		}

		sys.wait(7);		
	
		i = 0;
		while(i < times - 1)
		{			
			sys.wait(GetRandom(0.05, 0.15));
			BarnLightning(GetRandom(0.01, .0625), GetRandom(0.01, .0625), GetRandom(0.01, .125), GetRandom(.1, 1));
			 
			i++;
		}
		j++;
		}
	}

