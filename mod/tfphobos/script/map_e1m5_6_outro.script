	// Source: https://easings.net/#easeInOutCubic
	// We use this because we don't get any of the accel/decel stuff
	// because we do the updates manually
	float EaseInOutCubic(float x)
	{
		if(x < 0.5)
			return 4 * x * x * x;

		return 1 - sys.pow(-2 * x + 2, 3) * 0.5;
	}

	float hideSubTime = 0;

	void SubtitlesRunning()
	{
		while(hideSubTime > sys.getTime())
		{			
			sys.waitFrame();
		}
		sys.hideSubtitles();
	}

	void ShowSubtitles(string name, string titles, float duration)
	{
		PhobosShowSubtitle_e1m5_6(name, titles);
		hideSubTime = sys.getTime() + duration;
		sys.wait(duration);
		if(hideSubTime <= sys.getTime())
		{
			sys.hideSubtitles();
		}
		else
		{
			thread SubtitlesRunning();
		}
	}

	void showTextCam(string text, entity e)
	{
		e.setGuiParm("gui_parm1", text);
		e.setGuiParm("gui_parm2", 0);
		sys.trigger(e);

		sys.fadeTo('0 0 0', 0, 2);

		sys.wait(7);

		e.setGuiParm("gui_parm2", 1);
		sys.trigger(e);

		sys.fadeTo('0 0 0', 1, 1);

		sys.wait(1);
	}
	
	void showText(string text)
	{
		entity e = sys.getEntity("cameraGui1");
		showTextCam(text, e);
	}	
	

	float Beat(float delay)
	{
		sys.wait(delay);
		return delay;
	}

	void CharacterSays(entity characterEntity, string line)
	{
		sys.wait(characterEntity.startSoundShader(line, SND_CHANNEL_ANY));
	}	

	void Outro_CharacterSays(entity characterEntity, string line)
	{
		sys.wait(characterEntity.startSoundShader(line, SND_CHANNEL_ANY));
	}

	float motel_camera_updating = 1;
	void UpdateBensonBarnCamera(float fov_from, float fov_to)
	{
		motel_camera_updating = 1;
		
		float total_time = 24.0;
		float now = sys.getTime();
		float then = now + total_time;
				
		float fov_travel = fov_to - fov_from;

		float tsec = 1.0 / total_time;

		while(motel_camera_updating)
		{
			now = sys.getTime();

			if(now >= then)
			{
				$benson_barn_camera.setKey("fov", fov_to);	
				
				motel_camera_updating = 0;
				
				break;
			}

			float t = (total_time - (then - now)) * tsec;

			t = EaseInOutCubic(t);
			
			$benson_barn_camera.setKey("fov", fov_from + fov_travel * t);

			sys.waitFrame();
		}
	}

