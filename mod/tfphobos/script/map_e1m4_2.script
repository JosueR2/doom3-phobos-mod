	void select_wraithconfig()
	{
		float wraithselect;

		while (1)
		{
			wraithselect = sys.random(15);
		
				if (wraithselect <= 5){
					sys.trigger ($wraith_config1);
					//sys.println("wraith_config1 selected");
					sys.wait(1);
				} else if (wraithselect >= 11){
					sys.trigger ($wraith_config2);
					//sys.println("wraith_config2 selected");
					sys.wait(1);
				} 
				  else {
					sys.trigger ($wraith_config3);
					//sys.println("wraith_config3 selected");
					sys.wait(1);
				}
		}
	}
	
	void kill_wraith_selection()
	{
		sys.killthread ("map_e1m4_2::select_wraithconfig");
	}	
	
	void wraith_selection()
	{	
		thread select_wraithconfig();
	}
	
