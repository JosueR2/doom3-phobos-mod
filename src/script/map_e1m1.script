	float fceInvestigationReactionDone = 0;
	void FceInvestigationReaction()
	{
		if(fceInvestigationReactionDone == 0)
		{
			thread ShowNPCSubtitles("...", "Investigation? I guess that explains all the feds.", 3.5);
			CharacterSays(playerC, "sound/vo/player/general/InvestigationFeds.ogg");
			fceInvestigationReactionDone = 1;
		}
	}
	
	void main()
	{
		$ShowerKnob.rotateOnce('0 0 -45');

		SetupClock();
		thread AnimateClock();

		SetupBoxCage();
		StartIntro();

		thread FakeWindowGlitches();		

		InitCommon();
		InitScanner();		
	}
}