	void techlights_scroll1()
	{
		while (1)
		{
			$techlight_mover1.moveTo($techlight_dest1);
			$techlight_mover2.moveTo($techlight_dest2);
			sys.waitFor($techlight_mover1);
			$techlight_mover1.restorePosition();
			$techlight_mover2.restorePosition();
		}
	}

		void techlights_scroll2()
	{
		while (1)
		{
			$techlight_mover3.moveTo($techlight_dest3);
			$techlight_mover4.moveTo($techlight_dest4);
			sys.waitFor($techlight_mover3);
			$techlight_mover3.restorePosition();
			$techlight_mover4.restorePosition();
		}
	}


	//===========================================
	// START SERVER PUZZLE
	//===========================================

	// gotoPos 0 -> down
	// gotoPos 1 -> up
	// gotoPos 2 -> toggle
	
	void ToggleServerBridge(entity bridge, float gotoPos)
	{
			string bridgenum = bridge.getKey("bridgenumber");
		
				entity bridgedest_up = sys.getEntity("server_puzzle_bridge_" + bridgenum + "_uppos");
				entity bridgedest_down = sys.getEntity("server_puzzle_bridge_" + bridgenum + "_downpos");
	
				float state = bridge.getFloatKey("bridge_state");
				if(gotoPos != 0 && state == 0)
				{
					bridge.moveTo(bridgedest_up);
					//sys.waitFor(bridge);
					bridge.setKey("bridge_state", 1);
				}
				else if(gotoPos != 1 && state == 1)
				{
					bridge.moveTo(bridgedest_down);					
					//sys.waitFor(bridge);
					bridge.setKey("bridge_state", 0);
				}
	}

	// gotoPos 0 -> down
	// gotoPos 1 -> up
	// gotoPos 2 -> toggle
	void ToggleServerPuzzleNode(float i, float gotoPos)
	{
		entity node = sys.getEntity("server_puzzle_node_" + i);
			
		if(!node)
			return;

		float bridgeMax = 6;
		float j = 0;
		while(j < bridgeMax)
		{
			j++;

			string bridgeName = node.getKey("bridge_" + j);
			if(bridgeName == "")
				break;
				
			entity bridge = sys.getEntity(bridgeName);
			if(bridge)
			{
				ToggleServerBridge(bridge, gotoPos);
			}
		}
	}

	void MaintainPoweredBridges()
	{
		float bridgeMax = 12;
		float i = 0;
		while(i < bridgeMax)
		{
			i++;
			entity bridge = sys.getEntity("server_puzzle_bridge_" + i);

			string node1Name = bridge.getKey("node_1");
			string node2Name = bridge.getKey("node_2");

			entity node1 = sys.getEntity(node1Name);
			entity node2 = sys.getEntity(node2Name);

			float power1 = node1.getFloatKey("powered_state");
			float power2 = node2.getFloatKey("powered_state");

			ToggleServerBridge(bridge, power1 || power2);
		}
	}
	
	void SetupServerPuzzle()
	{
		float i = 0;
		while(i < 4)
		{
			entity light = sys.getEntity("server_puzzle_end_house_light" + (i+1));
			vector ogcolor = light.getColor();
			light.setKey("ogcolor", ogcolor);
			light.setColor(0, 0, 0);
			i++;
			sys.trigger($target_entity_fadeout_1);
			
			$server_puzzle_end_bridge_door_frame_light1.setColor(0, 0, 0);
			$server_puzzle_end_bridge_door_frame_light2.setColor(0, 0, 0);
			
			$server_puzzle_healthgui.hide();
			$server_puzzle_healthgui_light.setColor(0, 0, 0);
		}

		vector bridgeAngle = '0 37 0';

		// Rotate the angled bridges
		$server_puzzle_bridge_3.rotateOnce(bridgeAngle);
		$server_puzzle_bridge_5.rotateOnce(bridgeAngle);
		$server_puzzle_bridge_8.rotateOnce(bridgeAngle);
		$server_puzzle_bridge_10.rotateOnce(bridgeAngle);
		$server_puzzle_bridge_2.rotateOnce(-bridgeAngle);
		$server_puzzle_bridge_4.rotateOnce(-bridgeAngle);
		$server_puzzle_bridge_9.rotateOnce(-bridgeAngle);
		$server_puzzle_bridge_11.rotateOnce(-bridgeAngle);		

		/// Lower the end server bridge
		$server_puzzle_end_bridge.move(DOWN, 256);
		sys.trigger($server_puzzle_end_bridge_aas);
		sys.trigger($server_puzzle_end_bridge_clip);
	}

	void NodePowerSoundsStart(entity sndstart, entity loop)
	{
		sys.trigger( sndstart );
		sys.wait( .968 );
		sys.trigger( loop );
	}

	void NodePowerSoundsStop(entity sndstop, entity loop)
	{
		sys.trigger( sndstop );
		sys.trigger( loop );
	}
	
		float ServerBridge1Raised = 0;
		float ServerBridge2Raised = 0;
		float ServerBridge3Raised = 0;
		float ServerBridge4Raised = 0;
		float ServerBridge5Raised = 0;
		float ServerBridge6Raised = 0;
		float ServerBridge7Raised = 0;
		float ServerBridgeMainRaised = 1;
	
	void CrossCheckServerBridges()
	{
		if(ServerBridge1Raised == 0 && ServerBridge2Raised == 1
		&& ServerBridge3Raised == 0 && ServerBridge4Raised == 0
		&& ServerBridge5Raised == 0 && ServerBridge6Raised == 0 		
		&& ServerBridge7Raised == 0 && ServerBridgeMainRaised == 0)
			{
				$trigger_once_115.enable();
				$trigger_once_113.disable();
				$trigger_once_114.disable();
				$trigger_once_59.disable();
				if(debug)
				sys.println("Trig Config 1");
			}
		else if(ServerBridge1Raised == 0 && ServerBridge2Raised == 0
		&& ServerBridge3Raised == 0 && ServerBridge4Raised == 0
		&& ServerBridge5Raised == 0 && ServerBridge6Raised == 0 		
		&& ServerBridge7Raised == 1 && ServerBridgeMainRaised == 0)
			{
				$trigger_once_115.enable();
				$trigger_once_113.disable();
				$trigger_once_114.disable();
				$trigger_once_59.disable();
				if(debug)
				sys.println("Trig Config 2");
			}
		else if(ServerBridge1Raised == 0 && ServerBridge2Raised == 0
		&& ServerBridge3Raised == 0 && ServerBridge4Raised == 0
		&& ServerBridge5Raised == 1 && ServerBridge6Raised == 0 		
		&& ServerBridge7Raised == 1 && ServerBridgeMainRaised == 0)
			{
				$trigger_once_115.enable();
				$trigger_once_113.disable();
				$trigger_once_114.disable();
				$trigger_once_59.disable();
				if(debug)
				sys.println("Trig Config 3");
			}
		else if(ServerBridge1Raised == 0 && ServerBridge2Raised == 1
		&& ServerBridge3Raised == 0 && ServerBridge4Raised == 0
		&& ServerBridge5Raised == 1 && ServerBridge6Raised == 0 		
		&& ServerBridge7Raised == 0 && ServerBridgeMainRaised == 0)
			{
				$trigger_once_115.enable();
				$trigger_once_113.disable();
				$trigger_once_114.disable();
				$trigger_once_59.disable();
				if(debug)
				sys.println("Trig Config 4");
			}
		else if(ServerBridge1Raised == 0 && ServerBridge2Raised == 0
		&& ServerBridge3Raised == 0 && ServerBridge4Raised == 0
		&& ServerBridge5Raised == 0 && ServerBridge6Raised == 0 		
		&& ServerBridge7Raised == 0 && ServerBridgeMainRaised == 0)
			{
				$trigger_once_115.enable();
				$trigger_once_113.enable();
				$trigger_once_114.enable();
				$trigger_once_59.enable();
				if(debug)
				sys.println("Trig Config 5");
			}
		else
			{
				$trigger_once_115.disable();
				$trigger_once_113.disable();
				$trigger_once_114.disable();
				$trigger_once_59.disable();
				if(debug)
				sys.println("Trig Config 6");
			}
	}
	
	void Flag_ServerBridge1()
	{
		if(ServerBridge1Raised == 0)
				{
					ServerBridge1Raised = 1;
					if(debug)
					sys.println("ServerBridge1Raised = 1");
				}
				else if(ServerBridge1Raised == 1)
				{
					ServerBridge1Raised = 0;
					if(debug)
					sys.println("ServerBridge1Raised = 0");
				}
				sys.wait(1);
			CrossCheckServerBridges();
	}
	
