	void arch_seek_player()
	{
		vector arch_target = $player1.getOrigin();
		$arch_blast_target_marker.setOrigin(arch_target);
		$arch_blast_targeter.moveTo($arch_blast_target_marker);
	}	
	
	void arch_seek_player2()
	{
		vector arch_target = $player1.getOrigin();
		$arch_blast_target_marker.setOrigin(arch_target);
		$arch_blast_targeter2.moveTo($arch_blast_target_marker);
	}	

	void summon_boneys(float num) {
		entity  archspawn;
		
			sys.wait(.416);
			archspawn = sys.getEntity( "archspawn_1_batch" + num );
			sys.trigger(archspawn);
			sys.wait(.075);
			archspawn = sys.getEntity( "archspawn_2_batch" + num );
			sys.trigger(archspawn);
			archspawn = sys.getEntity( "archspawn_3_batch" + num );
			sys.trigger(archspawn);
			sys.wait(.125);
			archspawn = sys.getEntity( "archspawn_4_batch" + num );
			sys.trigger(archspawn);
			sys.wait(.175);
			archspawn = sys.getEntity( "archspawn_5_batch" + num );
			sys.trigger(archspawn);
			sys.wait(.175);
			archspawn = sys.getEntity( "archspawn_6_batch" + num );
			sys.trigger(archspawn);
			archspawn = sys.getEntity( "archspawn_7_batch" + num );
			sys.trigger(archspawn);
			sys.wait(.2);
			archspawn = sys.getEntity( "archspawn_8_batch" + num );
			sys.trigger(archspawn);
			sys.wait(.2);
			archspawn = sys.getEntity( "archspawn_9_batch" + num );
			sys.trigger(archspawn);
			archspawn = sys.getEntity( "archspawn_10_batch" + num );
			sys.trigger(archspawn);
			sys.wait(.3);
			archspawn = sys.getEntity( "archspawn_11_batch" + num );
			sys.trigger(archspawn);
			archspawn = sys.getEntity( "archspawn_12_batch" + num );
			sys.trigger(archspawn);
	}
	
	
	void summon_imps(float num) {
		entity  impspawn;
		entity  impspawn_relay;
		
			sys.wait(.416);
			impspawn = sys.getEntity( "impspawn_1_batch" + num );
			sys.trigger(impspawn);
			impspawn = sys.getEntity( "impspawn_2_batch" + num );
			sys.trigger(impspawn);
			impspawn_relay = sys.getEntity( "impspawn_hard" + num );
			sys.trigger(impspawn_relay);
			impspawn_relay = sys.getEntity( "impspawn_easy" + num );
			sys.trigger(impspawn_relay);
	}
	
	void summon_pinkies(float num) {
		entity  pinkyspawn;
		
			sys.wait(.416);
			pinkyspawn = sys.getEntity( "pinkyspawn_1_batch" + num );
			sys.trigger(pinkyspawn);
			pinkyspawn = sys.getEntity( "pinkyspawn_2_batch" + num );
			sys.trigger(pinkyspawn);
	}
	

