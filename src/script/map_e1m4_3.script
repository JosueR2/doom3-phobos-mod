	}

	void BombCountdown()
	{
		sys.trigger($light_60902);
		sys.trigger($light_65287);

		sys.trigger($bomb_sparks);

		float soundFadeTime = 20;
		$light_60819.fadeSound(SND_CHANNEL_ANY, -100, soundFadeTime);
		$speaker_85.fadeSound(SND_CHANNEL_ANY, -100, soundFadeTime);
		$speaker_162.fadeSound(SND_CHANNEL_ANY, -100, soundFadeTime);
		$speaker_9.fadeSound(SND_CHANNEL_ANY, -100, soundFadeTime);
		$power_station_speaker_loop_1.fadeSound(SND_CHANNEL_ANY, -100, soundFadeTime);
		$speaker_155.fadeSound(SND_CHANNEL_ANY, -100, soundFadeTime);
		$speaker_152.fadeSound(SND_CHANNEL_ANY, -100, soundFadeTime);
		$speaker_150.fadeSound(SND_CHANNEL_ANY, -100, soundFadeTime);
		$speaker_144.fadeSound(SND_CHANNEL_ANY, -100, soundFadeTime);
		$speaker_102.fadeSound(SND_CHANNEL_ANY, -100, soundFadeTime);

		// Start the song and measure how long it takes
		thread LeeBombTalkSub();
		float completeTime = $player1.startSoundShader("e1m4_3_thebomb", SND_CHANNEL_ANY);

		// Start moving and rotating the camera
		$bomb_cam_mover.move(270, 16);
		$bomb_cam_rotator.rotateOnce(' 25 0 0');
		sys.trigger($bomb_cam_1);
		sys.trigger($info_player_teleport_2);	

		// Set up the bomb
		$bomb.setGuiParm ("gui_parm61", 1);
		$bomb.setKey("gui_noninteractive", 1);
		sys.trigger($bomb);
		
		// Start fading out the background
		thread FadeOutBombBack();

		// Max is how long the timer should be - in milliseconds
		float max = 2000;		

		float one = 0;
		float two = 0;
		float three = 0;
		float four = 0;
		float five = 0;

		// We subtract 6 seconds from the overall time because the last DING of the song happens at that time
		float timeFactor = ((completeTime - 6) / 2);

		// Store the start in lastFrame. We will wait one frame before starting so we know how long has passed.
		float lastFrame = sys.getTime();

		while( max >= 0 )
		{
			sys.waitFrame();
			float timeDiff = sys.getTime() - lastFrame;

			float seconds = (max / 1000);
			float milliseconds = max % 1000;			

			// DecaSeconds
			one = seconds / 10;
			one = int(one);

			// Seconds
			two = seconds % 10;
			two = int(two);
			
			// Tenths
			three = milliseconds / 100;
			three = int(three);
			
			// Hundredths
			four = (milliseconds % 100) / 10;
			four = int(four);

			// Milliseconds
			five = milliseconds % 10;
			five = int(five);

			SetBombTime( one, two, three, four, five);
			
			max -= (timeDiff * 1000) / timeFactor;

			lastFrame = sys.getTime();
		}

		sys.fadeTo('0 0 0', 1, 0.0625);

		sys.wait(6);
		
		thread MoveSearchlight();
		ValleyBoomScene();
	}
	
