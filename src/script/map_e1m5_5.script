	void OpenMuseumShutters(float shutterset)
	{
		entity shutter1 = sys.getEntity("museum_shutter_" + shutterset + "a");
		entity shutter2 = sys.getEntity("museum_shutter_" + shutterset + "b");
		entity shutter3 = sys.getEntity("museum_shutter_" + shutterset + "c");
		entity shutter4 = sys.getEntity("museum_shutter_" + shutterset + "d");
		entity speaker_close1 = sys.getEntity("museum_shutter_" + shutterset + "a_spkrclose");
		entity speaker_close2 = sys.getEntity("museum_shutter_" + shutterset + "b_spkrclose");
		entity speaker_close3 = sys.getEntity("museum_shutter_" + shutterset + "c_spkrclose");
		entity speaker_close4 = sys.getEntity("museum_shutter_" + shutterset + "d_spkrclose");
		entity speaker_clack1 = sys.getEntity("museum_shutter_" + shutterset + "a_spkrclack");
		entity speaker_clack2 = sys.getEntity("museum_shutter_" + shutterset + "b_spkrclack");
		entity speaker_clack3 = sys.getEntity("museum_shutter_" + shutterset + "c_spkrclack");
		entity speaker_clack4 = sys.getEntity("museum_shutter_" + shutterset + "d_spkrclack");
		
			shutter1.move(DOWN, 24);
			sys.trigger(speaker_close1);
			sys.wait(.75);
			sys.trigger(speaker_clack1);
			shutter1.move(DOWN, 24);
			shutter2.move(DOWN, 24);
			sys.trigger(speaker_close2);
			sys.wait(.75);
			sys.trigger(speaker_clack2);
			shutter1.move(DOWN, 24);
			shutter2.move(DOWN, 24);
			shutter3.move(DOWN, 24);
			sys.trigger(speaker_close3);
			sys.wait(.75);
			sys.trigger(speaker_clack3);
			shutter1.move(DOWN, 22);
			shutter2.move(DOWN, 22);
			shutter3.move(DOWN, 22);
			shutter4.move(DOWN, 22);
			sys.trigger(speaker_close4);
			sys.wait(.75);
			sys.trigger(speaker_clack4);
	}

	void OpenMuseumShutters1()
	{
		OpenMuseumShutters(1);
	}

	void OpenMuseumShutters2()
	{
		OpenMuseumShutters(2);
	}
	
	void OpenMuseumShutters3()
	{
		OpenMuseumShutters(3);
	}

	void Beat(float delay)
	{
		sys.wait(delay);
	}

	void CharacterSays(entity characterEntity, string line)
	{
		sys.wait(characterEntity.startSoundShader(line, SND_CHANNEL_ANY));
	}	

	float hideSubTime = 0;

	void SubtitlesRunning()
	{
		while(hideSubTime > sys.getTime())
		{			
			sys.waitFrame();
		}
		sys.hideSubtitles();
	}

	void ShowSubtitles(string name, string titles, float duration)
	{
		PhobosShowSubtitle_e1m5_5(name, titles);
		hideSubTime = sys.getTime() + duration;
		sys.wait(duration);
		if(hideSubTime <= sys.getTime())
		{
			sys.hideSubtitles();
		}
		else
		{
			thread SubtitlesRunning();
		}
	}

	void SubtitlesRunning2()
	{
		while(hideSubTime > sys.getTime() && !stop_talking_man)
		{			
			sys.waitFrame();
		}
		sys.hideSubtitles();
	}

	void ShowSubtitles2(string name, string titles, float duration)
	{
		if(stop_talking_man)
		{
			return;
		}

		PhobosShowSubtitle_e1m5_5(name, titles);
		hideSubTime = sys.getTime() + duration;
		SubtitlesRunning2();
	}

	void MuseumPart1Subs()
	{
		ShowSubtitles("Tour Guide", "Welcome to the official tour of the Federal Commonwealth of Earth,\non Mars and its surrounding moons.", 7.35 );
		ShowSubtitles("Tour Guide", "On this tour you will be faced with the overwhelming success of the federacy.", 5.25);
		ShowSubtitles("Tour Guide", "And our never ceasing quest for the progress of humanity.", 4.25);
		ShowSubtitles("Tour Guide", "You will learn about our endeavors around The Solar System and beyond.", 5.1);
		ShowSubtitles("Tour Guide", "The Paragon be praised and have a nice day.", 3);
	}

	void StartMuseumPart1()
	{
		sys.disableItemGroup("museum");
		thread MuseumPart1Subs();
		CharacterSays($player1, "sound/vo/e1m5_5/Museum/Intro.ogg");
		sys.enableItemGroups();
	}
	
	
	void LiftUp()
	{
		$mall_bigelevator_clip.show();
		$mall_bigelevator_clip.bind($crane_1);
	
		$crane_1.move(UP, 360);
				
		sys.waitFor($crane_1);
		
		$mall_bigelevator_clip.unbind();
		$mall_bigelevator_clip.hide();
		
	}
	
	
	void ToggleLift()
	{
		{
			sys.trigger($target_setinfluence_6);

			StartPhobosSkyBoxGlitching();

			StartMuseumPart1();
		}

			$Mall_Lift_Switch.setKey("click_item", "0");			

				
			$Mall_Lift_Switch_Handle.rotateOnce('0 0 -90');
			$Mall_Lift_Switch.startSoundShader("one_shot_electrical_switch_heavy_1", SND_CHANNEL_ANY);

			sys.wait(.75);

			sys.trigger($mall_lift_trigger);
		
	}		

	void Player1GondolaSub()
	{
		ShowSubtitles("Sam", "I was wondering...", 2);
		ShowSubtitles("Sam", "The thing is. I may have come across this Benson person in my, well, previous life.", 6.25);
		ShowSubtitles("Sam", "My memory is still fuzzy, but I seem to recall a James Benson.", 5.25);
		ShowSubtitles("Sam", "And he was bad news.", 3);
	}

	void Player5GondolaSub()
	{
		ShowSubtitles("Sam", "I'm pretty sure he did.\nHe had stolen something of ours. Something very valuable.", 5.25);
		ShowSubtitles("Sam", "When we stole it back, he did not take it well.\nAt all.", 4.25);
	}

	void Miles8GondolaSub()
	{
		ShowSubtitles("Miles", "Why are you doing this?\nIs this your attempt at some sort of revenge?", 5);
		ShowSubtitles("Miles", "Who the fuck are you?", 2.5);
	}

	void Miles10GondolaSub()
	{
		ShowSubtitles("Miles", "That's what I used to call her.", 3);
		ShowSubtitles("Miles", "Lee.", 2);
		ShowSubtitles("Miles", "She didn't like it when people called her Kay.", 3);
	}

	void Miles11GondolaSub()
	{
		ShowSubtitles("Miles", "It's more than that.", 2);
		ShowSubtitles("Miles", "Okay, let me guess.\nYou used to live next to her.", 3.75);
		ShowSubtitles("Miles", "You used to signal her after your parents had gone to bed.\nWith a lamp. 3 times.", 6.5);
	}

	void Miles12GondolaSub()
	{
		ShowSubtitles("Miles", "But then her brother enrolled in the federal academy.", 3);
		ShowSubtitles("Miles", "Her full name being Kaylee Calloway and her brother's name being Samuel,\n that makes him Samuel Calloway.", 5);
		ShowSubtitles("Miles", "The very man you're looking for.", 3);
	}

	void Miles13GondolaSub()
	{
		ShowSubtitles("Miles", "And of course, then some time later when her mother died during tragic circumstances.", 4.75);
		ShowSubtitles("Miles", "It set the two of you spiraling out into a crazy plan\nto escape your hometown and general area, the Emerald Valley...", 7);
		ShowSubtitles("Miles", "Which of course failed.", 2);
	}

	void Miles14GondolaSub()
	{
		ShowSubtitles("Miles", "But then you tried selling that item of yours.", 3.25);
		ShowSubtitles("Miles", "But it all failed spectacularly and ended up with\nJames Benson taking away the only person that ever got you.", 8);
	}

	void Miles15GondolaSub()
	{
		ShowSubtitles("Miles", "Because they are my memories, Sam.", 3);
		ShowSubtitles("Miles", "My memories!", 3);
	}

	void Miles16GondolaSub()
	{
		ShowSubtitles("Miles", "I don't know. Look, if this is some sort of sick joke,\nplease just let me be.", 7);
		ShowSubtitles("Miles", "Do your thing. I don't need this.", 4.5);
		ShowSubtitles("Miles", "I'm sorry I lied, okay!?\nIt's in the past now.", 5);
	}

	void StartMilesTalkGondolaPartTwo()
	{
		thread Player1GondolaSub();
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Player3.ogg");

		Beat(.6);

		thread ShowSubtitles("Miles", "Oh?", 2);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Miles3.ogg");

		Beat(.5);

		thread ShowSubtitles("Sam", "Yeah. I think he abducted someone I knew; The girl.", 4.5);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Player4.ogg");

		Beat(1.2);

		thread ShowSubtitles("Miles", "Wait a minute. He abducted her?", 3);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Miles4.ogg");

		Beat(.75);

		thread Player5GondolaSub();
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Player5.ogg");

		Beat(.6);

		thread ShowSubtitles("Miles", "Wait. What was her name?", 3);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Miles5.ogg");

		Beat(.7);

		thread ShowSubtitles("Sam", "Her name was Lee.", 2);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Player6.ogg");

		Beat(1.5);

		thread ShowSubtitles("Miles", "Lee, as in L - E - E?", 2.5);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Miles6.ogg");

		Beat(.65);

		thread ShowSubtitles("Sam", "L - E - E yeah.", 2);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Player7.ogg");

		Beat(.7);

		thread ShowSubtitles("Miles", "Come on. That's not funny.", 2.5);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Miles7.ogg");

		Beat(.35);

		thread ShowSubtitles("Sam", "W...What do you mean?", 2);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Player8.ogg");

		Beat(.75);

		thread Miles8GondolaSub();
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Miles8.ogg");

		Beat(1.5);

		thread ShowSubtitles("Sam", "I...I don't know!? I really don't.\nWhat are you getting at?", 5.5);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Player9.ogg");

		Beat(.5);

		thread ShowSubtitles("Miles", "Look. I know I lied to you and I'm sorry.\nI thought we were past that.", 5);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Miles9.ogg");

		Beat(.45);

		thread ShowSubtitles("Sam", "We are.", 2);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Player10.ogg");

		Beat(4.5);

		thread Miles10GondolaSub();
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Miles10.ogg");

		Beat(.8);

		thread ShowSubtitles("Sam", "Are you saying it's the same person?\nOr a wild coincidence?", 3.5);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Player11.ogg");

		Beat(.6);

		thread Miles11GondolaSub();
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Miles11.ogg");

		Beat(.25);

		thread ShowSubtitles("Sam", "Erm...", 2);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Player12.ogg");

		Beat(.2);

		thread Miles12GondolaSub();
		float dtime = CharacterSaysNoWait($player1, "sound/vo/e1m5_5/MilesTalkGondola/Miles12.ogg");

		Beat(dtime - .25);

		thread ShowSubtitles("Sam", "Wait...", 2);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Player13.ogg");

		Beat(.25);

		thread Miles13GondolaSub();
		dtime = CharacterSaysNoWait($player1, "sound/vo/e1m5_5/MilesTalkGondola/Miles13.ogg");

		Beat(dtime - 0.25);

		thread ShowSubtitles("Sam", "Look...", 2);
		thread CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Player14.ogg");

		Beat(.25);

		thread Miles14GondolaSub();
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Miles14.ogg");

		Beat(1.5);

		thread ShowSubtitles("Sam", "But...How do you know all this?", 2.5);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Player15.ogg");

		Beat(.3);

		thread Miles15GondolaSub();
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Miles15.ogg");

		Beat(.75);

		thread ShowSubtitles("Sam", "How is that even possible?", 2);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Player16.ogg");

		Beat(.5);

		thread Miles16GondolaSub();
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Miles16.ogg");

		Beat(.75);

		thread ShowSubtitles("Sam", "I'm not joking, Samantha.\nThis doesn't make sense to me either, but I remember what I remember.", 6);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Player17.ogg");

		Beat(1.5);

		thread ShowSubtitles("Miles", "Yeah...I don't know what to say.", 4);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Miles17.ogg");
	}

	void top_apartment_shutters_open()
	{
		sys.trigger($top_apartments_shutter_1_portal);
		sys.trigger($top_apartments_shutter_2_portal);
		
		$top_apartments_shutter_1.startSoundShader ( "mc1_scanner_3s_movement", SND_CHANNEL_VOICE );
		$top_apartments_shutter_1.move(UP, 56);
		$top_apartments_shutter_2.move(UP, 88);
	}

	void top_apartment_shutters_close()
	{
		$top_apartments_shutter_1.startSoundShader ( "mc1_scanner_3s_movement", SND_CHANNEL_VOICE );
		$top_apartments_shutter_1.move(DOWN, 56);
		$top_apartments_shutter_2.move(DOWN, 88);
		sys.waitFor($top_apartments_shutter_2);
		sys.trigger($top_apartments_shutter_1_portal);
		sys.trigger($top_apartments_shutter_2_portal);
	}

	void AtriumShaft_SoundscapeChange()
	{
		$speaker_128.fadeSound (SND_CHANNEL_ANY, -15, 1);
		$speaker_130.fadeSound (SND_CHANNEL_ANY, -15, 1);
		$speaker_142.fadeSound (SND_CHANNEL_ANY, 0, 1);
	}
	
	void gondola_sound(float fWait) 
	{
		$gondola_02.startSoundShader ( "p1_gondola_start_low", SND_CHANNEL_VOICE );
		sys.wait (fWait);
		$gondola_02.startSoundShader ( "p1_gondola_stop_low", SND_CHANNEL_VOICE );
	}

	void gondola_sound_fadein()
	{	
		$speaker_140.fadeSound (SND_CHANNEL_ANY, 0, 10);
		$speaker_143.fadeSound (SND_CHANNEL_ANY, 0, 10);
		$speaker_141.fadeSound (SND_CHANNEL_ANY, 0, 10);
		$speaker_149.fadeSound (SND_CHANNEL_ANY, 0, 10);
		$speaker_155.fadeSound (SND_CHANNEL_ANY, 0, 10);
