	void MilesElevatorTalk()
	{
		sys.trigger($func_radiochatter_1);
	
		thread MilesElevator1Subs();
		CharacterSays($player1, "sound/vo/e1m4_4/elevator/miles1.ogg");
		
		Beat(.75);
		
		thread PlayerElevator1Subs();
		CharacterSays($player1, "sound/vo/e1m4_4/elevator/player1.ogg");
		
		Beat(.75);
		
		thread MilesElevator2Subs();
		CharacterSays($player1, "sound/vo/e1m4_4/elevator/miles2.ogg");
		
		Beat(.75);

		thread PlayerElevator2Subs();
		CharacterSays($player1, "sound/vo/e1m4_4/elevator/player2.ogg");
		
		Beat(.75);
		
		thread PlayerElevator3Subs();
		CharacterSays($player1, "sound/vo/e1m4_4/elevator/player3.ogg");

		Beat(.5);

		sys.hideSubtitles();
	}	

	void WaitBombComment()
	{
		sys.wait(1.0);
		CharacterSays($player1, "sound/vo/player/general/shitinternal.ogg");
	}
	

	void BombIntro()
	{
		sys.wait(3);

		VoidLeeTalk();

		sys.wait(1);

		sys.trigger($SpeakerShitShitShit);

		sys.wait(14);

		thread CharacterSays($player1, "sound/shav/e1m4_4/bomb_countdown.ogg");		

		sys.wait(3.25);
		
		CharacterSays($player1, "e1_bomb_keypunches");
		sys.wait(.35);		
		thread CharacterSays($player1, "e1_bomb_placement");
		
		sys.wait(1.5);

		sys.fadeTo('0 0 0', 0, 0.1);

		sys.trigger($bomb);

		sys.wait(.5);
		
		// Max is how long the timer should be - in milliseconds
		float max = 2000;

		float one = 0;
		float two = 0;
		float three = 0;
		float four = 0;
		float five = 0;

		// Store the start in lastFrame. We will wait one frame before starting so we know how long has passed.
		float lastFrame = sys.getTime();		

		thread WaitBombComment();

		while( max >= 0 )
		{
			sys.waitFrame();
			float timeDiff = sys.getTime() - lastFrame;

			float seconds = (max / 1000);
			float milliseconds = max % 1000;						

			// DecaSeconds
			one = seconds / 10;
			one = int(one);

			// Seconds
			two = seconds % 10;
			two = int(two);
			
			// Tenths
			three = milliseconds / 100;
			three = int(three);
			
			// Hundredths
			four = (milliseconds % 100) / 10;
			four = int(four);

			// Milliseconds
			five = milliseconds % 10;
			five = int(five);

			SetBombTime( one, two, three, four, five);
			
			max -= (timeDiff * 1000);

			lastFrame = sys.getTime();
		}

		sys.fadeTo('1 1 1', 1, 0.1);
		sys.trigger($SpeakerCrickets);

		sys.wait(0.25);		

		sys.trigger($introCamera);		
		
		sys.fadeTo('1 1 1', 0, 0.1);
		
		sys.wait(2.5);
		
		entity textCam = sys.getEntity("cameraGui1");
		showTextCamDuration("Emerald Valley, Oregon\nFederal Commonwealth of Earth", textCam, 0, 4);
		sys.wait(1);

		showTextCamDuration("Samantha Miles", textCam, 0, 4);
		sys.wait(1);

		sys.trigger($SpeakerRemember);

		sys.wait(2);

		sys.fadeTo('1 1 1', 1, 0);

		sys.trigger($intro_target_setinfluence_1);

		sys.wait(1);

		sys.trigger($info_teleport_mroom);
		sys.trigger($introCamera);

		sys.fadeTo('1 1 1', 0, 1);		

		sys.wait(10);

		thread turnOffHouseLights();

		crossFadeEnt ($LeeLight, offColor, onColor, .0625);

		sys.wait(.25);

		crossFadeEnt ($LeeLight, onColor, offColor, .0625);

		sys.wait(.75);

		crossFadeEnt ($LeeLight, offColor, onColor, .0625);

		sys.wait(.25);

		crossFadeEnt ($LeeLight, onColor, offColor, .0625);

		sys.wait(.75);

		crossFadeEnt ($LeeLight, offColor, onColor, .0625);

		sys.wait(.25);

		crossFadeEnt ($LeeLight, onColor, offColor, .0625);

		sys.wait(.5);

		sys.trigger($LightClicker);
	}

