		entity oll2 = sys.getEntity(goobridgeName + "_ledlight3");
		entity oll3 = sys.getEntity(goobridgeName + "_ledlight0");

		goobridge_04_roundabout = 1;
		while(goobridge_04_roundabout == 1 )
		{
			float i = 0;			
			while(i < 4 && goobridge_04_roundabout ==1)
			{
				if(i == 0 )
				{
					FlashRoundAboutButton(ol0,oll0);				
				}
				else if(i == 1 )
				{
					FlashRoundAboutButton(ol1,oll1);				
				}
				else if(i == 2 )
				{
					FlashRoundAboutButton(ol2,oll2);
				}
				else
				{
					FlashRoundAboutButton(ol3,oll3);
				}
				i++;
			}
		}
	}

	void SetMapLight(entity light, float red, float green, float blue)
	{		
		light.setColor(red, green, blue);
	}

	entity GetMapLight(float num, float silo, float dir)
	{		
		return sys.getEntity("c" + num + "_s" + silo + "_d" + dir);
	}

	void ClearMapLight(entity light)
	{
		SetMapLight(light, 0, 0.05f, 0);
	}

	void FlashMapLight(entity light)
	{
		SetMapLight(light, 0, 1, 0);
	}

	void OldMapLight(entity light)
	{
		SetMapLight(light, 1, 1, 0);
	}

	float IsAnimating(float b)
	{
		float animating = 0;

		if(b == 1 && bridgemaps_animation1 == 1)
			animating = 1;
		else if(b == 2 && bridgemaps_animation2 == 1)
			animating = 1;
		else if(b == 3 && bridgemaps_animation3 == 1)
			animating = 1;
		else if(b == 4 && bridgemaps_animation4 == 1)
			animating = 1;
		
		return animating;
	}

	void AnimateMap(float num, float armState1, float armState2, float b)
	{
		entity bridge;
		entity arm1;
		entity arm2;
		entity arm3;

		float s = 0;
		while(s < 4)
		{
			entity bridgeLight = sys.getEntity("c" + num + "_s" + (s + 1));

			if(s + 1 == b)
				bridge = bridgeLight;

			entity tunnelLight = sys.getEntity("c" + num + "_s" + (s + 1) + "_" + ((s + 2 ) % 4));			

			float d = 0;
			while(d < 4)
			{	
				entity armLight = GetMapLight(num, s + 1, d);				

				if(s + 1 == b && d == armState1)									
					arm1 = armLight;

				if(s + 1 == b && d == armState2)
					arm2 = armLight;

				if(s + 1 == b && d == (armState2 + 1) % 4)
					arm3 = armLight;

					d++;
			}
			s++;
		}
	
		while(IsAnimating(b) == 1)
		{
			OldMapLight(bridge);
			OldMapLight(arm1);
			OldMapLight(arm2);

			sys.wait(.5);

			ClearMapLight(bridge);
			ClearMapLight(arm1);
			ClearMapLight(arm2);

			sys.wait(.25);

			FlashMapLight(bridge);
			FlashMapLight(arm2);
			FlashMapLight(arm3);

			sys.wait(.5);

			ClearMapLight(bridge);
			ClearMapLight(arm2);
			ClearMapLight(arm3);

			sys.wait(.25);
		}
	}

	void AnimateMaps(float armState1, float armState2, float b)
	{
		if(b == 1)
			bridgemaps_animation1 = 1;
		else if(b == 2)
			bridgemaps_animation2 = 1;
		else if(b == 3)
			bridgemaps_animation3 = 1;
		else if(b == 4)
			bridgemaps_animation4 = 1;

		float c = 0;
		while(c < 3)
		{
			thread AnimateMap(c + 1, armState1, armState2, b);
			c++;
		}
	}

	void UpdateMapPath(float silo, float armState1, float armState2)
	{
		float c = 0;
		while(c < 3)
		{
			FlashMapLight(sys.getEntity("c" + (c+1) + "_s" + (silo)));			

			FlashMapLight(GetMapLight(c+1,silo,armState1));
			FlashMapLight(GetMapLight(c+1,silo,armState2));

			ClearMapLight(GetMapLight(c+1,silo,(armState2 + 1) % 4));
			ClearMapLight(GetMapLight(c+1,silo,(armState2 + 2) % 4));

			c++;
		}
	}

	void UpdateMapCompletion()
	{
		float c = 0;
		while(c < 3)
		{
			entity s12 = sys.getEntity("c" + (c+1) + "_s1_2");
			entity s23 = sys.getEntity("c" + (c+1) + "_s2_3");
			entity s34 = sys.getEntity("c" + (c+1) + "_s3_4");
			entity s41 = sys.getEntity("c" + (c+1) + "_s4_1");

			if((goobridge_01_arm01 == 0 || goobridge_01_arm01 == 3) && (goobridge_04_arm01 == 1 || goobridge_04_arm01 == 2))
				FlashMapLight(s41);
			else
				ClearMapLight(s41);

			if((goobridge_02_arm01 == 3 || goobridge_02_arm01 == 0) && (goobridge_03_arm01 == 1 || goobridge_03_arm01 == 2))
				FlashMapLight(s23);
			else
				ClearMapLight(s23);

			if((goobridge_01_arm01 == 2 || goobridge_01_arm01 == 3) && (goobridge_02_arm01 == 0 || goobridge_02_arm01 == 1))
				FlashMapLight(s12);
			else
				ClearMapLight(s12);

			if((goobridge_03_arm01 == 0 || goobridge_03_arm01 == 1) && (goobridge_04_arm01 == 2 || goobridge_04_arm01 == 3))
				FlashMapLight(s34);
			else
				ClearMapLight(s34);

			c++;
		}
	}

