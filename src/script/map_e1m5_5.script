	}


	void StopMuseumSpeak(float stop_from)
	{
		stop_talking_man = 1;

		if(museum_8_on && stop_from != 8)
		{
			OnMuseumPart8End();
		}

		if(museum_9_on && stop_from != 9)
		{
			OnMuseumPart9End();
		}

		$museum_speak_2.stopSound(SND_CHANNEL_ANY,0);
		$museum_speak_3.stopSound(SND_CHANNEL_ANY,0);
		$museum_speak_4.stopSound(SND_CHANNEL_ANY,0);
		$museum_speak_5.stopSound(SND_CHANNEL_ANY,0);
		$museum_speak_6.stopSound(SND_CHANNEL_ANY,0);
		$museum_speak_7.stopSound(SND_CHANNEL_ANY,0);
		$museum_speak_8.stopSound(SND_CHANNEL_ANY,0);
		$museum_speak_9.stopSound(SND_CHANNEL_ANY,0);
		$museum_speak_10.stopSound(SND_CHANNEL_ANY,0);
		$museum_speak_11.stopSound(SND_CHANNEL_ANY,0);
	}


