	void TryShedDoor()
	{
		$shed_door.startSoundShader("sound/shav/e1m5_2/locked_door.ogg", SND_CHANNEL_ANY);

		$shed_door_handle.rotateOnce('-15 0 0');

		$shed_door_hinge.accelTime(0);
		$shed_door_hinge.decelTime(0);
		$shed_door_hinge.time(.0625);

		float angle = 0.5;
		$shed_door_hinge.rotateOnce('0 0.5 0' * angle);

		float i = 0;
		while( i < 2 )
		{
			sys.waitFor($shed_door_hinge);
			$shed_door_hinge.rotateOnce('0 -1 0' * angle);
			sys.waitFor($shed_door_hinge);
			$shed_door_hinge.rotateOnce('0 1 0' * angle);
			i++;
		}	
	
		sys.waitFor($shed_door_hinge);

		$shed_door_hinge.rotateOnce('0 -0.5 0' * angle);

		$shed_door_handle.rotateOnce('15 0 0');
		
		sys.wait(0.25);
		
		$shed_door_class_clicker.setKey("click_item", "1");

		$shed_door_hinge.accelTime(0.5);
		$shed_door_hinge.decelTime(0.5);
		$shed_door_hinge.time(3);
	}

	float pantryDoorState = 0;
	float triedPantryDoor = 0;

	float firstTimeOfficeDoor = 1;

	void TryOfficeDoor()
	{
		if(pantryDoorState==0)
		{
			$office_door.startSoundShader("sound/shav/e1m5_2/locked_door.ogg", SND_CHANNEL_ANY);
	
			$office_door_handle.rotateOnce('-30 0 0');
	
			float angle = 0.5;
			$office_door_hinge.rotateOnce('0 0.5 0' * angle);
	
			float i = 0;
			while( i < 2 )
			{
				sys.waitFor($office_door_hinge);
				$office_door_hinge.rotateOnce('0 -1 0' * angle);
				sys.waitFor($office_door_hinge);
				$office_door_hinge.rotateOnce('0 1 0' * angle);
				i++;
			}	
		
			sys.waitFor($office_door_hinge);
	
			$office_door_hinge.rotateOnce('0 -0.5 0' * angle);
	
			$office_door_handle.rotateOnce('30 0 0');
	
			sys.waitFor($office_door_handle);

			sys.wait(.5);
	
			if(firstTimeOfficeDoor)
			{
				firstTimeOfficeDoor = 0;
				$outro_garage_door_clicker_1.setKey("click_item", 1);
				$house_pantry_door_clicker.setKey("click_item", 1);

				sys.wait(1);
				sys.trigger($objective_locate_box);
			}
			
			$office_door_item.setKey("click_item", 1);
		}
		else
		{
			$office_door_item.hide();
			sys.wait($office_door.startSoundShader("sound/shav/e1m5_2/unlock.ogg", SND_CHANNEL_ANY) + 0.5);

			$office_door_hinge.accelTime(0.5);
			$office_door_hinge.decelTime(0.5);
			$office_door_hinge.time(3);

			sys.trigger($office_door_portal);

			$office_door_handle.startSoundShader("e1m1_doorknobopen", SND_CHANNEL_ANY);
			$office_door_handle.rotateOnce('-30 0 0');
			
			$office_door_hinge.rotateOnce('0 115 0');
			$office_door_handle.startSoundShader("e1m4_3_door_creak_2", SND_CHANNEL_ANY);
			
			sys.wait(.5);

			$office_door_handle.rotateOnce('30 0 0');
		}
	}
	
