	float arachElevatorSouthState = 1;
	float arachElevatorNorthState = 1;

	void ArachElevDoorRange(string elev, float dir, float from, float to)
	{
		while(from < to)
		{
			entity door = sys.getEntity("arach_elev_" + elev + "_door_" + from);

			door.move(dir, 48);			

			sys.wait(.25);

			from++;
		}
	}

	void ArachDoors(string elev, float dir)
	{
		thread ArachElevDoorRange(elev, dir, 1, 9);

		sys.wait(.5);

		thread ArachElevDoorRange(elev, dir, 9, 17);

		entity door = sys.getEntity("arach_elev_" + elev + "_door_16");
		sys.waitFor(door);
	}

	void ToggleArachElevatorNorth()
	{
		if(arachElevatorNorthState != 2)
		{
			$arach_elev_north_top_clicker.setKey ("click_item", "0");
			$arach_elev_north_bottom_clicker.setKey ("click_item", "0");

			if(arachElevatorNorthState == 0)
			{
				arachElevatorNorthState = 2;

				$arach_elev_north_handle.move(UP, 12);
				$arach_elev_north_handle.startSoundShader("e1m5_3_large_switch", SND_CHANNEL_ANY);				

				sys.waitFor($arach_elev_north_handle);

				$arach_elev_north_top_flare.show();
				$arach_elev_north_bottom_flare.hide();
				$arach_elev_north_top_light.show();
				$arach_elev_north_bottom_light.hide();

				sys.wait(.5);

				$arach_elev_north.move(UP, 5 * 64);

				$arach_elev_north.startSoundShader("c1_pipeupaway", SND_CHANNEL_ANY);

				sys.waitFor($arach_elev_north);

				ArachDoors("north", DOWN);

				arachElevatorNorthState = 1;
				
				$arach_elev_north_bottom_clicker.setKey ("click_item", "1");				
			}
			else if(arachElevatorNorthState == 1)
			{
				arachElevatorNorthState = 2;				

				$arach_elev_north_handle.move(DOWN, 12);
				$arach_elev_north_handle.startSoundShader("e1m5_3_large_switch", SND_CHANNEL_ANY);

				sys.waitFor($arach_elev_north_handle);

				$arach_elev_north_top_flare.hide();
				$arach_elev_north_bottom_flare.show();
				$arach_elev_north_top_light.hide();
				$arach_elev_north_bottom_light.show();

				sys.wait(.5);

				ArachDoors("north", UP);

				$arach_elev_north.move(DOWN, 5 * 64);

				$arach_elev_north.startSoundShader("c1_pipeupaway", SND_CHANNEL_ANY);				

				sys.waitFor($arach_elev_north);

				arachElevatorNorthState = 0;

				$arach_elev_north_top_clicker.setKey ("click_item", "1");
			}
		}
	}
	
