	void GoToLevel()
	{
		sys.fadeTo('0 0 0', 1, .01);
		sys.wait(.01);

		sys.trigger($cam_chapter_text);
		
		sys.wait(2);
		
		sys.trigger($speaker_chapter_text);

		sys.fadeTo('0 0 0', 0, 2);

		sys.wait(4);

		sys.fadeTo('0 0 0', 1, 2);

		sys.wait(3);

		//sys.trigger($setinfluence_motel);

		//sys.trigger($player_teleport_map);
		sys.trigger($speaker_chapter_text_wakeup);
		sys.trigger($cam_chapter_text);

		sys.trigger($trigger_relay_1);
		sys.trigger($trigger_relay_37);
		sys.trigger($trigger_fade_1);
	}

	void DoTrainHorn()
	{	
		$speaker_1128.startSoundShader("sound/shav/intro/thorn_02.ogg", SND_CHANNEL_ANY);
	}

	void GoToBed()
	{
		$mote_noticeboard_item.hide();

		sys.trigger($outro_motel_cloudrain);
		motel_light_thunder_color = '.5 .51 .67';

		//Go to bed camera
		thread UpdateBedCameraAngle();			

		thread Player3Subs();
		float act_time = CharacterSays_NoWait($player1, "sound/vo/e1m5/motelcloset/player3.ogg");
		CharacterSays_NoWait($player1, "sound/shav/e1m5/thunder02.ogg");

		sys.wait(.6);
		act_time -= .6;

		sys.trigger($motel_bed_camera);

		sys.wait(act_time);
		
		sys.wait(0.5);

		CharacterSays_NoWait($player1, "sound/shav/e1m5/thunder02.ogg");

		thread ShowSubtitles("Lee", "Are you sure?", 4);
		CharacterSays($motel_speakerlee, "sound/vo/e1m5/motelcloset/lee18.ogg");
		sys.wait(0.5);

		thread ShowSubtitles("Sam", "I am.", 2);
		CharacterSays($player1, "sound/vo/e1m5/motelcloset/player4.ogg");

		sys.wait(7);

		thread ShowSubtitles("Lee", "I was thinking. What do you think happens when we die?", 5);
		CharacterSays($motel_speakerlee, "sound/vo/e1m5/motelcloset/lee19.ogg");

		sys.wait(.5);

		sys.fadeTo('0 0 0', 1, .5);
		sys.wait(6);

		sys.trigger($target_endlevel_1);
		//GoToLevel();
	}

	void Lee14Subs()
	{
		ShowSubtitles("Lee", "While I didn't know that at the time, I felt it.", 4);
