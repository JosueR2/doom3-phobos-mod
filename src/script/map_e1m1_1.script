		ShowNPCSubtitles("Girl", "You didn't know what to say.\nAnd I didn't want to talk.", 4);
	}

	void EnableHospitalSkipTimer()
	{
		sys.wait(1.5);
		if (hospitalActive == 1 && hospitalSkipped == 0)
		{
			canSkipHospital = 1;
			PhobosShowSubtitle_e1m1_1("", "[ Press SPACE or X to skip ]");
			sys.wait(5.0);
			if (hospitalActive == 1 && hospitalSkipped == 0)
			{
				sys.hideSubtitles();
			}
		}
	}

	void SkipHospitalSequence()
	{
		if (canSkipHospital == 0 || hospitalActive == 0 || hospitalSkipped == 1)
		{
			return;
		}

		hospitalSkipped = 1;
		canSkipHospital = 0;
		hospitalActive = 0;

		// 1. Terminate all hospital memory & scanner threads
		sys.killthread("map_e1m1_1::StartHospitalScene");
		sys.killthread("map_e1m1_1::EnableHospitalSkipTimer");
		sys.killthread("map_e1m1_1::Lee1_2Sub");
		sys.killthread("map_e1m1_1::Lee1_3Sub");
		sys.killthread("map_e1m1_1::CallHospitalElevatorLobby");
		sys.killthread("map_e1m1_1::Lee15Sub");
		sys.killthread("map_e1m1_1::OpenHospitalDoorHallway2");
		sys.killthread("map_e1m1_1::Lee17Sub");
		sys.killthread("map_e1m1_1::OpenHospitalDoorHallway3");
		sys.killthread("map_e1m1_1::OpenHospitalDoor");
		sys.killthread("map_e1m1_1::Lee13Sub");
		sys.killthread("map_e1m1_1::Lee14Sub");
		sys.killthread("map_e1m1_1::HospitalSymptoms");
		sys.killthread("map_e1m1_1::HospitalLightsOut2");
		sys.killthread("map_e1m1_1::EndHospitalOutsideScene");
		sys.killthread("map_e1m1_1::EndHospitalScene");
		sys.killthread("map_e1m1_1::BurnCoffin");
		sys.killthread("map_e1m1_1::CoffinTalk");
		sys.killthread("map_e1m1_1::Lee24Sub");
		sys.killthread("map_e1m1_1::ScannerSceneEnd");
		sys.killthread("map_e1m1_1::UpdateCameraAngle");
		sys.killthread("map_e1m1_1::Doctor6Sub");
		sys.killthread("map_e1m1_1::Doctor7Sub");
		sys.killthread("map_e1m1_1::MoveOutOfScanner");
		sys.killthread("map_e1m1_1::RotateBed");
		sys.killthread("map_e1m1_1::ShowNPCSubtitles");

		// 2. Clear subtitles and stop memory/scanner sounds
		sys.hideSubtitles();
		$m1_hospital.stopSound(SND_CHANNEL_ANY, 0);
		$player1.stopSound(SND_CHANNEL_ANY, 0);
		$scanner_headlight.stopSound(SND_CHANNEL_BODY, 0);
		$outro_coffin_door.stopSound(SND_CHANNEL_ANY, 0);
		$hospital_incinerator_button.stopSound(SND_CHANNEL_ANY, 0);

		// 3. Reset cinematic camera if active
		if (activeHospitalCam == 1)
		{
			sys.trigger($hospitalCamera);
			activeHospitalCam = 0;
		}

		// 4. Ensure scanner rings are stopped
		StopScannerRings();

		// 5. Teleport player directly into the Mars medical wing
		sys.trigger($info_player_teleport_3);

		// 6. Restore normal gameplay visuals and movement
		sys.fadeTo('0 0 0', 0, 0.2);
		$scanner_playerbody.hide();
		sys.trigger($target_setinfluence_4);

		// 7. Update door status and triggers
		sys.trigger($target_setkeyval_8);
		sys.trigger($target_setshaderparm_4);
		$doctordoor.lock(0);

		// 8. Progress doctor NPC and world events
		sys.trigger($e1m1_doctor_walking_medwing_3);
		sys.trigger($relay_miles);
		$e1m1_doctor_walking_medwing_3.show();
		sys.trigger($trigger_once_11);
		sys.trigger($relay_objective_doctor_complete);

		scannerActive = 0;

		sys.print("Phobos Mod: Hospital memory sequence skipped to Mars!\n");
	}

	void StartHospitalScene()
	{		
		hospitalActive = 1;
		hospitalSkipped = 0;
		canSkipHospital = 0;
		activeHospitalCam = 0;
		thread EnableHospitalSkipTimer();

		sys.fadeTo('0 0 0', 1, 0);
		activeHospitalCam = 1;
		sys.trigger($hospitalCamera);
		
		sys.wait(2);
		$m1_hospital.startSoundShader("e1m1_hospital", SND_CHANNEL_ANY);				
		sys.wait(2);		

		thread ShowNPCSubtitles("Girl", "Do you remember the night at the hospital?", 3);
		CharacterSays($player1, "sound/vo/e1m1/Scanner/Lee1.ogg");
		sys.wait(1);
		
		sys.wait(2);
		sys.trigger($m1_hospital_lobby);
		sys.wait(1);
		
		activeHospitalCam = 0;
		sys.trigger($hospitalCamera);
		sys.fadeTo('0 0 0', 0, 1);
		sys.trigger($setinfluence_hospital);
		sys.wait(3);
		
		thread Lee1_2Sub();
		CharacterSays($player1, "sound/vo/e1m1/Scanner/Lee1_2.ogg");
		sys.wait(1);

		$CounterBell.setKey("item_disabled", "0");
	}
	
