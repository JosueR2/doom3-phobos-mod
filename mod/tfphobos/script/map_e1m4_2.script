	void SetupGear1()
	{
		float i = 0;
		while(i < 36)
		{
			entity e = sys.getEntity("gear_tooth_" + i);
			e.bind($gear_mover);
			$gear_mover.rotateOnce('0 0 10');
			sys.waitFor($gear_mover);
			//e.unbind();
			i++;
		}
	}

	void SetupGear4()
	{
		$gear4_arm.bind($gear4_mover);
		$gear4_base.bind($gear4_mover);
		$gear4_mover.rotateOnce('0 0 22.5');
		sys.waitFor($gear4_mover);

		$gear4_mover.bind($gear4_arm);
		$gear4_arm.bind($gear4_base);

		$gear4_arm.unbind();
		$gear4_base.unbind();

		float i = 0;
		while(i < 9)
		{
			entity e = sys.getEntity("gear4_tooth_" + i);
			e.bind($gear4_mover);
			$gear4_mover.rotateOnce('0 0 40');
			sys.waitFor($gear4_mover);
			//e.unbind();
			i++;
		}

		$gear4_mover.rotateOnce('0 0 20');
		sys.waitFor($gear4_mover);
	}

	void RotateGears(vector rot)
	{
		$gear_mover.rotateOnce(rot);
		$gear4_mover.rotateOnce(rot * 4);

		sys.waitFor($gear_mover);
	}

	float gearPos = 0;

	void UpdateGearsOnBridge()
	{
		float a = 0;
		float b = 0;
		float c = 0;
		float d = 0;

		if(gearPos == 0)
		{
			a = 1;
		}
		else if(gearPos == 1)
		{
			b = 1;
		}
		else if(gearPos == 3)
		{
			c = 1;
		}
		else
		{
			d = 1;
		}

		$corebridge_gui.setGuiParm("gui_parm31", a);
		$corebridge_gui.setGuiParm("gui_parm32", b);
		$corebridge_gui.setGuiParm("gui_parm33", c);
		$corebridge_gui.setGuiParm("gui_parm34", d);
		sys.trigger($corebridge_gui);
	}

	void UpdateGearsOnFuelDoors(float oldPos, float newPos)
	{
		if(oldPos == 2)
		{
			oldPos = 3;
		}
		else if(oldPos == 3)
		{
			oldPos = 2;
		}

		if(newPos == 2)
		{
			newPos = 3;
		}
		else if(newPos == 3)
		{
			newPos = 2;
		}

		entity toGreen = sys.getEntity("core_" + (oldPos + 1) + "_setcolor_green");
		entity toRed = sys.getEntity("core_" + (newPos + 1) + "_setcolor_red");
		entity oldToggle = sys.getEntity("core_" + (oldPos + 1) + "_light_toggle");
		entity newToggle = sys.getEntity("core_" + (newPos + 1) + "_light_toggle");
		
		entity oldGui1 = sys.getEntity("core_" + (oldPos + 1) + "_door_gui_1");
		entity oldGui2 = sys.getEntity("core_" + (oldPos + 1) + "_door_gui_2");

		entity newGui1 = sys.getEntity("core_" + (newPos + 1) + "_door_gui_1");
		entity newGui2 = sys.getEntity("core_" + (newPos + 1) + "_door_gui_2");

		sys.trigger(toGreen);
		sys.trigger(toRed);
		sys.trigger(oldToggle);
		sys.trigger(newToggle);

		oldGui1.setGuiParm("gui_parm2", 0);
		oldGui2.setGuiParm("gui_parm2", 0);
		sys.trigger(oldGui1);
		sys.trigger(oldGui2);

		newGui1.setGuiParm("gui_parm2", 1);
		newGui2.setGuiParm("gui_parm2", 1);
		sys.trigger(newGui1);
		sys.trigger(newGui2);
	}

	void RotateGearsCCW()
	{
		float oldPos = gearPos;

		$GearsGui.setGuiParm("gui_parm1", 1);
		sys.trigger($GearsGui);
		
		RotateGears('0 0 -90');
	
		gearPos--;
		if(gearPos < 0)
			gearPos = 3;		

		$GearsGui.setGuiParm("gui_parm1", 0);
		$GearsGui.setGuiParm("gui_parm2", gearPos);
		sys.trigger($GearsGui);

		UpdateGearsOnBridge();
		UpdateGearsOnFuelDoors(oldPos, gearPos);
	}

	void RotateGearsCW()
	{
		float oldPos = gearPos;

		$GearsGui.setGuiParm("gui_parm1", 1);
		sys.trigger($GearsGui);

		RotateGears('0 0 90');

		gearPos++;
		if(gearPos > 3)
			gearPos = 0;

		$GearsGui.setGuiParm("gui_parm1", 0);
		$GearsGui.setGuiParm("gui_parm2", gearPos);
		sys.trigger($GearsGui);

		UpdateGearsOnBridge();
		UpdateGearsOnFuelDoors(oldPos, gearPos);
	}

	void DisengageWheel()
	{
		RotateGears('0 0 -45');
	}	

	void EngageWheel()
	{
		$gears_handle_mover.move(REL_RIGHT, 8);
		$gears_handle_mover.startSoundShader("one_shot_electrical_switch_heavy_1", SND_CHANNEL_ANY);
		sys.waitFor($gears_handle_mover);
		
		sys.trigger($ArchVile_Relay);

		RotateGears('0 0 45');

		$GearsGui.setGuiParm("gui_parm1", 0);
		$GearsGui.setGuiParm("gui_parm2", gearPos);
		sys.trigger($GearsGui);

		float i = 0;
		while(i < 3)
		{
			entity toGreen = sys.getEntity("core_" + (i + 1) + "_setcolor_green");			
			entity newToggle = sys.getEntity("core_" + (i + 1) + "_light_toggle");
		
			entity oldGui1 = sys.getEntity("core_" + (i + 1) + "_door_gui_1");
			entity oldGui2 = sys.getEntity("core_" + (i + 1) + "_door_gui_2");

			sys.trigger(toGreen);
			sys.trigger(newToggle);

			oldGui1.setGuiParm("gui_parm2", 0);
			oldGui2.setGuiParm("gui_parm2", 0);
			sys.trigger(oldGui1);
			sys.trigger(oldGui2);

			i++;
		}

		UpdateGearsOnBridge();
	}

	void SetupGears()
	{
		$gears_handle_mover.rotateOnce('0 0 -15');

		SetupGear1();
		SetupGear4();
		
		DisengageWheel();

		sys.wait(.5);

		$gear_mover.time(6);
		$gear_mover.accelTime(1);
		$gear_mover.decelTime(1);

		$gear_mover.rotateOnce('0 0 180');
		
		gearPos+=2;
		gearPos %= 4;				

		$gear4_mover.time(6);
		$gear4_mover.accelTime(1);
		$gear4_mover.decelTime(1);
	}

	void RunFilter(entity filter)
	{
		while(1)
		{
			filter.move(90, 112);
			sys.waitFor(filter);
			sys.wait(1.5);
			filter.move(270, 112);
			sys.wait(2.5);
		}
	}

	void RunFuelFilters()
	{
		thread RunFilter($fuel_filter_2);
		sys.wait(.5);
		thread RunFilter($fuel_filter_1);
		sys.wait(.125);
		thread RunFilter($fuel_filter_3);
	}
	
	void maintenance_ladder()
	{
		sys.trigger($ladder_aas);
		$service_ladder.move(-1, 192);
		sys.trigger($sp_service_ladder);
		sys.waitFor($service_ladder);
		sys.trigger($ladder_brush);
	}

	void CallCoreBridge()
	{
		$CoreBridgeCallerButton.move(90, 1);
		$CoreBridgeCallerButton.startSoundShader("e1m1_intercomclick1", SND_CHANNEL_ANY);
		sys.waitFor($CoreBridgeCallerButton);
		sys.wait(.125);
		$CoreBridgeCallerButton.startSoundShader("e1m1_intercomclick2", SND_CHANNEL_ANY);
		$CoreBridgeCallerButton.move(270, 1);

		MoveCoreBridge(5);
	}

	void TurnOffScreen(entity screen, entity flare)
	{
		screen.setColor(0, 0, 0);
		flare.setColor(0, 0, 0 );
		screen.setGuiParm ("gui_parm91", 1);
		screen.startSoundShader("guisounds_close", SND_CHANNEL_ANY);
		sys.trigger(screen);
	}
	
	void TurnOnScreen(entity screen, entity flare)
	{		
		screen.setColor(1, 1, 1);
		flare.setColor(0.05, 0.08, 0.14);
		screen.setGuiParm ("gui_parm91", 0);
		screen.startSoundShader("guisounds_open", SND_CHANNEL_ANY);
		sys.trigger(screen);
	}
	
	void hide_bridge_guis()
	{
		$func_static_89775.hide();
		$func_static_101509.hide();
		$GearsGui.hide();	
	}
	
