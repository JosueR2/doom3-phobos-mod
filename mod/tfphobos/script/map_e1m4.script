		ShowNPCSubtitles("Sam", "I know we've always talked about going out and seeing the world together.", 2.8);
		ShowNPCSubtitles("Sam", "But ever since you lost your mom\nyou've been really dead set on leaving the valley.", 5.3);
		ShowNPCSubtitles("Sam", "Leaving home. Why are we running?", 3);
	}	
	
