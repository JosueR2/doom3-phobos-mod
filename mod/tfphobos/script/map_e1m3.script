namespace map_e1m3
{
	float hangar_state = 0;
	float goInfluenceLoop = 1;

	float departureActive = 0;
	float canSkipDeparture = 0;
	float departureSkipped = 0;
	float activeDepartureCam = 0;

	void EnableDepartureSkipTimer()
	{
		sys.wait(1.5);
		if (departureActive == 1 && departureSkipped == 0)
		{
			canSkipDeparture = 1;
			PhobosSetCanSkip(1);
		}
	}

	void SkipDepartureSequence()
	{
		if (canSkipDeparture == 0 || departureActive == 0 || departureSkipped == 1)
		{
			return;
		}

		departureSkipped = 1;
		canSkipDeparture = 0;
		departureActive = 0;
		PhobosSetCanSkip(0);

		// Terminate departure & outro threads
		sys.killthread("map_e1m3::fce_departure");
		sys.killthread("map_e1m3::the_hangar_opening");
		sys.killthread("map_e1m3::EnableDepartureSkipTimer");
		sys.killthread("map_e1m3::FceChatterSub");

		// Hide any lingering subtitles
		sys.hideSubtitles();

		// Stop sounds
		$SpeakerDeparture.stopSound(SND_CHANNEL_ANY, 0);
		$player1.stopSound(SND_CHANNEL_ANY, 0);

		// Safely toggle active camera off
		if (activeDepartureCam == 1)
		{
			sys.trigger($hangar_scene_camera_above);
		}
		else if (activeDepartureCam == 2)
		{
			sys.trigger($hangar_scene_camera_side);
		}
		else if (activeDepartureCam == 3)
		{
			sys.trigger($hangar_scene_camera_below);
		}
		else if (activeDepartureCam == 4)
		{
			sys.trigger($PreOutroCam);
		}
		activeDepartureCam = 0;

		// Teleport player directly to outro room
		sys.trigger($info_player_teleport_outro);
		sys.wait(0.1);
		sys.trigger($setinfluence_outro);

		// Fade back to normal view
		sys.fadeTo('0 0 0', 0, 0.2);

		sys.print("Phobos Mod: FCE Departure cutscene skipped!\n");
	}

	void toggle_hangar_lights()
	{
		sys.trigger($hangar_alert);
		sys.trigger($hangar_light_01);
		sys.trigger($hangar_blink01);
		sys.trigger($hangar_light_02);
		sys.trigger($hangar_blink02);
		sys.trigger($hangar_light_03);
		sys.trigger($hangar_blink03);
		sys.trigger($hangar_light_04);
		sys.trigger($hangar_blink04);
	}

	void toggle_hangar()
	{
		toggle_hangar_lights();
	
		sys.wait(5);

		if( hangar_state == 0 )
		{
			sys.trigger($hangar_portal);
			$hangar_door01.move( 90, 384);
			sys.wait(.5);
			$hangar_door02.move( 270, 384);
			$hangar_bit.move(270, 192);
			
			sys.waitFor($hangar_door02);
						
			hangar_state = 1;
		}
		else
		{
			$hangar_door01.move( 270, 384);
			sys.wait(.5);
			$hangar_door02.move( 90, 384);
			$hangar_bit.move(90, 192);
			
			sys.waitFor($hangar_door02);
			sys.trigger($hangar_portal);
			
			hangar_state = 0;				
		}		
		toggle_hangar_lights();
	}

	void GasLeakStoppedSubs()
	{
		PhobosShowSubtitle_e1m3("PA", "Gas leak stopped. Fire extinguished.");
		sys.wait(3);
		sys.hideSubtitles();
	}

	void StopFire()
	{
		sys.quickSave("They Had Other Plans - Checkpoint 2");
		sys.wait(.25);
		
		$firehurt_rotator.rotateOnce('270 0 0');
		sys.trigger($speaker_950);
		sys.trigger($light_59042);
		sys.trigger($hurtflame);
		sys.trigger($firehurt_failsafe);
		sys.trigger($firehurt_emitter);
		sys.trigger($func_emitter_554);
		sys.trigger($trigger_hurt_3);
		sys.trigger($func_aas_obstacle_3);
		sys.trigger($light_64726);
		sys.trigger($speaker_1094);
		sys.trigger($speaker_1095);
		sys.trigger($light_64727);
		sys.trigger($func_emitter_555);
		sys.trigger($trigger_hurt_4);
		sys.trigger($func_aas_obstacle_4);		
		
		sys.wait(2);
		$firehurt_valve.startSoundShader("airlock_01", SND_CHANNEL_ANY);
		sys.wait(2);
		$firehurt_valve.startSoundShader("c1_pipedownbounce", SND_CHANNEL_ANY);

		sys.trigger($func_emitter_340);
		sys.trigger($func_emitter_341);
		sys.trigger($func_emitter_342);
		sys.trigger($func_emitter_343);
		sys.trigger($func_emitter_344);
		sys.trigger($func_emitter_345);
		sys.trigger($func_emitter_346);
		sys.trigger($func_emitter_354);

		sys.wait(.5	);
		sys.trigger($speaker_954);
		sys.trigger($speaker_955);
		sys.trigger($speaker_956);

		sys.waitFor($firehurt_rotator);
		$firehurt_valve.startSoundShader("co_m4_stop", SND_CHANNEL_ANY);
		sys.wait(1.25);

		thread GasLeakStoppedSubs();
		sys.trigger($speaker_972);

		$func_static_82841.remove();
		$func_static_83267.show();
		sys.trigger($trigger_relay_603);
	}
	
	void blast_zsec()
	{
		$monster_zsec_machinegun_11.kill();
	}
	
