	void SewerFinalPlayer1Sub()
	{
		ShowNPCSubtitles("Sam", "Lee. I've uhm. I've been meaning to ask you.\nAll this breaking out of the valley stuff?", 6);	
		ShowNPCSubtitles("Sam", "It's been really fun. It's been exhilarating even.\nBut...is...are we being serious here?", 9);		
		ShowNPCSubtitles("Sam", "I know we've been working on it for so long, but think of all the fun we've had.\nIn the valley. Do we really have it so bad? ", 12);		
		ShowNPCSubtitles("Sam", "I guess what I'm saying is...if this attempt fails, do we need to keep going?\nIt kinda feels like we're running...", 11);
	}
	
	void InspectAreaOne()
	{
		thread SewerFinalPlayer1Sub();
		CharacterSays($player1, "sewer_final_Player1");
