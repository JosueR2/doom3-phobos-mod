	// END RANDOM MONSTER SPAWNS
	//===========================================
	
	void main()
	{
		$m4lockdowndoor.open();
		
		sys.trigger($SpeakerAmbience_fadein_relay);
		sys.trigger($SpeakerEnterFuel);
		
		thread select_monsterconfig1();
		sys.wait(4);
		thread select_monsterconfig2();
		sys.wait(7);
		thread select_monsterconfig3();
		sys.wait(5);
		thread select_monsterconfig4();
		sys.wait(3.5);
		thread select_monsterconfig5();
		sys.wait(5);
		thread select_monsterconfig6();
		
		sys.trigger($fuellock_outer_clip1);
		sys.trigger($fuellock_outer_clip2);
		$fuellock_outer_r1.move(90, 56);
		$fuellock_outer_r2.move(90, 56);
		$fuellock_outer_l1.move(270, 56);
		$fuellock_outer_l2.move(270, 56);

		ChangeLevel2(128 * -4);
		ChangeLevel3(0);
		
		thread piston3();
		thread piston4();
		thread piston5();
		
		thread coolant_tubes_insert();
		thread plastube_load();
		
		thread crankshaft();
		sys.trigger($cannister_pistons_relay1);
		thread FMS_Activator();
		sys.trigger($trigger_relay_551);
		
		sys.wait(.3);
		sys.trigger($func_emitter_442);

		FMSToIdle();
		
		//main objective
		sys.trigger($target_primaryobjective_1);
		
		$FMS_OutZone_trigger.disable();
	}	
}