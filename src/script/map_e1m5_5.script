	void arch_fireball_splines()
	{
		sys.wait(.25);
		sys.trigger($little_skull_1);
		sys.trigger($little_skull_1_prt);
		sys.trigger($little_skull_1_light);
		sys.trigger($little_skull_1_speclight);
		sys.wait(.05);
		$little_skull_1.bind($arch_fireball_mover1);
		$little_skull_1_prt.bind($arch_fireball_mover1);
		$little_skull_1_light.bind($arch_fireball_mover1);
		$little_skull_1_speclight.bind($arch_fireball_mover1);
		sys.trigger($little_skull_2);
		sys.trigger($little_skull_2_prt);
		sys.trigger($little_skull_2_light);
		sys.trigger($little_skull_2_speclight);
		sys.wait(.05);
		$little_skull_2.bind($arch_fireball_mover2);
		$little_skull_2_prt.bind($arch_fireball_mover2);
		$little_skull_2_light.bind($arch_fireball_mover2);
		$little_skull_2_speclight.bind($arch_fireball_mover2);
		sys.trigger($arch_fireball1_spawnspkr);
		sys.trigger($movespkr_relay1);
		$arch_fireball_mover1.startSpline($archfireball_spline1);
		$arch_fireball_mover1.removeInitialSplineAngles();
		sys.wait(.05);
		sys.trigger($arch_fireball2_spawnspkr);
		sys.trigger($movespkr_relay2);
		$arch_fireball_mover2.startSpline($archfireball_spline2);
		//$arch_fireball_mover2.removeInitialSplineAngles();
		//$arch_fireball_mover2.disableSplineAngles();
		sys.wait(.15);
		sys.trigger($little_skull_3);
		sys.trigger($little_skull_3_prt);
		sys.trigger($little_skull_3_light);
		sys.trigger($little_skull_3_speclight);
		sys.wait(.05);
		$little_skull_3.bind($arch_fireball_mover3);
		$little_skull_3_prt.bind($arch_fireball_mover3);
		$little_skull_3_light.bind($arch_fireball_mover3);
		$little_skull_3_speclight.bind($arch_fireball_mover3);
		sys.wait(.05);
		sys.trigger($arch_fireball3_spawnspkr);
		sys.trigger($movespkr_relay3);
		$arch_fireball_mover3.startSpline($archfireball_spline3);
		$arch_fireball_mover3.removeInitialSplineAngles();
		sys.waitFor($arch_fireball_mover3);
		$arch_fireball_mover1.remove();
		$arch_fireball_mover2.remove();
		$arch_fireball_mover3.remove();
	}
	
	void kill_arch_dummies()
	{
		$arch_repel_trig1.remove();
		$arch_repel_trig2.remove();
		$arch_repel_trig3.remove();
		$arch_repel_trig4.remove();
		$arch_repel_trig5.remove();
		$arch_repel_trig6.remove();
		$archspawn_killswitch.setKey("on", 1);
		sys.trigger($inner_fireball1);
		sys.trigger($inner_fireball2);
		sys.trigger($inner_fireball3);
		sys.trigger($fireball_light1);
		sys.trigger($fireball_light2);
		sys.trigger($arch_baron_relay);
		$getarchpos_relay3.remove();
		$monster_demon_archvile_orig_1.kill();
		sys.wait(.15);
		$monster_demon_archvile_orig_2.kill();
		sys.wait(.25);
		$monster_demon_archvile_orig_3.kill();
		sys.wait(.35);
		$monster_demon_archvile_orig_4.kill();
		sys.wait(.45);
		$monster_demon_archvile_orig_5.kill();
		sys.wait(.55);
		$monster_demon_archvile_orig_6.kill();
		sys.wait(2);
		sys.trigger($func_static_107870);
	}
	
	void ghostskulls_axial_tilt()
	{
		while (1){
			
			sys.wait(3);
			$ghostskull_orbit_tilt1.rotateOnce('-24 0 0');
			$ghostskull_orbit_tilt2.rotateOnce('36 0 0');
			$ghostskull_orbit_tilt3.rotateOnce('-50 0 0');
			sys.wait(3);
			$ghostskull_orbit_tilt1.rotateOnce('24 0 0');
			$ghostskull_orbit_tilt2.rotateOnce('-36 0 0');
			$ghostskull_orbit_tilt3.rotateOnce('50 0 0');
		}
	}

	void stop_axial_tilt()
	{
		sys.killthread ("map_e1m5_5::ghostskulls_axial_tilt");
	}
	
