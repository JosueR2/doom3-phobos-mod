	float rack_server9 = 0;
	
	float rack_toggle = 1;
	
	float toggle_server(entity serverEntity, float state)
	{
		$server_control.setGuiParm ("gui_parm20", state);
		$server_control.setGuiParm ("gui_parm10", 1);
		if( state == 0 )
		{
			serverEntity.move(0, 32);
			sys.waitFor(serverEntity);			
			state = 1;
		}
		else
		{
			serverEntity.move(180, 32);
			sys.waitFor(serverEntity);
			state = 0;
		}
				
		 $server_control.setGuiParm ("gui_parm10", 0);
		
		if( rack_toggle == 1 )
			rack_toggle = 0;
		else
			rack_toggle = 1;
		
		$server_control.setGuiParm ("gui_parm11", rack_toggle);
		$server_control.setGuiParm ("gui_parm12", rack_toggle);
		$server_control.setGuiParm ("gui_parm13", rack_toggle);
		$server_control.setGuiParm ("gui_parm14", rack_toggle);
		$server_control.setGuiParm ("gui_parm15", rack_toggle);
		$server_control.setGuiParm ("gui_parm16", rack_toggle);
		$server_control.setGuiParm ("gui_parm17", rack_toggle);
		$server_control.setGuiParm ("gui_parm18", rack_toggle);
		$server_control.setGuiParm ("gui_parm19", rack_toggle);
		return state;
	}

	void toggle_server1()
	{
