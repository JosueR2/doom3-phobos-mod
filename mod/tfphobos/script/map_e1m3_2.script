	}

	void CheckAllLevels(float l1, float l2, float l3)
	{
		if(l1 == 4 && l2 == 4 && l3 == 0)
		{
			sys.wait(2);

			fms_disabled = 1;
			
			sys.wait(3);

			thread ShowNPCSubtitles("Sam", "That works!", 2);
			sys.trigger($speaker_1015);

			sys.wait(3.5);
			
			sys.quickSave("The Beginning of The End - Checkpoint 9");
			
			sys.wait(0.5);
			
			sys.trigger($item_objective_6);
		}
	}
	
	void StartFuelSounds()
	{
		$fms_mainscreen.startSoundShader("e1m3_2_beepx3", SND_CHANNEL_ANY);
		$fms_mainscreen.startSoundShader("bridge_up_speaker", SND_CHANNEL_ANY);
		sys.trigger($speakerDrain);
	}

	void EndFuelSounds()
	{
		sys.wait(1.5);
		sys.trigger($speakerDrain);
		$fms_mainscreen.startSoundShader("bridge_down_speaker", SND_CHANNEL_ANY);
		$fms_mainscreen.startSoundShader("e1m3_2_beepx3", SND_CHANNEL_ANY);
	}

	void ChangeFuelLevel1To2()
	{	
		StartFuelSounds();
		
		float fuel1level = $fms_mainscreen.getGuiParmFloat (1, "gui_parm4");
		float fuel2level = $fms_mainscreen.getGuiParmFloat (1, "gui_parm5");
		float fuel3level = $fms_mainscreen.getGuiParmFloat (1, "gui_parm6");
		float fuel1max = $fms_mainscreen.getGuiParmFloat (1, "gui_parm1");
		float fuel2max = $fms_mainscreen.getGuiParmFloat (1, "gui_parm2");

		float change = CalculateFuelChangeValue(fuel1level, fuel1max, fuel2level, fuel2max);

		$fms_mainscreen.setGuiParm("gui_parm7", fuel1level - change);
		$fms_mainscreen.setGuiParm("gui_parm8", fuel2level + change);			
		sys.trigger($fms_mainscreen);
		
		$fms_firstscreen.setGuiParm("gui_parm5", fuel1level - change);
		sys.trigger($fms_firstscreen);	
		
		$fms_thirdscreen.setGuiParm("gui_parm5", fuel2level + change);
		sys.trigger($fms_thirdscreen);

		float f1V = 0;
		float f2V = 0;

		if(fuel1level - change <= 4)
			f1V = 1;

		if(fuel2level + change <= 4)
			f2V = 1;

		$fms_fourthscreen.setGuiParm("gui_parm1", f1V);
		$fms_fourthscreen.setGuiParm("gui_parm2", f2V);
		sys.trigger($fms_fourthscreen);

		EndFuelSounds();
		
		ChangeLevel1(64 * -change);
		ChangeLevel2(128 * change);

		CheckLevel1(fuel1level - change, fuel2level + change, fuel3level);
		CheckLevel2(fuel2level + change);

		CheckAllLevels(fuel1level - change, fuel2level + change, fuel3level);			
	}
	
	void ChangeFuelLevel1To3()
	{	
		StartFuelSounds();
		
		float fuel1level = $fms_mainscreen.getGuiParmFloat (1, "gui_parm4");
		float fuel2level = $fms_mainscreen.getGuiParmFloat (1, "gui_parm5");
		float fuel3level = $fms_mainscreen.getGuiParmFloat (1, "gui_parm6");
		float fuel1max = $fms_mainscreen.getGuiParmFloat (1, "gui_parm1");
		float fuel3max = $fms_mainscreen.getGuiParmFloat (1, "gui_parm3");

		float change = CalculateFuelChangeValue(fuel1level, fuel1max, fuel3level, fuel3max);

		float newLevel1 = fuel1level - change;
		float newLevel3 = fuel3level + change;

		$fms_mainscreen.setGuiParm("gui_parm7", newLevel1);
		$fms_mainscreen.setGuiParm("gui_parm9", newLevel3);		
		sys.trigger($fms_mainscreen);
		
		$fms_firstscreen.setGuiParm("gui_parm5", newLevel1);
		sys.trigger($fms_firstscreen);	
		
		$fms_secondscreen.setGuiParm("gui_parm5", newLevel3);
		sys.trigger($fms_secondscreen);	
		
		$fms_firstscreen.setGuiParm("gui_parm5", fuel1level - change);
		sys.trigger($fms_firstscreen);
				
		float f1V = 0;
		float f3V = 0;

		if(fuel1level - change <= 4)
			f1V = 1;

		if(fuel3level + change == 0)
			f3V = 1;

		$fms_fourthscreen.setGuiParm("gui_parm1", f1V);
		$fms_fourthscreen.setGuiParm("gui_parm3", f3V);
		sys.trigger($fms_fourthscreen);

		EndFuelSounds();
		
		ChangeLevel1(64 * -change);
		ChangeLevel3(newLevel3);
		
		CheckLevel1(newLevel1, fuel2level, newLevel3);
		CheckLevel3(newLevel3);
				
		CheckAllLevels(fuel1level - change, fuel2level, fuel3level + change);			
	}

