	void CharacterSays(entity characterEntity, string line)
	{
		sys.wait(characterEntity.startSoundShader(line, SND_CHANNEL_ANY));
	}

	float CharacterSays2(entity characterEntity, string line)
	{
		return characterEntity.startSoundShader(line, SND_CHANNEL_ANY);
	}
	
	void CharacterSaysInterupt(entity characterEntity, string line, float interrupt)
    {
		sys.wait(characterEntity.startSoundShader(line, SND_CHANNEL_ANY) - interrupt);
    }

	void Beat(float delay)
	{
		sys.wait(delay);
	}

	float firstSpline = 0;

	void MoveTrainSpline(entity train, entity speaker, entity speaker2, entity brakes, float distance, float desiredSpeed, float moveType, entity spline, float gl)
	{		
		float adTime = 5.546f;

		if(gl == 1)
			adTime = 2;

		float acceleration = desiredSpeed / adTime;
		
		float accel = 0;
		float decel = 0;

		float totalAdTime = 0;
		float distanceTraveled = 0.0f;

		float adDis = 0.5f * acceleration * adTime * adTime;

		if( moveType == STARTUP || moveType == STARTANDSTOP )
		{
			train.accelTime(adTime);
			accel = 1;
			distanceTraveled += adDis;
			totalAdTime += adTime;
		}
		else
			train.accelTime(0);

		if( moveType == SLOWDOWN || moveType == STARTANDSTOP )		
		{
			train.decelTime(adTime);
			decel = 1;
			distanceTraveled += adDis;
			totalAdTime += adTime;
		}
		else
			train.decelTime(0);		

		float remainingDistance  = distance-distanceTraveled;
		float remainingTime = remainingDistance / desiredSpeed;
		float moveTime = totalAdTime + remainingTime;

		if(gl == 1)
		{
			moveTime = 16;
			remainingTime = 12;
		}		

		train.time(moveTime);
				if(gl == 1)
			train.disableSplineAngles();

		train.startSpline(spline);
		if(firstSpline == 0)
			train.removeInitialSplineAngles();
		
		firstSpline++;

		float spentTime = 0;

		if(accel == 1)
		{
			speaker.startSoundShader("sound/shav/general/pfft.ogg", SND_CHANNEL_BODY);
			speaker2.stopSound(SND_CHANNEL_BODY2, false);
			sys.wait(speaker.startSoundShader("sound/shav/e1m1/train_speedup.ogg", SND_CHANNEL_BODY2) - 0.2);
		}

		speaker2.startSoundShader("sound/shav/e1m1/train_travel.ogg", SND_CHANNEL_BODY2);
		
		if(remainingTime > 0.2)
		{			
			sys.wait(remainingTime + 0.2);
		}

		if(decel == 1 && gl == 0)
		{		
			speaker2.stopSound(SND_CHANNEL_BODY2, false);
			sys.trigger(brakes);
			sys.wait(speaker.startSoundShader("sound/shav/e1m1/train_slowdown.ogg", SND_CHANNEL_BODY2) - 0.2);
			speaker.startSoundShader("sound/shav/general/pfft.ogg", SND_CHANNEL_BODY);
			sys.wait(.1);
			speaker2.startSoundShader("sound/shav/e1m1/train_idle.ogg", SND_CHANNEL_BODY2);
		}		

		sys.waitFor(train);
	}

	void RotateTrain(entity anchor, vector rotation)
	{
		$Looptrain1.bind(anchor);
		anchor.rotateOnce(rotation);
		sys.waitFor(anchor);
		$Looptrain1.unbind();		
	}
	
	void DockTrain(float stationSide)
	{
		// Open Doors
		if( stationSide == STATIONLEFT || stationSide == STATIONBOTH)
		{
			$Looptrain1_OuterDoor1.open();
		}

		if( stationSide == STATIONRIGHT || stationSide == STATIONBOTH)
		{
			$Looptrain1_OuterDoor2.open();			
		}		
	}

	void DisembarkTrain(float stationSide)
	{
		// Close Doors
		if( stationSide == STATIONLEFT || stationSide == STATIONBOTH)
		{
			$Looptrain1_OuterDoor1.close();			
		}

		if( stationSide == STATIONRIGHT || stationSide == STATIONBOTH)
		{
			$Looptrain1_OuterDoor2.close();
		}

		sys.wait(3);
	}

	void StartRail()
	{
		$train_button.move(90, 1);
		$train_button.startSoundShader("sound/shav/e1m1/intercomclick1.ogg", SND_CHANNEL_ANY);
		sys.waitFor($train_button);
		sys.wait(.125);
		$train_button.startSoundShader("sound/shav/e1m1/intercomclick2.ogg", SND_CHANNEL_ANY);
		$train_button.move(270, 1);
		
		DisembarkTrain(STATIONRIGHT);
		
		sys.wait(0.1);

		thread ShowNPCSubtitles("AP", "Train leaving station.", 2.1);
		sys.wait(CharacterSays2($train_speaker_announcer, "sound/vo/e1m1/IntercomTrainLeavingStation.ogg"));

		sys.wait(.25);
		entity train = sys.getEntity("Looptrain1");
		entity speaker = sys.getEntity("train_speaker");
		entity speaker2 = sys.getEntity("train_speaker2");
		entity brakes = sys.getEntity("train_brakes");
		
		firstSpline = 0;
		MoveTrainSpline(train, speaker, speaker2, brakes, 1504+509.117+400+1064+75.36+75.36+376.8, TRAIN_SPEED_SLOW, STARTANDSTOP,$spline_administration1,0);
		
		sys.wait(1);
		sys.trigger($gaylevatorv2_alert);
		sys.trigger($gaylevatorv2_light01);
		sys.trigger($gaylevatorv2_blink01);
		sys.trigger($gaylevatorv2_light02);
		sys.trigger($gaylevatorv2_blink02);

		sys.wait(3);
		
		thread MoveTrainSpline(train, speaker, speaker2, brakes, 384, TRAIN_SPEED_FAST, STARTANDSTOP, $spline_administration2,1);
		$gaylevatorv2.move(DOWN, 384);
		sys.waitFor($gaylevatorv2);

		sys.wait(1);
		
		sys.trigger($gaylevatorv2_alert);
		sys.trigger($gaylevatorv2_light01);
		sys.trigger($gaylevatorv2_blink01);
		sys.trigger($gaylevatorv2_light02);
		sys.trigger($gaylevatorv2_blink02);
		
		MoveTrainSpline(train, speaker, speaker2, brakes, 5176, TRAIN_SPEED_FAST, STARTANDSTOP, $spline_administration3,0);
		DockTrain(STATIONRIGHT);
	}

	void AnnounceTrainAdmin()
	{
		thread ShowNPCSubtitles("AP", "Arriving at Administration.", 3.25);
		sys.wait(CharacterSays2($train_speaker_announcer, "sound/vo/e1m1/IntercomTrainArrivingAt.ogg"));
		sys.wait(.25);
		sys.wait(CharacterSays2($train_speaker_announcer, "sound/vo/e1m1/IntercomTrainAdministration.ogg"));
		sys.wait(1);
		sys.quickSave("Stranger in a Strange Land - Checkpoint 3");
	}

