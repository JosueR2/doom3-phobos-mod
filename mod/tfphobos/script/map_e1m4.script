	void DrainToggle()
	{
		float fuelTank = $fuelcontrol.getGuiParmFloat (1, "gui_parm1");		
		
		if( fuelTank == 0 )
		{
			fuelTank = 1;
			
			if( hatch01state == 0 )
			{
				//$hatch01_door3.move(180, 28);
				//$hatch01_door4.move(0, 28);
				hatch01state = 1;
				
				sys.trigger($hatch01_setlight_green);				
				
				if( objective_drainsecondpipe_state == 1 )
				{
					objective_drainsecondpipe_state = 2;					
				}
			}
			
			if( hatch03state == 1 )
			{
				//$hatch03_door1.move(270, 28);
				//$hatch03_door3.move(270, 28);
				//$hatch03_door2.move(90, 28);
				//$hatch03_door4.move(90, 28);
				//sys.trigger($hatch03_portal);
				hatch03state = 0;
				
				sys.trigger($hatch03_setlight_red);				
			}						
		}
		else
		{
			fuelTank = 0;
			
			if( hatch01state == 1 )
			{
				//$hatch01_door3.move(0, 28);
				//$hatch01_door4.move(180, 28);
				//sys.trigger($hatch01_portal);
				hatch01state = 0;
				
				sys.trigger($hatch01_setlight_red);
				sys.trigger($starthatch_toRed);
			}
			
			if( hatch03state == 0 )
			{
				//sys.trigger($hatch03_portal);
				//$hatch03_door1.move(90, 28);
				//$hatch03_door3.move(90, 28);
				//$hatch03_door2.move(270, 28);
				//$hatch03_door4.move(270, 28);
				hatch03state = 1;
				
				sys.trigger($hatch03_setlight_green);
				sys.trigger($starthatch_toGreen);
				
				if( objective_drainstartpipe_state == 0 )
				{
					objective_drainstartpipe_state = 1;					
				}
			}
		}
		
		sys.trigger($relay_toggleDrain);
		$fuelcontrol.setGuiParm("gui_parm1", fuelTank);
		sys.trigger($fuelcontrol);
	}
	
