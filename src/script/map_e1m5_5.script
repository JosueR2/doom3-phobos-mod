	void LeaveBarn()
	{
		//sys.trigger($outside_motel_struggle_teleport);

		$road_cam_01_rotator.accelTime(0);
		$road_cam_01_rotator.decelTime(0);
		$road_cam_01_rotator.time(0.01);
		$road_cam_01_rotator.rotateOnce('0 0 -90');

		sys.fadeTo('0 0 0', 1, 0);

		sys.wait(4);

		$road_cam_01_mover.accelTime(0);
		$road_cam_01_mover.decelTime(1);
		$road_cam_01_mover.time(55);
		$road_cam_01_mover.move(90, 736 + 1024);

		sys.trigger($road_cam_01);

		sys.fadeTo('0 0 0', 0, 2);

		$player1.startSoundShader("sound/shav/e1m5_4/sirens.ogg", SND_CHANNEL_ANY);

		sys.wait(25);

		$sirens_mover.move(90, 1024 + 1024);
		thread crossFadeEnt ($light_sirens_01, '0 0 0', '0.5 0.5 0.5', 2);
		thread crossFadeEnt ($light_sirens_02, '0 0 0', '0.5 0.5 0.5', 2);

		sys.waitFor($sirens_mover);

		thread crossFadeEnt ($light_sirens_01, '0.5 0.5 0.5', '0 0 0', 0.01);
		thread crossFadeEnt ($light_sirens_02, '0.5 0.5 0.5', '0 0 0', 0.01);

		sys.wait(20);

		$road_cam_01_rotator.accelTime(2);
		$road_cam_01_rotator.decelTime(.25);
		$road_cam_01_rotator.time(5);
		$road_cam_01_rotator.rotateOnce('0 0 90');

		sys.waitFor($road_cam_01_mover);
		sys.waitFor($road_cam_01_rotator);

		$roadblocker.show();
		sys.trigger($outside_motel_struggle_teleport);
		sys.trigger($road_cam_01);
	}

