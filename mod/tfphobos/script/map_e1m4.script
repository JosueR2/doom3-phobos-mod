	void KeyTalk()
	{
		sys.trigger($SpeakerTension);
		sys.trigger($camera_key_talk);

		thread CharacterSays($player1, "e1m3_1_smallwind");

		CharacterSays($player1, "e1m1_trainfly");
		
		Beat(2.5);
				
		thread ShowNPCSubtitles("Sam", "Lee are you still there?", 2);
		CharacterSays($player1, "e1m3_1_intro_Player2");
	
		Beat(1.75);		
		
		thread ShowNPCSubtitles("Sam", "Tell me about the device. The box.", 2.15);
		CharacterSays($player1, "e1m3_1_intro_Player3");

		Beat(.5);
				
		thread ShowNPCSubtitles("Lee", "It's a key. Our only chance to get out.", 3.5);
		CharacterSays($player1, "e1m3_1_intro_Lee3");
		
		Beat(1.75);
		
		// Teleport away
		sys.trigger($camera_key_talk);
		TeleportToAreaOne();
	}

	float doorPortTime = 0;
	void DoorPort()
	{		
		if(doorPortTime == 0)
		{
			doorPortTime++;
			KeyTalk();
		}
		else
		{
			$seweruwu_door_1_clicker.hide();
			$seweruwu_door_1_box.show();
			$seweruwu_door_1_box.move(270, 4);
			$seweruwu_door_1_box.startSoundShader("shav_general_insert", SND_CHANNEL_ANY);
			sys.waitFor($seweruwu_door_1_box);
			sys.wait(.5);

			sys.wait($seweruwu_door_1_clicker.startSoundShader("shav_general_keycard", SND_CHANNEL_ANY));
			
			$seweruwu_door_1_clicker.startSoundShader("shav_general_accepted", SND_CHANNEL_ANY);

			sys.wait(1.75);
			$seweruwu_door_1_box.move(90, 4);
			$seweruwu_door_1_box.startSoundShader("shav_general_extract", SND_CHANNEL_ANY);
			sys.waitFor($seweruwu_door_1_box);
			sys.wait(.5);
			$seweruwu_door_1_box.hide();
			$player1.startSoundShader("e1m3_1_pickupbox", SND_CHANNEL_ANY);

			sys.wait(1);
			
			sys.trigger($seweruwu_door_1_lower);
		}
	}
	
