		$light_chain_light_20.show();
		$light_chain_light_21.show();
		$light_chain_light_22.show();
		$light_chain_light_23.show();
		
		$light_chain_light_entity_1.show();
		$light_chain_light_entity_2.show();
		$light_chain_light_entity_3.show();
		$light_chain_light_entity_4.show();
		$light_chain_light_entity_5.show();
		$light_chain_light_entity_6.show();
		$light_chain_light_entity_7.show();
		$light_chain_light_entity_8.show();
		
		//Turn on lights
		thread crossFadeEnt ($intro_blue_light_1, offColor, onColor, .0625);
		thread crossFadeEnt ($intro_blue_light_bulb_1, white, offColor, .0625);
		$intro_blue_light_flare_1.show();
		
		thread crossFadeEnt ($intro_blue_light_2, offColor, onColor, .0625);
		thread crossFadeEnt ($intro_blue_light_2_ambient, offColor, onColor, .0625);
		thread crossFadeEnt ($intro_blue_light_bulb_2, offColor, white, .0625);
		$intro_blue_light_flare_2.show();
		
		thread crossFadeEnt ($intro_blue_light_3, offColor, onColor, .0625);
		thread crossFadeEnt ($intro_blue_light_4, offColor, onColor, .0625);
		thread crossFadeEnt ($intro_blue_light_bulb_3, offColor, white, .0625);
		$intro_blue_light_flare_3.show();
		
		thread crossFadeEnt ($intro_blue_light_5, offColor, onColor, .0625);
		thread crossFadeEnt ($intro_blue_light_6, offColor, onColor, .0625);
		thread crossFadeEnt ($intro_blue_light_6_ambient, offColor, onColor, .0625);
		thread crossFadeEnt ($intro_blue_light_bulb_4, offColor, white, .0625);
		$intro_blue_light_flare_4.show();
		
		thread crossFadeEnt ($intro_blue_light_7, offColor, onColor, .0625);
		thread crossFadeEnt ($intro_blue_light_8, offColor, onColor, .0625);
		thread crossFadeEnt ($intro_blue_light_8_ambient, offColor, onColor, .0625);
		thread crossFadeEnt ($intro_blue_light_bulb_5, offColor, white, .0625);
		$intro_blue_light_flare_5.show();
	
		sys.wait(1.25);
	
		thread ShowNPCSubtitles("Sam", "Generator is back up!", 2);
		Intro_CharacterSays($player1, "e1m3_1_intro_Player21");
		
		crossTodo = 1;
		sys.trigger($todo_setkeyval_3);

		Beat(1.5);
		
		thread ShowNPCSubtitles("Lee", "Perfect. Did you put the thing back in its spot?", 3);
		Intro_CharacterSays($player1, "e1m3_1_intro_Lee19");
		Intro_CharacterSays($player1, "e1m3_1_walkie_beep");
		
		Beat(0.5);
		
		thread ShowNPCSubtitles("Sam", "I will. I will.", 2);
		Intro_CharacterSays($player1, "e1m3_1_intro_Player22");
		
		$item_intro_pickup_box.setKey("click_item", 1);		

		ShowIntroClickers();
	}

	float goFlick = 0;
	
	void TurnOnSwitch()
	{		
		$func_mover_intro_switch.rotateOnce('-90 0 0');
		$func_mover_intro_switch.startSoundShader("one_shot_electrical_switch_heavy_1", SND_CHANNEL_ANY);		
		
		if(goFlick == 0)
		{
			thread LightFlicker();			
		}

		sys.wait(.75);

		$func_mover_intro_switch.time(2);
		$func_mover_intro_switch.rotateOnce('90 0 0');

		sys.wait(3);

		$func_mover_intro_switch.time(.25);

		$item_light_switch_on.setKey("click_item", 1);
	}

	void ToggleLightSwitch()
	{
		if(lightSwitchState == 0 || lightSwitchState == 1)
		{
			lightSwitchState = -1;

			TurnOnSwitch();

			goFlick = 1;

			lightSwitchState = 1;
		}
		else if(lightSwitchState == 2)
		{
			lightSwitchState = -1;
			
			TurnOnSwitchTwo();

			lightSwitchState = 3;			
		}
	}
	
