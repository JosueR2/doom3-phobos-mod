	float music_suspense_state = 1;
	void Music_Suspense_01_Start()
	{
		$Speaker_Music_AfterHours.fadeSound(SND_CHANNEL_ANY, -100, 10);
		sys.wait($player1.startSoundShader("sound/shav/e1m5_2/turn_on_the_lights.ogg", SND_CHANNEL_ANY) - 2);
		sys.trigger($Speaker_Music_Suspense_01);
		$Speaker_Music_Suspense_01.fadeSound(SND_CHANNEL_ANY, -100, 0);
		sys.waitFrame();
		$Speaker_Music_Suspense_01.fadeSound(SND_CHANNEL_ANY, 100, 5);

		sys.wait(10);

		sys.trigger($Speaker_Music_AfterHours);
	}

	void Music_Suspense_Advance()
	{
		entity old_entity = sys.getEntity("Speaker_Music_Suspense_0" + music_suspense_state);
		music_suspense_state++;
		entity new_entity = sys.getEntity("Speaker_Music_Suspense_0" + music_suspense_state);

		sys.trigger(new_entity);
		new_entity.fadeSound(SND_CHANNEL_ANY, -100, 0);
		sys.waitFrame();
		old_entity.fadeSound(SND_CHANNEL_ANY, -100, 15);
		new_entity.fadeSound(SND_CHANNEL_ANY, 100, 5);
	}

	void TurnOnMainLights()
	{
		sys.disableItemGroup("living_room");

		thread Music_Suspense_01_Start();

		RestoreLightGroup(lg_main, lg_main_num);
		$player1.startSoundShader("sound/shav/e1m5_2/light_switch.ogg", SND_CHANNEL_ANY);

		sys.wait(1);
		
		$office_door_item.setKey("click_item", 1);
		$picture_frame_item.setKey("click_item", 1);
		$recipe_item.setKey("click_item", 1);
		$tv_reaction_clicker.setKey("click_item", 1);
		
		thread ShowSubtitles("Sam", "Fancy. The feds take care of their own...", 3);
		CharacterSays($player1, "sound/vo/e1m5_2/BensonHouse/FancyReaction.ogg");

		sys.enableItemGroups();

		vector pink = '1 0 1';
		vector cyan = '0 1 1';
		vector yellow = '1 1 0';

		while(1)
		{
			FadeMediaLights(pink, cyan);

			sys.wait(4);

			FadeMediaLights(cyan, yellow);

			sys.wait(4);

			FadeMediaLights(yellow, pink);

			sys.wait(4);
		}		
	}

