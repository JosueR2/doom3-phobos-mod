	void select_monsterconfig1()
	{
		float monsterselect1;

		while (1)
		{
			monsterselect1 = sys.random(15);
		
				if (monsterselect1 <= 5){
					sys.trigger ($monster_select_count1a);
					sys.wait(.5);
				} else if (monsterselect1 >= 11){
					sys.trigger ($monster_select_count1b);
					sys.wait(.5);
				} else {
					sys.trigger ($monster_select_count1c);
					sys.wait(.5);
				}
		}
	}
	
