	float milesConvoStarted = 0;
	float imTalkingToMiles = 0;
	float settingsVODone = 0;

	void PickupBomb()
	{
		bombTaken = 1;
	
		thread Outro_CharacterSays($player1, "e1m3_1_pickupbox");
	
		$bomb_template.hide();
		sys.wait(0.1);
				
		if(milesConvoStarted == 1)
		{
			imTalkingToMiles = 1;

			sys.wait(1.5);

			sys.trigger($func_radiochatter_2);
			thread ShowNPCSubtitles("Sam", "Samantha. I found a bomb! Maybe I can blow my way in?!", 3);
			Outro_CharacterSays($player1, "e1m4_3_MilesCall_Player13_b");
			Beat(.5);
			thread ShowNPCSubtitles("Miles", "Boom.", 2);
			Outro_CharacterSays($player1, "e1m4_3_MilesCall_Miles13");
			Beat(.5);
			thread ShowNPCSubtitles("Sam", "Boom.", 2);
			Outro_CharacterSays($player1, "e1m4_3_MilesCall_Player14");

			$place_bomb_item.setKey("click_item", 1);
			$broken_wall_item.setKey("click_item", 0);

			imTalkingToMiles = 0;
		}		
	}

	void ReviewSettings()
	{
		if(imTalkingToMiles == 0 && settingsVODone == 0)
		{
			settingsVODone = 1;
			thread ShowNPCSubtitles("Sam", "Review settings before use...gotcha.", 3);
			$player1.startSoundShader("e1m4_3_ReviewSettings", SND_CHANNEL_ANY);
		}
	}
	
