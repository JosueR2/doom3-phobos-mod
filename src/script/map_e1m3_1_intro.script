	void SetEqValues(entity gui, float value)
	{
		float iN = 6;
		float jN = 5;
		float i = 0;
		float j = 0;

		while(i < iN)
		{
			while(j < jN)
			{
				gui.setGuiParm("gui_parm" + (i+1) + (j+1), value);
				j++;
			}
			j = 0;
			i++;
		}
	}

	float Floor(float value, float max)
	{
		float i = max;

		while(i > 0)
		{
			if(value < i && value > i - 1)
				return i - 1;

				i--;
		}
		return value;
	}	

	void RandomEq(entity gui)
	{
		float iN = 6;
		float jN = 5;
		float i = 0;
		float j = 0;

		while(1)
		{
			while(i < iN)
			{
				float r = Floor(sys.random(eqPeak), eqPeak);				
				while(j < jN)
				{
					float val = 0;
					if((j-1) < r)
					{
						val = 1;
					}
					gui.setGuiParm("gui_parm" + (i+1) + (j+1), val);
					j++;
				}
				j = 0;
				i++;
			}
			i = 0;

			sys.wait(.125);
		}
	}

