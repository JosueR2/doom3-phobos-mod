	void extract_tubes() {
	while(1)
	{	
		$hookset1.moveTo($conveyor_hook_end);
		sys.wait(3);
		sys.trigger($hookset1_relay);
		$tube1.unbind();
		$tube1.bind($hookset1);
		sys.trigger($spkr_tubecatch);
		sys.wait(.5);
		$tube_extracter.moveTo($extracter_inside);
		sys.waitFor($tube_extracter);
		sys.trigger($tube_compartment);
		
		copier_light_start();
		sys.wait(1.5);
		$tube2.bind($tube_extracter);
		$tube_extracter.moveTo($extracter_outside);
		sys.trigger($tube_compartment);
		$tube2.show();
		$tube2_tipa.show();
		$tube2_tipb.show();
		sys.trigger($tlight2);
		$tube2b.show();
		$tube2_tipa2.show();
		$tube2_tipb2.show();
		sys.trigger($tlight2b);
		$hookset2.moveTo($conveyor_hook_end);
		sys.wait(3);
		sys.trigger($hookset2_relay);
		$tube2.unbind();
		$tube2.bind($hookset2);
		sys.trigger($spkr_tubecatch);
		sys.wait(.5);
		$tube_extracter.moveTo($extracter_inside);
		sys.waitFor($tube_extracter);
		sys.trigger($tube_compartment);
		
		copier_light_start();
		sys.wait(1.5);
		$tube3.bind($tube_extracter);
		$tube_extracter.moveTo($extracter_outside);
		sys.trigger($tube_compartment);
		$tube3.show();
		$tube3_tipa.show();
		$tube3_tipb.show();
		sys.trigger($tlight3);
		$tube3b.show();
		$tube3_tipa2.show();
		$tube3_tipb2.show();
		sys.trigger($tlight3b);
		sys.waitFor($tube_extracter);
		$hookset3.moveTo($conveyor_hook_end);
		sys.wait(3);
		sys.trigger($hookset3_relay);
		$tube3.unbind();
		$tube3.bind($hookset3);
		sys.trigger($spkr_tubecatch);
		sys.wait(.5);
		$tube_extracter.moveTo($extracter_inside);
		sys.waitFor($tube_extracter);
		sys.trigger($tube_compartment);
		
		copier_light_start();
		sys.wait(1.5);
		$tube1.bind($tube_extracter);
		$tube_extracter.moveTo($extracter_outside);
		sys.trigger($tube_compartment);
		$tube1.show();
		$tube1_tipa.show();
		$tube1_tipb.show();
		sys.trigger($tlight1);
		$tube1b.show();
		$tube1_tipa2.show();
		$tube1_tipb2.show();
		sys.trigger($tlight1b);
		sys.waitFor($tube_extracter);
		}
	}
	
