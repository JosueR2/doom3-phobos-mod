	void PickUpBox()
	{
		sys.disableItemGroup("vault_items");

		$player1.startSoundShader("e1m3_1_pickupbox", SND_CHANNEL_ANY);
		$the_box_key.hide();

		sys.wait(1);

		sys.trigger($objective_locate_box_pantry_complete);

		sys.wait(2);

		sys.showTextMessage("I found the box! Call me!", 1);

		sys.wait(2);

		LeeTexts("Amazing! <3 <3\nCall you in 2 sec.");

		entity music_entity = sys.getEntity("Speaker_Music_Suspense_0" + music_suspense_state);

		music_entity.fadeSound(SND_CHANNEL_ANY, -12, 10);

		sys.wait(5);

		sys.wait($player1.startSoundShader("sound/shav/e1m3/phonering.ogg", SND_CHANNEL_ANY));
		sys.wait(.25);
		$player1.startSoundShader("sound/shav/e1m3/phone_bleep1.ogg", SND_CHANNEL_ANY);
		
		sys.wait(.5);

		thread LeeEnding1Subs();
		CharacterSays($player1, "sound/vo/e1m5_2/BensonHouse/EndingTalk/Lee1.ogg");

		Beat(.5);

		thread Player1EndingSubs();
		CharacterSays($player1, "sound/vo/e1m5_2/BensonHouse/EndingTalk/Player1.ogg");

		Beat(.5);

		thread LeeEnding2Subs();
		CharacterSays($player1, "sound/vo/e1m5_2/BensonHouse/EndingTalk/Lee2.ogg");

		Beat(.5);

		thread PlayerEnding2Subs();
		CharacterSays($player1, "sound/vo/e1m5_2/BensonHouse/EndingTalk/Player2.ogg");

		Beat(.5);

		thread LeeEnding3Subs();
		CharacterSays($player1, "sound/vo/e1m5_2/BensonHouse/EndingTalk/Lee3.ogg");

		Beat(.5);

		thread ShowSubtitles("Sam", "Yeah...", 2);
		CharacterSays($player1, "sound/vo/e1m5_2/BensonHouse/EndingTalk/Player3.ogg");

		Beat(.5);

		thread LeeEnding4Subs();
		CharacterSays($player1, "sound/vo/e1m5_2/BensonHouse/EndingTalk/Lee4.ogg");

		Beat(.5);

		thread ShowSubtitles("Sam", "Are you sure you don't need any help?\nI can swing by the motel first.", 4);
		CharacterSays($player1, "sound/vo/e1m5_2/BensonHouse/EndingTalk/Player4.ogg");

		Beat(.5);

		thread LeeEnding5Subs();
		CharacterSays($player1, "sound/vo/e1m5_2/BensonHouse/EndingTalk/Lee5.ogg");

		Beat(.5);

		thread ShowSubtitles("Sam", "You too, Lee.", 2);
		CharacterSays($player1, "sound/vo/e1m5_2/BensonHouse/EndingTalk/Player5.ogg");

		Beat(.5);

		music_entity.fadeSound(SND_CHANNEL_ANY, -100, 10);

		sys.fadeTo('0 0 0', 1, .125);
		sys.wait(.5);
		sys.wait($player1.startSoundShader("sound/shav/e1m1/ominoushorn.ogg", SND_CHANNEL_ANY) + 1);

		sys.wait(3);

		sys.trigger($target_endlevel_1);
	}	

