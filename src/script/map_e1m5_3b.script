	void GirlRoomSignReaction()
	{			
		if(seenQuest == 1)
		{			
			seenQuest = 2;

			//Start treasure hunt			
			$item_treasure_lightchain.setKey("click_item", 1);

			sys.wait(1);
									
			sys.trigger($objective_find_contraband);

			$func_static_100080.setKey("click_item", 1);

		}

		if(hasGirlSignReaction == 0)
		{
			hasGirlSignReaction = 1;
			
			$girl_room_door_item.setKey("click_item", "1");						

			hasGirlSignReaction = 2;

			QuestSignReaction();
		}
	}
	
	void OpenPantryDoor()
	{	
		$house_pantry_door_clicker.setKey("click_item", 0);

		if(pantryDoorState == 0)
		{
			$pantry_door.startSoundShader("sound/shav/e1m5_2/locked_door.ogg", SND_CHANNEL_ANY);

			$pantry_door_handle.rotateOnce('0 0 15');

			float angle = 0.5;
			$pantry_door_hinge.rotateOnce('0 0.5 0' * angle);

			float i = 0;
			while( i < 2 )
			{
				sys.waitFor($pantry_door_hinge);
				$pantry_door_hinge.rotateOnce('0 -1 0' * angle);
				sys.waitFor($pantry_door_hinge);
				$pantry_door_hinge.rotateOnce('0 1 0' * angle);
				i++;
			}	
		
			sys.waitFor($pantry_door_hinge);

			$pantry_door_hinge.rotateOnce('0 -0.5 0' * angle);

			$pantry_door_handle.rotateOnce('0 0 -15');

			if(triedPantryDoor == 0)
			{
				$kichen_door_clicker.setKey("click_item", 1);

				triedPantryDoor = 1;
				
				sys.wait(0.5);
			}
		}
		
		if(pantryDoorState == 1)
		{
			sys.wait($pantry_door.startSoundShader("sound/shav/e1m5_2/unlock.ogg", SND_CHANNEL_ANY) + 0.5);

			$pantry_door_hinge.accelTime(0.5);
			$pantry_door_hinge.decelTime(0.5);
			$pantry_door_hinge.time(3);

			sys.trigger($pantry_door_portal);

			$pantry_door_handle.startSoundShader("e1m1_doorknobopen", SND_CHANNEL_ANY);
			$pantry_door_handle.rotateOnce('0 0 30');
			
			$pantry_door_hinge.rotateOnce('0 115 0');
			$pantry_door_handle.startSoundShader("e1m4_3_door_creak_2", SND_CHANNEL_ANY);
			
			sys.wait(.5);

			$pantry_door_handle.rotateOnce('0 0 -30');
		}
	}	

	void ClosePantryDoor()
	{	
		$pantry_clip.show();
		$pantry_door.setKey("solid", 0);

		$pantry_door_hinge.accelTime(0.5);
		$pantry_door_hinge.decelTime(0.5);
		$pantry_door_hinge.time(3);			
			
		$pantry_door_hinge.rotateOnce('0 -115 0');
		$pantry_door_handle.startSoundShader("e1m4_3_door_creak_2", SND_CHANNEL_ANY);
			
		sys.waitFor($pantry_door_hinge);

		sys.trigger($pantry_door_portal);
		
		$pantry_clip.hide();
		$pantry_door.setKey("solid", 1);
	}
	
