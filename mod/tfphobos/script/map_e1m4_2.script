	float corebridge_position = 0;

	float usingMatches = 1;
	float clockRunning = 0;
	float hideSubTime = 0;

	void SubtitlesRunning()
	{
		while(hideSubTime > sys.getTime())		
		{			
			sys.waitFrame();
		}
		sys.hideSubtitles();
	}

	void ShowNPCSubtitles(string name, string titles, float duration)
	{
		PhobosShowSubtitle_e1m4_2(name, titles);
		hideSubTime = sys.getTime() + duration;
		sys.wait(duration);
		if(hideSubTime <= sys.getTime())
		{
			sys.hideSubtitles();
		}
		else
		{
			thread SubtitlesRunning();
		}
	}

	void Beat(float delay)
	{
		sys.wait(delay);
	}	
	
	void MoveCoreBridge(float position)
	{
		$CoreBridgeCaller.setKey ("click_item", "0");

		$corebridge_gui.setGuiParm("gui_parm2", 1);
		sys.trigger($corebridge_gui);

		// If the bridge is moving or already in the right position, move along!
		if( corebridge_position == position || corebridge_position == 6)
			return;

		// 1: Find out which undeployment to use
		float undeployHeight = 16;
		if( corebridge_position == 0 )
			undeployHeight = 16;
		else if( corebridge_position == 5 )
			undeployHeight = 8;

		// 2: Calculate the route from the current position to the destination
		float gothroughmiddle = 1;
		if( (position == 0 && corebridge_position == 1) || (position == 1 && corebridge_position == 0))
			gothroughmiddle = 0;

		float goingfromdock = 0;
		if( corebridge_position == 0 )
		{		
			goingfromdock = 1;			
		}
		
		float goingtodock = 0;
		if( position == 0 )
			goingtodock = 1;

		float goingthroughdoor = 0;
		if( position == 0 || corebridge_position == 0)
		goingthroughdoor = 1;

		// 3: Find out which deployment to use
		float deployHeight = 16;
		if( position == 0)
			deployHeight = 16;
		else if( position == 5)
			deployHeight = 8;

		// 4: Undeploy
		//if(corebridge_position != 5)
		{
			$corebridge_mover.move(DOWN, undeployHeight);
		}
		//corebridge_position = 6;

		
		if( goingfromdock == 0 && corebridge_position != 5)
		{			
			$corebridge_extender_east.move(180, 80);
			$corebridge_extender_west.move(0, 80);				
			sys.waitFor($corebridge_extender_west);
		}
		// 5: If going through door, make sure to open it
		
		if( goingfromdock == 1 )
		{
			$corebridge_door_east.move(180, 32);
			$corebridge_door_west.move(0, 32);

			$corebridge_door_light1.show();
			$corebridge_door_light2.show();
			$corebridge_door_light2.startSoundShader("loop_alarm_08", SND_CHANNEL_BODY);
			
			sys.trigger($moving_bridge_clip);
			
			$fuelcore_door.open();
			sys.waitFor($fuelcore_door);
			
			$corebridge_mover.moveTo($corebridge_pos1);
			sys.waitFor($corebridge_mover);			
			
			sys.trigger($moving_bridge_clip);
			
			$fuelcore_door.close();
			$corebridge_door_light1.hide();
			$corebridge_door_light2.hide();
		}

		// 6: If going through the middle, do that
		if( gothroughmiddle == 1 )
		{
			$corebridge_mover.moveTo($corebridge_pos5);
			sys.waitFor($corebridge_mover);
		}

		if( goingtodock == 1 )
		{
			$corebridge_mover.moveTo($corebridge_pos1);
			sys.waitFor($corebridge_mover);

			$corebridge_door_east.move(0, 32);
			$corebridge_door_west.move(180, 32);
		}

		// 7: If gone through door, make sure to close it
		

		// 9: If going to the dock, go there
		if( goingtodock == 1 )
		{			
			$corebridge_door_light1.show();
			$corebridge_door_light2.show();
			$corebridge_door_light2.startSoundShader("loop_alarm_08", SND_CHANNEL_BODY);

			$fuelcore_door.open();
			sys.waitFor($fuelcore_door);			
		}

				// 8: Go to the end destination
		entity destination = sys.getEntity("corebridge_pos" + position);
		
		$corebridge_mover.moveTo(destination);
		sys.waitFor($corebridge_mover);

		if( goingtodock == 1 )
		{
			$fuelcore_door.close();
			$corebridge_door_light1.hide();
			$corebridge_door_light2.hide();
		}		
		// 10: Deploy		
		//if(position != 5)
		{
			$corebridge_mover.move(UP, deployHeight);
		}
		if( goingtodock == 0 && position != 5)
		{
			$corebridge_extender_east.move(0, 80);
			$corebridge_extender_west.move(180, 80);
		
			sys.waitFor($corebridge_extender_west);
		}
		corebridge_position = position;
		
		$corebridge_gui.setGuiParm("gui_parm1", position);
		
		sys.wait(3);
		
		$corebridge_gui.setGuiParm("gui_parm2", 2);
		sys.trigger($corebridge_gui);

		if(position != 5)
		{
			$CoreBridgeCaller.setKey ("click_item", "1");
		}
	}
		
