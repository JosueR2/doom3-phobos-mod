	void floorhatch_close()	
	{	
		$floor_panel.move(180, 60);
		sys.waitFor($floor_panel);
		$floor_panel.move(-1, 4);
		sys.waitFor($floor_panel);
		sys.trigger($func_portal_1);		
	}
		
