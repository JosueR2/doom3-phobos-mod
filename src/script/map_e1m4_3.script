	void SubtitlesRunning()
	{
		while(hideSubTime > sys.getTime())		
		{			
			sys.waitFrame();
		}
		sys.hideSubtitles();
	}

	void ShowNPCSubtitles(string name, string titles, float duration)
	{
		PhobosShowSubtitle_e1m4_3(name, titles);
		hideSubTime = sys.getTime() + duration;
		sys.wait(duration);
		if(hideSubTime <= sys.getTime())
		{
			sys.hideSubtitles();
		}
		else
		{
			thread SubtitlesRunning();
		}
	}
	
	void Outro_CharacterSays(entity characterEntity, string line)
	{
		sys.wait(characterEntity.startSoundShader(line, SND_CHANNEL_ANY));
	}
	
	void Beat(float delay)
	{
		sys.wait(delay);
	}	
	
	float bombTaken = 0;
		
	void SetBomb()
	{
		if( bombTaken == 1 )
		{
			$func_static_83268.hide();
			$bomb.show();
			bombTaken = 2;
		}
	}
	
	void TakeBomb()
	{
