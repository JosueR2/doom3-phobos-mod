	void FlashRoundAboutButton(entity ol, entity oll)
	{
		ol.setColor(1,1,0);
		oll.show();
		
		sys.wait(0.125);
		
		ol.setColor(0.5,0,0);
		oll.hide();
	}

	void StartRoundAbout1()
	{
		string goobridgeName = "goobridge_01";
		entity ol0 = sys.getEntity(goobridgeName +"_led1");
		entity ol1 = sys.getEntity(goobridgeName + "_led2");
		entity ol2 = sys.getEntity(goobridgeName + "_led3");
		entity ol3 = sys.getEntity(goobridgeName + "_led0");

		entity oll0 = sys.getEntity(goobridgeName + "_ledlight1");
		entity oll1 = sys.getEntity(goobridgeName + "_ledlight2");
		entity oll2 = sys.getEntity(goobridgeName + "_ledlight3");
		entity oll3 = sys.getEntity(goobridgeName + "_ledlight0");

		goobridge_01_roundabout = 1;
		while(goobridge_01_roundabout == 1 )
		{
			float i = 0;			
			while(i < 4 && goobridge_01_roundabout ==1)
			{
				if(i == 0 )
				{
					FlashRoundAboutButton(ol0,oll0);				
				}
				else if(i == 1 )
				{
					FlashRoundAboutButton(ol1,oll1);				
				}
				else if(i == 2 )
				{
					FlashRoundAboutButton(ol2,oll2);
				}
				else
				{
					FlashRoundAboutButton(ol3,oll3);
				}
				i++;
			}
		}
	}

