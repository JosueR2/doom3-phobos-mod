	void Miles2Sub()
	{
		PhobosShowSubtitle_e1m1_2("Miles", "We've got hostiles! We're encountering heavy resistance from an unknown source.\nOn Mars and on Phobos.");
		
		sys.wait(6);
		
		PhobosShowSubtitle_e1m1_2("Miles", "We currently don't have a precise origin of the attack.");
		
		sys.wait(3.5);
		
		PhobosShowSubtitle_e1m1_2("Miles", "But we suspect the controversy surrounding the Union Aerospace owned Delta labs to have played a major part.");
				
		sys.wait(5);
				
		PhobosShowSubtitle_e1m1_2("Miles", "As a high ranking officer, my situation has changed.\nBut yours doesn't have to.");		
		
		sys.wait(5.5);
		
		PhobosShowSubtitle_e1m1_2("Miles", "I have arranged for your transportation to the Bulwark.");
		
		sys.wait(2);
		
		PhobosShowSubtitle_e1m1_2("Miles", "A shuttle will be awaiting your arrival.\nThe pilot, Frank, is an old friend of mine.");
	}
	
	void Miles3Sub()
	{
		PhobosShowSubtitle_e1m1_2("Miles", "The Hostiles! They're unlike anything I've ever seen.\nI...I must admit I'm in shock of this whole situation.");
		
		sys.wait(8);
		
		PhobosShowSubtitle_e1m1_2("Miles", "We were suspicious of their efforts...and...commitment to...\nBut nothing like this.");
		
		sys.wait(5.5);
		
		PhobosShowSubtitle_e1m1_2("Miles", "I mean the scale. It's insane!");
	}
	
	void Miles4Sub()
	{
		PhobosShowSubtitle_e1m1_2("Miles", "I'm sorry. I can't answer all your questions right now.");
		
		sys.wait(3);
		
		PhobosShowSubtitle_e1m1_2("Miles", "All you need to know is. Shoot on sight.\nYou will know when you see them.");
		
		sys.wait(6);
		
		PhobosShowSubtitle_e1m1_2("Miles", "I'm currently transferring to our flagship, but please.\nPlease contact me later. When you can.");
		
		sys.wait(6.25);
		
		PhobosShowSubtitle_e1m1_2("Miles", "And Sam.");
	}

	void AnswerCall()
	{
		sys.trigger($radiocaller);

		entity radio = sys.getEntity("comm_snapin");
		entity playerC = sys.getEntity("player1");

		playerC.startSoundShader("sound/shav/e1m1/intercomclick2.ogg", SND_CHANNEL_ANY);

		$commscreen_online.hide();
		sys.wait(.1);
		$commscreen_radio.setGuiParm("gui_parm41", 1);
		sys.trigger($commscreen_radio);
		$commscreen_radio.show();

		sys.trigger($train_radio_blinker_tex);
		sys.trigger($train_radio_blinker_light);
		
		sys.wait(2);
		
		PhobosShowSubtitle_e1m1_2("Miles", "Sam!");
		CharacterSays(radio, "sound/vo/e1m1_2/MilesCall1/Miles1.ogg");		
		
		Beat(.25);
		
		PhobosShowSubtitle_e1m1_2("Sam", "Miles! What's going on?");
		CharacterSays(playerC, "sound/vo/e1m1_2/MilesCall1/Player1.ogg");
		
		Beat(.75);
		
		thread Miles2Sub();		
		sys.wait(CharacterSays2(radio, "sound/vo/e1m1_2/MilesCall1/Miles2.ogg") - .5f);
		
		PhobosShowSubtitle_e1m1_2("Sam", "Frank who? Wait. Hostiles?\nWhoa whoa you're going a mile a minute.");
		CharacterSays(playerC, "sound/vo/e1m1_2/MilesCall1/Player2.ogg");
		
		Beat(.5);
		
		thread Miles3Sub();		
		CharacterSays(radio, "sound/vo/e1m1_2/MilesCall1/Miles3.ogg");
		
		Beat(.25);
		
		sys.trigger($stranger_speaker);
		
		PhobosShowSubtitle_e1m1_2("Sam", "Wait. What are you talking about?\nWhat's going on?");
		CharacterSays(playerC, "sound/vo/e1m1_2/MilesCall1/Player3.ogg");
		
		Beat(.5);
		
		thread Miles4Sub();		
		CharacterSays(radio, "sound/vo/e1m1_2/MilesCall1/Miles4.ogg");
		
		Beat(.25);
		
		PhobosShowSubtitle_e1m1_2("Sam", "I...");
		CharacterSays(playerC, "sound/vo/e1m1_2/MilesCall1/Player4.ogg");
		
		Beat(.05);
		
		thread ShowNPCSubtitles("Miles", "Stay safe!", 2);
		CharacterSays(radio, "sound/vo/e1m1_2/MilesCall1/Miles5.ogg");
		
		Beat(.25);
		
		playerC.startSoundShader("sound/shav/e1m1/intercomclick2.ogg", SND_CHANNEL_ANY);
		
		Beat(.25);
		$commscreen_radio.hide();
		$commscreen_offline.show();
		sys.trigger($comm_snapin);
		Beat(1.25);

		thread ShowNPCSubtitles("Sam", "Great. That's just fantastic.\nSamantha how are you?", 4);
		CharacterSays(playerC, "sound/vo/e1m1_2/MilesCall1/Player5.ogg");
		
		sys.wait(3);

		CharacterSays2(playerC, "sound/shav/e1m1/powerfuck.ogg");		

		float lTime = .25;
		
		thread crossFadeEnt ($rail_intro_tunnel_light_1, '0 0 0', '0.043137 0.05098 0.062745', lTime);
		thread crossFadeEnt ($rail_intro_light_1, '0 0 0', '1 0.45 0', lTime);
		thread crossFadeEnt ($rail_intro_light_2, '0 0 0', '1 0.45 0', lTime);
		thread crossFadeEnt ($rail_intro_fixture_1, '0 0 0', '1 0.9608 0.2235', lTime);
		thread crossFadeEnt ($rail_intro_fixture_2, '0 0 0', '1 0.9608 0.2235', lTime);
		sys.trigger($rail_intro_fx_1);
		sys.trigger($rail_intro_fx_2);
		
		sys.wait(.125);
		
		thread crossFadeEnt ($rail_tunnel_over_train_tex, '0 0 0', '1 1 1', lTime);
		thread crossFadeEnt ($rail_tunnel_over_train_light, '0 0 0', '0.58 0.62 0.71', lTime);
		thread crossFadeEnt ($rail_intro_tunnel_light_2, '0 0 0', '0.043137 0.05098 0.062745', lTime);
		thread crossFadeEnt ($rail_intro_light_3, '0 0 0', '1 0.45 0', lTime);
		thread crossFadeEnt ($rail_intro_light_4, '0 0 0', '1 0.45 0', lTime);
		thread crossFadeEnt ($rail_intro_fixture_3, '0 0 0', '1 0.9608 0.2235', lTime);
		thread crossFadeEnt ($rail_intro_fixture_4, '0 0 0', '1 0.9608 0.2235', lTime);
		sys.trigger($rail_intro_fx_3);
		sys.trigger($rail_intro_fx_4);

		sys.wait(.75);

		thread crossFadeEnt ($rail_intro_tunnel_light_3, '0 0 0', '0.043137 0.05098 0.062745', lTime);
		thread crossFadeEnt ($rail_intro_light_5, '0 0 0', '1 0.45 0', lTime);
		thread crossFadeEnt ($rail_intro_light_6, '0 0 0', '1 0.45 0', lTime);
		thread crossFadeEnt ($rail_intro_fixture_5, '0 0 0', '1 0.9608 0.2235', lTime);
		thread crossFadeEnt ($rail_intro_fixture_6, '0 0 0', '1 0.9608 0.2235', lTime);
		sys.trigger($rail_intro_fx_5);
		sys.trigger($rail_intro_fx_6);

		sys.wait(.75);

		thread crossFadeEnt ($rail_intro_tunnel_light_4, '0 0 0', '0.043137 0.05098 0.062745', lTime);
		thread crossFadeEnt ($rail_intro_light_7, '0 0 0', '1 0.45 0', lTime);
		thread crossFadeEnt ($rail_intro_light_8, '0 0 0', '1 0.45 0', lTime);
		thread crossFadeEnt ($rail_intro_fixture_7, '0 0 0', '1 0.9608 0.2235', lTime);
		thread crossFadeEnt ($rail_intro_fixture_8, '0 0 0', '1 0.9608 0.2235', lTime);
		sys.trigger($rail_intro_fx_7);
		sys.trigger($rail_intro_fx_8);

		sys.wait(1);
		
		thread crossFadeEnt ($rail_tunnel_door_tex_2, '0 0 0', '1 1 1', lTime);
		thread crossFadeEnt ($rail_tunnel_door_light_2, '0 0 0', '1 0.94 0.63', lTime);
		thread crossFadeEnt ($rail_tunnel_door_flare_2, '0 0 0', '0.466667 0.411765 0', lTime);
		
		sys.wait(1);

		thread crossFadeEnt ($rail_tunnel_door_tex_1, '0 0 0', '1 1 1', lTime);
		thread crossFadeEnt ($rail_tunnel_door_light_1, '0 0 0', '1 0.94 0.63', lTime);
		thread crossFadeEnt ($rail_tunnel_door_flare_1, '0 0 0', '0.466667 0.411765 0', lTime);

		sys.wait(2);
		sys.trigger($rail_fx);

		sys.wait(2);

		sys.trigger($speaker_1010);
		sys.trigger($st_train_speaker2);

		MoveTrainSpline(sys.getEntity("StartTrain"), sys.getEntity("st_train_speaker"), sys.getEntity("st_train_speaker2"), sys.getEntity("st_train_brakes"), 1696, 120, STARTANDSTOP, $spline_start,0);
		
		sys.quickSave("Stranger in a Strange Land - Checkpoint 1");
		sys.trigger($target_setinfluence_1);

		$StartTrainDoor.open();
	}

	void TrafficLightFuck()
	{
		float tState = 0;

		while(1)
		{
			float delay = sys.random(2) + .125;
			sys.wait(delay);

			if(tState == 0)
			{
				thread crossFadeEnt ($railtrack_signal_two_light_top, '.75 0 0', '0 0 0', .125);
				thread crossFadeEnt ($railtrack_signal_two_lamp_top, '1 1 1', '0 0 0', .125);
				thread crossFadeEnt ($railtrack_signal_two_flare_top, '.75 0 0', '0 0 0', .125);

				sys.wait(.125);

				thread crossFadeEnt ($railtrack_signal_two_light_bottom, '0 0 0', '0 .75 0', .125);
				thread crossFadeEnt ($railtrack_signal_two_lamp_bottom, '0 0 0', '1 1 1', .125);
				thread crossFadeEnt ($railtrack_signal_two_flare_bottom, '0 0 0', '0 .75 0', .125);

				sys.wait(.125);
			}
			else
			{
				thread crossFadeEnt ($railtrack_signal_two_light_bottom, '0 .75 0', '0 0 0', .125);
				thread crossFadeEnt ($railtrack_signal_two_lamp_bottom, '1 1 1', '0 0 0', .125);
				thread crossFadeEnt ($railtrack_signal_two_flare_bottom, '0 .75 0', '0 0 0', .125);

				sys.wait(.125);

				thread crossFadeEnt ($railtrack_signal_two_light_top, '0 0 0', '.75 0 0', .125);
				thread crossFadeEnt ($railtrack_signal_two_lamp_top, '0 0 0', '1 1 1', .125);
				thread crossFadeEnt ($railtrack_signal_two_flare_top, '0 0 0', '.75 0 0', .125);

				sys.wait(.125);
			}

			tState = (tState + 1) % 2;
		}
	}

	void track_switch()
	{
		sys.trigger($track_zap1);
		sys.trigger($track_switch_spkr);
		$track_pivot.rotateOnce ('180 0 0');
		sys.waitFor($track_pivot);
		
		thread crossFadeEnt ($railtrack_signal_four_light_top, '.75 0 0', '0 0 0', .125);
		thread crossFadeEnt ($railtrack_signal_four_lamp_top, '1 1 1', '0 0 0', .125);
		thread crossFadeEnt ($railtrack_signal_four_flare_top, '.75 0 0', '0 0 0', .125);
		thread crossFadeEnt ($railtrack_signal_four_light_bottom, '0 0 0', '0 .75 0', .125);
		thread crossFadeEnt ($railtrack_signal_four_lamp_bottom, '0 0 0', '1 1 1', .125);
		thread crossFadeEnt ($railtrack_signal_four_flare_bottom, '0 0 0', '0 .75 0', .125);
		thread crossFadeEnt ($railtrack_signal_three_light_top, '0 0 0', '.75 0 0', .125);
		thread crossFadeEnt ($railtrack_signal_three_lamp_top, '0 0 0', '1 1 1', .125);
		thread crossFadeEnt ($railtrack_signal_three_flare_top, '0 0 0', '.75 0 0', .125);
		thread crossFadeEnt ($railtrack_signal_three_light_bottom, '0 .75 0', '0 0 0', .125);
		thread crossFadeEnt ($railtrack_signal_three_lamp_bottom, '1 1 1', '0 0 0', .125);
		thread crossFadeEnt ($railtrack_signal_three_flare_bottom, '0 .75 0', '0 0 0', .125);
				
		sys.trigger($track_zap2);
	}
	
