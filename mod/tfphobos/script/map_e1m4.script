	void SewerOpenDeadEndDoor()
	{
		$sewer_scene_gratedoor_2.startSoundShader("e1m4_locked_gate", SND_CHANNEL_ANY);		

		$sewer_scene_gratedoor_2_mover.rotateOnce('0 1 0');
		sys.waitFor($sewer_scene_gratedoor_2_mover);
		$sewer_scene_gratedoor_2_mover.rotateOnce('0 -2 0');
		sys.waitFor($sewer_scene_gratedoor_2_mover);
		$sewer_scene_gratedoor_2_mover.rotateOnce('0 2 0');
		sys.waitFor($sewer_scene_gratedoor_2_mover);
		$sewer_scene_gratedoor_2_mover.rotateOnce('0 -2 0');
		sys.waitFor($sewer_scene_gratedoor_2_mover);
		$sewer_scene_gratedoor_2_mover.rotateOnce('0 2 0');
		sys.waitFor($sewer_scene_gratedoor_2_mover);
		$sewer_scene_gratedoor_2_mover.rotateOnce('0 -1 0');

		if(sewerDeadEndOnce == 0)
		{
			sewerDeadEndOnce = 1;
			thread ShowNPCSubtitles("Sam", "Can't go that way.", 2);
			sys.wait($player1.startSoundShader("sewer_Player4", SND_CHANNEL_ANY));
		}

		sys.wait(1);
		
		$SewerDeadEndDoorClicker.setKey("click_item", "1");
	}
	
