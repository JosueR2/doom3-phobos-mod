	void select_monster_configs()
		{
			thread select_monsterconfig1();
			sys.wait(3.5);
			thread select_monsterconfig2();
			sys.wait(2.5);
			thread select_monsterconfig3();
			sys.wait(5);
			thread select_monsterconfig4();
			sys.wait(7);
			thread select_monsterconfig5();
		}

	void main()
	{
		//StartupRealm();
		//return;

		{
		// BOMB SCENE
		{
			sys.fadeTo('0 0 0', 1, 0);
			sys.trigger($bomb_cam);
			BombIntro();
		}

		// SET UP BOMB AREA
		{
			$void_toggle_portal_rotator.rotateOnce('35 0 0');
			$bomb2.hide();
			
			BombAreaSoundFadeOut();
		}


		// SET UP MOTEL
		{
			$motel_phone_mover.rotateOnce('0 38 0');
			$door_bathroom_mover.rotateOnce('0 -105 0');
			$func_static_100455.setKey("click_item", "0");
			$func_static_100081.setKey("click_item", "0");
			$func_static_100080.setKey("click_item", "0");
			$func_static_100082.setKey("click_item", "0");
