#include "script/map_e1m5_3b.script"

namespace map_e1m5_2
{	
	void GooTransPlatformLoop(entity platform, float setup)
	{
		while(1 == 1)
		{
			float numBarrels = sys.random(3);
			float spawnPlace = sys.random(4);			

			if( spawnPlace >= 4 )
				spawnPlace = 0;
			else if( spawnPlace >= 3)
				spawnPlace = 2;
			else if( spawnPlace >= 2)
				spawnPlace = 1;
			else
				spawnPlace = 0;			
				
			entity barrelOne;
			entity barrelTwo;
			entity spawner;

			entity startE = sys.getEntity("gootransplat" + setup + "_start");
			platform.setOrigin(startE.getOrigin());
			
			if( numBarrels >= 1 )
			{
				barrelOne = sys.spawn("moveable_barrel1");
				spawner = sys.getEntity("gootransplat" + setup + "_barrelspawn" + (spawnPlace + 1));
				barrelOne.setOrigin(spawner.getOrigin());				
			}
			
			if( numBarrels >= 2 )
			{
				barrelTwo = sys.spawn("moveable_barrel1");
				spawner = sys.getEntity("gootransplat" + setup + "_barrelspawn" + (spawnPlace + 2));
				barrelTwo.setOrigin(spawner.getOrigin());				
			}
				
			
			sys.wait(1);

			entity end = sys.getEntity("gootransplat" + setup + "_end");

			platform.moveTo(end);

			sys.waitFor(platform);

			if( numBarrels >= 1 )
			{
				barrelOne.remove();
			}
			
			if( numBarrels >= 2 )
			{
				barrelTwo.remove();
			}
		}
	}

	void StartGooTransPlat(float max, float del, float setup)
	{
		float i = 0;
		while(i < max)
		{
			thread GooTransPlatformLoop(sys.getEntity("gootransplat" + setup + "_0" + (i + 1)), setup);
			sys.wait(del);
			i++;
		}
	}

	void PlatTest()
	{
		sys.trigger($trigger_once_184);
		
		$CargoLinesHandle.rotateOnce('-90 0 0');
		$CargoLinesHandle.startSoundShader("e1m5_3_large_switch", SND_CHANNEL_ANY);

		sys.wait(1);
		
		sys.trigger($power_station_speaker_start_1);
		sys.wait(2.75);		
		sys.trigger($power_station_speaker_loop_1);

		thread StartGooTransPlat(6, 4, 1);
		thread StartGooTransPlat(4, 4, 2);
	}
	
	void piston_discs_down() 
	{
		$pistondisc_1.time (.4);
		$pistondisc_1.accelTime (.125);
		$pistondisc_1.decelTime (.15);
		$pistondisc_2.time (.4);
		$pistondisc_2.accelTime (.125);
		$pistondisc_2.decelTime (.15);
		$pistondisc_3.time (.4);
		$pistondisc_3.accelTime (.125);
		$pistondisc_3.decelTime (.15);
		$pistondisc_4.time (.4);
		$pistondisc_4.accelTime (.125);
		$pistondisc_4.decelTime (.15);
		$pistondisc_5.time (.4);
		$pistondisc_5.accelTime (.125);
		$pistondisc_5.decelTime (.15);
		
		while (1) {
			$pistondisc_1.moveTo($p1u);
			$pistondisc_2.moveTo($p2d);
			$pistondisc_3.moveTo($p3u);
			$pistondisc_4.moveTo($p4u);
			$pistondisc_5.moveTo($p5d);
			sys.waitFor($pistondisc_1);
			
			$pistondisc_1.moveTo($p1d);
			$pistondisc_2.moveTo($p2u);
			$pistondisc_3.moveTo($p3d);
			$pistondisc_4.moveTo($p4d);
			$pistondisc_5.moveTo($p5u);
			sys.waitFor($pistondisc_1);
		
		}
	}
	
	void storagecab_surprise()	
	{
			$cabinet_swing.accelTime (.4);
                $cabinet_swing.time (.5);
                $cabinet_swing.rotateOnce ('0 0 90');
                sys.waitFor ($cabinet_swing);
				sys.trigger($cabinet_slam);
				sys.trigger($cabinet_dust);
                
                $cabinet_swing.accelTime (.05);
                $cabinet_swing.time (.05);
                $cabinet_swing.rotateOnce ('0 0 -4');
                sys.waitFor ($cabinet_swing);
                $cabinet_swing.rotateOnce ('0 0 4');
                sys.waitFor ($cabinet_swing);

                $cabinet_swing.time (.05);
                $cabinet_swing.rotateOnce ('0 0 -2');
                sys.waitFor ($cabinet_swing);
                $cabinet_swing.rotateOnce ('0 0 2');
	}
	
