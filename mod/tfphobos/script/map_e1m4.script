	float boxtimes = 0;
	float boxGot = 0;
	void BurnCoffin()
	{		
		$hospital_incinerator_button.move(90, 1);
		$hospital_incinerator_button.startSoundShader("e1m1_intercomclick1", SND_CHANNEL_ANY);
		sys.waitFor($hospital_incinerator_button);
		sys.wait(.125);
		$hospital_incinerator_button.startSoundShader("e1m1_intercomclick2", SND_CHANNEL_ANY);
		$hospital_incinerator_button.move(-90, 1);

		if(boxtimes == 1)
		{
			$outro_coffin_table_cylinder_lower.move(UP, 8);
			$outro_coffin_table_cylinder_upper.move(UP, 16);

			sys.waitFor($outro_coffin_table_cylinder_upper);

			sys.wait(1);

			$outro_coffin_door.move(UP, 56);
			sys.waitFor($outro_coffin_door);
		
			$hospital_body_box_tray.move(90, 140);
			$hospital_body_box_tray.startSoundShader("e1m4_rolling", SND_CHANNEL_ANY);
			sys.waitFor($hospital_body_box_tray);			

			sys.wait(1);
			$outro_coffin_door.move(DOWN, 56);

			sys.waitFor($outro_coffin_door);
			sys.wait(1);

			$outro_coffin_door.startSoundShader("e1m1_burn2", SND_CHANNEL_ANY);

			thread crossFadeEnt ($the_box, '0 0 0', '.75 0 0', .01);
			thread crossFadeEnt ($boxkey_askey, '0 0 0', '.75 0 0', .01);			
			$hospital_pick_box_from_burner.setKey("item_action", "Pickup");
			boxtimes++;			

			sys.wait(4.5);

			$outro_coffin_door.startSoundShader("sound/shav/e1m4/boxchange.ogg", SND_CHANNEL_ANY);			

			sys.wait(2);

			$outro_coffin_door.move(UP, 56);
			sys.waitFor($outro_coffin_door);
		
			$hospital_body_box_tray.move(90, -140);
			$hospital_body_box_tray.startSoundShader("e1m4_rolling", SND_CHANNEL_ANY);
			
			sys.waitFor($hospital_body_box_tray);
			$hospital_pick_box_from_burner.setKey("click_item", "1");

			sys.wait(1);
			$outro_coffin_door.move(DOWN, 56);
		}
		else
		{
			$outro_coffin_table_cylinder_lower.move(UP, 8);
			$outro_coffin_table_cylinder_upper.move(UP, 16);

			sys.waitFor($outro_coffin_table_cylinder_upper);

			sys.wait(1);

			$outro_coffin_door.move(UP, 56);		
		
			sys.waitFor($outro_coffin_door);
			sys.wait(1);
		
			$outro_coffin.move(90, 192);
			$outro_coffin.startSoundShader("e1m4_rolling", SND_CHANNEL_ANY);
			sys.waitFor($outro_coffin);
		
			$outro_coffin_door.move(DOWN, 56);
		
			sys.waitFor($outro_coffin_door);

			sys.wait(1);

			$outro_coffin_door.startSoundShader("e1m1_burn2", SND_CHANNEL_ANY);
		
			//hide coffin
			$outro_coffin.hide();
			$outro_coffin_handles.hide();
			$outro_coffin_flowers.hide();
		
			//show box
			$the_box.show();
			$hospital_body_box_tray.show();
				
			sys.wait(6.5);
		
			$outro_coffin_door.move(UP, 56);
			sys.waitFor($outro_coffin_door);
		
			$hospital_body_box_tray.move(90, -140);
			$hospital_body_box_tray.startSoundShader("e1m4_rolling", SND_CHANNEL_ANY);
			sys.waitFor($hospital_body_box_tray);
			$hospital_pick_box_from_burner.setKey("click_item", "1");		

			sys.wait(1);
			$outro_coffin_door.move(DOWN, 56);
		}
	}	

	void PickUpBoxFromBurner()
	{				
		if(boxtimes == 1)
		{
			$the_box.show();
			$player1.startSoundShader("e1m3_1_placebox", SND_CHANNEL_ANY);			
			$hospital_incinerator_item.setKey("click_item", 1);
		}
		else if(boxtimes == 2)
		{
			$the_box.hide();
			$player1.startSoundShader("e1m3_1_pickupbox", SND_CHANNEL_ANY);
			$boxkey_askey_clicker.setKey("click_item", "1");
		}
	}
	
	float scannerActive;

	void UpdateCameraAngle()
	{	
		scannerActive = 1;
		while(scannerActive == 1)
		{						
			$scanner_camera.setAngles($player1.getHead().getAngles());
			sys.wait(GAME_FRAMETIME);
		}
	}

	void BlueTunnel()
	{
		sys.fadeTo('0 0 0', 1, .01);

		$sewer_vent_door_reaction_item.hide();
		sys.trigger($SpeakerAreYouWithMeOrNot);
		sys.trigger($SpeakerVoidBack);		
		sys.trigger($SpeakerSetAdrift);
		sys.trigger($BlueWorldCam);		
		sys.fadeTo('0 0 0', 0, .0625);

		sys.wait(5);
		sys.wait(1);

		$BlueWorldRotator.rotateOnce('90 0 0');
		sys.waitFor($BlueWorldRotator);
		
		$BlueWorldMover.move(DOWN, 3200);

		sys.wait(21.5);
		sys.trigger($SpeakerVoidHorn);

		sys.wait(1);
		sys.trigger($uwu_void_plug);

		$BlueWorldRotator.time(8);
		$BlueWorldRotator.rotateOnce('360 180 0');		

		sys.wait(14);

		sys.wait(1.277);
		sys.fadeTo('0 0 0', 1, .01);
		sys.wait(4);

		sys.fadeTo('0 0 0', 0, .01);
		sys.trigger($BlueWorldCam);		

		$SpeakerVoidBack.fadeSound(SND_CHANNEL_ANY, -30, 20);
	}

	void InsertScanner()
	{
		thread UpdateCameraAngle();

		sys.fadeTo('1 1 1', 1, .0625);
		sys.wait(0.0625);			
		$scanner_playerbody.show();		
		
		sys.trigger($small_ventilation_room_teleport);
		
		$boxkey_door_mover.time(0.01);
		$boxkey_door_mover.rotateOnce('0 85 0');

		sys.trigger($scanner_camera);		

		sys.fadeTo('1 1 1', 0, .125);

		sys.wait(1);

		thread ShowNPCSubtitles("Sam", "Samantha Miles. Sounds familiar.", 5);
		sys.wait($player1.startSoundShader("sewer_soundsfamiliar", SND_CHANNEL_ANY) + .5);
				
		$scanner_bed_hospital.move(UP, 16);
		sys.waitFor($scanner_bed_hospital);
		sys.wait(1);
		
		$outro_coffin_door.move(UP, 56);		
		
		sys.waitFor($outro_coffin_door);
		sys.wait(1);

		$scanner_bed_hospital.move(90, 160);

		sys.waitFor($scanner_bed_hospital);
		
		$outro_coffin_door.move(DOWN, 56);
		sys.fadeTo('0 0 0', 1, 2);

		sys.waitFor($outro_coffin_door);

		$SpeakerAreYouWithMeOrNot.fadeSound(SND_CHANNEL_ANY, -100, 6);
		sys.wait($player1.startSoundShader("sound/shav/e1m1/burn3.ogg", SND_CHANNEL_ANY));
		
		scannerActive = 0;
		
		BlueTunnel();

		sys.trigger($SpeakerTension);
		$seweruwu_door_1_clicker.setKey("click_item", 1);
		
		sys.fadeTo('0 0 0', 0, 2);		
		sys.trigger($SpeakerRecognize);
	}
	void SenseHospital()
	{
		while(1)
		{			
			vector angles = $player1.getViewAngles();		
			
			if(angles_y < 0)
			{
				break;
			}			

			sys.waitFrame();
		}

		$player1.startSoundShader("e1m4_see_hospital", SND_CHANNEL_ANY);
		sys.trigger($HospitalSideSensor2);
	}

	void TeleportToAreaOne()
	{
		sys.trigger($info_player_teleport_area_one);
		$player1.startSoundShader("e1m4_spotlight", SND_CHANNEL_ANY );
