	//===========================================
	// RANDOM MONSTER SPAWNS
	//===========================================		
	
	void select_monsterconfig(float encounterNum)
	{
		float monsterselect;
		entity monster_config_a = sys.getEntity("monster_config_a" + encounterNum);
		entity monster_config_b = sys.getEntity("monster_config_b" + encounterNum);


		while (1)
		{
			monsterselect = sys.random(15);
		
				if (monsterselect <= 8){
					sys.trigger (monster_config_a);
					//sys.println("monster_configa" + encounterNum + "selected");
					sys.wait(.5);
				} else {
					sys.trigger (monster_config_b);
					//sys.println("monster_configb" + encounterNum + "selected");
					sys.wait(.5);
				} 
		}
	}
	
	void select_monsterconfig1()
	{
		select_monsterconfig(1);
	}		
	
	void kill_monster_selection1()
	{sys.killthread ("map_e1m3_1::select_monsterconfig1");}	
	
	//===========================================
	// END RANDOM MONSTER SPAWNS
	//===========================================
	float skipIntro = 0;

	void main()
	{	
		if(skipIntro == 0)
		{
			map_e1m3_1_intro::main2();
		}
		else
		{
			sys.trigger($info_player_teleport_1);
			sys.trigger($trigger_relay_624);
			sys.trigger($trigger_relay_610);
		}

		thread select_monsterconfig1();

		sys.trigger($hangarlock_inner_clip);
		$hangarlock_inner_r.move(180, 56);
		$hangarlock_inner_l.move(0, 56);
		thread TimelinePosters();
		sys.trigger($trigger_count_4);
		sys.trigger($trigger_count_6);
		sys.trigger($trigger_relay_692);
		sys.trigger($func_static_77865);
		$trigger_multiple_19.disable();
		$trigger_multiple_21.disable();
		$trigger_multiple_22.disable();
		$trigger_multiple_25.disable();
		$trigger_multiple_26.disable();
		$trigger_multiple_27.disable();
		$trigger_multiple_5.disable();
		$trigger_multiple_4.disable();
		$trigger_multiple_7.disable();
		$trigger_multiple_13.disable();
		$trigger_multiple_11.disable();
		$trigger_multiple_9.disable();
		$sentry_scan_lp.rotateOnce('70 0 0');
		$sentry_scan_rp.rotateOnce('-70 0 0');
		sys.waitFor($sentry_scan_rp);
		$sentry_scan_luparm.bind($sentry_scan_lp);
		$sentry_scan_ruparm.bind($sentry_scan_rp);
	}
