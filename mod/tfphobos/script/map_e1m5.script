		ShowSubtitles("Lee", "The sound of the lonely horn of the train haunted me.\nI can sometimes still hear it.", 10);
		ShowSubtitles("Lee", "At that moment in time I swore that I would not give in.\nI would return. Some day.", 10);
		ShowSubtitles("Lee", "And I thought that moment would be now.", 5);
