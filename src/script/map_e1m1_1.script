	void HLTurnHookTrip()
	{
		while (1)
		{
			$hlturn_cratehook01.move(270, 1200);
			sys.waitFor($hlturn_cratehook01);
			$hlturn_cratehook01.bind($hlturn_anchor01);
			$hlturn_anchor01.rotateOnce('0 -180 0');
			sys.waitFor($hlturn_anchor01);
			$hlturn_cratehook01.unbind();
			$hlturn_cratehook01.move(90, 1200);
			sys.waitFor($hlturn_cratehook01);
			$hlturn_cratehook01.restorePosition();
		}
	}

	float Floor(float value, float max)
	{
		float i = max;

		while(i > 0)
		{
			if(value < i && value > i - 1)
				return i - 1;

				i--;
		}
		return value;
	}

