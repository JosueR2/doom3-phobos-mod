	void ChangeLevel1(float distance)
	{
		sys.waitFor($fuelcachemain_water);
		$fuelcachemain_water.move(UP, distance);
	}
	
	void ChangeLevel2(float distance)
	{
		sys.waitFor($fuelcachesecondary_water);
		$fuelcachesecondary_water.move(UP, distance);
	}

	void ChangeLevel3(float level)
	{
		$fuelcachetertiary_water_1.hide();
		$fuelcachetertiary_water_2.hide();
		$fuelcachetertiary_water_3.hide();
		$light_58994.hide();
		$light_58993.hide();
		$light_58968.hide();
		$light_58969.hide();
		$light_58970.hide();
		$light_58995.hide();

		if( level == 1 )
		{
			$fuelcachetertiary_water_1.show();
			$light_58994.show();
			$light_58993.show();
			$light_58995.show();
		}
		else if( level == 2 )
		{
			$fuelcachetertiary_water_2.show();
			$light_58994.show();
			$light_58993.show();
			$light_58995.show();
		}
		else if( level == 3)
		{
			$fuelcachetertiary_water_3.show();
			$light_58994.show();
			$light_58993.show();
			$light_58995.show();
		}
		else
		{
			$light_58968.show();
			$light_58969.show();
			$light_58970.show();
		}
	}

	void RefreshFuelLevelsFromGui()
	{
		float fuel1level = $fms_mainscreen.getGuiParmFloat (1, "gui_parm7");
		float fuel2level = $fms_mainscreen.getGuiParmFloat (1, "gui_parm8");
		float fuel3level = $fms_mainscreen.getGuiParmFloat (1, "gui_parm9");

		$fms_mainscreen.setGuiParm("gui_parm4", fuel1level);
		$fms_mainscreen.setGuiParm("gui_parm5", fuel2level);
		$fms_mainscreen.setGuiParm("gui_parm6", fuel3level);
	}

	float CalculateFuelChangeValue(float fromLevel, float fromMax, float toLevel, float toMax )
	{
		float newValue = toMax - toLevel;
		
		if( fromLevel > newValue )
		{
			return newValue;
		}
		else
		{
			return fromLevel;
		}
	}

	void CheckLevel1(float level1, float level2, float level3)
	{					
		if( level1 <= 4 && level3 == 0 )
		{
			$fuelcacehemain_hatch.lock(0);
			$fuelcacehemain_hatch_light1.setColor(0,0.5,0);
			$fuelcacehemain_hatch_light2.setColor(0,0.5,0);
			$fuelcacehemain_hatch_light3.setColor(0,0.5,0);
			$fuelcacehemain_hatch_light4.setColor(0,0.5,0);
			$fuelcacehemain_hatch_gui.setGuiParm("gui_parm2", 0);
			sys.trigger($fuelcacehemain_hatch_gui);
			$func_static_80635.show();
			$func_static_80636.hide();
		}
		else
		{			
			$fuelcacehemain_hatch.lock(2);
			$fuelcacehemain_hatch_light1.setColor(0.5,0,0);
			$fuelcacehemain_hatch_light2.setColor(0.5,0,0);
			$fuelcacehemain_hatch_light3.setColor(0.5,0,0);
			$fuelcacehemain_hatch_light4.setColor(0.5,0,0);
			$fuelcacehemain_hatch_gui.setGuiParm("gui_parm2", 1);
			sys.trigger($fuelcacehemain_hatch_gui);
			$func_static_80635.hide();
			$func_static_80636.show();
		}
	}
	
	void CheckLevel2(float level)
	{
		if(level <= 4 )
		{
			$secondcache_hatch.lock(0);
			$light_58803.setColor(0,0.5,0);
			$light_58804.setColor(0,0.5,0);
			$light_57060.setColor(0,0.5,0);
			$light_57061.setColor(0,0.5,0);
			$secondcache_hatch_gui.setGuiParm("gui_parm2", 0);
			sys.trigger($secondcache_hatch_gui);
			$pipe2ndcache_red.hide();
			$pipe2ndcache_green.show();
		}
		else
		{
			$secondcache_hatch.lock(2);
			$pipe2ndcache_green.hide();
			$pipe2ndcache_red.show();
			$light_58803.setColor(0.5,0,0);
			$light_58804.setColor(0.5,0,0);
			$light_57060.setColor(0,0.5,0);
			$light_57061.setColor(0,0.5,0);
			$secondcache_hatch_gui.setGuiParm("gui_parm2", 1);
			sys.trigger($secondcache_hatch_gui);
		}
	}

	void CheckLevel3(float level)
