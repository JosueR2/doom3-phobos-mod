				sys.trigger($trigger_relay_prot3);
				sys.wait(2);
				sys.trigger($trigger_relay_prot3);
				$printer_spark3.bind($printer_rot3);
				$printer_rot3.rotateDownTo(Y_AXIS, 130);
				sys.waitFor($printer_rot3);
				$printer_spark3.unbind();
				sys.trigger($trigger_relay_prot3);
				sys.wait(1.8);
				sys.trigger($trigger_relay_prot3);
				$printer_spark3.bind($printer_rot3);
				$printer_rot3.rotateDownTo(Y_AXIS, 70);
				sys.waitFor($printer_rot3);
				$printer_spark3.unbind();
				sys.trigger($trigger_relay_prot3);
				sys.wait(1.5);
				sys.trigger($trigger_relay_prot3);
				$printer_spark3.bind($printer_rot3);
				$printer_rot3.rotateDownTo(Y_AXIS, 0);
				sys.waitFor($printer_rot3);
				$printer_spark3.unbind();
				sys.trigger($trigger_relay_prot3);
				sys.wait(2);
				sys.trigger($trigger_relay_prot3);
			}
	}
	
	void release_bfgcell()
	{
		sys.killthread ("map_e1m5_4::printer_loop1");
		sys.killthread ("map_e1m5_4::printer_loop2");
		sys.killthread ("map_e1m5_4::printer_loop3");
		sys.wait(.25);
		
		$printer_beam1_spkr.fadeSound(SND_CHANNEL_ANY, -30, 1);
		$printer_beam2_spkr.fadeSound(SND_CHANNEL_ANY, -30, 1);
		$printer_beam3_spkr.fadeSound(SND_CHANNEL_ANY, -30, 1);
		$printer_spark1.unbind();
		$printer_spark2.unbind();
		$printer_spark3.unbind();
		sys.wait(.25);
		$printer_spark1.remove();
		$printer_spark2.remove();
		$printer_spark3.remove();
		sys.trigger($target_entity_setcolor_21);
		sys.trigger($target_entity_setcolor_24);
		sys.trigger($target_entity_setcolor_25);
		$printer_lightbeam1.setColor(0, 0, 0);
		$printer_lightbeam2.setColor(0, 0, 0);
		$printer_lightbeam3.setColor(0, 0, 0);
		
		sys.wait(.25);
		
		$printer_rot1.rotateDownTo(Y_AXIS, 0);
		$printer_rot2.rotateDownTo(Y_AXIS, 0);
		$printer_rot3.rotateDownTo(Y_AXIS, 0);
		
		sys.wait(.25);
		sys.trigger($bfg_forcefield);
		sys.wait(.25);
		sys.trigger($bfgcell_clip);
		
		sys.trigger($bfgcell_rot);
		sys.wait(.5);
		$ammo_bfg_small_1.unbind();
		sys.trigger($ammo_bfg_small_1);
	}
	
