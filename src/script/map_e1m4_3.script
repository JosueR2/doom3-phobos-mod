		sys.wait(212);
		sys.fadeTo('0 0 0', 1, 4);
		sys.wait(15);
		
		sys.trigger($EndEpisodeTwo);
	}

	float GetRandom(float min, float variance)
	{
		return sys.random(variance) + min;
	}

	void MotelLightningSession(float times)
	{
		float i = 0;
		while(i < times - 1)
		{			
			sys.wait(GetRandom(0.05, 0.15));
			MotelLightning(GetRandom(0.01, .0625), GetRandom(0.01, .0625), GetRandom(0.01, .125), GetRandom(.1, 1));
			 
			i++;
		}

		sys.wait(GetRandom(0.05, 0.3));

		MotelLightning(GetRandom(0.1, .0625), GetRandom(0.3, .35), GetRandom(.2, .3), GetRandom(.5, .7));
	}

	void UpdateMotel()
	{		
		while(1)
		{
			MotelLightningSession(GetRandom(1, 5));
			sys.wait(GetRandom(.2, 4));
		}
	}
	
	void e1m4_3_Outro_Player2Sub()
	{
		ShowNPCSubtitles("Sam", "Point taken.", 2);
		sys.wait(1);
		ShowNPCSubtitles("Sam", "I guess as darkness falls and you begin to let go, time stretches toward infinity.\nLeaving you behind in an eternal state.", 9);
		ShowNPCSubtitles("Sam", "The last thoughts you had. Your final regrets.\nAnd it would go on forever.", 7);
		ShowNPCSubtitles("Sam", "But your memories would warp and the people you loved would fade away.\nOnly to haunt you as fleeting voices in your mind.", 8);
	}
	
	void e1m4_3_Outro_Lee6Sub()
	{
		ShowNPCSubtitles("Lee", "It's like drowning. Your body becomes cold and numb as the water engulfs you.\nBut you don't stay afloat. You sink. Like a stone. ", 12);
		ShowNPCSubtitles("Lee", "You get further and further away from the surface.\nDown into the darkness.", 4.1);
		ShowNPCSubtitles("Lee", "As you go deeper and deeper the pain will leave your body and your thoughts become clear.", 6.1);
		ShowNPCSubtitles("Lee", "The only thing left is your own voice in the back of your mind, desperately trying to escape. ", 6);
		ShowNPCSubtitles("Lee", "Until even that is gone and for a while you almost don't exist and then...", 7);
	}

	void MotelScene()
	{
		sys.fadeTo('0 0 0', 1, 0);
		$SpeakerWeFailed.fadeSound(SND_CHANNEL_ANY, -100, 10);		
		$speaker_intro_generator.fadeSound(SND_CHANNEL_ANY, -100, 10);

		sys.trigger($outro_motel_speaker_thunder1);
		sys.trigger($outro_motel_speaker_thunder2);

		sys.wait(3);

		thread UpdateCameraAngle();
		thread UpdateMotel();
		
		sys.trigger($outro_garage_music_1);

		sys.trigger($info_player_teleport_1);
		sys.trigger($outro_bed_camera);

		sys.wait(.25);

		sys.fadeTo('0 0 0', 0, 0.125);

		sys.wait(5);

		$outro_motel_speakerlee.startSoundShader("e1m4_3_bed", SND_CHANNEL_ANY);
		sys.wait(3.5);

		thread ShowNPCSubtitles("Lee", "Sam. What do you think happens when we die?", 4);
		Outro_CharacterSays($outro_motel_speakerlee, "e1m4_3_Outro_Lee3");
		Beat(.7);
		thread ShowNPCSubtitles("Sam", "Is it a good or a bad death?", 2);
		Outro_CharacterSays($player1, "e1m4_3_Outro_Player1");
		Beat(.6);		
		thread ShowNPCSubtitles("Lee", "Are there good deaths?", 2);
		Outro_CharacterSays($outro_motel_speakerlee, "e1m4_3_Outro_Lee4");
		Beat(1.35);		
		thread e1m4_3_Outro_Player2Sub();
		Outro_CharacterSays($player1, "e1m4_3_Outro_Player2");
		Beat(.25);
		thread ShowNPCSubtitles("Lee", "So when does it end?", 2);
		Outro_CharacterSays($outro_motel_speakerlee, "e1m4_3_Outro_Lee5");
		Beat(1);
		thread ShowNPCSubtitles("Sam", "I don't know. Maybe it doesn't.\nWhat do you think happens?", 4.15);
		Outro_CharacterSays($player1, "e1m4_3_Outro_Player3");
		Beat(.75);
		$outro_motel_speakerlee.startSoundShader("e1m4_3_bed2", SND_CHANNEL_ANY);
		Beat(1.25);
		thread e1m4_3_Outro_Lee6Sub();
		Outro_CharacterSays($outro_motel_speakerlee, "e1m4_3_Outro_Lee6");
		Beat(1);
		thread ShowNPCSubtitles("Sam", "And then what?", 2.15);
		Outro_CharacterSays($player1, "e1m4_3_Outro_Player4");
		Beat(1.75);		
		thread ShowNPCSubtitles("Lee", "Nothing. It's all gone.", 2);
		Outro_CharacterSays($outro_motel_speakerlee, "e1m4_3_Outro_Lee7");
		Beat(1);
		sys.fadeTo('0 0 0', 1, 0.125);
		
		MeetingWithJNoteClick();
	}
	
