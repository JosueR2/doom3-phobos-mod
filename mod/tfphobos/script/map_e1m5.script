		ShowSubtitles("Sam", "I...He's planning to sell the box. To someone. He's using you.", 10);
		ShowSubtitles("Sam", "Where do we go from here?", 2);
	}

	void HideOnAltan()
	{
		float skipto = 0;
		if(!skipto)
		{
		//fade to black
		sys.fadeTo('0 0 0', 1, .5);

		sys.wait(.5);

		sys.wait($player1.startSoundShader("sound/shav/e1m5/curtain.ogg", SND_CHANNEL_ANY) - 1.0);
		sys.trigger($altan_door_slider_speaker);

		sys.wait(5);
		
		$not_closet_cam_01_mover.move(270, 64);

		$curtian_sepia_decal.hide();
		sys.trigger($not_closet_cam_01);
		sys.fadeTo('0 0 0', 0, .5);

		sys.trigger($speaker_somethingsoff);

		sys.wait(3);

		//Lee opens the door
		sys.trigger($lee_open_door_speaker);

		sys.wait(3);

		$not_closet_cam_02_mover.moveTo($not_closet_cam_02_target);
		sys.trigger($not_closet_cam_02);

		sys.wait(4);
		
		//Lee and benson talk
		thread ShowSubtitles("Lee", "Well. We're here...\nThanks for following me up.", 3.25);
		CharacterSays($SpeakerLee, "sound/vo/e1m5/motelcloset/lee1.ogg");
		Beat(.75);
		
		thread ShowSubtitles("James Benson", "My Pleasure.\nHow do you like the room?", 3);
		CharacterSays($SpeakerBenson, "sound/vo/e1m5/motelcloset/benson1.ogg");
		Beat(1);

		thread ShowSubtitles("Lee", "Erm...I'm...it's a fine room.", 3.25);
		CharacterSays($SpeakerLee, "sound/vo/e1m5/motelcloset/lee2.ogg");
		Beat(.15);
		
		$curtian_sepia_decal.show();
		$not_closet_cam_03_mover.moveTo($not_closet_cam_03_target);
		sys.trigger($not_closet_cam_03);

		thread Benson2Subtitle();
		CharacterSays($SpeakerBenson, "sound/vo/e1m5/motelcloset/benson2.ogg");
		Beat(.75);
		
		
		thread ShowSubtitles("Lee", "Or something?", 2);
		CharacterSays($SpeakerLee, "sound/vo/e1m5/motelcloset/lee3.ogg");
		Beat(.25);
		
		thread ShowSubtitles("James Benson", "I just hope you've enjoyed yourself these past few days.", 5.0);
		CharacterSays($SpeakerBenson, "sound/vo/e1m5/motelcloset/benson3.ogg");
		Beat(.75);
	
		$not_closet_cam_06_mover.moveTo($not_closet_cam_06_target);
		sys.trigger($not_closet_cam_06);

		thread ShowSubtitles("Lee", "I have.", 2);
		CharacterSays($SpeakerLee, "sound/vo/e1m5/motelcloset/lee4.ogg");
		Beat(1.5);		
			


		thread Benson4Subs();
		CharacterSays($SpeakerBenson, "sound/vo/e1m5/motelcloset/benson4.ogg");
		Beat(.2);
		
		thread ShowSubtitles("Lee", "Well I, erm, I appreciate that.\nI'm still bummed about your contact though.", 5.25);
		CharacterSays($SpeakerLee, "sound/vo/e1m5/motelcloset/lee5.ogg");
		
		Beat(1.0);

		$not_closet_cam_04_mover.moveTo($not_closet_cam_04_target);
		sys.trigger($not_closet_cam_04);
		
		thread Benson5Subtitle();
		CharacterSays($SpeakerBenson, "sound/vo/e1m5/motelcloset/benson5.ogg");
		Beat(.25);
		
		$not_closet_cam_05_mover.moveTo($not_closet_cam_05_target);
		sys.trigger($not_closet_cam_05);
		
		thread ShowSubtitles("Lee", "I'm just disappointed. It's not your fault.\nI'm SO tired...", 7.25);
		CharacterSays($SpeakerLee, "sound/vo/e1m5/motelcloset/lee6.ogg");
		Beat(1.5);
		
		thread ShowSubtitles("James Benson", "Lee, I'd like to stay for a bit.\nIf you don't mind.", 4.5);
		CharacterSays($SpeakerBenson, "sound/vo/e1m5/motelcloset/benson6.ogg");
		Beat(.75);
		
		thread ShowSubtitles("Lee", "Oh...erm...I'll be right back.", 3.25);
		CharacterSays($SpeakerLee, "sound/vo/e1m5/motelcloset/lee7.ogg");		
		Beat(2.5);

		sys.trigger($not_closet_cam_07);
		
		//sys.trigger($benson_steps);

		sys.trigger($SpeakerDoorOpenCloseLock);

		Beat(2);		

		Beat(4);

		sys.trigger($SpeakerFaucet);
		Beat(2.5);

		sys.trigger($not_closet_cam_08);
		
		sys.wait(4);
				
		//sys.trigger($SpeakerBensonNear);
		sys.wait(.5);

		sys.trigger($benson_phone_ring);

		sys.wait(.5);

		sys.trigger($benson_foot_walk);
		

		thread UpdateClosetCameraAngle();		

		sys.wait(4);

		sys.wait($benson_door.startSoundShader("sound/shav/e1m5/curtain.ogg", SND_CHANNEL_ANY) - 1.0);		

		sys.fadeTo('0 0 0', 1, .5);		
		
		sys.wait(.5);

		sys.trigger($altan_door_slider_speaker);

		//go to closet camera
		sys.trigger($motel_closet_camera);
		
		sys.wait(1);
		
		sys.fadeTo('0 0 0', 0, .5);		
		
		sys.wait(2);

		thread ShowSubtitles("James Benson", "Where have you been?\nI've tried to get a hold of you for the better part of a week.", 4.25);
		CharacterSays($SpeakerBenson2, "sound/vo/e1m5/motelcloset/benson7.ogg");
		sys.wait(2.5);
		
		thread ShowSubtitles("James Benson", "I can't talk here. Not for long anyway.\nDid you get my message?", 4.5);
		CharacterSays($SpeakerBenson2, "sound/vo/e1m5/motelcloset/benson8.ogg");		
		sys.wait(2.5);
		
		thread ShowSubtitles("James Benson", "A week back.\nAbout the...Artifact...", 4);
		CharacterSays($SpeakerBenson2, "sound/vo/e1m5/motelcloset/benson9.ogg");
		sys.wait(2.5);

		thread ShowSubtitles("James Benson", "Yes and yes.", 2.5);
		CharacterSays($SpeakerBenson2, "sound/vo/e1m5/motelcloset/benson10.ogg");
		sys.wait(2.5);	

		thread ShowSubtitles("James Benson", "I know the going rate for these artifacts. This one came all the way from Mars.\nIt was not easy getting it here.", 6.5);
		CharacterSays($SpeakerBenson2, "sound/vo/e1m5/motelcloset/benson11.ogg");
		sys.wait(1.5);

		thread ShowSubtitles("James Benson", "I'm thinking at least 4 million.", 2.5);
		CharacterSays($SpeakerBenson2, "sound/vo/e1m5/motelcloset/benson12.ogg");
		sys.wait(2.5);

		thread ShowSubtitles("James Benson", "Right now? Don't have it with me and I wouldn't meet you if I had.\nBut I have pictures. See you soon.", 8);
		CharacterSays($SpeakerBenson2, "sound/vo/e1m5/motelcloset/benson13.ogg");		
		sys.wait(2.5);

		$not_closet_cam_09_mover.moveTo($not_closet_cam_09_target);
		sys.trigger($not_closet_cam_09);

		//Lee comes out of the bathroom
		sys.trigger($SpeakerUnlockDoorOpenClose);
		Beat(3);

		thread ShowSubtitles("James Benson", "Lee...I have to go. Business. I'm sorry.\nI hope we can continue this again soon.", 7);
		CharacterSays($SpeakerBenson, "sound/vo/e1m5/motelcloset/benson14.ogg");		
		Beat(.25);

		thread ShowSubtitles("Lee", "Sure. Have a fine evening.", 2);
		CharacterSays($SpeakerLee, "sound/vo/e1m5/motelcloset/lee8.ogg");
				
		sys.trigger($SpeakerBensonLeaves);
		
		sys.wait(8.5);
		
		//Remove heavy breathing
		//sys.trigger($ClosetBreathing);
		
		// Open bathroom door
		$door_bathroom_mover.rotateOnce('0 -75 0');
		$pizza_fredag_door_clip.hide();
		$hide_bathroom_clicker.hide();
		}
		sys.wait(1.25);

		// Turn off the game show
		$SpeakerTVShow.fadeSound (SND_CHANNEL_ANY, -100, 50);
		sys.trigger($SpeakerSoothing);
		sys.wait(6);

		sys.trigger($outro_camera_freetext);

		sys.wait(1);

		showText("Later.");

		sys.wait(4);

		sys.trigger($outro_camera_freetext);
		sys.trigger($not_closet_cam_09);

		//Exit closet
		//$SliderLeft.move(270, 30);
		//sys.trigger($SliderLeftSpeaker);
		sys.fadeTo('0 0 0', 1, 1.5);
		sys.wait(6);

		thread Player1_1Subs();
		CharacterSays($player1, "sound/vo/e1m5/motelcloset/player1_1.ogg");

		sys.wait(5);

		thread ShowSubtitles("Sam", "Are you okay?", 2);
		CharacterSays($player1, "sound/vo/e1m5/motelcloset/player2.ogg");

		
		sys.wait(1.5);
		thread ShowSubtitles("Lee", "Have I ever told you about my last day outside the valley?", 7.5);
		CharacterSays($player1, "sound/vo/e1m5/motelcloset/lee10.ogg");
		
		// SPAWN IN PARTY ROOM
		thread StartTrainStuff();
		sys.trigger($teleport_train);

		
		if(!skipto)
		{
		sys.trigger($not_closet_cam_09);
		}
		sys.wait(.125);
		sys.fadeTo('0 0 0', 0, 0);

		//Turn off the lights
		$motel_floor_light_1_1.setColor(0,0,0);
		$motel_floor_light_1_2.setColor(0,0,0);
		$motel_floor_light_1_source.setColor(0, 0, 0);
		$motel_floor_light_2_1.setColor(0, 0, 0);
		$motel_floor_light_2_2.setColor(0, 0, 0);
		$motel_floor_light_2_source.setColor(0, 0, 0);
		$motel_bed_light_1_ambient.setColor(0, 0, 0);
		$motel_bed_light_1_source.setColor(0, 0, 0);
		$motel_bed_light_1.setColor(0, 0, 0);
		$motel_bed_light_2_ambient.setColor(0, 0, 0);
		$motel_bed_light_2_source.setColor(0, 0, 0);
		$motel_bed_light_2.setColor(0, 0, 0);
		$motel_fan_light_source.setColor(0, 0, 0);
		$motel_fan_light.setColor(0, 0, 0);
		$motel_ambient_light_1.setColor(0.24, 0.20, 0.16);
		$motel_ambient_light_2.setColor(0.12, 0.12, 0.16);
		$light_65836.setColor(0, 0, 0);
		$light_65838.setColor(0, 0, 0);
		$func_static_108262.setColor(0, 0, 0);
		$func_static_107926.setColor(0, 0, 0);
		$house_light_group_main_42.setColor(0, 0, 0);
		$house_light_group_main_41.setColor(0, 0, 0);
		$house_light_group_main_12.setColor(0, 0, 0);
		$house_light_group_main_71.setColor(0, 0, 0);
		$house_light_group_main_74.setColor(0, 0, 0);
		$func_rotating_2.stopRotating();
	}

