	#define CRANE_NONE		0
	#define CRANE_NORTH		1
	#define CRANE_SOUTH		2
	#define CRANE_WEST		3
	#define CRANE_EAST		4
	#define CRANE_UP		5
	#define CRANE_DOWN		6
	#define CRANE_CALL_DETENTION 7
	#define CRANE_CALL_OFFICES 8
	#define CRANE_CALL_ARMORY 9
	#define CRANE_CALL_RECREATION 10
	#define CRANE_CALL_CARGO 11
	#define CRANE_CALL_SERVERS 12

	float command = CRANE_NONE;		
	vector	crane_mins;
	vector	crane_maxs;
	vector	crane_pos;

	void cache_crane_sounds() 
	{
		sys.cacheSoundShader( "al3_crane_fingers_open" );
		sys.cacheSoundShader( "al3_crane_fingers_close" );
		sys.cacheSoundShader( "al3_crane_loop" );
		sys.cacheSoundShader( "al3_crane_end" );
		sys.cacheSoundShader( "al3_crane_updown_loop" );
		sys.cacheSoundShader( "al3_crane_updown_end" );
	}

	void sound_crane_fingers_open() {
		$crane_hook.startSoundShader ("al3_crane_fingers_open", SND_CHANNEL_VOICE2 );
	}

	void sound_crane_fingers_close() {
		$crane_hook.startSoundShader ("al3_crane_fingers_close", SND_CHANNEL_VOICE2 );
	}

	void sound_crane_loop() {
		$crane_hook.startSoundShader ("m1_loop", SND_CHANNEL_VOICE2 );
	}

	void sound_crane_stop() {
		$crane_hook.startSoundShader ("m1_stop", SND_CHANNEL_VOICE2 );
	}

	void sound_crane_updown_loop() {
		$crane_hook.startSoundShader ("m2_loop", SND_CHANNEL_VOICE2 );
	}

	void sound_crane_updown_end() {
		$crane_hook.startSoundShader ("m2_stop", SND_CHANNEL_VOICE2 );
	}
	
	void crane_move( entity part, entity wheel1, entity wheel2, float dir, float amount, float stopOnCommand ) 
	{
		float cmd;

		if ( amount < 0.01 ) {
			return;
		}

		if ( ( dir == UP ) || ( dir == DOWN ) ) 
		{
			sound_crane_updown_loop();
		} 
		else 
		{
			sound_crane_loop();
		}
			
		part.move( dir, amount );

		float rotTime = amount / 45;
		wheel1.time(rotTime);
		wheel2.time(rotTime);

		float wheelDiameter = wheel1.getFloatKey("wheelDiameter");
		float revolutions = amount / wheelDiameter;
		float rotDir = 1;
		if(dir == SOUTH || dir == UP)
			rotDir = -1;		
		
		vector rotVec1 = wheel1.getVectorKey("rotVec");
		vector rotVec2 = wheel2.getVectorKey("rotVec");

		wheel1.rotateOnce(rotVec1 * revolutions * rotDir);
		wheel2.rotateOnce(rotVec2 * revolutions * rotDir);

		if ( !stopOnCommand ) 
		{
			sys.waitFor( part );
		} 
		else 
		{
			cmd = command;
			while( command == cmd ) 
			{
				sys.waitFrame();

				vector diff = crane_maxs - $crane_hook.getWorldOrigin();

				float num = diff_z / 64;
				num += 1;				

				float i = 1;
				while(i < 15)
				{
					entity wire = sys.getEntity("crane_wire_" + i);
					if(i < num)
					{
						wire.show();
					}
					else
					{
						wire.hide();
					}
					i++;
				}				
				
				if ( !part.isMoving() )
				{
					break;
				}
			}
			part.stopMoving();			
			wheel1.stopRotating();
			wheel2.stopRotating();
		}

		if ( ( dir == UP ) || ( dir == DOWN ) ) {
			sound_crane_updown_end();
		} else {
			sound_crane_stop();
		}

		crane_pos = $crane_hook.getWorldOrigin();
	}

	void crane_call_station_on(string name)
	{
		entity texture = sys.getEntity("crane_caller_" + name + "_texture");
		entity light = sys.getEntity("crane_caller_" + name + "_light");		
		
		texture.setColor(0, 0.25, 0);
		light.setColor(0, 0.25, 0);
	}

	void crane_call_station_off(string name)
	{
		entity texture = sys.getEntity("crane_caller_" + name + "_texture");
		entity light = sys.getEntity("crane_caller_" + name + "_light");		
		
		texture.setColor(0.15, 0.15, 0);
		light.setColor(0.15, 0.15, 0);
	}

	void crane_call_station_broken(string name)
	{
		entity texture = sys.getEntity("crane_caller_" + name + "_texture");
		entity light = sys.getEntity("crane_caller_" + name + "_light");		
		
		texture.setColor(0.25, 0, 0);
		light.setColor(0.25, 0, 0);
	}

	void crane_reset_clickers()
	{
		$crane_caller_detention_clicker.setKey("item_disabled", 0);
		$crane_caller_armory_clicker.setKey("item_disabled", 0);
		$crane_caller_cargo_clicker.setKey("item_disabled", 0);
		$crane_caller_servers_clicker.setKey("item_disabled", 0);
		$crane_caller_recreation_clicker.setKey("item_disabled", 0);
		$crane_caller_offices_clicker.setKey("item_disabled", 0);
	}

	void crane_reset_callers()
	{
		crane_call_station_off("detention");
		crane_call_station_off("offices");
		crane_call_station_off("armory");
		crane_call_station_off("recreation");
		crane_call_station_off("servers");
	}

	void crane_disable_clickers()
	{
		$crane_main_gui_1.setKey("gui_noninteractive", 1);

		sys.disableItemGroup("crane_clickers");

		crane_reset_clickers();
	}

	void crane_enable_clickers(entity ignoreClicker)
	{
		$crane_main_gui_1.setKey("gui_noninteractive", 0);

		ignoreClicker.setKey("item_disabled", 1);
		sys.enableItemGroup("crane_clickers");
	}

	void crane_update_loop() 
	{
		crane_mins = $crane_pos_min.getOrigin();
		crane_maxs = $crane_pos_max.getOrigin();
		crane_pos = $crane_hook.getWorldOrigin();
		$crane_hook.speed( 45 );
		$crane_roller_top.speed( 45 );
		$crane_roller_side.speed( 45 );

		while( 1 ) 
		{
			command = CRANE_NONE;
			while( command == CRANE_NONE ) 
			{
				//update_laser();
				sys.waitFrame();
			}

			if ( command == CRANE_WEST ) {
				if ( crane_pos_x > crane_mins_x ) 
				{
					crane_reset_clickers();
					crane_reset_callers();
					crane_move( $crane_roller_top, $crane_roller_topwheel1, $crane_roller_topwheel2, WEST, crane_pos_x - crane_mins_x, true );
				}

			} else if ( command == CRANE_EAST ) {
				if ( crane_pos_x < crane_maxs_x ) 
				{
					crane_reset_clickers();
					crane_reset_callers();
					crane_move( $crane_roller_top, $crane_roller_topwheel1, $crane_roller_topwheel2, EAST, crane_maxs_x - crane_pos_x, true );
				}

			} else if ( command == CRANE_SOUTH ) {
				if ( crane_pos_y > crane_mins_y ) 
				{
					crane_reset_clickers();
					crane_reset_callers();
					crane_move( $crane_roller_side, $crane_roller_northwheel,$crane_roller_southwheel, SOUTH, crane_pos_y - crane_mins_y, true );
				}

			} else if ( command == CRANE_NORTH ) {
				if ( crane_pos_y < crane_maxs_y ) 
				{
					crane_reset_clickers();
					crane_reset_callers();
					crane_move( $crane_roller_side, $crane_roller_northwheel,$crane_roller_southwheel, NORTH, crane_maxs_y - crane_pos_y, true );
				}
			} else if ( command == CRANE_UP ) {
				if ( crane_pos_z < crane_maxs_z ) 
				{
					crane_reset_clickers();
					crane_reset_callers();
					crane_move( $crane_hook, $crane_hook_westwheel,$crane_hook_eastwheel, UP, crane_maxs_z - crane_pos_z, true );
				}

			} else if ( command == CRANE_DOWN ) {
				if ( ( crane_pos_z > crane_mins_z ) ) 
				{
					crane_reset_clickers();
					crane_reset_callers();
					crane_move( $crane_hook, $crane_hook_westwheel,$crane_hook_eastwheel, DOWN, crane_pos_z - crane_mins_z, true );
				}
			} 
			else if(command >= CRANE_CALL_DETENTION)
			{				
				crane_disable_clickers();

				vector destination = crane_pos;
				entity destinationClicker = $crane_caller_detention_clicker;							
				
				if(command == CRANE_CALL_DETENTION)
				{
					destination = $crane_pos_detention.getWorldOrigin();
				}
				else if(command == CRANE_CALL_OFFICES)
				{
					destination = $crane_pos_offices.getWorldOrigin();
					destinationClicker = $crane_caller_offices_clicker;
				}
				else if(command == CRANE_CALL_SERVERS)
				{
					destination = $crane_pos_servers.getWorldOrigin();
					destinationClicker = $crane_caller_servers_clicker;
				}
				else if(command == CRANE_CALL_RECREATION)
				{
					destination = $crane_pos_recreation.getWorldOrigin();
					destinationClicker = $crane_caller_recreation_clicker;
				}
				else if(command == CRANE_CALL_CARGO)
				{
					destination = $crane_pos_cargo.getWorldOrigin();
					destinationClicker = $crane_caller_cargo_clicker;
				}
				else if(command == CRANE_CALL_ARMORY)
				{
					destination = $crane_pos_armory.getWorldOrigin();
					destinationClicker = $crane_caller_armory_clicker;
				}

				destinationClicker.startSoundShader( "sound/shav/e1m5_4/callme.ogg", SND_CHANNEL_VOICE );

				vector diff = crane_pos - destination;

				float distanceX = abs(diff_x);
				float distanceY = abs(diff_y);
				float distanceZ = abs(diff_z);

				
				float dir;

				if(abs(diff_x) > 0)
				{
					dir = WEST;
					if(diff_x < 0)
						dir = EAST;

					crane_move( $crane_roller_top, $crane_roller_topwheel1, $crane_roller_topwheel2, dir, distanceX, true );
				}

				if(abs(diff_z) > 0)
				{
					dir = DOWN;
					if(diff_z < 0)
						dir = UP;

					crane_move( $crane_hook, $crane_hook_westwheel,$crane_hook_eastwheel, dir, distanceZ, true );
				}

				if(abs(diff_y) > 0)
				{
					dir = SOUTH;
					if(diff_y < 0)
						dir = NORTH;
					
					crane_move( $crane_roller_side, $crane_roller_northwheel,$crane_roller_southwheel, dir, distanceY, true );
				}

				crane_enable_clickers(destinationClicker);
			}			
		}
	}

