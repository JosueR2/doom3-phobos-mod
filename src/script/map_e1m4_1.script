	//===========================================
	// RANDOM MONSTER SPAWNS
	//===========================================		
	
	
	void select_impcrawlconfig()
	{
		float impcrawlselect;

		while (1)
		{
			impcrawlselect = sys.random(15);
		
				if (impcrawlselect <= 5){
					sys.trigger ($impcrawl_config1);
					//sys.println("impcrawl_config1 selected");
					sys.wait(.5);
				} else if (impcrawlselect >= 11){
					sys.trigger ($impcrawl_config2);
					//sys.println("impcrawl_config2 selected");
					sys.wait(.5);
				} 
				  else {
					sys.trigger ($impcrawl_config3);
					//sys.println("impcrawl_config3 selected");
					sys.wait(.5);
				}
		}
	}
	
	void kill_impcrawl_selection()
	{
		sys.killthread ("map_e1m4_1::select_impcrawlconfig");
	}	
	
	void select_monsterconfig(float encounterNum)
	{
		float monsterselect;
		entity monster_config_a = sys.getEntity("monster_config_a" + encounterNum);
		entity monster_config_b = sys.getEntity("monster_config_b" + encounterNum);


		while (1)
		{
			monsterselect = sys.random(15);
		
				if (monsterselect <= 8){
					sys.trigger (monster_config_a);
					//sys.println("monster_configa" + encounterNum + "selected");
					sys.wait(.5);
				} else {
					sys.trigger (monster_config_b);
					//sys.println("monster_configb" + encounterNum + "selected");
					sys.wait(.5);
				} 
		}
	}
	
	void select_monsterconfig1()
	{
		select_monsterconfig(1);
	}		

	void select_monsterconfig2()
	{
		select_monsterconfig(2);
	}				
	
	void kill_monster_selection1()
	{sys.killthread ("map_e1m4_1::select_monsterconfig1");}
	
	void kill_monster_selection2()
	{sys.killthread ("map_e1m4_1::select_monsterconfig2");}
	
	//===========================================
	// END RANDOM MONSTER SPAWNS
	//===========================================
	
