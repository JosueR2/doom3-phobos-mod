	float finding_calloway = 0;
	void FindCalloway()
	{
		if(finding_calloway == 1)
		{
			return;
		}
		finding_calloway = 1;

		// Fade out the background music...
		$PeppershakerMusic.fadeSound (SND_CHANNEL_ANY, -100, 10);

		//...and start the scene specific music
		sys.trigger($SpeakerAdrift4);

		// Fade to black
		sys.fadeTo('0 0 0', 1, .75);

		sys.wait(1);
		
		// Rotate the camera slightly to give it an upsetting angle
		$calloblock_cam_1_mover.time(0.1);
		$calloblock_cam_1_mover.accelTime(0);
		$calloblock_cam_1_mover.decelTime(0);
		$calloblock_cam_1_mover.rotateOnce('0 0 15');

		sys.wait(4);
		
		// Start viewing through the cam (1/DOOR)
		sys.trigger($calloblock_cam_1);

		// Set up the camera so it moves towards the target as the door opens
		$calloblock_cam_1_mover.time(60);
		$calloblock_cam_1_mover.moveTo($calloblock_cam_1_target);

		sys.wait(1);
		
		// Fade in
		sys.fadeTo('0 0 0', 0, .25);
		
		sys.wait(1.5);

		// Change the door light color to the 'unlocked' state and play the dumb little sound
		thread crossFadeEnt ($calloblock_door_frame, '0.64 0.11 0.05', '1 0.823529 0.521569', .25);
		thread crossFadeEnt ($calloblock_door_light, '0.64 0.11 0.05', '1 0.7 0', .25);
		$calloblock_door.startSoundShader("default_door_unlocked", SND_CHANNEL_ANY);
		
		sys.wait(3);

		// Open the door
		$calloblock_door.open();

		sys.wait(3.5);

		// Start moving the camera along the corridor
		$calloblock_cam_2_mover.time(60);
		$calloblock_cam_2_mover.move(0, 128);

		// Switch to the camera (2/HALLWAY)
		sys.trigger($calloblock_cam_2);

		sys.wait(1);

		// Close the door behind us
		$calloblock_door.close();

		sys.wait(7);

		// Show details of the interior, move towards the fan
		$calloblock_cam_3_mover.time(60);
		$calloblock_cam_3_mover.moveTo($calloblock_cam_3_target);

		// Switch to the camera (3/FAN)
		sys.trigger($calloblock_cam_3);

		sys.wait(6);

		// Show the calloway door from the fan perspective
		$calloblock_cam_4_mover.time(60);
		$calloblock_cam_4_mover.moveTo($calloblock_cam_4_target);

		// Switch to the camera (4/CALLODOOR)
		sys.trigger($calloblock_cam_4);

		sys.wait(6);

		// Show the callodoor dead on
		$calloblock_cam_5_mover.time(60);
		$calloblock_cam_5_mover.move(90, 128);

		// Switch to the camera (5/CALLODOOR DEAD ON)
		sys.trigger($calloblock_cam_5);		
		
		$SpeakerAdrift4.fadeSound (SND_CHANNEL_ANY, -100, 50);

		sys.wait(5);

		sys.trigger($SpeakerGloomy);
		$speaker_callo_ambient1.fadeSound (SND_CHANNEL_ANY, -100, 100);
		$speaker_callo_ambient2.fadeSound (SND_CHANNEL_ANY, -100, 100);

		thread ShowSubtitles("Sam", "Samantha...I have bad news...About Calloway.\nHe didn't make it.", 10.5);
		thread CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player1.ogg");

		// Change the door light color to the 'unlocked' state and play the dumb little sound
		thread crossFadeEnt ($calloblock_door_2_frame, '0.64 0.11 0.05', '1 0.823529 0.521569', .25);
		thread crossFadeEnt ($calloblock_door_2_light, '0.64 0.11 0.05', '1 0.7 0', .25);
		$calloblock_door_2.startSoundShader("default_door_unlocked", SND_CHANNEL_ANY);

		sys.wait(3);

		$calloblock_door_2.open();

		sys.wait(6);

		// Show the dead Calloway
		$calloblock_cam_6_mover.time(120);
		$calloblock_cam_6_mover.moveTo($calloblock_cam_6_target);

		// Switch to the camera (6/CALLOBODY)
		sys.trigger($calloblock_cam_6);

		sys.wait(6);

		thread ShowSubtitles("Sam", "Samantha?", 2);
		thread CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player2.ogg");

		sys.wait(2);

		thread ShowSubtitles("Miles", "I hear you.", 2); 
		thread CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles1.ogg");

		// Show the blood coming down from his body
		$calloblock_cam_7_mover.time(12);
		$calloblock_cam_7_mover.rotateOnce('0 0 90');

		// Switch to the camera (7/BLOOD)
		sys.trigger($calloblock_cam_7);

		sys.wait(1);

		thread ShowSubtitles("Sam", "I'm sorry.", 2);
		thread CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player3.ogg");

		sys.wait(5);

		sys.fadeTo('0 0 0', 1, .25);

		sys.wait(.5);
		
		// We change to the "sit cam" in calloway's cell
		sitting = 1;
		sys.trigger($e1m5_6_sam_1);
		thread UpdateCameraAngles3();

		Beat(.5);

		sys.trigger($calloblock_sit_camera);

		Beat(.5);

		sys.fadeTo('0 0 0', 0, .25);

		
		// Finish the conversation

		thread ShowSubtitles("Miles", "He was a good man.", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles2.ogg");

		Beat(3);

		// Ever since you shared his last message, I wanted to find him for you.
		// I guess what Im trying to say is that I understand.
		// [PAUSE]
		// Are you okay?
		thread FinalPlayer4Sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player4.ogg");

		Beat(1);

		// Heh. Well. No.
		// I thought I was better prepared for this, but I guess..not.
		// Its just more...baggage.
		// [LONG PAUSE]
		// (Starting to doubt her own principles)
		// All though it feels so wrong to call him that.
		// [LONG PAUSE]
		// This really leaves you at a d...an impasse.
		thread FinalMiles3Sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles3.ogg");

		Beat(1.25);

		thread ShowSubtitles("Sam", "You as well.", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player5.ogg");

		Beat(0.5);

		thread ShowSubtitles("Miles", "I know what to do.", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles4.ogg");

		Beat(0.75);

		thread ShowSubtitles("Sam", "Receptacle base?", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player6.ogg");

		Beat(1.0);

		thread FinalMiles5sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles5.ogg");

		Beat(1.5);

		thread ShowSubtitles("Sam", "And I'm guessing that door may be one-way?", 2.2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player7.ogg");

		Beat(1.5);

		thread ShowSubtitles("Miles", "It may very well be.", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles6.ogg");

		Beat(0.75);

		thread ShowSubtitles("Sam", "I don't know. Sounds like Russian roulette to me.", 3);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player8.ogg");

		Beat(0.5);

		thread ShowSubtitles("Miles", "Well so be it.", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles7.ogg");

		Beat(1.5);

		thread ShowSubtitles("Sam", "Wait. Can't we reconvene? Figure out a better solution?", 3.5);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player9.ogg");

		Beat(0.75);

		thread FinalMiles8sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles8.ogg");

		Beat(0.5);

		thread ShowSubtitles("Sam", "You can't go! You can't leave me here now!", 3.2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player10.ogg");

		Beat(0.25);
		
		thread ShowSubtitles("Miles", "Get to the surface. You can send out an SOS.\nWe have dropships close by. Maybe they can bring you to safety.", 6.25);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles9.ogg");

		Beat(0.75);

		thread ShowSubtitles("Sam", "But wait...You're my clean slate Samantha.\nYou're all that I have. I get it now.", 8);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player11.ogg");

		Beat(.25);

		thread FinalMiles10Sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles10.ogg");

		Beat(1.25);

		thread ShowSubtitles("Sam", "Are you sure about this?", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player12.ogg");
		
		Beat(0.5);
		
		thread ShowSubtitles("Miles", "Go home, Sam. It's not too late for you.\nGoodbye.", 6);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles11.ogg");
		
		sys.fadeTo('0 0 0', 1, 0);


		$player1.startSoundShader("sound/shav/e1m5_6/what_happened.ogg", SND_CHANNEL_ANY);

		Beat(2.5);
		
		thread ShowSubtitles("Sam", "Wait...What happened to Kaylee?", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player13.ogg");

		sys.wait(1);

		sys.wait($player1.startSoundShader("sound/shav/e1m5_6/sinister.ogg", SND_CHANNEL_ANY));

		//sys.trigger($calloblock_sit_camera);
		Start_Outro();
	}

	void ShowConsequences()
	{
		$player1.showConsequences();
		sys.trigger($speaker_consequences);
	}	

	void MilesTalkStart()
	{
		Beat(5);

		thread ShowSubtitles("Sam", "Samantha?", 2); 
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkStart/Player1.ogg");

		Beat(0.5);

		thread ShowSubtitles("Miles", "I..I need some time.\nI have somewhere to be. Something to do. Sorry.", 8.10);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkStart/Miles1.ogg");
	}

	void MidPlayer1Sub()
	{
		ShowSubtitles("Sam", "Miles, look at it this way.", 1.6);
		ShowSubtitles("Sam", "We haven't found him yet,\nso he may very well be locked inside a cell.", 5);
		ShowSubtitles("Sam", "But wouldn't a locked cell be the safest place to be in a situation like this?\nIt may not be so bad after all.", 6.05);
	}

	void MidMiles5Sub()
	{
		ShowSubtitles("Miles", "I joined the FCE to accomplish two things.\nNo more, no less.", 6.75);
		ShowSubtitles("Miles", "The first thing has been done.", 2.1);
		ShowSubtitles("Miles", "The second was to help Calloway find out the truth about Kaylee.", 5);
	}

	void MilesTalkMid()
	{
		thread MidPlayer1Sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkMid/Player1.ogg");

		Beat(1.5);

		thread ShowSubtitles("Miles", "For someone who was basically born yesterday,\nyou sure know what to say.", 4);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkMid/Miles1.ogg");

		Beat(0.5);

		thread ShowSubtitles("Sam", "Hey, I'm a good person.", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkMid/Player2.ogg");

		Beat(1);

		thread ShowSubtitles("Miles", "I'll miss this you know.", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkMid/Miles2.ogg");

		Beat(.75);

		thread ShowSubtitles("Sam", "I'm not going anywhere.", 2); 
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkMid/Player3.ogg");

		Beat(0.5);

		thread ShowSubtitles("Miles", "I know.", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkMid/Miles3.ogg");

		Beat(0.75);

		thread ShowSubtitles("Sam", "Soo...?", 2); 
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkMid/Player4.ogg");

		Beat(1.0);

		thread ShowSubtitles("Miles", "To be perfectly honest, I'm going to Receptacle base and...\nIt might be a one-way ticket.", 6.2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkMid/Miles4.ogg");

		Beat(0.5);

		thread ShowSubtitles("Sam", "What? The research station?", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkMid/Player5.ogg");

		Beat(0.75);

		thread MidMiles5Sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkMid/Miles5.ogg");

		Beat(0.5);

		thread ShowSubtitles("Sam", "What's the first?", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkMid/Player6.ogg");

		Beat(0.5);

		thread ShowSubtitles("Miles", "The first is burning to a crisp.", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkMid/Miles6.ogg");

		Beat(0.75);

		thread ShowSubtitles("Sam", "Oh...Benson...\nAbout the second...don't do anything rash...", 6.1);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkMid/Player7.ogg");

		Beat(0.65);

		thread ShowSubtitles("Miles", "I won't.\nI will await your findings on Calloway at least.", 4.2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkMid/Miles7.ogg");

		Beat(0.85);

		thread ShowSubtitles("Sam", "Okay well if I can find myself, I can find him.\nI'll get back to you.", 4.2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkMid/Player8.ogg");
	}	

	void script_relay_start()
	{
		if(1)
		{
			sys.trigger($trigger_relay_588);

			sys.wait(5);		

			sys.trigger($SpeakerAdrift16);
		}
	}


	void main()
	{		
		setup_outro();

		sys.trigger($setinfluence_detention);

		thread UpdateTurrets();
		SetupSecurityCameras();
		$TurretLaserTrig.disable();

		
		
		
		sys.wait(5);

		//FindCalloway();
		//Start_Outro();

		/*

		sitting = 1;
		thread UpdateCameraAngles3();		
		sys.trigger($calloblock_sit_camera);
		*/
	}
}