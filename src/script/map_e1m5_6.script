	void FinalPlayer4Sub()
	{
		ShowSubtitles("Sam", "Ever since you shared his last message,\nI wanted to find him for you.", 4.8);
		ShowSubtitles("Sam", "I guess what I'm trying to say is that I understand.", 4.65);
		ShowSubtitles("Sam", "Are you okay?", 2);
	}

	void FinalMiles3Sub()
	{
		ShowSubtitles("Miles", "Heh. Well. No.", 2.9);
		ShowSubtitles("Miles", "I thought I was better prepared for this, but I guess...not\nIt's just more...baggage.", 8.1);
		ShowSubtitles("Miles", "All though it feels so wrong to call him that.\nThis really leaves you at a d...an impasse.", 7.1);
	}

	void FinalMiles5sub()
	{
		ShowSubtitles("Miles", "Calloway has...had a hypothesis about it.", 4.65);
		ShowSubtitles("Miles", "The receptacle is a door of sorts. To somewhere else.\nAnother plane of existence.", 6.28);
		ShowSubtitles("Miles", "It may be a long shot, but everything points towards this realm.\nI think she might be in there.", 7.5);
		ShowSubtitles("Miles", "Either way, it's the last bullet in the chamber.", 4.6);
	}

	void FinalMiles8sub()
	{
		ShowSubtitles("Miles", "You're on Mars. I'm on Phobos.", 4.2);
		ShowSubtitles("Miles", "This is the end of the line. For me, at least.\nI have to do this.", 6);
		ShowSubtitles("Miles", "Look. I don't want to drag you down any further.\n I have put you through enough.", 5.35);
	}

	void FinalMiles10Sub()
	{
		ShowSubtitles("Miles", "Sam.\nIt's done.", 2.8);
		ShowSubtitles("Miles", "If all goes well, I'll see you again.\nIf not...thank you...for everything.", 8.5);
	}	

	void MilesTalkFinal()
	{
		thread ShowSubtitles("Sam", "Samantha...I have bad news...About Calloway.\nHe didn't make it.", 10.5);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player1.ogg");

		Beat(0.5);

		thread ShowSubtitles("Sam", "Samantha?", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player2.ogg");

		Beat(0.5);

		thread ShowSubtitles("Miles", "I hear you.", 2); 
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles1.ogg");

		Beat(0.5);

		thread ShowSubtitles("Sam", "I'm sorry.", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player3.ogg");

		Beat(0.5);

		thread ShowSubtitles("Miles", "He was a good man.", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles2.ogg");

		Beat(0.5);

		thread FinalPlayer4Sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player4.ogg");

		Beat(0.5);

		thread FinalMiles3Sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles3.ogg");

		Beat(0.5);

		thread ShowSubtitles("Sam", "You as well.", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player5.ogg");

		Beat(0.5);

		thread ShowSubtitles("Miles", "I know what to do.", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles4.ogg");

		Beat(0.5);

		thread ShowSubtitles("Sam", "Receptacle base?", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player6.ogg");

		Beat(0.5);

		thread FinalMiles5sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles5.ogg");

		Beat(0.5);

		thread ShowSubtitles("Sam", "And I'm guessing that door may be one-way?", 3);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player7.ogg");

		Beat(0.5);

		thread ShowSubtitles("Miles", "It may very well be.", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles6.ogg");

		Beat(0.5);

		thread ShowSubtitles("Sam", "I don't know. Sounds like Russian roulette to me.", 3);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player8.ogg");

		Beat(0.5);

		thread ShowSubtitles("Miles", "Well so be it.", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles7.ogg");

		Beat(0.5);

		thread ShowSubtitles("Sam", "Wait. Can't we reconvene? Find out a better solution?", 3.5);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player9.ogg");

		Beat(0.5);

		thread FinalMiles8sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles8.ogg");

		Beat(0.5);

		thread ShowSubtitles("Sam", "You can't go! Where do you want me to go?\nTo do? You can't leave me here now!", 6);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player10.ogg");

		Beat(0.5);
		
		thread ShowSubtitles("Miles", "Get to the surface. You can send out an SOS.\nWe have dropships close by. Maybe they can bring you to safety.", 7);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles9.ogg");

		Beat(0.5);

		thread ShowSubtitles("Sam", "But wait...You're my clean slate Samantha.\nYou're all that I have. I get it now.", 9.5);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player11.ogg");

		Beat(0.5);

		thread FinalMiles10Sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles10.ogg");

		Beat(0.5);

		thread ShowSubtitles("Sam", "Are you sure about this?", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player12.ogg");

		Beat(0.5);

		thread ShowSubtitles("Miles", "Go home, Sam. It's not too late for you.\nGoodbye.", 6.5);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Miles11.ogg");

		Beat(0.5);

		thread ShowSubtitles("Sam", "Wait...What happened to Kaylee?", 2);
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_6/MilesTalkFinal/Player13.ogg");
	}

	float sitting = 0;
	void UpdateCameraAngles3()
	{			
