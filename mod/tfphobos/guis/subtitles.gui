windowDef Desktop {
	rect	0 ,0 ,640 ,480 
	backcolor	0 ,0 ,0 ,0 
	visible "gui::subtitle1_visible"
	float "sub_scale" 0.275

	editDef SizeSync
	{
		rect 0, 0, 0, 0
		visible 1
		noevents 1
		cvar "g_subSize"
		liveUpdate 1
		text "gui::sub_scale"
	}
	
	windowDef Subtitles
	{						
		rect 0, 355, 640, 125
		backcolor 0, 0, 0, .5
		visible 1

		windowDef Name
		{
			rect 0, 3, 640, 22
			forecolor 1, .5, .25, 1
			text "gui::subtitle1_name"
			textalign 1
			textscale "gui::sub_scale"
			shadow 1
			font "fonts/an"
		}

		windowDef Text
		{	
			rect 0, 26, 640, 95
			forecolor .5, .75, 1, 1		
			text "gui::subtitle1_text"
			textalign 1
			textscale "gui::sub_scale"
			shadow 1
			font "fonts/an"
		}
	}
}
