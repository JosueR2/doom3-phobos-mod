	vector offColor = '0 0 0';
	vector onColor = '0.1 0.38 0.47';
	vector white = '1 1 1';
	
	void LightFlicker()
	{
		sys.trigger($fusebox_emitter);
		sys.trigger($fusebox_light);
		thread Intro_CharacterSays($player1, "e1m3_1_fuseblow");		
		
		thread crossFadeEnt ($intro_blue_light_1, onColor, offColor, .0625);
		thread crossFadeEnt ($intro_blue_light_bulb_1, white, offColor, .0625);
		$intro_blue_light_flare_1.hide();
		
		thread crossFadeEnt ($intro_blue_light_2, onColor, offColor, .0625);
		thread crossFadeEnt ($intro_blue_light_bulb_2, white, offColor , .0625);
		$intro_blue_light_flare_2.hide();
		
		thread crossFadeEnt ($intro_blue_light_3, onColor, offColor, .0625);
		thread crossFadeEnt ($intro_blue_light_4, onColor, offColor, .0625);
		thread crossFadeEnt ($intro_blue_light_bulb_3, white, offColor, .0625);
		$intro_blue_light_flare_3.hide();
		
		thread crossFadeEnt ($intro_blue_light_5, onColor, offColor, .0625);
		thread crossFadeEnt ($intro_blue_light_6, onColor, offColor, .0625);
		thread crossFadeEnt ($intro_blue_light_6_ambient, onColor, offColor, .0625);
		thread crossFadeEnt ($intro_blue_light_bulb_4, white, offColor, .0625);
		$intro_blue_light_flare_4.hide();
		
		thread crossFadeEnt ($intro_blue_light_7, onColor, offColor, .0625);
		thread crossFadeEnt ($intro_blue_light_8, onColor, offColor, .0625);
		thread crossFadeEnt ($intro_blue_light_8_ambient, onColor, offColor, .0625);
		thread crossFadeEnt ($intro_blue_light_bulb_5, white, offColor, .0625);
		$intro_blue_light_flare_5.hide();
			
		$item_fuse_door.setKey("click_item", 1);

		sys.wait(.125);

		sys.trigger($fusebox_emitter);
		sys.trigger($fusebox_light);

		sys.wait(.125);		
		
		sys.wait(2.5);
		
		thread ShowNPCSubtitles("Lee", "What hap....ugh", 2);
		Intro_CharacterSays($LeeAtticSpeaker, "e1m3_1_intro_Lee16_1");
		
		sys.wait(.5);
		
		thread ShowNPCSubtitles("Lee", "What happened?", 2);
		Intro_CharacterSays($player1, "e1m3_1_intro_Lee16_2");
		Intro_CharacterSays($player1, "e1m3_1_walkie_beep");
		
		sys.wait(.75);
		
		thread ShowNPCSubtitles("Sam", "I think I broke a fuse. I'll look for another.", 3);
		Intro_CharacterSays($player1, "e1m3_1_intro_Player18_1");

		sys.wait(.75);
		
		thread ShowNPCSubtitles("Lee", "Bleep bloop.", 2);
		Intro_CharacterSays($player1, "e1m3_1_intro_Lee16_3");
		Intro_CharacterSays($player1, "e1m3_1_walkie_beep");
		
		sys.wait(2);

		sys.trigger($speaker_intro_generator);
		thread Intro_CharacterSays($player1, "e1m3_1_generator_end");
		sys.trigger($func_shaking_intro_generator);
	}
	
	void LightFlickerTwo()
	{
		Beat(1.5);
	
		thread ShowNPCSubtitles("Sam", "Hey Lee. Got the fuse.\nBut I think the generator was running on fumes.", 4);
		Intro_CharacterSays($player1, "e1m3_1_intro_Player19");
		
		Beat(1);
		
		thread ShowNPCSubtitles("Lee", "Give me a second. There might be some up here.", 2);
		Intro_CharacterSays($player1, "e1m3_1_intro_Lee17");
		Intro_CharacterSays($player1, "e1m3_1_walkie_beep");

		$LeeStepSpeaker.startSoundShader("e1m3_1_Leestep3", SND_CHANNEL_ANY);
		
		Beat(4);
		
		thread ShowNPCSubtitles("Lee", "Bombs away!", 2);
		Intro_CharacterSays($LeeAtticSpeaker, "e1m3_1_intro_Lee14");
		
		sys.wait(1);
		
		sys.trigger($gascan_moveable);
		
		sys.wait(1.5);
		
		thread ShowNPCSubtitles("Sam", "Hey watch out will you?!", 4);
		Intro_CharacterSays($player1, "e1m3_1_intro_Player20");
		
		sys.wait(.5);
		
		$gascan_moveable.setKey("click_item", 1);
		
		thread ShowNPCSubtitles("Lee", "Sorry!\nSee if that has enough to hold us for a while.", 4);
		Intro_CharacterSays($LeeAtticSpeaker, "e1m3_1_intro_Lee18");
	}
	
