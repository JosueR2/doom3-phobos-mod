	float bomb_cam_updating = 1;

	void Update_Bomb_Cam2(entity camcam, entity lookat_1, entity lookat_2, float fov_from, float fov_to, float total_time)
	{
		bomb_cam_updating = 1;

		float now = sys.getTime();
		float then = now + total_time;
				
		float fov_travel = fov_to - fov_from;

		float tsec = 1.0 / total_time;

		while(bomb_cam_updating)
		{
			now = sys.getTime();

			if(now >= then)
			{
				//camcam.setAngles(final_angles);
				camcam.setKey("fov", fov_to);
				
				bomb_cam_updating = 0;
				
				break;
			}

			float t = (total_time - (then - now)) * tsec;

			t = EaseInOutCubic(t);

			vector new_angles = lookat_1.getOrigin() - camcam.getWorldOrigin();
			new_angles = sys.vecNormalize(new_angles);

			vector look_at_body = lookat_2.getOrigin() - camcam.getWorldOrigin();
			look_at_body = sys.vecNormalize(look_at_body);

			vector gogo = (look_at_body * t) + (new_angles * (1-t));

			$outro_camera_bomb.setAngles(sys.VecToAngles(gogo));
			$outro_camera_bomb.setKey("fov", fov_from + fov_travel * t);
			
			sys.waitFrame();
		}
	}

	void Do_Box_End()
	{
		sys.wait(2);

		$player1.startSoundShader("sound/shav/e1m5_6/boxrot0.ogg", SND_CHANNEL_ANY);

		float i = 0;
		while(i++ < 10)
		{
			$outro_boxybox_shakeweight_mover.rotateOnce('0 0 1');
			sys.waitFor($outro_boxybox_shakeweight_mover);
			$outro_boxybox_shakeweight_mover.rotateOnce('0 0 -1');
			sys.waitFor($outro_boxybox_shakeweight_mover);
		}

		sys.wait(1);

		$speakeradrift21.fadeSound (SND_CHANNEL_ANY, -100, 10);
		$player1.startSoundShader("sound/shav/e1m1/wineglass.ogg", SND_CHANNEL_ANY);


		sys.wait(.5);

		thread crossFadeEnt ($outro_boxybox, '0 0.4 1', '.75 0 0', 2.0);
		thread crossFadeEnt ($outro_boxybox_portal, '0 0.4 1', '.75 0 0', 2.0);
		thread crossFadeEnt ($outro_boxybox_light1, '0 0 0', '1 .5 .5', 2.0);
		thread crossFadeEnt ($outro_boxybox_light2, '0 0 0', '1 1 1', 2.0);

		sys.wait(1);		

		sys.wait(.5);		

		$player1.startSoundShader("sound/shav/e1m4/boxchange.ogg", SND_CHANNEL_ANY);

		sys.wait(.5);

		i = 0;

		$player1.startSoundShader("sound/shav/e1m5_6/boxrot.ogg", SND_CHANNEL_ANY);

		while(i++ < 5)
		{
			$outro_boxybox_shakeweight_mover.rotateOnce('0 0 1');
			sys.waitFor($outro_boxybox_shakeweight_mover);
			$outro_boxybox_shakeweight_mover.rotateOnce('0 0 -1');
			sys.waitFor($outro_boxybox_shakeweight_mover);
		}
		
		$outro_boxybox_mover.rotateOnce('0 83 0');

		while(i++ < 15)
		{
			$outro_boxybox_shakeweight_mover.rotateOnce('0 0 1');
			sys.waitFor($outro_boxybox_shakeweight_mover);
			$outro_boxybox_shakeweight_mover.rotateOnce('0 0 -1');
			sys.waitFor($outro_boxybox_shakeweight_mover);
		}


		i = 0;

		while(i++ < 30)
		{
			$outro_boxybox_shakeweight_mover.rotateOnce('0 0 2');
			sys.waitFor($outro_boxybox_shakeweight_mover);
			$outro_boxybox_shakeweight_mover.rotateOnce('0 0 -2');
			sys.waitFor($outro_boxybox_shakeweight_mover);
		}

		sys.wait(.5);

		thread crossFadeEnt ($outro_boxybox_beam, '0 0 0', '.3 .5 .9', .25);
		thread crossFadeEnt ($outro_boxybox_light1, '1 .5 .5', '0 0 0', .25);
		thread crossFadeEnt ($outro_boxybox_light2, '1 1 1', '0 0 0', .25);

		$outro_boxybox_portal.hide();		

		sys.wait(1.5);

		sys.trigger($speaker_outro_fable);
		$SpeakerBombGoesOff.fadeSound (SND_CHANNEL_ANY, -100, 10);
		
		Beat(.5);
		
		$outro_camera_bomb_mover.accelTime(.125);
		$outro_camera_bomb_mover.time(.75);
		$outro_camera_bomb_mover.decelTime(0);
		$outro_camera_bomb_mover.move(180, 30);

		sys.wait(.75);
		
		sys.fadeTo('0 0 0', 1, .125);
		
		sys.wait(.2);

		sys.trigger($outro_camera_freetext);

		sys.wait(1);

		showText("To be concluded...");

		sys.wait(2);

		sys.trigger($speaker_outro_fable2);

		//sys.waitFor($outro_camera_box_mover);

		//sys.wait(5.5);
	}

	void Update_Bomb_Cam(vector angles_from, vector angles_to, float fov_from, float fov_to, float total_time)
	{
		//sys.println(angles_from + " -> " + angles_to);
		//sys.println(fov_from + " -> " + fov_to);

		bomb_cam_updating = 1;
		vector final_angles = angles_to;
		vector initial_angles = angles_from;			

		vector travel = final_angles;// - initial_angles;
		
		float now = sys.getTime();
		float then = now + total_time;
				
		float fov_travel = fov_to - fov_from;

		float tsec = 1.0 / total_time;

		while(bomb_cam_updating)
		{
			now = sys.getTime();

			if(now >= then)
			{
				$outro_camera_bomb.setAngles(final_angles);
				$outro_camera_bomb.setKey("fov", fov_to);
				
				bomb_cam_updating = 0;
				
				break;
			}

			float t = (total_time - (then - now)) * tsec;

			t = EaseInOutCubic(t);

			vector new_angles = initial_angles + travel * t;

			new_angles = $outro_camera_bomb_target.getOrigin() - $outro_camera_bomb.getWorldOrigin();
			new_angles = sys.vecNormalize(new_angles);

			vector look_at_body = $bomb_lee_body_angledummy_target.getOrigin() - $outro_camera_bomb.getWorldOrigin();
			look_at_body = sys.vecNormalize(look_at_body);

			vector gogo = (look_at_body * t) + (new_angles * (1-t));

			$outro_camera_bomb.setAngles(sys.VecToAngles(gogo));
			$outro_camera_bomb.setKey("fov", fov_from + fov_travel * t);

			//sys.println("Time<" + t + "> Angles -> " + (initial_angles + travel * t));

			sys.waitFrame();
		}
	}

