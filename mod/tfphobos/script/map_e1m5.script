	void InspectTrainLetter()
	{
		$curtian_sepia_decal.hide();
		$motel_curtains.hide();
		$motel_curtains_off.show();

		thread Lee14Subs();
		float time_to_wait = CharacterSays_NoWait($player1, "sound/vo/e1m5/motelcloset/lee14.ogg");

		sys.wait(12);

		sys.trigger($SpeakerHorn2);

		sys.wait(time_to_wait - 12);

		sys.wait(0.25);
		
		$camera_outside_mover.moveTo($camera_outside_target);
		sys.trigger($portal_valley);
		sys.trigger($camera_outside);
		sys.wait(0.25);

		thread Lee15Subs();
		CharacterSays($player1, "sound/vo/e1m5/motelcloset/lee15.ogg");
		sys.wait(0.25);

		trainSequenceState = 0;

		sys.trigger($camera_box_key_portal);
		
		thread Update_Key_Cam_Portal();
		sys.trigger($camera_box_key);
		$camera_box_key_mover.moveTo($camera_box_key_target);
		sys.wait(0.25);

		thread Lee16Subs();
		CharacterSays($player1, "sound/vo/e1m5/motelcloset/lee16.ogg");
		$camera_box_key_portal_mover.move(UP, 64);
		sys.wait(0.25);		

		$player1.startSoundShader("sound/shav/e1m4_4/foop.ogg", SND_CHANNEL_ANY);

		thread Lee161Subs();		
		CharacterSays($player1, "sound/vo/e1m5/motelcloset/lee16_1.ogg");
		sys.wait(0.25);		

		$player1.startSoundShader("sound/shav/e1m5/thunder01.ogg", SND_CHANNEL_ANY);
		
		sys.trigger($outside_barn_cam);
		$outside_barn_mover.move(DOWN, 128);
		
		sys.wait(0.25);

		thread BarnLightningSession();

		thread Lee162Subs();
		float line_time = CharacterSays_NoWait($player1, "sound/vo/e1m5/motelcloset/lee16_2.ogg");
		sys.wait(9);
		line_time -= 9;
		
		$camera_barn_workstation_mover.moveTo($camera_barn_workstation_target);
		sys.trigger($camera_barn_workstation);

		sys.wait(line_time + 0.25);

		sys.trigger($camera_barn_map);
		$camera_barn_map_mover.moveTo($camera_barn_map_target);		

		thread Lee17Subs();
		CharacterSays($player1, "sound/vo/e1m5/motelcloset/lee17.ogg");
		sys.wait(0.25);

		update_key_cam_portal = 0;

		GoToBed();
	}

