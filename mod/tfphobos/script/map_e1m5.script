	#define	RC_EAST		2
	#define RC_SOUTH	4
	#define	RC_WEST		8

	#define SEWERS_DRAINS_STATE_NONE 0
	#define SEWERS_DRAINS_STATE_A1 1
	#define SEWERS_DRAINS_STATE_A2 2
	#define SEWERS_DRAINS_STATE_A3 3
	
	#define SEWERS_A1_BRIDGE_SECONDWING 2
	#define SEWERS_A2_BRIDGE_SECONDWING 2
	#define SEWERS_A3_BRIDGE_SECONDWING 4
	#define SEWERS_A1_ROOM 1
	#define SEWERS_A2_ROOM 2
	#define SEWERS_A3_ROOM 3
	
