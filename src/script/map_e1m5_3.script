	void activate_crushers()
	{
		float crusherselect;

		while (1)
		{
			crusherselect = sys.random(20);
		
				if (crusherselect <= 5){
					sys.trigger ($crusher1_relay);
					sys.wait(.5);
				} else if (crusherselect <= 10){
					sys.trigger ($crusher2_relay);
					sys.wait(.5);
				} 
				else if (crusherselect <= 15){
					sys.trigger ($crusher3_relay);
					sys.wait(.5);
				} 
				 else {
					sys.trigger ($crusher4_relay);
					sys.wait(.5);
				}
		}
	}	
		
		
void StartCrusher_NB(float crusherNumNB)
	{	
		entity crusher = sys.getEntity("crusher" + crusherNumNB);
		entity crusherlift = sys.getEntity("crusherlift" + crusherNumNB);
		entity crusher_poundspkr = sys.getEntity("crusher" + crusherNumNB + "_poundspkr");
		entity crusher_spkrdown = sys.getEntity("crusher" + crusherNumNB + "_spkrdown");
		entity crusher_spkrup = sys.getEntity("crusher" + crusherNumNB + "_spkrup");
		entity klaxon_relay = sys.getEntity("crusher" + crusherNumNB + "_klaxon_relay");
		
		float crusherRaised = crusher.getFloatKey("crusherRaised");
		
		if( crusherRaised == 1)
		{
		
			crusher.setKey("crusherRaised", 0);
		
			crusher.time(.85);
			crusher.decelTime(0);
			crusher.accelTime(.25);
			sys.trigger(klaxon_relay);
			sys.wait(.5);
			sys.trigger(crusher_spkrdown);
			crusher.move(DOWN, 264);
			sys.waitFor(crusher);
			sys.trigger(crusher_poundspkr);
			sys.wait(.5);
			crusher.time(5);
			crusher.decelTime(1);
			crusher.accelTime(.5);
			sys.trigger(crusher_spkrup);
			crusher.move(UP, 264);
			sys.wait(2);
			sys.trigger(klaxon_relay);
			sys.wait(2);
			sys.waitFor(crusher);
			crusher.setKey("crusherRaised", 1);
		}
			else if( crusherRaised == 0 && debug){sys.println("crusher " + crusherNumNB + " is not ready!");}
	}
	
