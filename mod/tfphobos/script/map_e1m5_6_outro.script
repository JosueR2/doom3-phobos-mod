	void Do_Bump_Trunk(float strength)
	{
		float cam_strength = strength * 0.2;

		$benson_trunk_mover.move(DOWN, 3 * strength);
		$outro_camera_trunk_mover_bumper.move(DOWN, 3 * cam_strength);

		sys.waitFor($benson_trunk_mover);
		
		$benson_trunk_mover.move(UP, 6* strength);
		$outro_camera_trunk_mover_bumper.move(UP, 6 * cam_strength);

		sys.waitFor($benson_trunk_mover);

		$benson_trunk_mover.move(DOWN, 5* strength);
		$outro_camera_trunk_mover_bumper.move(DOWN, 5 * cam_strength);

		sys.waitFor($benson_trunk_mover);
		
		$benson_trunk_mover.move(UP, 4* strength);
		$outro_camera_trunk_mover_bumper.move(UP, 4 * cam_strength);

		sys.waitFor($benson_trunk_mover);

		$benson_trunk_mover.move(DOWN, 3* strength);
		$outro_camera_trunk_mover_bumper.move(DOWN, 3 * cam_strength);

		sys.waitFor($benson_trunk_mover);
		
		$benson_trunk_mover.move(UP, 1* strength);
		$outro_camera_trunk_mover_bumper.move(UP, 1 * cam_strength);

		sys.waitFor($benson_trunk_mover);
	}

	void Bump_Trunk(float total_time)
	{
		float now = sys.getTime();
		float then = now + total_time;
		
		float random_variance = .4f;
		float random_floor = 0.1f;

		while(sys.getTime() < then)
		{
			float r = sys.random(random_variance) + random_floor;
			float strength = sys.random(0.2f) + 0.01f;
			sys.wait(r);

			Do_Bump_Trunk(strength);
		}
	}
		
	void Call_Lee()
	{
		// Fade out the music, the sirens and the crickets
		$SpeakerThatsNotRight.fadeSound (SND_CHANNEL_ANY, -100, 10);
		$SpeakerValleyDefense.fadeSound (SND_CHANNEL_ANY, -100, 10);
		$SpeakerCrickets.fadeSound (SND_CHANNEL_ANY, -100, 10);
		
		//Lee_Diary_Scene();

		if(1)
		{
			//sys.fadeTo('0 0 0', 1, 0);			

			sys.trigger($speaker_the_end_is_near);
			
			sys.trigger($outro_camera_freetext);

			sys.wait(1);

			showText("Earlier that night.");

			sys.wait(3);

			thread TweakClouds('0 0 0', 1);
			
			sys.trigger($benson_camera_road_top);
			sys.fadeTo('0 0 0', 0, 3);		
			
			$benson_camera_road_top_mover.move(90, 6608);

			sys.wait(12);

			thread TweakClouds('1 1 1', 0);

			sys.wait(12);

			thread TweakClouds('1 1 1', 0);

			sys.wait(12.35);

			$benson_sky_camera_mover.move(90, 6608);
			sys.trigger($benson_sky_camera);

			sys.wait(12.0);

			$benson_camera_trunk_down_mover.rotateOnce('0 35 0');
			sys.trigger($benson_camera_trunk_down);

			sys.wait(12.0);
			
			$benson_camera_trunk_mover.move(180, 32);
			sys.trigger($benson_camera_trunk);
			/*
			thread Bump_Trunk(30.0);

			sys.wait(12.0);

			Outro_ShowTrunkCamera(12.0);*/
		}
		
		$benson_barn_car_light_rotator.time(10);
		$benson_barn_car_light_rotator.accelTime(2);
		$benson_barn_car_light_rotator.decelTime(2);
		$benson_barn_camera_mover.move(90, 192);
		sys.trigger($benson_barn_camera);

		sys.wait(6.0);
		
		thread UpdateBensonBarnCamera(100, 45);
		
		thread crossFadeEnt($benson_barn_car_light_1, '0.18 0.17 0.11', '0.729412 0.698039 0.458824',9);
		thread crossFadeEnt($benson_barn_car_light_2, '0.18 0.17 0.11', '0.729412 0.698039 0.458824',9);

		sys.wait(4);
		
		$player1.startSoundShader("sound/shav/e1m5_6/CarApproaching.ogg", SND_CHANNEL_ANY);

		$benson_barn_car_light_rotator.rotateOnce('0 -180 0');

		sys.wait(14.0);

		float get_outta_car_time = $player1.startSoundShader("sound/shav/e1m5_6/GettingOutOfCar.ogg", SND_CHANNEL_ANY);

		$benson_barn_camera_2_mover.moveTo($benson_barn_camera_2_target);
		sys.trigger($benson_barn_camera_2);
		
		sys.wait(get_outta_car_time - .1);

		Outro_ShowTrunkCamera2(10);

		$benson_barn_camera_10_mover.move(90, 256);	
		sys.trigger($benson_barn_camera_10);

		sys.wait(7);

		//sys.trigger($speaker_before_the_light);

		$benson_barn_camera_11_mover.moveTo($benson_barn_camera_11_target);
		sys.trigger($benson_barn_camera_11);

		sys.wait(7);
		$player1.startSoundShader("sound/shav/e1m5_6/DraggingBody.ogg", SND_CHANNEL_ANY);

		sys.wait(14);		

		// start the new music
		sys.trigger($speakeradrift21);

		//Outro_ShowBombCamera(5);

		$benson_barn_camera_3_mover.moveTo($benson_barn_camera_3_target);
		sys.trigger($benson_barn_camera_3);

		sys.wait(3);

		$benson_barn_door.startSoundShader("sound/shav/e1m5_6/OpenBarnDoor.ogg", SND_CHANNEL_ANY);
		$benson_barn_door.move(0, 80);

		sys.wait(2);

		$player1.startSoundShader("sound/shav/e1m5_6/dragbody2.ogg", SND_CHANNEL_ANY);

		sys.wait(10.0);

		$bomb.hide();		

		Outro_ShowLadderCamera(8);

		Outro_ShowTopTopSkatCamera(8);
		
		Outro_ShowBodybagCamera(8);

		Outro_ShowGasBlur(10);
		
		Outro_ShowCarpetCamera(20);
		
		Outro_ShowWalkieTalkieCamera(5);

		Outro_ShowOutsideAgain(5);

		Outro_ShowLeeBox(10);

		Outro_ShowWheel(10);

		Outro_ShowBensonLeave(10);
		
		Outro_ShowBombCamera(5);
		
		//Outro_ShowBoxCamera(5);
		
		Outro_ShowBarnBurnCamera(5);

		return;

		$player1.startSoundShader("sound/shav/e1m1/doorknobopen.ogg", SND_CHANNEL_ANY);
	}

	float sam_camera_updating = 1;
	void Update_Sam_Camera(vector angles_from, vector angles_to, float fov_from, float fov_to)
	{
		sam_camera_updating = 1;
		vector final_angles = angles_to;
		vector initial_angles = angles_from;			

		vector travel = final_angles - initial_angles;			

		float total_time = 6.0;
		float now = sys.getTime();
		float then = now + total_time;
				
		float fov_travel = fov_to - fov_from;

		float tsec = 1.0 / total_time;

		while(sam_camera_updating)
		{
			now = sys.getTime();

			if(now >= then)
			{
				$sam_door_cam_mover.setAngles(final_angles);
				$sam_door_cam.setKey("fov", fov_to);	
				
				sam_camera_updating = 0;
				
				break;
			}

			float t = (total_time - (then - now)) * tsec;

			t = EaseInOutCubic(t);

			$sam_door_cam_mover.setAngles(initial_angles + travel * t);

			$sam_door_cam.setKey("fov", fov_from + fov_travel * t);

			sys.waitFrame();
		}
	}

	void OpenRoomDoor()
	{
		float height_offset = $player1.getEyeHeight();
		vector origin = $player1.getWorldOrigin() + '0 0 1' * height_offset;
		vector angles = $player1.getViewAngles();

		$sam_door_cam_mover.setWorldOrigin(origin);
		$sam_door_cam_mover.setAngles(angles);

		$sam_door_cam.setKey("fov", 90);
		sys.trigger($sam_door_cam);

		$outro_door_out_handle.startSoundShader("e1m1_doorknobopen", SND_CHANNEL_ANY);
		$outro_door_out_handle.rotateOnce('0 0 -30');
		
		$outro_door_out_mover.rotateOnce('0 75 0');
		$outro_door_out_handle.startSoundShader("e1m4_3_door_creak_2", SND_CHANNEL_ANY);

		sys.wait(.75);
		$player1.startSoundShader("e1m4_3_ALargerWorld", SND_CHANNEL_ANY);
		sys.wait(.25);

		$outro_door_out_handle.rotateOnce('0 0 30');

		sys.wait(3);

		// TODO: Get actual fov
		thread Update_Sam_Camera($player1.getViewAngles(), $sam_door_cam_angles.getAngles(), 90, 45);

		vector destination = $sam_door_cam_heighter.getWorldOrigin() + ($sam_door_cam_target_0.getWorldOrigin() - origin);

		$sam_door_cam_heighter.moveToPos(destination);
		
		sys.waitFor($sam_door_cam_heighter);
		sys.wait(1);
		
		$sam_door_cam_mover.move(0, 96);
		sys.fadeFromTo('0 0 0', 0, '0 0 0', 1, 2);
		
		sys.waitFor($sam_door_cam_mover);

		sys.wait(1);		
			
		Call_Lee();
	}

	void setup_outro()
	{
		$outro_phone_room_mover.rotateOnce('0 -14 0');
		$benson_barn_car_light_rotator.rotateOnce('0 180 0');
	}
	
