	void StartPumps()
	{
		if( pumps == 0 )
		{
			pumps = 1;
			
			sys.quickSave("The Beginning of The End - Checkpoint 5");
			sys.wait(0.25);
			
			$pumproom_switch.rotateOnce('0 0 -90');
			pumpSpeakers();
			sys.wait(0.5);
			sys.trigger($speaker_1003);
			sys.trigger($commando_relay);
			sys.wait(4);

			while(1)
			{
				$pumproom_pump02.move(270, 56);
				sys.wait(0.25);
				$pumproom_pump03.move(270, 56);
				sys.wait(0.25);
				$pumproom_pump01.move(90, 56);
				sys.wait(0.25);
				$pumproom_pump04.move(90, 56);

				sys.waitFor($pumproom_pump02);

				$pumproom_pump02.move(90, 56);
				sys.wait(0.25);
				$pumproom_pump03.move(90, 56);
				sys.wait(0.25);
				$pumproom_pump01.move(270, 56);
				sys.wait(0.25);
				$pumproom_pump04.move(270, 56);
				sys.wait(0.25);

				sys.waitFor($pumproom_pump02);
			}
		}
	}
	
	float m4lockdownstate = 0;
	float WhereIsTheFireReaction_State = 0;

	void CloseM4Lockdown()
	{
		sys.trigger($trigger_once_363);

		fuckydoorstate = 1;
		sys.trigger($bulkhead_portal);

		ClickCacheButton(sys.getEntity("LockdownDoor2_Clicker"));

		$m4lockdowndoor.close();
		m4lockdownstate = 1;
		
		sys.trigger($postlockdown_relay);
		
		sys.wait(3.5);
		
		thread ShowNPCSubtitles("PA", "Fire contained.", 2);
		sys.trigger($speaker_1002);
		
		sys.trigger($comm_beep);
		
		$Comm_Holder.setKey("click_item", 1);
		
		if(WhereIsTheFireReaction_State == 1)
		{
			sys.trigger($item_objective_4);
		}
		
		$exit_cache_window_shutter_1.move (90, 92);
		
		sys.wait(.75);
		
		$exit_cache_window_shutter_2.move (270, 92);
	}	
	
	void OpenLockdownDoor()
	{
		$LockDownDoor1Clicker.setKey("click_item", "0");
		ClickCacheButton(sys.getEntity("LockdownDoor1_Clicker"));

		if( m4lockdownstate == 1 )
		{
			$lockdowndoor1.open();
			sys.wait(1.5);
			$lockdowndoor2.open();
			sys.trigger($func_door_2034);
			sys.trigger($func_static_100016);
			sys.trigger($func_static_83244);
			sys.trigger($target_entity_setcolor_4);
		}
		else
		{
			thread ShowNPCSubtitles("PA", "Unable to lift lockdown. Fire not contained.\nPlease contain fire.", 7.15);
			sys.wait($player1.startSoundShader("fire_not_contained", SND_CHANNEL_VOICE2 ));
			sys.wait(1);
			$LockDownDoor1Clicker.setKey("click_item", "1");
			
			if(WhereIsTheFireReaction_State == 0)
			{
				thread ShowNPCSubtitles("Sam", "Where is the fire?", 2);
				$player1.startSoundShader("where_is_fire", SND_CHANNEL_VOICE2);			
				WhereIsTheFireReaction_State = 1;
				
				sys.wait(3);
				
				sys.trigger($item_objective_3);
			}
		}
	}

	void DisengageLockdown()
	{
		$lockdown_handle.rotateOnce('90 0 0');
		$lockdown_handle.startSoundShader("one_shot_electrical_switch_heavy_1", SND_CHANNEL_ANY);

		$lockdowndoor3.open();
		$lockdowndoor5.open();		
		$lockdowndoor7.open();		
		$lockdowndoor9.open();

		sys.wait(2.75);

		sys.trigger($light_59217);
		sys.trigger($light_59220);
		sys.trigger($light_59214);
		sys.trigger($light_59215);
		
		thread ShowNPCSubtitles("PA", "Lockdown lifted.", 2);
		sys.trigger($speaker_1001);

		sys.wait(1.5);

		$lockdowndoor4.open();
		$lockdowndoor6.open();
		$lockdowndoor8.open();
		$lockdowndoor10.open();
		sys.trigger($target_entity_setcolor_5);
		sys.trigger($func_static_100018);
		sys.trigger($func_static_83248);

		sys.trigger($trigger_relay_486);
	}

	void EasterIsHere()
	{
		$lost_secret_player_clip.show();
	
		sys.trigger($lost_spkr3);

		sys.wait(.5);
		$lockdowndoor9.close();
		sys.wait(1.5);
		
		$lockdowndoor10.close();
		
		sys.waitFor($lockdowndoor10);

		sys.wait(1);

		sys.trigger($lostrelay);

		sys.trigger($lostmap);
		sys.trigger($lost_spkr);
		sys.trigger($lost_spkr2);

		sys.wait(9);

		sys.trigger($lostrelay);
		sys.trigger($lostmap);
		sys.trigger($target_entity_setcolor_3);
		sys.trigger($lost_spkr2);

		sys.wait(2);

		sys.trigger($lost_spkr4);

		$lockdowndoor10.open();
		sys.wait(1.5);
		$lockdowndoor9.open();
		
		$lost_secret_player_clip.hide();
	}
	
