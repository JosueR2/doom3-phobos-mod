	float hideSubTime = 0;

	void SubtitlesRunning()
	{
		while(hideSubTime > sys.getTime())
		{			
			sys.waitFrame();
		}
		sys.hideSubtitles();
	}

	void ShowSubtitles(string name, string titles, float duration)
	{
		PhobosShowSubtitle_e1m5_4(name, titles);
		hideSubTime = sys.getTime() + duration;
		sys.wait(duration);
		if(hideSubTime <= sys.getTime())
		{
			sys.hideSubtitles();
		}
		else
		{
			thread SubtitlesRunning();
		}
	}

	
	

	float Beat(float delay)
	{
		sys.wait(delay);
		return delay;
	}	

	void Miles4Subs()
	{
		ShowSubtitles("Miles", "I don't know you.\nAnd I don't even know if Calloway knows you.", 4.5);
		ShowSubtitles("Miles", "I...I was...I had to do something important and I...\nI couldn't...", 8.5);
		ShowSubtitles("Miles", "I wanted to make sure Calloway was okay...\nAnd then you came along. No memory. Nowhere to go.", 9.5);
	}

	void Player5Subs()
	{
		ShowSubtitles("Sam", "Wait. So you lied to me and sent me on a wild goose chase because you had better things to do?", 7);
		ShowSubtitles("Sam", "Oh, no, right. There were higher ups. Probably forced you at gunpoint, right?", 5);
	}

	void Miles6Subs()
	{
		ShowSubtitles("Miles", "But where else were you going to go?", 2);
		ShowSubtitles("Miles", "You show up in a federal uniform.", 2);
		ShowSubtitles("Miles", "Naturally you would have the best chances of finding your identity at the Bulwark.", 5.25);
		ShowSubtitles("Miles", "So I sent you on your way.", 2.5);
	}

	void Miles7Subs()
	{
		ShowSubtitles("Miles", "But that was after we met and at the time,\nthe only evacuation that took place was far from you.", 6);
		ShowSubtitles("Miles", "I even tried to arrange for transportation to the Bulwark.\nThe shuttle, remember?", 4.5);
	}

	void Miles8Subs()
	{
		ShowSubtitles("Miles", "I'm sorry I lied. I really wish I hadn't.", 2.5);
		ShowSubtitles("Miles", "But in the end I still think we did the right thing; Getting you to safety.", 3.75);
		ShowSubtitles("Miles", "Even if it turned out not to be so safe after all.", 5);
		ShowSubtitles("Miles", "There are no safe places right now.", 3);
		ShowSubtitles("Miles", "I don't know what to say.", 3.5);
		ShowSubtitles("Miles", "Please say something.", 3);
	}

	void Miles5Subs()
	{
		ShowSubtitles("Miles", "No...no higher ups.\nNo orders. No mission.", 5);
		ShowSubtitles("Miles", "There are some things I need to do.\nSomething that can't be put off.", 5);
	}

	void Player6Subs()
	{
		ShowSubtitles("Sam", "Ah well that only kind of makes it worse.", 3);
		ShowSubtitles("Sam", "So you lied of your own volition and sent me through what can only be described as...as...", 4);
	}

	float miles_called = 0;
	void StartMilesCall()
	{
		if(miles_called == 1)
		{
			return;
		}
		
		miles_called = 1;

		$func_static_108752.setKey("gui_noninteractive", 1);

		sys.trigger($setinfluence_talk);
		$func_static_108752.startSoundShader("sound/shav/e1m5_4/ethanrom.ogg", SND_CHANNEL_ANY);
		$player1.startSoundShader("sound/shav/e1m5_4/lies.ogg", SND_CHANNEL_ANY);

		$speaker_157.fadeSound(SND_CHANNEL_ANY, -20, 10);
		$speaker_154.fadeSound(SND_CHANNEL_ANY, -20, 10);

		$func_door_188678.close();
		$func_door_188678.setKey("locked", 1);
		$func_static_108491.setColor(1, 0, 0);

		sys.wait(8);

		thread ShowSubtitles("AP", "Welcome to the Federal Recreation Area, Ethan Rom.\nHave a nice day.", 5);
		CharacterSays($player1, "sound/vo/e1m5_4/MilesCall/Welcome.ogg");

		Beat(2);

		thread ShowSubtitles("Sam", "Ethan? Miles?\nYou said my name was Sam, right? Just Sam?", 6.25);
		CharacterSays($player1, "sound/vo/e1m5_4/MilesCall/Player1.ogg");

		Beat(1.5);

		thread ShowSubtitles("Miles", "Yeah. I don't recall your last name.\nJust Sam.", 4.5);
		CharacterSays($player1, "sound/vo/e1m5_4/MilesCall/Miles1.ogg");
		
		Beat(.75);

		thread ShowSubtitles("Sam", "So Calloway never mentioned it? There's some sort of personnel scanner here.\nIt says my name is Ethan Rom.", 8);
		CharacterSays($player1, "sound/vo/e1m5_4/MilesCall/Player2.ogg");

		Beat(1);

		thread ShowSubtitles("Miles", "Ah.", 2);
		CharacterSays($player1, "sound/vo/e1m5_4/MilesCall/Miles2.ogg");
		
		Beat(1.75);

		thread ShowSubtitles("Sam", "Ah?", 2);
		CharacterSays($player1, "sound/vo/e1m5_4/MilesCall/Player3.ogg");

		Beat(1.5);

		thread ShowSubtitles("Miles", "Look, I have not been completely truthful.\nTo put it mildly.", 7.25);
		CharacterSays($player1, "sound/vo/e1m5_4/MilesCall/Miles3.ogg");
		
		Beat(.5);

		thread ShowSubtitles("Sam", "To put it mildly?", 2);
		CharacterSays($player1, "sound/vo/e1m5_4/MilesCall/Player4.ogg");

		Beat(1.25);

		thread Miles4Subs();
		CharacterSays($player1, "sound/vo/e1m5_4/MilesCall/Miles4.ogg");
		
		Beat(.25);

		thread Player5Subs();
		CharacterSays($player1, "sound/vo/e1m5_4/MilesCall/Player5.ogg");

		Beat(.5);

		thread Miles5Subs();
		CharacterSays($player1, "sound/vo/e1m5_4/MilesCall/Miles5.ogg");
		
		Beat(.25);

		thread Player6Subs();
		CharacterSays($player1, "sound/vo/e1m5_4/MilesCall/Player6.ogg");

		Beat(.1);

		thread Miles6Subs();
		CharacterSays($player1, "sound/vo/e1m5_4/MilesCall/Miles6.ogg");
		
		Beat(.5);

		thread ShowSubtitles("Sam", "But I could have been evacuated!?", 2);
		CharacterSays($player1, "sound/vo/e1m5_4/MilesCall/Player7.ogg");

		Beat(.5);

		thread Miles7Subs();
		CharacterSays($player1, "sound/vo/e1m5_4/MilesCall/Miles7.ogg");
		
		Beat(1.5);

		thread Miles8Subs();
		CharacterSays($player1, "sound/vo/e1m5_4/MilesCall/Miles8.ogg");

		Beat(1.5);

		thread ShowSubtitles("Sam", "There's nothing to say.", 2);
		CharacterSays($player1, "sound/vo/e1m5_4/MilesCall/Player8.ogg");			

		Beat(1);

		sys.fadeTo('0 0 0', 1, 2);

		sys.wait(3);

		// Change level
		sys.trigger($target_endlevel_1);
	}

	void setup()
	{
		thread select_code();
		sys.wait(2.5);
		thread select_impconfig();
		sys.wait(5);
		thread select_wraithconfig();
		sys.wait(8);
		thread select_lostsoulconfig();
		
		sys.trigger($func_static_77865);
		
		sys.trigger($trigger_count_12);
		
		$trigger_once_115.disable();
		$trigger_once_113.disable();
		$trigger_once_114.disable();
		$trigger_once_59.disable();
		
		CrossCheckServerBridges();
		
		SetupServerPuzzle();

		cache_crane_sounds();

		thread crane_update_loop();		
		
		sys.trigger($printer3_on);
		sys.trigger($printer2_on);
		sys.trigger($printer1_on);
		sys.wait(1);
		thread printer_loop1();
		thread printer_loop2();
		thread printer_loop3();	
		
		sys.wait(1);
		thread shippingcrates1();
		sys.wait(1.5);
		thread shippingcrates2();
		
		$mc_assembly_midpoint.rotateOnce ( '-135 0 0' );
		sys.waitFor ($mc_assembly_midpoint);

		$mc_pistrod1.bind ($mc_piston1);
		$mc_pistrod2.bind ($mc_piston2);
		$mc_pistrod3.bind ($mc_piston3);

		$mc_piston1.time (.125);
		$mc_pistrod1.time (.125);
		$mc_piston2.time (.125);
		$mc_pistrod2.time (.125);
		$mc_piston3.time (.125);
		$mc_pistrod3.time (.125);
		$mc_crankshaft.time (.125);

		sys.wait(1);

		thread crankshaft_move();
		
		sys.wait(1);
		
		thread cycle_pump3();
		sys.wait(1.35);
		thread cycle_pump2();
		sys.wait(2.55);
		thread cycle_pump1();
		
		sys.wait(1);
		
		thread techlights_scroll1();
		thread techlights_scroll2();
		
		$trigger_multiple_18.disable();
		
	}

	void main()
	{		
		thread setup();
		
		sys.trigger($setinfluence_levelstart);	

		sys.wait(3);

		$tension_leg_top_cargo_lift.move(UP, 576);
		
		sys.waitFor($tension_leg_top_cargo_lift);
		$func_mover_209.unbind();
		$func_mover_206.unbind();
		$func_mover_205.unbind();
		$func_mover_212.unbind();
		$func_mover_224.unbind();
		$func_mover_221.unbind();
		$func_mover_218.unbind();
		$func_mover_215.unbind();

	}
}