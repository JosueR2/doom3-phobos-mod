	void gondola_02_start()
	{
		gondola_sound_fadeout();

		sys.trigger($SpeakerGondolaTalkieWalkie);

		sys.trigger($gondola_02_doorclip);
		$gondola_02_doorclip.bind($gondola_02_base);
		$gondola_02_door_left.startSoundShader ( "p1_gondola_doors_low", SND_CHANNEL_VOICE );

		$gondola_02_door_left.move ( 180, 28 );
		$gondola_02_door_right.move ( 0, 28 );
		sys.waitFor( $gondola_02_door_right );

		sys.wait( .5 );

		$gondola_02_door_left.startSoundShader ( "p1_gondola_doors_low", SND_CHANNEL_VOICE );

		$gondola_02_door_left.move ( 270, 2 );
		$gondola_02_door_right.move ( 270, 2 );
		sys.waitFor( $gondola_02_door_right );
		
		$gondola_02_door_right.bind ($gondola_02);
		$gondola_02_door_left.bind ($gondola_02);

		$player1.disableWeapon();
		
		//soundscape change just outside gondola start room
		thread AtriumShaft_SoundscapeChange();

		sys.wait( .5 );

		sys.trigger($gondola_arm_spkr);
		$gondola_02_arm_mover.move ( -1, 16);
		sys.waitFor( $gondola_02_arm_mover );

		sys.wait( 1 );

		float gTime = 50 * 2.75;
		$gondola_02_base.time( gTime );
		$gondola_02_base.accelTime( 3 );
		$gondola_02_base.decelTime( 3 );

		thread gondola_sound(gTime - 3);

		$gondola_02_base.startSpline( $p1_sp1 );
		$gondola_02_base.removeInitialSplineAngles();
		sys.waitFor( $gondola_02_base );

		$gondola_02_base.stopSpline();

		sys.wait(1);

		sys.wait($tunnel_elevator_mover.startSoundShader ( "al4_paddles_low", SND_CHANNEL_VOICE ));

		sys.wait(.1);

		sys.wait($tunnel_elevator_mover.startSoundShader ( "al4_spinner_2second_low", SND_CHANNEL_VOICE ));

		sys.wait(.1);

		sys.wait($tunnel_elevator_mover.startSoundShader ( "al4_paddles_low", SND_CHANNEL_VOICE ));

		sys.wait(1);

		$gondola_02_base.bind($tunnel_elevator_mover);

		$tunnel_elevator_mover.move(-1, 640);

		float revolutions = 640 / 50.265;

		$func_mover_284.time(20);
		$func_mover_277.time(20);

		$func_mover_286.time(20);
		$func_mover_282.time(20);

		$func_mover_284.rotateOnce('0 0 -1' * revolutions * 360);
		$func_mover_277.rotateOnce('0 0 -1' * revolutions * 360);
		$func_mover_286.rotateOnce('0 0 1' * revolutions * 360);
		$func_mover_282.rotateOnce('0 0 1' * revolutions * 360);

		sys.waitFor($tunnel_elevator_mover);

		sys.wait(1);

		sys.wait($tunnel_elevator_mover.startSoundShader ( "al4_spinner_2second_low", SND_CHANNEL_VOICE ));

		sys.wait(1);

		$gondola_02_base.unbind();

		gTime = 20 * 3;
		$gondola_02_base.time( gTime );
		$gondola_02_base.accelTime( 3 );
		$gondola_02_base.decelTime( 3 );

		thread gondola_sound(gTime - 3);

		$gondola_02_base.startSpline( $p1_sp2 );
		$gondola_02_base.removeInitialSplineAngles();
		sys.waitFor( $gondola_02_base );

		sys.wait( .5 );

		$gondola_02_door_right.unbind();
		$gondola_02_door_left.unbind();

		$gondola_02_door_left.startSoundShader ( "p1_gondola_doors_low", SND_CHANNEL_VOICE );		// -Xian
		$gondola_02_door_left.move ( 90, 2 );
		$gondola_02_door_right.move ( 90, 2 );
		sys.waitFor( $gondola_02_door_right );

		sys.wait( .5 );
		$gondola_02_door_left.startSoundShader ( "p1_gondola_doors_low", SND_CHANNEL_VOICE );		// -Xian

		$gondola_02_door_left.move ( 0, 28 );
		$gondola_02_door_right.move ( 180, 28 );
		sys.waitFor( $gondola_02_door_right );
		
		sys.trigger($gondola_02_doorclip);

		sys.wait( .5 );

		gondola_sound_fadein();
		//$player1.enableWeapon();
	}

	void SetupGondola()
	{
		//Move the Gondolas into position and open the doors
		$gondola_02_door_left.move ( 90, 2 );
		$gondola_02_door_right.move ( 90, 2 );
		sys.waitFor($gondola_02_door_left);
		$gondola_02_door_left.move ( 0, 28 );
		$gondola_02_door_right.move ( 180, 28 );
		sys.waitFor($gondola_02_door_left);
		$gondola_02_door_right.move( -2, 16);
		$gondola_02_door_left.move( -2, 16);
		$gondola_02_arm_mover.move( -2, 16);
	}

	void select_monsterconfig1()
	{
		float monsterselect1;

		while (1)
		{
			monsterselect1 = sys.random(15);
		
			if (monsterselect1 <= 5){
				sys.trigger ($monster_batch1_1);
				sys.wait(.5);
			} else if (monsterselect1 >= 10){
				sys.trigger ($monster_batch1_2);
				sys.wait(.5);
			} 
				else {
				sys.trigger ($monster_batch1_3);
				sys.wait(.5);
			}
		}
	}
	
