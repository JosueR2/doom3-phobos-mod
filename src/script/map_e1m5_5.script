	void OpenMotelFrontDoor()
	{
		sys.trigger($SpeakerIWasWrong);

		$motel_front_door_hinge.rotateOnce('0 -70 0');
		$motel_front_door_handle.startSoundShader("e1m4_3_door_creak_2", SND_CHANNEL_ANY);
		
		thread ShowSubtitles("Sam", "Hello?", 2);
		CharacterSays($player1, "sound/vo/player/general/Hello.ogg");

		float height_offset = $player1.getEyeHeight();
		vector origin = $player1.getWorldOrigin() + '0 0 1' * height_offset;
		vector angles = $player1.getViewAngles();
		
		$motel_front_door_cam_mover.setWorldOrigin(origin);
		$motel_front_door_cam_mover.setAngles(angles);
		
		$motel_front_door_cam.setKey("fov", 90);
		sys.trigger($motel_front_door_cam);

		sys.wait(4);		

		sys.wait(0.5);

		// TODO: Get actual fov
		thread UpdateMotelFrontCamera($player1.getViewAngles(), $motel_front_door_cam_angles.getAngles(), 90, 45);
		
		vector destination = $motel_front_door_cam_heighter.getWorldOrigin() + ($motel_front_door_cam_target_0.getWorldOrigin() - origin);

		$motel_front_door_cam_heighter.moveToPos(destination);

		sys.waitFor($motel_front_door_hinge);
		sys.waitFor($motel_front_door_cam_heighter);
		sys.wait(1);
		
		$motel_front_door_cam_mover.move(90, 256);

		$motel_front_door_cam_mover.moveTo($motel_front_door_cam_target_1);

		sys.wait(6);

		$motel_front_door_cam_mover.rotateOnce('0 40 0');
		
		sys.waitFor($motel_front_door_cam_mover);

		sys.wait(2);
		
		sys.trigger($motel_bathroom_cam);

		sys.wait(6);

		$motel_bathroom_cupboard_cam_mover.move(270, 16);
		sys.trigger($motel_bathroom_cupboard_cam);

		sys.wait(6);

		sys.trigger($motel_bathroom_bath_cam);
		
		sys.wait(6);
		
		sys.trigger($motel_top_cam);

		sys.wait(6);

		$motel_floor_cam_mover.move(0, 256);
		sys.trigger($motel_floor_cam);

		sys.waitFor($motel_floor_cam_mover);
		sys.trigger($motel_desk_cam);

		sys.wait(6);

		sys.trigger($motel_tools_cam);

		sys.wait(6);

		sys.trigger($motel_broken_door_cam);

		sys.wait(6);

		sys.trigger($motel_fan_cam);

		sys.wait(6);

		sys.trigger($motel_head_cam);

		sys.wait(6);

		$bathroom_shower_speaker_130.fadeSound (SND_CHANNEL_ANY, -100, 10);
		
		sys.fadeTo('0 0 0', 1, 1);

		sys.wait(6);

		Back_To_Level();
	}
	
