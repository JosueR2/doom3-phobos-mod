	void Node6PowerOut() { NodePowerOut(6); }
	void Node7PowerIn() { NodePowerIn(7); }
	void Node7PowerOut() { NodePowerOut(7); }
	
	void NodeMasterPowerIn()
	{
		sys.trigger($nodeonoff_relaymaster);
	
		//Door closing sound/anims
		$player1.removeInventoryItem("Pwr Cell");
		$node_master_powercell.show();
		sys.wait(0.5);

		$node_master_generator.setAnimation("closing");
		sys.trigger($node_master_generator);
		sys.trigger($node_master_powercell_openclose1);
		sys.trigger($node_master_powercell_idle1);
		//generator_gui.guiNamedEvent(1, "powercellDeviceStarted");
		sys.trigger($node_master_powerbeam);
		sys.trigger($node_master_powerzzz);
		thread crossFadeEnt ($node_master_powerlight, '0 0 0', '0.12 0.73 0.12', 0.75);
		sys.wait( 1.0 );
		
		sys.trigger($serverspkron_relaymaster);
		thread crossFadeEnt ($node_master_serverlight, '0 0 0', '0.12 0.73 0.12', 1.5);
		thread crossFadeEnt ($node_master_serverflares1, '0 0 0', '0.12 0.73 0.12', 1.5);
		thread crossFadeEnt ($node_master_serverflares2, '0 0 0', '0.73 0.93 0.73', 2.25);

		//Power starting sound
		thread NodePowerSoundsStart($node_master_powercell_start, $node_master_powercell_loop);

		$server_puzzle_node_4.setKey("powered_state", 1);
		MaintainPoweredBridges();	
	}
	void NodeMasterPowerOut()
	{
		sys.trigger($nodeonoff_relaymaster);
	
		sys.trigger($node_master_powerbeam);
		sys.trigger($node_master_powerzzz);
		thread crossFadeEnt ($node_master_powerlight, '0.12 0.73 0.12', '0 0 0', 0.75);
	
		//Power shutdown sound
		thread NodePowerSoundsStop($node_master_powercell_stop, $node_master_powercell_loop);
		sys.wait(1.5);
		
		sys.wait(1.25);
		
		sys.trigger($serverspkroff_relaymaster);
		thread crossFadeEnt ($node_master_serverlight, '0.12 0.73 0.12', '0 0 0', 1.25);
		thread crossFadeEnt ($node_master_serverflares1, '0.12 0.73 0.12', '0 0 0', 1.25);
		thread crossFadeEnt ($node_master_serverflares2, '0.73 0.93 0.73', '0 0 0', 1.75);

		//Door opening sound/anims
		sys.trigger($node_master_powercell_openclose1);
		sys.trigger($node_master_powercell_idle1);
		$node_master_generator.setAnimation("opening");
		sys.trigger($node_master_generator);
		sys.wait(0.5);

		$node_master_powercell.hide();
		$player1.giveInventoryItem("item_powercell");
		$player1.startSoundShader("guisounds_item", SND_CHANNEL_VOICE);
		//Lock the gui
		//$node_master_generator_gui.guiNamedEvent(1, "powercellDeviceStarted");
		
		$server_puzzle_node_4.setKey("powered_state", 0);
		MaintainPoweredBridges();
	}
	
	
	//float nodeEndOnce = 0;
	float nodeEndCells = 0;
	float nodeEndBridgeState = 0;
	void NodeEndPowerIn()
	{
		nodeEndBridgeState = 2;
		
		sys.trigger($server_puzzle_end_bridge_clip);
		
		$player1.removeInventoryItem("Pwr Cell");
		$player1.removeInventoryItem("Pwr Cell");
		$server_puzzle_end_generator_pcell_1.show();
		$server_puzzle_end_generator_pcell_2.show();
		
		sys.trigger($server_puzzle_end_lights_flicker);
		
		sys.wait(.5);

		$server_puzzle_end_generator.setAnimation("closing");
		sys.trigger($server_puzzle_end_generator);
		sys.trigger($server_puzzle_end_powercell_openclose);
		sys.trigger($server_puzzle_end_powercell_idle);
		

		sys.wait(1);		

		thread NodePowerSoundsStart($server_puzzle_end_powercell_start, $server_puzzle_end_powercell_loop);

		$server_puzzle_end_bridge.move(UP, 256);
		sys.waitFor($server_puzzle_end_bridge);
		sys.trigger($server_puzzle_end_bridge_aas);

		$server_puzzle_end_bridge_door.lock(0);
		$server_puzzle_end_bridge_door_frame.setColor(1, 0.8, 0.5);

		//if(nodeEndOnce == 0)
		{
			//nodeEndOnce = 1;
			float i = 0;
			while(i < 4)
			{
				entity light = sys.getEntity("server_puzzle_end_house_light" + (i + 1));
				vector color = light.getColor();
				vector ogcolor = light.getVectorKey("ogcolor");
			
				sys.trigger($target_entity_fadein_1);
				sys.trigger($target_entity_fadein_2);
				sys.trigger($target_entity_fadein_3);
				$server_puzzle_end_bridge_door_frame_light1.setColor(1, 0.7, 0);
				$server_puzzle_end_bridge_door_frame_light2.setColor(1, 0.7, 0);
			
				$server_puzzle_healthgui.show();
				$server_puzzle_healthgui_light.setColor(0.77, 0.85, 1);
			
				thread crossFadeEnt (light, color, ogcolor, 0.25);
				i++;
			}
		}

		nodeEndBridgeState = 1;
		return;
	}
	void NodeEndPowerOut()
	{	
		nodeEndBridgeState = 2;
		
		sys.trigger($server_puzzle_end_bridge_clip);

		thread NodePowerSoundsStop($server_puzzle_end_powercell_stop, $server_puzzle_end_powercell_loop);
		sys.wait(1.5);

		sys.trigger($server_puzzle_end_powercell_openclose);
		sys.trigger($server_puzzle_end_powercell_idle);
		$server_puzzle_end_generator.setAnimation("opening");
		sys.trigger($server_puzzle_end_generator);
		
		sys.wait(0.5);

		$server_puzzle_end_generator_pcell_2.hide();
		$player1.giveInventoryItem("item_powercell");
		$server_puzzle_end_generator_pcell_1.hide();
		$player1.giveInventoryItem("item_powercell");

		sys.trigger($server_puzzle_end_lights_flicker);

		$server_puzzle_end_bridge_door.lock(1);
		$server_puzzle_end_bridge_door_frame.setColor(.5, 0, 0);
		{
			float i = 0;
			while(i < 4)
			{
				entity light = sys.getEntity("server_puzzle_end_house_light" + (i+1));
				vector ogcolor = light.getColor();
				light.setKey("ogcolor", ogcolor);
				light.setColor(0, 0, 0);
				i++;
				sys.trigger($target_entity_fadeout_1);
				
				$server_puzzle_end_bridge_door_frame_light1.setColor(0, 0, 0);
				$server_puzzle_end_bridge_door_frame_light2.setColor(0, 0, 0);
				
				$server_puzzle_healthgui.hide();
				$server_puzzle_healthgui_light.setColor(0, 0, 0);
			}
		}

		$server_puzzle_end_bridge.move(DOWN, 256);
		sys.trigger($server_puzzle_end_bridge_aas);
		sys.waitFor($server_puzzle_end_bridge);
		nodeEndBridgeState = 0;
		return;
	}

		float ServerElevatorState = 1;
		// elevator states: 0 = bottom, 1 = top, 2 = in transit 

	void ServerElevatorPowerOut()
	{	
		$ServerElGui_Top.setGuiParm( "gui_parm5", 4 );
		$ServerElGui_Bot.setGuiParm( "gui_parm5", 4 );
		$ServerElGui.setGuiParm( "gui_parm5", 4 );
		
		//Power shutdown sound
		thread NodePowerSoundsStop($server_elevator_powercell_onstop, $server_elevator_powercell_loop);
		sys.wait(1.5);

		//Door opening sound/anims
		sys.trigger($server_elevator_powercell_openclose1);
		sys.trigger($server_elevator_powercell_idle1);
		$server_elevator_generator.setAnimation("opening");
		sys.trigger($server_elevator_generator);
		sys.wait(0.5);

		$server_elevator_powercell.hide();
		$player1.giveInventoryItem("item_powercell");
		$player1.startSoundShader("guisounds_item", SND_CHANNEL_VOICE);		

		sys.wait(1.0);
		
		if(ServerElevatorState == 1)
		{
			ServerElevatorState = 2;
			$server_power_elevator.setKey("snd_accel", "m2_start");
			$server_power_elevator.setKey("snd_decel", "m2_stop");
			$server_power_elevator.setKey("snd_move", "m2_loop");
			$server_power_elevator.moveTo($server_el_bot_dest);
			sys.trigger($ServerEl_AAS_Top);
			sys.waitFor($server_power_elevator);
			sys.trigger($ServerEl_AAS_Bottom);
			$ServerElGui.setGuiParm( "gui_parm1", 1 );
			ServerElevatorState = 0;
		}
		else if(ServerElevatorState == 0)
		{
			return;
		}
			else if(ServerElevatorState == 2)
		{
			$server_power_elevator.setKey("snd_accel", "m2_start");
			$server_power_elevator.setKey("snd_decel", "m2_stop");
			$server_power_elevator.setKey("snd_move", "m2_loop");
			$server_power_elevator.moveTo($server_el_bot_dest);
			sys.waitFor($server_power_elevator);
			sys.trigger($ServerEl_AAS_Bottom);
			$ServerElGui.setGuiParm( "gui_parm1", 1 );
			ServerElevatorState = 0;
		}
	}

	void ServerElevatorPowerIn()
	{
		$ServerElGui_Top.setGuiParm( "gui_parm5", 0 );
		$ServerElGui_Bot.setGuiParm( "gui_parm5", 0 );
		$ServerElGui.setGuiParm( "gui_parm5", 0 );
	
		//Door closing sound/anims
		$player1.removeInventoryItem("Pwr Cell");
		$server_elevator_powercell.show();
		sys.wait(0.5);

		$server_elevator_generator.setAnimation("closing");
		sys.trigger($server_elevator_generator);
		sys.trigger($server_elevator_powercell_openclose1);
		sys.trigger($server_elevator_powercell_idle1);
		//generator_gui.guiNamedEvent(1, "powercellDeviceStarted");
		sys.wait(1.0);

		//Power starting sound
		thread NodePowerSoundsStart($server_elevator_powercell_start, $server_elevator_powercell_loop);

		sys.wait(1.0);
	}
	
	void ServerElevatorUp()
	{
		if(ServerElevatorState == 0)
		{
			ServerElevatorState = 2;
			$server_power_elevator.setKey("snd_accel", "m3_start");
			$server_power_elevator.setKey("snd_decel", "m3_stop");
			$server_power_elevator.setKey("snd_move", "m3_loop");
			$server_power_elevator.moveTo($server_el_top_dest);
			sys.trigger($ServerEl_AAS_Bottom);
			sys.waitFor($server_power_elevator);
			sys.trigger($ServerEl_AAS_Top);
			$ServerElGui.setGuiParm( "gui_parm1", 2 );
			ServerElevatorState = 1;
		}
		else if(ServerElevatorState == 1)
		{
			return;
		}
		else if(ServerElevatorState == 2)
		{
			return;
		}
	}
	
	void ServerElevatorDown()
	{
		if(ServerElevatorState == 1)
		{
			ServerElevatorState = 2;
			$server_power_elevator.setKey("snd_accel", "m3_start");
			$server_power_elevator.setKey("snd_decel", "m3_stop");
			$server_power_elevator.setKey("snd_move", "m3_loop");
			$server_power_elevator.moveTo($server_el_bot_dest);
			sys.trigger($ServerEl_AAS_Top);
			sys.waitFor($server_power_elevator);
			sys.trigger($ServerEl_AAS_Bottom);
			$ServerElGui.setGuiParm( "gui_parm1", 1 );
			ServerElevatorState = 0;
		}
		else if(ServerElevatorState == 0)
		{
			return;
		}
		else if(ServerElevatorState == 2)
		{
			return;
		}
	}
		
	void ToggleServerElevator()
	{
		if(ServerElevatorState == 1)
		{
			ServerElevatorState = 2;
			$server_power_elevator.setKey("snd_accel", "m3_start");
			$server_power_elevator.setKey("snd_decel", "m3_stop");
			$server_power_elevator.setKey("snd_move", "m3_loop");
			$server_power_elevator.moveTo($server_el_bot_dest);
			sys.trigger($ServerEl_AAS_Top);
			sys.waitFor($server_power_elevator);
			sys.trigger($ServerEl_AAS_Bottom);
			$ServerElGui.setGuiParm( "gui_parm1", 1 );
			ServerElevatorState = 0;
		}
		else if(ServerElevatorState == 0)
		{
			ServerElevatorState = 2;
			$server_power_elevator.setKey("snd_accel", "m3_start");
			$server_power_elevator.setKey("snd_decel", "m3_stop");
			$server_power_elevator.setKey("snd_move", "m3_loop");
			$server_power_elevator.moveTo($server_el_top_dest);
			sys.trigger($ServerEl_AAS_Bottom);
			sys.waitFor($server_power_elevator);
			sys.trigger($ServerEl_AAS_Top);
			$ServerElGui.setGuiParm( "gui_parm1", 2 );
			ServerElevatorState = 1;
		}
		else if(ServerElevatorState == 2)
		{
			return;
		}
	}

