	void holograms1()
	{	
		sys.trigger($target_setkeyval_7);
		thread hologram_button("func_mover_103", "func_static_99346", "func_static_99343");
		hologram_button("func_mover_102", "func_static_99342", "func_static_99341");

		sys.trigger($holo1_scan_spkr);
		sys.trigger($h1_scanline1);
		sys.trigger($h1_scanline2);
		sys.trigger($h1_scanline3);
		sys.trigger($h1_scanline4);
		sys.trigger($h1_scanline5);
		sys.trigger($h1_scanline6);
		sys.trigger($h1_scanline7);
		sys.trigger($h1_scanline8);
		$holo1_landscapescan1.move(180, 160);
		$holo1_landscapescan2.move(0, 160);
		$holo1_landscapescan3.move(90, 184);
		$holo1_landscapescan4.move(270, 184);
		sys.waitFor($holo1_landscapescan1);		
		$holo1_landscapescan1.move(0, 160);
		$holo1_landscapescan2.move(180, 160);
		$holo1_landscapescan3.move(270, 184);
		$holo1_landscapescan4.move(90, 184);
		sys.waitFor($holo1_landscapescan1);
		sys.trigger($hologram_landscape1);
		sys.trigger($hologram_meshgrid1);
		sys.trigger($h1_scanline1);
		sys.trigger($h1_scanline2);
		sys.trigger($h1_scanline3);
		sys.trigger($h1_scanline4);
		sys.trigger($h1_scanline5);
		sys.trigger($h1_scanline6);
		sys.trigger($h1_scanline7);
		sys.trigger($h1_scanline8);
		$holo_landscape1.move(-1, 24);
