	void RotateBridge(string goobridgeName, float armState1, float armState2, float b)
	{
		entity bridgeGui = sys.getEntity(goobridgeName + "_gui");		

		float buttonPos = armState1;		
		float buttonPos2 = (buttonPos+1) % 4;

		entity b1 = sys.getEntity(goobridgeName + "_button_" + buttonPos);
		entity b2 = sys.getEntity(goobridgeName + "_button_" + buttonPos2);
		
		entity mainPart = sys.getEntity(goobridgeName + "_main");
		entity lower_dest = sys.getEntity(goobridgeName + "_downpos");
		entity upper_dest = sys.getEntity(goobridgeName + "_uppos");
		vector failsafe = upper_dest.getWorldOrigin();
		
		b2.show();
		sys.wait(.01);
		b1.hide();		

		entity ol1 = sys.getEntity(goobridgeName + "led" + armState1);
		entity ol2 = sys.getEntity(goobridgeName + "led" + armState2);
		ol1.setColor(0.5,0,0);
		ol2.setColor(0.5,0,0);

		thread AnimateMaps(armState1, armState2, b);

		if(b == 1)
			thread StartRoundAbout1();
		else if(b == 2)
			thread StartRoundAbout2();			
		if(b == 3)
			thread StartRoundAbout3();
		if(b == 4)
			thread StartRoundAbout4();

		b2.startSoundShader("one_shot_electrical_switch_heavy_1", SND_CHANNEL_ANY);		

		sys.wait(1);
		
		//while(1)
		{
		//sys.wait(2);		

		thread DetractArm(goobridgeName + "_arm1", armState1, "in");
		sys.wait(.5);
		thread DetractArm(goobridgeName + "_arm2", armState2, "in");		
		sys.wait(.5);
		
		sys.wait(2);
		
		mainPart.moveTo(lower_dest);

		sys.wait(1);

		mainPart.rotateOnce('0 -90 0');
		
		sys.wait(4);				

		armState1 = (armState1 + 1) % 4;		
		armState2 = (armState2 + 1) % 4;
		
		sys.wait(.5);	
		
		mainPart.moveTo(upper_dest);
		
		sys.wait(2);
		
		thread DetractArm(goobridgeName + "_arm1", armState1, "out");	

		sys.wait(.5);
		
		DetractArm(goobridgeName + "_arm2", armState2, "out");								

		if(b == 1)
		{
			thread StopRoundAbout1();		
			thread StopMapAnimation1();
		}
		else if(b == 2)
		{
			thread StopRoundAbout2();
			thread StopMapAnimation2();
		}
		if(b == 3)
		{
			thread StopRoundAbout3();
			thread StopMapAnimation3();
		}
		if(b == 4)
		{
			thread StopRoundAbout4();
			thread StopMapAnimation4();
		}

		sys.wait(.25);

		entity nl1 = sys.getEntity(goobridgeName + "_led" + armState1);
		entity nl2 = sys.getEntity(goobridgeName + "_led" + armState2);
		nl1.setColor(0,0.5,0);
		nl2.setColor(0,0.5,0);

		UpdateMapPath(b, armState1, armState2);
		
		mainPart.setWorldOrigin(failsafe);

		sys.wait(.5);		

			bridgeGui.setKey("click_item", "1");
		}
	}

