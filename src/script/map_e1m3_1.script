	void ManageTimeline(float number, float state)
	{
		entity timeline = sys.getEntity("timelineposter" + number);
		entity speaker = sys.getEntity("timelineposter" + number + "_speaker");

		if(state == 0)
		{
			timeline.startSoundShader("e1m3_1_timeline_start", SND_CHANNEL_ANY);
			crossFadeEnt (timeline, '0 0 0', '1 1 1', .75);
			sys.trigger(speaker);
		}
		else if(state == 1)
		{
			sys.trigger(speaker);
			timeline.startSoundShader("e1m3_1_timeline_end", SND_CHANNEL_ANY);				
			crossFadeEnt (timeline, '1 1 1', '0 0 0', .25);				
		}		
	}

	void ManageTimeline1()
	{
		if(inTP1 == 1 && timelinePoster1 == 0)
		{
			timelinePoster1 = 2;				
			ManageTimeline(1, 0);
			timelinePoster1 = 1;
		}
		else if(inTP1 == 0 && timelinePoster1 == 1)
		{
			timelinePoster1 = 2;
			ManageTimeline(1, 1);
			timelinePoster1 = 0;
		}
	}

