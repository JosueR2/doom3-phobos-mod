	// END RANDOM MONSTER SPAWNS
	//===========================================
	
	void main()
	{
		SetupConfScene();		

		MaintainGarageElevatorCallers();	

		sys.wait(5);
		thread select_monsterconfig2();
		sys.wait(5);
		thread select_monsterconfig3();		
		sys.wait(3);
		thread select_monsterconfig1();	

		thread ToggleEndBridge();
		thread rotate_fan();		
	}
