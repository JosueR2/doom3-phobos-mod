	void NodePowerIn(float i)
	{
		entity sndstart = sys.getEntity("node_" + i + "_powercell_start");
		entity loop = sys.getEntity("node_" + i + "_powercell_loop");
		entity powercell = sys.getEntity("node_" + i + "_powercell");
		entity generator = sys.getEntity("node_" + i + "_generator");
		entity openclose1 = sys.getEntity("node_" + i + "_powercell_openclose1");
		entity idle1 = sys.getEntity("node_" + i + "_powercell_idle1");
		entity node = sys.getEntity("server_puzzle_node_" + i);
		entity node_powerbeam = sys.getEntity("node_" + i + "_powerbeam");
		entity node_powerlight = sys.getEntity("node_" + i + "_powerlight");
		entity node_powerzzz = sys.getEntity("node_" + i + "_powerzzz");
		entity serverlight = sys.getEntity("node_" + i + "_serverlight");
		entity serverspkron_relay = sys.getEntity("serverspkron_relay" + i);
		entity serverflares1 = sys.getEntity("node_" + i + "_serverflares1");
		entity serverflares2 = sys.getEntity("node_" + i + "_serverflares2");
		entity nodeonoff_relay = sys.getEntity("nodeonoff_relay" + i);
	
		sys.trigger( nodeonoff_relay );
	
		//Door closing sound/anims
		$player1.removeInventoryItem("Pwr Cell");
		powercell.show();
		sys.wait(0.5);

		generator.setAnimation("closing");
		sys.trigger(generator);
		sys.trigger(openclose1);
		sys.trigger(idle1);
		//generator_gui.guiNamedEvent(1, "powercellDeviceStarted");
		sys.trigger(node_powerbeam);
		sys.trigger(node_powerzzz);
		thread crossFadeEnt (node_powerlight, '0 0 0', '0.12 0.73 0.12', 0.75);
		sys.wait( 1.0 );
		
		sys.trigger(serverspkron_relay);
		thread crossFadeEnt (serverlight, '0 0 0', '0.12 0.73 0.12', 1.5);
		thread crossFadeEnt (serverflares1, '0 0 0', '0.12 0.73 0.12', 1.5);
		thread crossFadeEnt (serverflares2, '0 0 0', '0.73 0.93 0.73', 2.25);

		//Power starting sound
		thread NodePowerSoundsStart(sndstart, loop);

		node.setKey("powered_state", 1);
		MaintainPoweredBridges();
	}

	void NodePowerOut(float i)
	{
		entity sndstop = sys.getEntity("node_" + i + "_powercell_stop");
		entity loop = sys.getEntity("node_" + i + "_powercell_loop");
		entity powercell = sys.getEntity("node_" + i + "_powercell");
		entity generator = sys.getEntity("node_" + i + "_generator");
		entity openclose1 = sys.getEntity("node_" + i + "_powercell_openclose1");
		entity idle1 = sys.getEntity("node_" + i + "_powercell_idle1");
		entity node = sys.getEntity("server_puzzle_node_" + i);
		entity node_powerbeam = sys.getEntity("node_" + i + "_powerbeam");
		entity node_powerzzz = sys.getEntity("node_" + i + "_powerzzz");
		entity node_powerlight = sys.getEntity("node_" + i + "_powerlight");
		entity serverlight = sys.getEntity("node_" + i + "_serverlight");
		entity serverspkroff_relay = sys.getEntity("serverspkroff_relay" + i);
		entity serverflares1 = sys.getEntity("node_" + i + "_serverflares1");
		entity serverflares2 = sys.getEntity("node_" + i + "_serverflares2");
		entity nodeonoff_relay = sys.getEntity("nodeonoff_relay" + i);

		sys.trigger( nodeonoff_relay );

		// Lower the bridges
		node.setKey("powered_state", 0);
		MaintainPoweredBridges();

		sys.trigger(node_powerbeam);
		sys.trigger(node_powerzzz);
		thread crossFadeEnt (node_powerlight, '0.12 0.73 0.12', '0 0 0', 0.75);

		//Power shutdown sound
		thread NodePowerSoundsStop(sndstop, loop);
		sys.wait( 1.5 );
		
		sys.trigger(serverspkroff_relay);
		thread crossFadeEnt (serverlight, '0.12 0.73 0.12', '0 0 0', 1.25);
		thread crossFadeEnt (serverflares1, '0.12 0.73 0.12', '0 0 0', 1.25);
		thread crossFadeEnt (serverflares2, '0.73 0.93 0.73', '0 0 0', 1.75);
		
		//Door opening sound/anims
		sys.trigger( openclose1 );
		sys.trigger( idle1 );
		generator.setAnimation( "opening" );
		sys.trigger( generator );
		sys.wait( 0.5 );

		powercell.hide();		
		$player1.giveInventoryItem("item_powercell");
		$player1.startSoundShader( "guisounds_item", SND_CHANNEL_VOICE );
	}

	void Node1PowerIn() { NodePowerIn(1); }
	void Node1PowerOut() { NodePowerOut(1); }
	void Node2PowerIn() { NodePowerIn(2); }
	void Node2PowerOut() { NodePowerOut(2); }
