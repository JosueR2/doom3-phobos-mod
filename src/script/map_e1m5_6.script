	//===========================================
	// START SOMA DOORS
	//===========================================

	void OpenSomaDoor(string name)
	{
		entity door = sys.getEntity("somadoor_round_" + name);
		entity portal = sys.getEntity("somadoor_portal_" + name);

		entity switch_a = sys.getEntity("somadoor" + name + "_gui_a");
		entity switch_b = sys.getEntity("somadoor" + name + "_gui_b");
				
		entity somaguis_off = sys.getEntity("disable_soma" + name + "_guis");
		entity somaguis_on = sys.getEntity("enable_soma" + name + "_guis");
		entity somaguis_blue = sys.getEntity("soma" + name + "_guilights_blue");
		entity somaguis_green = sys.getEntity("soma" + name + "_guilights_green");
		
		float state = door.getFloatKey("state");
		float openDir = door.getFloatKey("openDir");
		float closeDir = door.getFloatKey("closeDir");
		vector rv = door.getVectorKey("rotateVector");

		if( state == 0)
		{
			door.setKey("state", 2);

			sys.trigger(portal);
			
			sys.trigger(somaguis_blue);
			sys.trigger(somaguis_off);
			
			switch_a.setShaderParm( 7, 2 );
			switch_b.setShaderParm( 7, 2 );
			
			door.accelTime(1);
			door.decelTime(1);
			door.time(2.5);

			door.startSoundShader ("al4_openslats_2s", SND_CHANNEL_VOICE);
			door.rotateOnce(rv * 135);
			sys.waitFor(door);
			
			door.accelTime(1);
			door.decelTime(.5);
			door.time(3.5);

			door.startSoundShader ("sound/doors/large/hugedoor_01_open.wav", SND_CHANNEL_VOICE);
			
			door.move(openDir, 128);
			door.rotateOnce(rv * 90);
		
			sys.waitFor(door);
			

			door.setKey("state", 1);

			sys.wait(5);

			door.setKey("state", 2);

			door.startSoundShader ("sound/doors/large/hugedoor_01_close.wav", SND_CHANNEL_VOICE);
			door.move(closeDir, 128);
			door.rotateOnce(rv * -90);

			sys.waitFor(door);

			door.accelTime(1);
			door.decelTime(1);
			door.time(2.5);

			door.startSoundShader ("al4_openslats_2s", SND_CHANNEL_VOICE);
			door.rotateOnce(rv * -135);
			sys.waitFor(door);

			sys.trigger(portal);

			switch_a.setShaderParm( 7, 1 );
			switch_b.setShaderParm( 7, 1 );
			
			sys.trigger(somaguis_on);
			sys.trigger(somaguis_green);
			
			door.setKey("state", 0);
		}
	}
	
	void OpenSomaDoorDetention()
	{
		OpenSomaDoor("detention");
	}

