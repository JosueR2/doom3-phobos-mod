	float LowerTracksState = 0;

	void ReverseLowerTracks()
	{
		$reverse_tracks_clicker.setKey("click_item", "0");
		
		if(LowerTracksState == 0)
		{
			$reverse_tracks_handle.rotateUpTo(X_AXIS, 90);
			sys.trigger($track_rev_whirr_spkr);
			LowerTracksState = 1;
		}
		else
		{
			$reverse_tracks_handle.rotateDownTo(X_AXIS, 0);
			sys.trigger($track_rev_whirr_spkr);
			LowerTracksState = 0;
		}
		
		float i = 0;
		while( i < 10 )
		{
			entity platform = sys.getEntity("track_orange_platform_" + (i + 1));
			platform.stopMoving();
			platform = sys.getEntity("track_green_platform_" + (i + 1));
			platform.stopMoving();
			i++;
		}
		Track_Orange_Direction = Track_Orange_Direction * -1;
		Track_Green_Direction = Track_Green_Direction * -1;

		sys.wait(2.8);

		$reverse_tracks_clicker.setKey("click_item", "1");
	}

	float forcefield_lower = 1;	

	void TurnOffField(entity handle, entity red, entity green, entity console, entity relay, entity relayDone)
	{
		handle.move(UP, 8);
		handle.startSoundShader("one_shot_electrical_switch_heavy_1", SND_CHANNEL_ANY);
		red.show();
		green.hide();

		console.startSoundShader("e1_bomb_placement", SND_CHANNEL_VOICE2);

		sys.trigger(relay);
		sys.wait(0.025);
		sys.trigger(relay);
		sys.wait(0.025);
		sys.trigger(relay);
		sys.wait(0.025);
		sys.trigger(relay);
		sys.wait(0.025);
		sys.trigger(relay);
		sys.wait(0.1);
		sys.trigger(relay);
		sys.wait(0.1);
		sys.trigger(relay);

		sys.trigger(relayDone);
	}

	void TurnOffOrangeField()
	{
		entity handle = sys.getEntity("upperff_console_handle");
		entity red = sys.getEntity("upperff_console_red");
		entity green = sys.getEntity("upperff_console_green");
		entity console = sys.getEntity("upperff_console");
		entity relay = sys.getEntity("upperff_relay");
		entity relayDone = sys.getEntity("upperff_relay_done");
		
		TurnOffField(handle, red, green, console, relay, relayDone);

		sys.trigger($speaker_1168);
	}

