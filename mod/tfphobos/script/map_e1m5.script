	}

	void CallKarl()
	{
		thread PhoneNextDoor();
		CharacterSays($player1, "sound/shav/e1m4_4/calling_karl.ogg");

		sys.trigger($SpeakerTVShow);

		thread ShowSubtitles("Karl", "Hello thanks for calling. This is Karl's shovels and digging equipment.\nHow may I help you today?", 3.5);
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m5/karlcall/karl1_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m5/karlcall/karl1.ogg");		

		Beat(.1);

		thread ShowSubtitles("Sam", "Wait, what?", 2);
		CharacterSays($player1, "sound/vo/e1m5/karlcall/player1.ogg");

		Beat(.2);

		thread ShowSubtitles("Karl", "Oh it's you.", 2);
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m5/karlcall/karl2_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m5/karlcall/karl2.ogg");		

		Beat(.15);

		thread ShowSubtitles("Sam", "Shovels and digging equipment?", 2);
		CharacterSays($player1, "sound/vo/e1m5/karlcall/player2.ogg");

		Beat(.75);

		thread ShowSubtitles("Karl", "Don't worry about it. A little side business.\nIt's a little...boring...you know.", 5.5);
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m5/karlcall/karl3_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m5/karlcall/karl3.ogg");
		
		Beat(.25);

		thread ShowSubtitles("Sam", "Was that a joke?", 2);
		CharacterSays($player1, "sound/vo/e1m5/karlcall/player3.ogg");

		Beat(1.75);

		thread ShowSubtitles("Karl", "So did you talk to hot stuff? I'm a busy man, you know.\nCan't wait forever for you guys.", 4.5);
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m5/karlcall/karl4_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m5/karlcall/karl4.ogg");		

		Beat(.3);

		thread ShowSubtitles("Sam", "Right. I'm sure the shovel game is intense.", 2.5);
		CharacterSays($player1, "sound/vo/e1m5/karlcall/player4.ogg");

		Beat(.32);

		thread ShowSubtitles("Karl", "Something like that. You get it!\nHot stuff. Talk to her?", 2.5);
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m5/karlcall/karl5_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m5/karlcall/karl5.ogg");

		Beat(.5);

		thread ShowSubtitles("Sam", "Well...", 2);
		CharacterSays($player1, "sound/vo/e1m5/karlcall/player5.ogg");

		Beat(.2);

		thread ShowSubtitles("Karl", "Want me to talk to her?\nI'll bring my A game.", 2.5);
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m5/karlcall/karl6_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m5/karlcall/karl6.ogg");
		
		Beat(.15);

		thread ShowSubtitles("Sam", "Oh...dear...no\n...making me sick. I'll handle it.", 8);
		CharacterSays($player1, "sound/vo/e1m5/karlcall/player6.ogg");

		Beat(.25);

		thread ShowSubtitles("Karl", "So why are you calling? Come on, man. Busy busy busy.\nGrab the girl. Say the things. Move the stuff. What are you waiting for?", 6.5);
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m5/karlcall/karl7_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m5/karlcall/karl7.ogg");

		Beat(.3);

		thread ShowSubtitles("Sam", "It's complicated. I just...", 3);
		float time_to_say = CharacterSays_NoWait($player1, "sound/vo/e1m5/karlcall/player7.ogg");

		sys.wait(time_to_say - .5);

		thread ShowSubtitles("Karl", "Complicated schmartulated. Come on...just...why are you calling?", 3.5);
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m5/karlcall/karl8_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m5/karlcall/karl8.ogg");		

		Beat(.3);

		thread ShowSubtitles("Sam", "I'm looking into it.Your payment.\nI have to know if it's even possible.", 5.5);
		CharacterSays($player1, "sound/vo/e1m5/karlcall/player8.ogg");

		Beat(.25);

		thread ShowSubtitles("Karl", "The money? The money. That minuscule tiny weeny amount?", 4.5);
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m5/karlcall/karl9_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m5/karlcall/karl9.ogg");		

		Beat(.5);

		thread ShowSubtitles("Sam", "It's not minuscule to us.\nI just wanted to tell you we're interested.", 3.5);
		CharacterSays($player1, "sound/vo/e1m5/karlcall/player9.ogg");

		Beat(.25);

		thread ShowSubtitles("Karl", "Can you get the cash or no?\nI keep telling you. Busy man.", 3.5);
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m5/karlcall/karl10_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m5/karlcall/karl10.ogg");		

		Beat(.3);

		thread (LeeStartsTexting());

		thread ShowSubtitles("Sam", "Is that why there's constantly game show tv noise coming from your room?", 3.5);
		CharacterSays($player1, "sound/vo/e1m5/karlcall/player10.ogg");

		Beat(.25);		

		thread ShowSubtitles("Karl", "It's REALLY inappropriate to listen in on your neighbours.", 2.5);
		thread CharacterSays($speaker_karl_room, "sound/vo/e1m5/karlcall/karl11_muffled.ogg");
		CharacterSays($player1, "sound/vo/e1m5/karlcall/karl11.ogg");

		Beat(.65);

		thread ShowSubtitles("Sam", "Oh. I gotta go.\nI'll be back with more, soon.", 2.5);
		CharacterSays($player1, "sound/vo/e1m5/karlcall/player11.ogg");

		$mote_noticeboard_item.hide();

		Beat(1);

		sys.trigger($SpeakerTVShow);

		sys.showTextMessage("What? Why?", 1);

		Beat(.5);

		sys.showTextMessage("YOU ARE NOT IN ARRANGEMENT YET. HE DOES NOT KNOW ABOUT YOU. HIDE!", 0);
		
		Beat(.5);

		thread ShowSubtitles("Sam", "Shit! Gotta find a place to hide!", 2);
		CharacterSays($player1, "sound/vo/e1m5/motelcloset/player1.ogg");

		$hide_bed_clicker.setKey("click_item", "1");		
	}

	void ReactToFML()
	{
		thread ShowSubtitles("Sam", "Lee is in a really dark place right now.\nI guess we both are.", 2);
		CharacterSays($player1, "sound/vo/e1m5/darkplace.ogg");

		sys.wait(10);

		//Lee calls
		sys.wait($player1.startSoundShader("sound/shav/e1m3/phonering.ogg", SND_CHANNEL_ANY));
		sys.wait(.25);
		$player1.startSoundShader("sound/shav/e1m3/phone_bleep1.ogg", SND_CHANNEL_ANY);

		sys.wait(.5);	

		thread ShowSubtitles("Lee", "Hey.", 2);
		CharacterSays($player1, "sound/vo/e1m5/motelcloset/lee9.ogg");

		sys.wait(0.5);

		thread ShowSubtitles("Sam", "Are you okay?", 2);
		CharacterSays($player1, "sound/vo/e1m5/motelcloset/player2.ogg");

		sys.wait(0.5);

		thread ShowSubtitles("Lee", "Have I ever told you about my last day outside the valley?", 5);
		CharacterSays($player1, "sound/vo/e1m5/motelcloset/lee10.ogg");

		sys.wait(2);

		CharacterSays($player1, "sound/vo/player/general/HelloAlt.ogg");

		StartTrainStuff();
	}

	float thundering = 1;	

	void MotelLightning(float fadeInTime, float fadeOutTime, float staying, float intensity)
	{
		thread crossFadeEnt ($motel_curtains, '0.172549 0.011765 0.000000', '0.576471 0.309804 0.305882' * intensity, fadeInTime);
		thread crossFadeEnt ($motel_light_thunder, '0 0 0', motel_light_thunder_color * intensity, fadeInTime);
		
		sys.wait(staying);

		thread crossFadeEnt ($motel_curtains, '0.576471 0.309804 0.305882' * intensity, '0.172549 0.011765 0.000000', fadeOutTime);		
		thread crossFadeEnt ($motel_light_thunder, motel_light_thunder_color * intensity, '0 0 0', fadeOutTime);		
	}

	void InspectMap()
	{
		thread ShowSubtitles("Sam", "Hmmm.", 2);
		CharacterSays($player1, "sound/vo/player/general/HmmLong.ogg");
	}

	void MotelLightningSession(float times)
	{
		float i = 0;
		while(i < times - 1)
		{			
			sys.wait(GetRandom(0.05, 0.15));
			MotelLightning(GetRandom(0.01, .0625), GetRandom(0.01, .0625), GetRandom(0.01, .125), GetRandom(.1, 1));
			 
			i++;
		}

		sys.wait(GetRandom(0.05, 0.3));

		MotelLightning(GetRandom(0.1, .0625), GetRandom(0.3, .35), GetRandom(.2, .3), GetRandom(.5, .7));
	}	

	void UpdateMotel()
	{
		while(thundering)
		{
			MotelLightningSession(GetRandom(1, 5));
			sys.wait(GetRandom(2, 10));
		}
	}	

