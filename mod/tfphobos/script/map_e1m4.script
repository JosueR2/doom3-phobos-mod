	float sewerInspectVentDoorState = 0;

	void LeeFilterStuck()
	{
		while(leeAtFilter == 0 || sewerInspecting == 1)
		{
			sys.waitFrame();
		}

		HideSewerClickers();

		sys.wait(2.5);

		thread ShowNPCSubtitles("Lee", "I need your help. There seems to be a filter or whatever.\nCan you extract it? Somehow?", 5);
		thread CharacterSays($Scare_Vent_2, "sewer_filter_Lee1_vent");
		CharacterSays($player1, "sewer_filter_Lee1");
		CharacterSays($player1, "e1m3_1_walkie_beep");
		Beat(.5);
		
		thread ShowNPCSubtitles("Sam", "Let me see...", 2);
		CharacterSays($player1, "sewer_filter_Player1");
		Beat(.5);
		
		$sewer_vent_filter_item.setKey("click_item", "1");
		
		ShowSewerClickers();
	}

	float startLeeOnce = 0;

	void SewerInspectVentDoor()
	{
		if(sewerInspectVentDoorState == 0)
		{
			thread ShowNPCSubtitles("Sam", "hmm.", 2);
			sys.wait($player1.startSoundShader("player_vo_hmm", SND_CHANNEL_ANY));
			sys.wait(1);			
			$sewer_vent_door_reaction_item.setKey("click_item", "1");

			if(startLeeOnce == 0)
			{
				startLeeOnce = 1;
				thread LeeFilterStuck();
			}

			return;
		}

		HideSewerClickers();

		$sewer_vent_door_reaction_item.hide();

		$seweruwu_door_1_upper.startSoundShader("shav_general_alarm5", SND_CHANNEL_ANY);

		sys.wait(3);
	
		thread ShowNPCSubtitles("Sam", "There is a door opening here. But it seems...inoperable.", 4.15);
		CharacterSays($player1, "sewer_filter_Player3");
		Beat(.5);
		
		thread ShowNPCSubtitles("Lee", "I saw some controls back where I crawled into the duct.\nMaybe...that's...something?", 4.25);
		thread CharacterSays($Scare_Vent_2, "sewer_filter_Lee3_vent");
		CharacterSays($player1, "sewer_filter_Lee3");
		CharacterSays($player1, "e1m3_1_walkie_beep");
		Beat(.5);
		
		$sewer_turn_on_vent_power_item.setKey("click_item", "1");

		ShowSewerClickers();
	}
	
	void SewerRemoveFilter()
	{	
		HideSewerClickers();

		$sewer_vent_door_reaction_item.setKey("click_item", "0");

		$sewer_vent_filter_mover.move(DOWN, 32);
		
		sys.wait(4);
		
		$sewer_vent_filter.hide();
		$sewer_vent_filter.startSoundShader("e1m3_1_placebox", SND_CHANNEL_ANY);
		$sewer_vent_filter_removed.show();
		
		thread ShowNPCSubtitles("Lee", "Thanks. What about you? Any progress?", 2.25);
		thread CharacterSays($Scare_Vent_2, "sewer_filter_Lee2_vent");
		CharacterSays($player1, "sewer_filter_Lee2");
		CharacterSays($player1, "e1m3_1_walkie_beep");
		Beat(.5);
		
		thread ShowNPCSubtitles("Sam", "I think I see where I need to go. Two sec...", 2.25);
		CharacterSays($player1, "sewer_filter_Player2");
		Beat(.5);
		
		sewerInspectVentDoorState = 1;
		$sewer_vent_door_reaction_item.setKey("click_item", "1");

		ShowSewerClickers();
	}	
	
