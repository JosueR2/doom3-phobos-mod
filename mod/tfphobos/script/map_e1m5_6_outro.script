	void SetBombTime( float one, float two, float three, float four, float five)
	{
		$bomb.setGuiParm("gui_parm11", one);
		$bomb.setGuiParm("gui_parm12", two);
		$bomb.setGuiParm("gui_parm13", three);
		$bomb.setGuiParm("gui_parm14", four);
		$bomb.setGuiParm("gui_parm15", five);
		sys.trigger($bomb);
	}	
	
	void StartBomb()
	{
		// Max is how long the timer should be - in milliseconds
		float max = 41000;

		float one = 0;
		float two = 0;
		float three = 0;
		float four = 0;
		float five = 0;

		// Store the start in lastFrame. We will wait one frame before starting so we know how long has passed.
		float lastFrame = sys.getTime();

		while( max >= 0 )
		{
			sys.waitFrame();
			float timeDiff = sys.getTime() - lastFrame;

			float seconds = (max / 1000);
			float milliseconds = max % 1000;						

			// DecaSeconds
			one = seconds / 10;
			one = int(one);

			// Seconds
			two = seconds % 10;
			two = int(two);
			
			// Tenths
			three = milliseconds / 100;
			three = int(three);
			
			// Hundredths
			four = (milliseconds % 100) / 10;
			four = int(four);

			// Milliseconds
			five = milliseconds % 10;
			five = int(five);

			//sys.println("bomb time!: " + two);
			SetBombTime( one, two, three, four, five);
			
			max -= (timeDiff * 1000);

			lastFrame = sys.getTime();
		}
		SetBombTime( 0,0,0,0,0 );
	}

	void Outro_ShowBensonLeave(float duration)
	{
		$benson_barn_car_light_rotator.time(10);
		$benson_barn_car_light_rotator.accelTime(2);
		$benson_barn_car_light_rotator.decelTime(2);
		$benson_barn_camera_mover.move(270, 192);
		sys.trigger($benson_barn_camera);
		$player1.startSoundShader("sound/shav/e1m5_6/bensonleaving.ogg", SND_CHANNEL_ANY);
		sys.fadeTo('0 0 0', 0, .125);

		sys.wait(1.0);
		
		thread UpdateBensonBarnCamera(45, 100);
		
		thread crossFadeEnt($benson_barn_car_light_1, '0.729412 0.698039 0.458824', '0.18 0.17 0.11', 9);
		thread crossFadeEnt($benson_barn_car_light_2, '0.729412 0.698039 0.458824', '0.18 0.17 0.11', 9);

		sys.wait(4);
		
		//$player1.startSoundShader("sound/shav/e1m5_6/CarApproaching.ogg", SND_CHANNEL_ANY);

		$benson_barn_car_light_rotator.rotateOnce('0 180 0');

		sys.wait(12.0);

		thread StartBomb();

		sys.wait(10.0);
	}

