namespace map_e1m4_4
{

	//0 = closed
	//1 = open
	//2 = transitioning

	float sewerhole_state = 0;

	void OpenSewerHole()
	{
		if( sewerhole_state == 0)
		{
			$SewerHole_Switch.setKey("click_item", "0");	
			sewerhole_state = 2;

			$sewerhole_switch.rotateOnce('-90 0 0');
			sys.waitFor($sewerhole_switch);

			$sewerhole_switch.startSoundShader("one_shot_electrical_switch_heavy_1", SND_CHANNEL_ANY);
			$sewerhole_arm.rotateOnce('-135 0 0');

			sys.waitFor($sewerhole_arm);

			sewerhole_state = 1;
			
			$SewerHole_Switch.setKey("click_item", "1");			
		}
		else if( sewerhole_state == 1)
		{
			$SewerHole_Switch.setKey("click_item", "0");
			sewerhole_state = 2;

			$sewerhole_switch.rotateOnce('90 0 0');
			sys.waitFor($sewerhole_switch);

			$sewerhole_switch.startSoundShader("one_shot_electrical_switch_heavy_1", SND_CHANNEL_ANY);
			$sewerhole_arm.rotateOnce('135 0 0');

			sys.waitFor($sewerhole_arm);

			sewerhole_state = 0;
			
			$SewerHole_Switch.setKey("click_item", "1");			
		}
	}
	
	void BreakLadder()
	{
		$StartLadder1.move(DOWN, 56);
		
		sys.waitFor($StartLadder1);
		$StartLadder1.startSoundShader("al4_pounder_1second", SND_CHANNEL_ANY);
		$StartLadder1.startSoundShader("sound/shav/e1m4_4/ladderslide.ogg", SND_CHANNEL_ANY);

		sys.wait(.2);
		
		$StartLadder2.move(DOWN, 56);
		
		$StartLadder1.time(0.125);
		$StartLadder1.accelTime(0);		
		$StartLadder1.move(UP, 4);

		sys.waitFor($StartLadder2);

		$StartLadder1.move(DOWN, 4);
		
		$StartLadder2.time(0.125);
		$StartLadder2.accelTime(0);		
		
		$StartLadder2.move(UP, 4);

		sys.waitFor($StartLadder2);

		$StartLadder2.move(DOWN, 4);
		
		$StartLadder2.startSoundShader("al4_pounder_1second", SND_CHANNEL_ANY);
		
		sys.waitFor($StartLadder2);
		
		sys.trigger($func_static_85944);
	}	
		
	void SetTime( float one, float two, float three, float four, float five)
	{
		$hatchcounter.setGuiParm("gui_parm1", one);
		$hatchcounter.setGuiParm("gui_parm2", two);
		$hatchcounter.setGuiParm("gui_parm3", three);
		$hatchcounter.setGuiParm("gui_parm4", four);
		$hatchcounter.setGuiParm("gui_parm5", five);
		sys.trigger($hatchcounter);
	}

	void bloom_on()
	{
		float bloomFactor = -0.1;
		$player1.setBloomParms( 0, 0.01 );
		$player1.toggleBloom( 1 );
		
		while( bloomFactor > 0 )
		{
			$player1.setBloomParms( 0, bloomFactor );
			bloomFactor = bloomFactor - 0.001;
			sys.wait(.025);
		}
	}

	void bloom_off()
	{
       	$player1.toggleBloom( 0 );
	}

	void LostSign()
	{		
		sys.trigger($func_cameraview_1);	
		
		thread bloom_on();

		sys.fadeTo('0 0 0', 0, 1);
		
		$lostSign.startSoundShader("sound/shav/e1m4_2/losttitles.ogg", SND_CHANNEL_ANY);
		$lostSign.move(UP, 768);
		$lostSign.rotateOnce('0 -70 0');
		
		sys.waitFor($lostSign);
		
		//sys.wait(50);
		bloom_off();
		sys.trigger($func_cameraview_1);
	}

	float roundDone = 0;

void LostCounter()
{
	while(1 == 1)
	{
	//float max = 60 * 4;
	float max = 72;

	float one = 0;
	float two = 0;
	float three = 0;
	float four = 0;
	float five = 0;

	float secondCounter = 0;
	float minuteCounter = 108;

	if( roundDone > 0 )
	{			
		max = 108*60;				
	}
	
	while( max >= 0 )
	{						
		float minutes = (max / 60);
		minutes = int(minutes);
		
		float seconds = (max % 60);
		seconds = int(seconds);

		if( minutes > 2 )
		{
			if (max - minutes*60 > 0 )
			{
				minutes++;
			}

			seconds = 0;
		}		
	
		one = (minutes / 100);
		one = int(one);
		
		two = ((minutes - (one * 100)) / 10);
		two = int(two);
		
		three = ((minutes - (one * 100)) % 10);
		three = int(three);
		
		four = (seconds / 10 );
		four = int(four);
		
		five = (seconds % 10);
		five = int(five);
		
		SetTime( one, two, three, four, five);
		
		if(roundDone > 0)
		{
			sys.wait(1);
			$player1.startSoundShader("sound/shav/e1m4_2/lostend.wav", SND_CHANNEL_ANY);
			sys.wait(4.6);

			sys.fadeTo('0 0 0', 1, 0.01);

			sys.wait(5);			

			LostSign();
			
			sys.trigger($teleport_postlost);

			$bomb_hatch.show();

			return;			
		}

		if( minutes < 3 )
		{
			$hatchcounter.startSoundShader("sound/shav/e1m4_2/timer_tick.wav", SND_CHANNEL_ANY);
		}
		else
		{
			if( max % 60 == 0)
			{
				$hatchcounter.startSoundShader("sound/shav/e1m4_2/timer_tick.wav", SND_CHANNEL_ANY);
			}
		}

		if( minutes < 4 )
		{
			if( minutes < 1 )
			{
				if( seconds <= 10 )
				{
					$hatchcounter.startSoundShader("sound/shav/e1m4_2/timer_alarm.wav", SND_CHANNEL_ANY);										
				}
				else
				{
					if( seconds % 2 == 0 )
						$hatchcounter.startSoundShader("sound/shav/e1m4_2/timer_alarm.wav", SND_CHANNEL_ANY);										
				}
			}
			else
			{				
				if( seconds % 2 == 0 )
					$hatchcounter.startSoundShader("sound/shav/e1m4_2/timer_beep.wav", SND_CHANNEL_ANY);		
			}
		}	
		
		max--;
		
		sys.wait(.75);

		if( roundDone > 0)
		{
			$hatchcounter.startSoundShader("sound/shav/e1m4_2/code_ok.wav", SND_CHANNEL_ANY);
			break;
		}
	}	

	sys.wait(.75);		
	
	if( roundDone > 0)
	{
		$hatchcounter.startSoundShader("sound/shav/e1m4_2/timer_reset.wav", SND_CHANNEL_ANY);		
	}
	else
	{
		$hatchcounter.startSoundShader("sound/shav/e1m4_2/time_out_and_abort.wav", SND_CHANNEL_ANY);
	}
	
	if( roundDone == 0)
	{
		float index = 0;
		while( index < 110 )
		{
			one = int(sys.random(9));
			two = int(sys.random(9));
			three = int(sys.random(9));
			four = int(sys.random(9));
			five = int(sys.random(9));		

			if( index > 54 )
				four = 11;
		
			if( index > 60 )
				three = 11;
				
			if( index > 76 )
				five = 11;
				
			if( index > 94 )
				one = 11;
				
			if( index > 99 )
				two = 11;
				
			//if( index == 100 )
				//$func_static_1.startSoundShader("sound/shav/e1m4_2/em_spinup_full.ogg", SND_CHANNEL_ANY);
		
			SetTime( one, two, three, four, five);
		
			index = index + 1;
			sys.wait(0.1);
			
			roundDone = 1;
		}
	}	
	
	$hatchcounter.startSoundShader("sound/shav/e1m4_2/timer_reset.wav", SND_CHANNEL_ANY);
	
	index = 0;
	while( index < 10 )
	{
		one = int(sys.random(9));
		two = int(sys.random(9));
		three = int(sys.random(9));
		four = int(sys.random(9));
		five = int(sys.random(9));
	
		SetTime( one, two, three, four, five);	
	
		index = index + 1;
			sys.wait(0.1);			
		}
		
		//$func_static_1.setGuiParm("gui_parm7", 0);
		//sys.trigger($func_static_1);
		}
	}

	void Execute()
	{
		roundDone = 1;
	}

