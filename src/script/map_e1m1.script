	void BoxPostBlur()
	{
		float xm = 0.0016;
		float ym = 0.00213333;

		float xs = xm / 10;
		float ys = ym / 10;

		float xv = xm;
		float yv = ym;

		float c = 0;

		while(c < 10)
		{
			xv += xs;
			yv += ys;

			$box_postscene_blur.setShaderParm(3, xv);
			$box_postscene_blur.setShaderParm(4, yv);

			sys.wait(.1);
			c++;
		}

		c = 0;		

		while(c < 10)
		{
			xv -= xs;
			yv -= ys;

			$box_postscene_blur.setShaderParm(3, xv);
			$box_postscene_blur.setShaderParm(4, yv);

			sys.wait(.1);
			c++;
		}

		c = 0;

		while(c < 10)
		{
			xv += xs;
			yv += ys;

			$box_postscene_blur.setShaderParm(3, xv);
			$box_postscene_blur.setShaderParm(4, yv);

			sys.wait(.1);
			c++;
		}

		c = 0;
		
		while(c < 10)
		{
			xv -= xs;
			yv -= ys;

			$box_postscene_blur.setShaderParm(3, xv);
			$box_postscene_blur.setShaderParm(4, yv);

			sys.wait(.1);
			c++;
		}

		c = 0;

		while(c < 10)
		{
			xv += xs;
			yv += ys;

			$box_postscene_blur.setShaderParm(3, xv);
			$box_postscene_blur.setShaderParm(4, yv);

			sys.wait(.1);
			c++;
		}

		c = 0;
		
		while(c < 10)
		{
			xv -= xs;
			yv -= ys;

			$box_postscene_blur.setShaderParm(3, xv);
			$box_postscene_blur.setShaderParm(4, yv);

			sys.wait(.1);
			c++;
		}

		c = 0;

		while(c < 10)
		{
			xv += xs;
			yv += ys;

			$box_postscene_blur.setShaderParm(3, xv);
			$box_postscene_blur.setShaderParm(4, yv);

			sys.wait(.1);
			c++;
		}

		c = 0;

		while(c < 20)
		{
			xv -= xs;
			yv -= ys;

			$box_postscene_blur.setShaderParm(3, xv);
			$box_postscene_blur.setShaderParm(4, yv);

			sys.wait(.1);
			c++;


		}

		sys.fadeTo('0 0 0', .95, .75);

		sys.wait(.1);

		$box_postscene_blur.hide();

		sys.wait(.1);

		sys.fadeTo('0 0 0', 0, .75);
	}

	void EndBoxTrip()
	{
		if (map_intro::introSkipped == 1)
		{
			return;
		}

		$box_postscene_blur.show();

		sys.trigger($box_postscene_fade1);

		sys.trigger($target_setinfluence_5);

		sys.wait(1);		

		sys.wait(3);

		thread BoxPostBlur();

		sys.wait(3);

		thread ShowNPCSubtitles("...", "Uh! My head.", 1.5);
		sys.trigger($speaker_1037);

		sys.wait(2);

		sys.trigger($box_postscene_fade2);		
		
		sys.wait(4);		

		sys.wait(4);		

		sys.waitFor($box_postscene_cameraMover);

		$box_postscene_cameraMover.moveTo($box_postscene_camdest);
		$box_postscene_cameraMover.rotateOnce('90 0 0');		

		sys.waitFor($box_postscene_cameraMover);
		
		sys.wait(.1);

		sys.trigger($info_player_teleport_4);
		sys.trigger($box_postscene_camera);

		map_intro::activeCam = 0;
		map_intro::introActive = 0;
		map_intro::canSkipIntro = 0;
		PhobosSetCanSkip(0);
	}

	void showTextCam(string text, entity e)
	{		
		e.setGuiParm("gui_parm1", text);
		e.setGuiParm("gui_parm2", 0);
		sys.trigger(e);

		sys.wait(2);

		sys.wait(4);

		e.setGuiParm("gui_parm2", 1);
		sys.trigger(e);

		sys.wait(1);		
	}

	void showText(string text)
	{
		sys.wait(1);

		float num = 1;
		
			entity e = sys.getEntity("cameraGui" + num);
			thread showTextCam(text, e);
			num++;	

		sys.wait(7);
	}

	void SkipIntroSequence()
	{
		if (map_intro::canSkipIntro == 0 || map_intro::introSkipped == 1 || map_intro::introActive == 0)
		{
			return;
		}
		map_intro::introSkipped = 1;
		map_intro::introActive = 0;
		map_intro::canSkipIntro = 0;
		PhobosSetCanSkip(0);

		// Terminate all possible intro threads
		sys.killthread("map_e1m1::RunIntroGogo");
		sys.killthread("map_e1m1::EnableSkipTimer");
		sys.killthread("map_intro::Gogo");
		sys.killthread("map_intro::turnOffHouseLights");
		sys.killthread("map_intro::showText");
		sys.killthread("map_intro::showTextCam");
		sys.killthread("map_intro::ShowNPCSubtitles");
		sys.killthread("map_intro::SubtitlesRunning");
		sys.killthread("map_intro::Lee4Sub");
		sys.killthread("map_intro::ExitWindow");
		sys.killthread("map_intro::TalkFence");
		sys.killthread("map_intro::BlueTunnel");
		sys.killthread("map_e1m1::EndBoxTrip");
		sys.killthread("map_e1m1::BoxPostBlur");

		// Hide any lingering subtitles
		sys.hideSubtitles();

		// Safely toggle off any active camera
		if (map_intro::activeCam == 1)
		{
			sys.trigger($introCamera);
		}
		else if (map_intro::activeCam == 2)
		{
			sys.trigger($BlueWorldCam);
		}
		else if (map_intro::activeCam == 3)
		{
			sys.trigger($box_postscene_camera);
		}
		map_intro::activeCam = 0;

		// Teleport player directly to Mars bedroom start
		sys.trigger($info_player_teleport_4);

		// Set Mars influence & objectives
		sys.trigger($target_setinfluence_5);

		// Ensure PDA item is granted
		sys.trigger($trigger_relay_69);

		// Alarm clock rotated
		$outro_alarmclock.rotateOnce('0 -35 0');

		// Clean up post-scene blur and restore visual
		$box_postscene_blur.hide();
		sys.fadeTo('0 0 0', 0, 0.2);

		$introCamera.stopSound(SND_CHANNEL_ANY, 0);
		$player1.stopSound(SND_CHANNEL_ANY, 0);

		sys.print("Phobos Mod: Intro sequence skipped!\n");
	}

	void EnableSkipTimer()
	{
		// Wait 2 seconds for the scene to settle and ignore any clicks from the menu
		sys.wait(2.0);

		if (map_intro::introSkipped == 0 && map_intro::introActive == 1)
		{
			map_intro::canSkipIntro = 1;
			PhobosSetCanSkip(1);
		}
	}

	void RunIntroGogo()
	{
		map_intro::Gogo();
	}

	void StartIntro()
	{
		$outro_alarmclock.rotateOnce('0 -35 0');
		sys.trigger($trigger_relay_69);
		
		map_intro::introActive = 1;
		map_intro::introSkipped = 0;
		map_intro::canSkipIntro = 0;

		thread EnableSkipTimer();

		thread RunIntroGogo();
	}

	void StartPads()
	{
		$m1_pads.startSoundShader("e1m1_pads", SND_CHANNEL_ANY);
	}

	float Floor(float value, float max)
	{
		float i = max;

		while(i > 0)
		{
			if(value < i && value > i - 1)
				return i - 1;

				i--;
		}

		return value;
	}

	void WindowGlitch(float num)
	{		
		entity monitor = sys.getEntity("intro_monitors_fake_" + num);
		entity gui = sys.getEntity("intro_gui_flicker_" + num);

		sys.trigger(gui);

		sys.wait(1.8f);
		sys.trigger(gui);	
	}

	void FakeWindowGlitches()
	{
		while(1)
		{
			float delay = sys.random(20) + 3;
			sys.wait(delay);

			float rnd = 56;
			
			sys.trigger($glitchspeaker);

			float i = 0;
			while(i < rnd)
			{
				float num = sys.random(8) + 1;
				num = Floor(num, 9);

				thread WindowGlitch(num);

				sys.wait(.1);
				i++;
			}
		}
	}
	
	void SetupBoxCageSide(string prefix)
	{
		float i = 0;

		while(i < 5)
		{
			entity shutter = sys.getEntity(prefix + (i+1));
			entity rotator = sys.getEntity(prefix + "rotator_" + (i+1));

			vector rv = rotator.getVectorKey("rot");
						
			rotator.rotateOnce(rv);
			sys.waitFor(rotator);

			shutter.bind(rotator);

			rotator.accelTime(.25);
			rotator.decelTime(.5);
			rotator.time(3);
			
			i++;
		}
	}

	void SetupBoxCage()
	{
		thread SetupBoxCageSide("box_shutter_southwest_");
		thread SetupBoxCageSide("box_shutter_south_");
		thread SetupBoxCageSide("box_shutter_southeast_");
		thread SetupBoxCageSide("box_shutter_east_");
		thread SetupBoxCageSide("box_shutter_northeast_");
		thread SetupBoxCageSide("box_shutter_north_");
		thread SetupBoxCageSide("box_shutter_northwest_");
		thread SetupBoxCageSide("box_shutter_west_");		
	}	

	void OpenBoxCageSide(string prefix)
	{
		float i = 0;

		while(i < 5)
		{
			entity shutter = sys.getEntity(prefix + "rotator_" + (i+1));
			shutter.rotateOnce('0 0 -55');
			
			shutter.move(UP, (i) * 24 + 8);
			
			sys.wait(.25);

			i++;
		}
	}

	void OpenBoxCage()
	{
		thread ShowNPCSubtitles("...", "Hello? Anyone?\nWhat is this place?", 4);
		sys.trigger($speaker_1023);
		
		sys.trigger($setup_talk_relay);
		
		$speaker_lightson_music.startSoundShader("e1m1_lightson", SND_CHANNEL_PDA);

		thread OpenBoxCageSide("box_shutter_north_");		
		$box_glass_wat.setKey("click_item", 1);		
		
		sys.wait(.5);
		thread OpenBoxCageSide("box_shutter_northeast_");
		thread OpenBoxCageSide("box_shutter_northwest_");
		
		sys.wait(.5);
		thread OpenBoxCageSide("box_shutter_east_");
		thread OpenBoxCageSide("box_shutter_west_");
		sys.wait(.5);		

		thread OpenBoxCageSide("box_shutter_south_");
		thread OpenBoxCageSide("box_shutter_southeast_");
		sys.wait(.5);
		thread OpenBoxCageSide("box_shutter_southwest_");

		sys.wait(1);		
	}

	void AnimateClockColon()
	{
		while(1)
		{
			sys.wait(.75);
			sys.trigger($info_screen_time_colon);
		}
	}

	void AnimateClock()
	{
		thread AnimateClockColon();

		float currentTime = 0;

		while(currentTime < 60)
		{
			float tens = Floor(currentTime / 10, 9);
			float ones = currentTime % 10;

			entity tensEntity = sys.getEntity("info_screen_time_" + tens + "x");
			entity onesEntity = sys.getEntity("info_screen_time_x" + ones);
			
			tensEntity.show();
			onesEntity.show();

			sys.wait(60);

			currentTime++;

			if(currentTime < 60)
			{
				tensEntity.hide();
				onesEntity.hide();
			}
		}
	}

	void SetupClock()
	{
		float i = 0;
		while( i < 10)
		{
			if(i < 6)
				sys.getEntity("info_screen_time_" + i + "x").hide();
				
			sys.getEntity("info_screen_time_x" + i).hide();

			i++;
		}
	}

	void SlideDoor()
	{
		$GlassDoor.move(180, 64);
	}

	void ShowerOff()
	{		
		$ShowerKnob.rotateOnce('0 0 45');
		sys.wait(.5);					
		$ShowerBeams.move(DOWN, 128);	
		sys.wait(.75);
		sys.trigger($speaker_130);	
		sys.wait(.25);
		sys.trigger($ShowerSplash);
		sys.wait(.5);
		sys.trigger($DrainSplash);
		sys.waitFor($ShowerBeams);
		$ShowerBeams.hide();		
	}

	void GrabSharpies()
	{
		thread ShowNPCSubtitles("...", "Hmm.", 2);
		thread CharacterSays($player1, "sound/shav/e1m3/pickupbox.ogg");

		sys.trigger($RemoveSharpies);
		sys.trigger($speaker_1056);		
		$whiteboard_max_1.setKey("click_item", 1);		
	}

	float needCode = 0;

	void CodeTalk()
	{
		if(needCode == 0)
		{			
			thread ShowNPCSubtitles("...", "Seems to be a code.", 2);
			sys.trigger($speaker_129);
		}
		else
		{
			thread ShowNPCSubtitles("...", "I guess that's the code.", 2);
			sys.trigger($speaker_1061);
		}
	}

	void NeedCode()
	{
		thread ShowNPCSubtitles("...", "I Should probably look for a code.", 2);
		needCode = 1;
	}	
	
