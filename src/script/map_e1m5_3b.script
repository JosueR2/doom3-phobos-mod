	void BasementBookcaseCheck()
	{
		if(knobLeftState == 3 && knobRightState == 2)
		{
			$basement_vault_knob_left_clicker.hide();
			$basement_vault_knob_right_clicker.hide();

			$vault_bookcase.accelTime(1);
			$vault_bookcase.decelTime(1);
			$vault_bookcase.time(10);
			$vault_bookcase.startSoundShader("sound/shav/e1m4/rolling.ogg", SND_CHANNEL_ANY);

			$vault_bookcase.move(DOWN, 110);

			sys.waitFor($vault_bookcase);

			sys.wait(.5);

			$vault_handles_clicker.setKey("click_item", 1);
		}
	}

