	void Miles12Sub()
	{
		PhobosShowSubtitle_e1m5_2("Miles", "I guess, technically, but he hasn't checked in for a long time.");		
		sys.wait(7.25);		
		PhobosShowSubtitle_e1m5_2("Miles", "Oh, right, speaking of the Bulwark.\nI think things have changed a bit.");
		sys.wait(7);
		PhobosShowSubtitle_e1m5_2("Miles", "They may have had to retreat further back into the complex.\nIt's not as safe as we initially thought.");
	}

	void Miles7Sub()
	{
		PhobosShowSubtitle_e1m5_2("Miles", "Yes! Well we've been orbiting the base for a couple of hours now.\nWe're just about to depart for the surface.");
		sys.wait(5.75);
		PhobosShowSubtitle_e1m5_2("Miles", "I hope it's not too bad down there.");
	}

	void Miles11Sub()
	{
		PhobosShowSubtitle_e1m5_2("Miles", "Sort of. Personnel on the different bases mostly work in shifts.");
		sys.wait(4);
		PhobosShowSubtitle_e1m5_2("Miles", "They rarely live at their workplace\nunless of course they work at the Bulwark itself.");
	}
	
	void Miles14Sub()
	{
		PhobosShowSubtitle_e1m5_2("Miles", "I wish I knew. With all that's been going on,\nI don't know what to hope for.");
		sys.wait(7);
		PhobosShowSubtitle_e1m5_2("Miles", "If they got to him, he could have been detained.\nIf not, he may be in hiding.");
		sys.wait(7.25);
		PhobosShowSubtitle_e1m5_2("Miles", "I can't tell you exactly where to go,\nbut I'm sure there are clues as to what happened to him.");
	}

	void Miles15Sub()
	{
		PhobosShowSubtitle_e1m5_2("Miles", "I hope not, but he's been silent for so long and with all of this going on,\nit's hard to say.");
		sys.wait(6);
		PhobosShowSubtitle_e1m5_2("Miles", "I...I'm sorry...\nI don't know what to say.");
	}

	void MilesCall1()
	{
		PhobosShowSubtitle_e1m5_2("Miles", "Sam? Are you there?");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles1.ogg");
		
		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Sam", "Miles? How did you...?");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player1.ogg");	

		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Miles", "It wasn't me. The radio indicated that you were in range.\nYou must be close to federal equipment!");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles2.ogg");
		
		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Sam", "Yeah I think I'm getting close!");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player2.ogg");	

		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Miles", "I'm so glad you're safe.\nYou ARE safe, right?");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles3.ogg");
		
		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Sam", "I think so.\nWell, yes. All things considered.");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player3.ogg");	

		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Miles", "So what happened back there?");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles4.ogg");
		
		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Sam", "The bomb? Yeah. I forgot to review the settings...\nhad 3 seconds to get out of there.");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player4.ogg");	

		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Miles", "Ooof.");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles5.ogg");
		
		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Sam", "I woke up on the other side of the room with ringing in my ears.\n...But I'm okay. It subsided.");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player5.ogg");	

		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Miles", "Having fun without me I see.\nI wish I could help you more directly...");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles6.ogg");
		
		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Sam", "So do I.\nDid you ever reach Phobos?");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player6.ogg");	

		Beat(.5);
		
		thread Miles7Sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles7.ogg");
		
		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Sam", "What are you going to do once you get there?");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player7.ogg");	

		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Miles", "Almost all personnel has been drawn back to Phobos to secure some important assets.\nI'm part of the task force.");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles8.ogg");
		
		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Sam", "Assets on Phobos?");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player8.ogg");

		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Miles", "Yeah. Our most prized research is located on Phobos.\nTeleportation. Receptacle base.");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles9.ogg");
		
		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Sam", "Calloway is usually stationed on that base, right?\nI think he mentioned that in his message to you.");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player9.ogg");	

		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Miles", "Yup. Exactly.\nIt's where he works.");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles10.ogg");
		
		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Sam", "Right. But then he lives on Mars? In the Bulwark?\nOr how does that work?");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player10.ogg");

		Beat(.5);
		
		thread Miles11Sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles11.ogg");
		
		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Sam", "So there's a chance he may still be there?\nOn Phobos?");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player11.ogg");

		Beat(.5);
		
		thread Miles12Sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles12.ogg");
		
		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Sam", "What, so I can't grab a cold one and relax?");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player12.ogg");

		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Miles", "That may have to wait.");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles13.ogg");
		
		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Sam", "I had it all planned out, too...\nSo where do I find Calloway?");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player13.ogg");

		Beat(.5);
		
		thread Miles14Sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles14.ogg");
		
		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Sam", "Sounds reassuring.\nSo you think something bad happened to him?");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player14.ogg");

		Beat(.5);
		
		thread Miles15Sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles15.ogg");

		sys.hideSubtitles();

		$func_static_100810.setKey("item_disabled", 0);
	}
	
	void Miles17Sub()
	{
		PhobosShowSubtitle_e1m5_2("Miles", "Does it really matter all that much?");		
		sys.wait(3.25);		
		PhobosShowSubtitle_e1m5_2("Miles", "We have a tendency to shape our identity way too much by what we have done.");
		sys.wait(5);	
		PhobosShowSubtitle_e1m5_2("Miles", "And not enough by what we want to do and what we want to accomplish.\nWho we want to be.");
		sys.wait(5.75);		
		PhobosShowSubtitle_e1m5_2("Miles", "You have been given a clean slate.\nYou're a free man!");
	}
	
	void Miles18Sub()
	{
		PhobosShowSubtitle_e1m5_2("Miles", "What about all the bad memories? Getting bullied at school.\nThe first time you lost a pet.");		
		sys.wait(8);		
		PhobosShowSubtitle_e1m5_2("Miles", "Family members getting sick, dying? Losing your job. The love of your life leaving you?\nDo you really need all that baggage?");		
		sys.wait(10.25);		
		PhobosShowSubtitle_e1m5_2("Miles", "To be honest, sometimes I wish I could forget everything.");
	}
	
	void Miles19Sub()
	{
		PhobosShowSubtitle_e1m5_2("Miles", "That's true, but there will never be a shortage of possibilities for failure.");
		sys.wait(7.25);
		PhobosShowSubtitle_e1m5_2("Miles", "I mean you'll make new mistakes, but you'll have the luxury of forgetting the old.");
		sys.wait(6.25);
		PhobosShowSubtitle_e1m5_2("Miles", "Think of it this way. About every two weeks, most of your skin cells have been replaced.");		
		sys.wait(6);
		PhobosShowSubtitle_e1m5_2("Miles", "Going 7 years, every atom in your body has been exchanged for another.");	
		sys.wait(5);		
		PhobosShowSubtitle_e1m5_2("Miles", "None of what you are made up of is the same as the you from 7 years ago.");
		sys.wait(5);
		PhobosShowSubtitle_e1m5_2("Miles", "So why do we have to act as if we're still the same person?");
	}
	
	void Miles20Sub()
	{
		PhobosShowSubtitle_e1m5_2("Miles", "And vice versa. Look. I'm not telling you how to feel or what to think.");		
		sys.wait(7.5);		
		PhobosShowSubtitle_e1m5_2("Miles", "I'm sure you'll recover your memory, but even if you don't.");
		sys.wait(4.5);		
		PhobosShowSubtitle_e1m5_2("Miles", "Something good could come of it.\nYou're a good person, Sam. I wish I had met you sooner.");
	}
	
	void Miles21Sub()
	{
		PhobosShowSubtitle_e1m5_2("Miles", "Don't say anything.");
		sys.wait(2);		
		PhobosShowSubtitle_e1m5_2("Miles", "I have to leave. We're departing for the surface soon,\nbut I just wanted to reconnect with you.");	
		sys.wait(5.75);	
		PhobosShowSubtitle_e1m5_2("Miles", "I'm so glad you're still with me.\nI'm sorry for all of this.");	
		sys.wait(4);
		PhobosShowSubtitle_e1m5_2("Miles", "Be careful, okay?");
	}

	void Player18Sub()
	{
		PhobosShowSubtitle_e1m5_2("Sam", "But, aren't those the memories that shape who you are the most?");
		sys.wait(3.75);
		PhobosShowSubtitle_e1m5_2("Sam", "Would you be the same Samantha Miles if you had not experienced all those bad times?");
	}
	
	void MilesCall2()
	{
		PhobosShowSubtitle_e1m5_2("Sam", "Samantha? I was thinking. What if I never recover my memory?");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player15.ogg");

		Beat(.5);
	
		PhobosShowSubtitle_e1m5_2("Miles", "I'm sure you will, but even if you don't...\nWould that be so bad?");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles16.ogg");
		
		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Sam", "But if I don't, how will I know who I was?\nWho I am?");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player16.ogg");

		Beat(.5);
		
		thread Miles17Sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles17.ogg");
		
		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Sam", "What about all the good memories?\nI must be missing out on a few great times.");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player17.ogg");

		Beat(.5);
		
		thread Miles18Sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles18.ogg");
		
		Beat(.5);
		
		thread Player18Sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player18.ogg");
		
		Beat(.5);
		
		thread Miles19Sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles19.ogg");
		
		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Sam", "Sure, that's easy to say when you don't lack an identity.");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player19.ogg");

		Beat(.5);
		
		thread Miles20Sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles20.ogg");
		
		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Sam", "Thanks. Now I don't know what to say.");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player20.ogg");

		Beat(.5);
		
		thread Miles21Sub();
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Miles21.ogg");
		
		Beat(.5);
		
		PhobosShowSubtitle_e1m5_2("Sam", "You too, Smiles.");
		CharacterSays($Sam_Miles_Convo_Spkr, "sound/vo/e1m5_2/MilesCall/Player21.ogg");
		
		Beat(.5);
		
		sys.hideSubtitles();

		sys.trigger($levelexit_relay);
	}
	
