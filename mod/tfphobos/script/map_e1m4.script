	float hideSubTime = 0;

	void SubtitlesRunning()
	{
		while(hideSubTime > sys.getTime())		
		{			
			sys.waitFrame();
		}
		sys.hideSubtitles();
	}

	void ShowNPCSubtitles(string name, string titles, float duration)
	{
		PhobosShowSubtitle_e1m4(name, titles);
		hideSubTime = sys.getTime() + duration;
		sys.wait(duration);
		if(hideSubTime <= sys.getTime())
		{
			sys.hideSubtitles();
		}
		else
		{
			thread SubtitlesRunning();
		}
	}
	
	void CharacterSays(entity characterEntity, string line)
	{
		sys.wait(characterEntity.startSoundShader(line, SND_CHANNEL_ANY));
	}
	
	void Beat(float delay)
	{
		sys.wait(delay);
	}
	
	void StartObjectiveTwo()
	{
		objective_drainsecondpipe_state = 1;
	}

	void SetLock(float pipe, float state, float oldState)
	{
		entity door1 = sys.getEntity("fuelpipe0" + pipe + "_hatch01");
		entity door2 = sys.getEntity("fuelpipe0" + pipe + "_hatch02");
		entity gui1 = sys.getEntity("fuelpipe0" + pipe + "_hatch01_gui");
		entity gui2 = sys.getEntity("fuelpipe0" + pipe + "_hatch02_gui");
		entity light1 = sys.getEntity("fuelpipe0" + pipe + "_hatch01_light_" + (1 - state));
		entity light2 = sys.getEntity("fuelpipe0" + pipe + "_hatch02_light_" + (1 - state));		
		entity tex_red = sys.getEntity("fuelpipe0" + pipe + "_hatch01_tex_red");
		entity tex_red2 = sys.getEntity("fuelpipe0" + pipe + "_hatch02_tex_red");
		entity tex_green = sys.getEntity("fuelpipe0" + pipe + "_hatch01_tex_green");
		entity tex_green2 = sys.getEntity("fuelpipe0" + pipe + "_hatch02_tex_green");
		entity flare_red = sys.getEntity("fuelpipe0" + pipe + "_flare_0");
		entity flare_green = sys.getEntity("fuelpipe0" + pipe + "_flare_1");
		
		door1.lock(state);
		door2.lock(state);
		gui1.setGuiParm("gui_parm2", state);
		sys.trigger(gui1);
		gui2.setGuiParm("gui_parm2", state);
		sys.trigger(gui2);
		sys.trigger(light1);
		sys.trigger(light2);
		
		if(state == 1)
		{
			thread crossFadeEnt (flare_red, '0 0 0', '.5 0 0', .125);
			thread crossFadeEnt (flare_green, '0 .5 0', '0 0 0', .125);
		}
		else
		{
			thread crossFadeEnt (flare_red, '.5 0 0', '0 0 0', .125);
			thread crossFadeEnt (flare_green, '0 0 0', '0 .5 0', .125);
		}
		

		if(oldState != state)
		{
			sys.trigger(tex_red);
			sys.trigger(tex_green);
			sys.trigger(tex_red2);
			sys.trigger(tex_green2);
		}
	}

	float cargoLineReady = 0;

	void TransferFuel1()
	{		
		float oldState = $fuelcontrol.getGuiParmFloat (1, "gui_parm1");
		float oS1 = 0;
		float oS2 = 0;
		float oS3 = 0;

		if(oldState == 1)
		{
			oS1 = 1;
		}
		else if(oldState == 2)
		{
			oS2 = 1;
		}
		else
		{
			oS3 = 1;
		}

		$fuelcontrol.setGuiParm("gui_parm1", 1);
		sys.trigger($fuelcontrol);

		$fuelcontrol.startSoundShader("e1m3_2_beepx3", SND_CHANNEL_ANY);
		$fuelcontrol.startSoundShader("bridge_up_speaker", SND_CHANNEL_ANY);
		sys.trigger($speakerDrain);
		
		sys.wait(4.75);
		
		sys.trigger($speakerDrain);
		$fuelcontrol.startSoundShader("bridge_down_speaker", SND_CHANNEL_ANY);
		$fuelcontrol.startSoundShader("e1m3_2_beepx3", SND_CHANNEL_ANY);

		SetLock(1, 1, oS1);
		SetLock(2, 0, oS2);
		SetLock(3, 0, oS3);

		cargoLineReady = 0;
	}

