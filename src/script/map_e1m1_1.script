	void Miles2Sub()
	{
		PhobosShowSubtitle_e1m1_1("Miles", "Oh yeah. Right. I know.");
		
		sys.wait(2);
		
		PhobosShowSubtitle_e1m1_1("Miles", "This...This is Samantha Miles.");
		
		sys.wait(3);
		
		PhobosShowSubtitle_e1m1_1("Miles", "Our short...ugh...our short range communication is acting up.");
		
		sys.wait(5);
		
		ShowNPCSubtitles("Miles", "You need to find a stable and secure connection and call me back.\nWe need to talk.", 5);
	}
	
	void MilesCalls()
	{		
		m1trainstate = 2;
		
		thread CharacterSays(playerC, "sound/shav/general/radioincoming.ogg");
		Beat(2.25);		
		thread CharacterSays(playerC, "sound/shav/general/radioincoming.ogg");
		Beat(2.25);
		thread CharacterSays(playerC, "sound/shav/general/radioincoming.ogg");
		
		PhobosShowSubtitle_e1m1_1("...", "Oh shit. Is that me?");
		thread CharacterSays(playerC, "sound/vo/player/general/OhShitIsThatMe.ogg");
		Beat(2.25);
		thread CharacterSays(playerC, "sound/shav/general/radioincoming.ogg");
		Beat(2.25);

		playerC.startSoundShader("sound/shav/e1m1/intercomclick1.ogg", SND_CHANNEL_ANY);
		sys.trigger($func_radiochatter_1);
		Beat(1.25);
		
		PhobosShowSubtitle_e1m1_1("...", "Hello?\nThis is me speaking.");
		CharacterSays(playerC, "sound/vo/e1m1/milescall1/player1.ogg");
		Beat(.25);
		
		PhobosShowSubtitle_e1m1_1("Miles", "Sam?");
		CharacterSays(playerC, "sound/vo/e1m1/milescall1/miles1.ogg");
		Beat(.5);
		
		PhobosShowSubtitle_e1m1_1("...", "I wouldn't know.\nI lost my memory.");
		CharacterSays(playerC, "sound/vo/e1m1/milescall1/player2.ogg");
		Beat(.75);
		
		thread Miles2Sub();
		CharacterSays(playerC, "sound/vo/e1m1/milescall1/miles2.ogg");
		Beat(.5);
		playerC.startSoundShader("sound/shav/e1m1/intercomclick2.ogg", SND_CHANNEL_ANY);
		Beat(1);
		sys.trigger($trigger_confroom_objective);
	}

	float callMilesCompleted = 0;
	void CallMilesCSInterupt(entity characterEntity, string line, float interrupt)
    {
		if(callMilesCompleted == 0)
		{
			sys.wait(characterEntity.startSoundShader(line, SND_CHANNEL_ANY) - interrupt);
		}		
    }	
	
	void CompleteCallMiles()
	{
		if(callMilesCompleted == 0)
		{
			callMilesCompleted = 1;
			sys.hideSubtitles();
		}
	}

	void CallMilesCS(entity entity, string line)
	{
		if(callMilesCompleted == 0)
		{
			CharacterSays(entity, line);
		}
	}	

	void CallMilesBeat(float amount)
	{
		if(callMilesCompleted == 0)
		{
			Beat(amount);
		}
	}

