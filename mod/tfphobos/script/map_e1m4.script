	void CargoLoop()
	{
		thread CargoLoopRed();
		thread CargoLoopBlue();
		thread CargoLoopOrange();
		sys.wait(9);
		thread CargoLoopGreen();
	}

	float cargofuelstate = 0;	
	float cargofuelobjectivestate = 0;

	void FuelCargo()
	{
		$FuelToCargo_Clicker.setKey ("click_item", "0");
		
		if(cargoLineReady == 1)
		{
			$FuelToCargo_Handle.move(DOWN, 8);
			$FuelToCargo_Handle.startSoundShader("one_shot_electrical_switch_heavy_1", SND_CHANNEL_VOICE2 );
			sys.wait(.125);

			$FuelToCargo_Handle.startSoundShader("mech_fingers_1_5s", SND_CHANNEL_ANY );

			sys.wait(1.5);

			sys.trigger($FuelToCargo_Relay);			
			
			//show/hide flares
			$func_static_88001.hide();
			$func_static_88004.show();
			
			thread crossFadeEnt ($CargoFuelFlare, '0 0 0', '0.141176 0.654902 1', 1);
			thread crossFadeEnt ($CargoFuelLight, '0 0 0', '0.141176 0.654902 1', 1);
			
			thread crossFadeEnt ($CargoFuelFlare_2, '0 0 0', '0.141176 0.654902 1', 1);
			thread crossFadeEnt ($CargoFuelLight_2, '0 0 0', '0.141176 0.654902 1', 1);
			
			thread crossFadeEnt ($CargoFuelFlare_3, '0 0 0', '0.141176 0.654902 1', 1);
			thread crossFadeEnt ($CargoFuelLight_3, '0 0 0', '0.141176 0.654902 1', 1);

			cargofuelstate = 1;
			
			sys.wait(.5);
			
			if(cargofuelobjectivestate == 1)
			{
				sys.trigger($item_objective_5);
			}	
		}
		else
		{			
			thread ShowNPCSubtitles("PA", "Fuel pipe is empty.\nPlease fill fuel pipe.", 4.15);
			sys.wait($player1.startSoundShader("e1m4_fuel_pipe_empty", SND_CHANNEL_VOICE2 ));

			$FuelToCargo_Clicker.setKey ("click_item", "1");
			
			sys.wait(.5);
			
			if(cargofuelobjectivestate == 0)
			{
				sys.trigger($item_objective_4);				
				cargofuelobjectivestate = 1;
			}		
		}
	}

	void SuspendCargo()
	{
		CargoSuspended = 1;

		float i = 0;
		while( i < 10 )
		{
			entity platform = sys.getEntity("track_orange_platform_" + (i + 1));
			platform.stopMoving();
			platform = sys.getEntity("track_green_platform_" + (i + 1));
			platform.stopMoving();
			platform = sys.getEntity("track_blue_platform_" + (i + 1));
			platform.stopMoving();

			if( i < 8 )
			{
				platform = sys.getEntity("track_red_platform_" + (i + 1));
				platform.stopMoving();
			}

			i++;
		}
	}

	void StartCargo()
	{
		$StartCargo_Clicker.setKey("click_item", "0");

		if(cargofuelstate == 1)
		{
			thread ShowNPCSubtitles("Sam", "This better work.", 2.1);
			sys.wait($player1.startSoundShader("player_vo_thisbetterwork", SND_CHANNEL_VOICE2 ));

			sys.wait(.5);

			$StartCargo_Handle.move(DOWN, 8);
			$StartCargo_Handle.startSoundShader("one_shot_electrical_switch_heavy_1", SND_CHANNEL_VOICE2 );
			sys.wait(.125);
			
			//show/hide flares
			$func_static_88005.hide();
			$func_static_88008.show();
			sys.trigger($exit_strobe_light);
			
			sys.trigger($track_init_spkr);
			
			sys.trigger($track_init_flash_relay);
			
			sys.wait(3);
			sys.trigger($cargo_lights_relay_1);
			
			sys.trigger($track_spkr_seq_relay);
			
			sys.trigger($activate_exit_relay);
			
			sys.wait(10.5);

			CargoSuspended = 0;
		}		
		else
		{
			thread ShowNPCSubtitles("PA", "Cargo line fuel is empty.\nPlease transfer fuel.", 5.15);
			sys.wait($player1.startSoundShader("e1m4_cargo_line_empty", SND_CHANNEL_VOICE2 ));

			$StartCargo_Clicker.setKey("click_item", "1");
		}
	}

