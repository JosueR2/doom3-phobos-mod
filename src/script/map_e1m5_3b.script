	float CookieNumber = 0;
	void EatHarveyCookies()
	{
		$eat_cookie_item.setKey("click_item", 0);
	
		$player1.startSoundShader("sound/shav/e1m5_2/eating_cookie.ogg", SND_CHANNEL_ANY);
		
		if(CookieNumber == 0)
		{
			$harvey_cookie_1.hide();
			CookieNumber++;
			
			sys.wait(1.25);
			$eat_cookie_item.setKey("click_item", 1);
		}
		else if(CookieNumber == 1)
		{
			$harvey_cookie_2.hide();
			CookieNumber++;
			
			sys.wait(1.25);
			$eat_cookie_item.setKey("click_item", 1);
		}
		else if(CookieNumber == 2)
		{
			$harvey_cookie_3.hide();
			$eat_cookie_item.setKey("click_item", 0);
		}
	}	
	
	void main_house()
	{
		sys.trigger($info_portalsky_1);

		// Open open doors
		$master_bedroom_door_hinge.rotateOnce('0 80 0');		
		
		$skewed_picture.rotateOnce('0 0 8');
	
		// Pantry
		$pantry_lever_mover.rotateOnce('-45 0 0');

		// Store basement light colors
		basementLight = $basement_light_1.getColor();
		basementLightOff = basementLight * 0.25;
		basementLightFixture = $basement_light_1_fixture.getColor();
		basementLightFlare = $basement_light_1_flare.getColor();
		basementLightGlare = $basement_light_1_glare.getColor();
		basementLight2_7 = $basement_light_2.getColor();
		basementLightSpotsFixture = $basement_light_spots_fixture.getColor();
		basementLightSpotsFlare = $basement_light_spots_flare.getColor();

		basementVaultLight1_2 = $basement_vault_light_1.getColor();
		basementVaultLight3_4 = $basement_vault_light_3.getColor();
		basementVaultLight5 = $basement_vault_light_5.getColor();
		basementVaultLightSpotsFixture = $basement_vault_light_spots_fixture.getColor();
		basementVaultLightSpotsFlare = $basement_vault_light_spots_flare.getColor();

		// Turn off the vault lights in the basement
		$basement_vault_light_1.setColor(0, 0, 0);
		$basement_vault_light_2.setColor(0, 0, 0);
		$basement_vault_light_3.setColor(0, 0, 0);
		$basement_vault_light_4.setColor(0, 0, 0);
		$basement_vault_light_5.setColor(0, 0, 0);
		$basement_vault_light_spots_fixture.setColor(0, 0, 0);
		$basement_vault_light_spots_flare.setColor(0, 0, 0);
		
		// Store all the light colors and turn off the lights
		StoreLightGroup(lg_main, lg_main_num);
		StoreLightGroup("empty_room", 8);
		StoreLightGroup("master_bedroom", 18);
		StoreLightGroup("pantry", 5);
		StoreLightGroup("top_bathroom", 4);
		StoreLightGroup("bottom_bathroom", 4);
		StoreLightGroup("garage", 20);
		StoreLightGroup("cellar", 12);
		StoreLightGroup("attic", 10);
		StoreLightGroup("shed", 3);

		if(show_planning)
		{
			$player1.startSoundShader("sound/shav/blueworld/distant_horn.ogg", SND_CHANNEL_ANY);
			sys.wait(5.5);
		}

		sys.trigger($speaker_1102);
		sys.trigger($Speaker_Music_AfterHours);
		sys.trigger($info_player_teleport_1);
		
		vector angles = $Benson_Start_View.getAngles();
		$player1.setViewAngles(angles);
		
		//if(show_planning)
		//{
		//	sys.trigger($camera_outshot);
		//}

		sys.fadeTo('0 0 0', 0, .25);

		sys.wait(2);

		sys.trigger($objective_break_into_house);

		sys.wait(7);

		sys.showTextMessage("I'm here now!\nI can't believe we're doing it!", 1);

		sys.wait(2);

		LeeTexts("Good Luck!\nI really wish I was there with you...");

		sys.wait(2);
		
		sys.quickSave("The Last Date - Checkpoint 1");
	}

	void GoWithBus()
	{
		$SpeakerBefore.fadeSound(SND_CHANNEL_ANY, -100,20);
		sys.fadeTo('0 0 0', 1, 0);

		sys.wait(4);

		main_house();
	}

	void Lee1Subs()
	{
		ShowSubtitles("Lee", "Okay so Benson is bad news and a complete and total dead end.", 5.6);
		ShowSubtitles("Lee", "We tried to get out of the valley with his help.\nBut turns out he is a creeper and stole our most valuable asset; The box.", 8);
		ShowSubtitles("Lee", "James Benson has it and he wants to sell it.", 4);
	}

	void Lee2Subs()
	{
		ShowSubtitles("Lee", "Now, *we* want to get out of this place.\nWe tried all sorts of things. All sorts of places. No dice.", 7);
		ShowSubtitles("Lee", "We even tried Benson...who's trying to swindle us.", 4);
	}

	void Lee3Subs()
	{
		ShowSubtitles("Lee", "As suspected, the box is our ticket out of here.\nAnd this is where our next door neighbor, Karl, can help us.", 4.45);
		ShowSubtitles("Lee", "This is plan C.", 4);
	}

	void Lee4Subs()
	{
		ShowSubtitles("Lee", "In exchange for an absurd amount of money,\nhe will provide us with a way out.", 3.4);
		ShowSubtitles("Lee", "We have no cash, but, the box is worth at least 4 million,\naccording to Benson.", 4.5);
		ShowSubtitles("Lee", "We can use the box to pay Karl for his services,\nwhich means we can finally get out.", 4.75);
		ShowSubtitles("Lee", "But, we don't have the box. Benson does.", 4);
		ShowSubtitles("Lee", "In conclusion we need to steal it back.", 3);
		ShowSubtitles("Lee", "To re-steal it. Tonight.\nAnd how do we do that?", 5);
	}

	void Lee5Subs()
	{
		ShowSubtitles("Lee", "We are here.\nThe Old Oak Motel.", 4);
		ShowSubtitles("Lee", "Benson, going from his home, will pick me up at 8 and take us to our last date, somewhere in town.", 6);
	}

	void Lee6Subs()
	{
		ShowSubtitles("Lee", "Meanwhile, you take the bus from right around the corner and go here, where Benson lives.", 4.25);
		ShowSubtitles("Lee", "Here.", 2);
	}

	void Lee7Subs()
	{
		ShowSubtitles("Lee", "While I distract Benson and drag out the evening for as long as you need.", 3.5);
		ShowSubtitles("Lee", "You find a way inside his house where you locate the box and reacquire it.", 5.5);
	}

	void Lee8Subs()
	{
		ShowSubtitles("Lee", "Once the box is back in your hands,\nyou message me and we meet at the barn.", 4);
		ShowSubtitles("Lee", "Here.", 2);
		ShowSubtitles("Lee", "So how do we find this box?", 3);
	}

	void Lee9Subs()
	{
		ShowSubtitles("Lee", "Okay, so first we need to get in.", 3.25);
		ShowSubtitles("Lee", "You could of course try the front door or the garage door, but they are probably locked.", 5.25);
		ShowSubtitles("Lee", "Look around for a key.", 2.25);
		ShowSubtitles("Lee", "Alternatively, out back there is an old shed.\nMaybe there is something in there.", 4.7);
		ShowSubtitles("Lee", "Once inside, we need to search the most likely hiding spots.", 5);
		ShowSubtitles("Lee", "I have only ever been downstairs and the most interesting room here would be this elongated thing.", 6);
		ShowSubtitles("Lee", "I think it's an office, but I'm not sure.\nI haven't been inside.", 5);
		ShowSubtitles("Lee", "It's a two-story building though.\nThere could even be an attic.", 4.65);
		ShowSubtitles("Lee", "What's upstairs? I don't know exactly, but I know Benson sleeps up there.\nAnd there's bound to be other rooms as well.", 8.75);
		ShowSubtitles("Lee", "Once you have the box, go back, take the bus all the way back to our place.\nHide it in the safe spot and wait for me there.", 8.75);
		ShowSubtitles("Lee", "Look. I know you have received the short end of the stick for this plan,\nbut it's the only way to do it safely.", 7.75);
		ShowSubtitles("Lee", "Hopefully when this day is over, we have the box in our possession,\nback at the barn and ready to move on with our lives.", 7.45);
		ShowSubtitles("Lee", "Benson can go suck it.", 3);
	}	

	void StartBreakinPlanning()
	{
		if(show_planning)
		{
			// Set up zoom-in camera
			{			
				vector height_offset = '0 0 0';
				height_offset_z = $player1.getEyeHeight();
				vector origin = $player1.getWorldOrigin() + height_offset;
				vector angles = $player1.getViewAngles();
			
				$camera_inside_note_mover.setWorldOrigin(origin);
				$camera_inside_note.setAngles(angles);
			}

			$SpeakerTheLastDate.fadeSound(SND_CHANNEL_ANY, -100,20);

			sys.trigger($camera_inside_note);

			// Move towards note
			{
				vector destination = $LeeNoteUwu.getWorldOrigin();
				$camera_inside_note_mover.moveToPos(destination);		
				
				sys.wait(2);

				sys.fadeTo('0 0 0', 1, 2);

				sys.wait(2);
			}			

			// Set up coffee
			{
				$altan_coffee_steam.hide();
				$altan_coffee_cup.hide();
				$altan_coffee_level.hide();

				$planning_coffee_1_cup.show();
				$planning_coffee_2_cup.show();
				$planning_coffee_1_level.show();
				$planning_coffee_2_level.show();
				$planning_coffee_1_steam.show();
				$planning_coffee_2_steam.show();
			}

			sys.wait(1);

			$lee_open_door_speaker.startSoundShader("sound/shav/e1m4_4/door_open.ogg", SND_CHANNEL_ANY);

			sys.wait(2);

			// Set up planning lighting
			{			
				$Motel_Light_1.hide();
				$Motel_Light_2.hide();
				$camera_notes_light.show();
				$Motel_Map_Light.show();		
			}

			// Show outside
			{
				sys.trigger($camera_planning_outside);
				$camera_planning_outside_mover.moveTo($target_null_17);
				sys.fadeTo('0 0 0', 0, .1);			
			}

			thread Lee1Subs();
			float lee1time = CharacterSaysNoWait($speaker_lee_1, "sound/vo/e1m5_2/BensonHouse/Planning/Lee1.ogg");

			sys.wait(5.5);
			lee1time -= 5.5;

			// Show notes
			{
				sys.trigger($SpeakerPlanning);
				sys.trigger($camera_notes);
				
				sys.wait(lee1time);
				
				$camera_notes_mover.accelTime(.25);
				$camera_notes_mover.time(1.75);
				$camera_notes_mover.decelTime(.125);
				$camera_notes_mover.move(0, 18);
				
				sys.waitFor($camera_notes_mover);

				Beat(1.25);

				thread Lee2Subs();
				float duration = CharacterSaysNoWait($speaker_lee_1, "sound/vo/e1m5_2/BensonHouse/Planning/Lee2.ogg");

				sys.wait(duration * 0.75);

				$camera_notes_mover.accelTime(.25);
				$camera_notes_mover.time(1.75);
				$camera_notes_mover.decelTime(.125);
				$camera_notes_mover.move(0, 16);

				sys.wait(duration * 0.25);

				Beat(1.5);

				thread Lee3Subs();
				duration = CharacterSaysNoWait($speaker_lee_1, "sound/vo/e1m5_2/BensonHouse/Planning/Lee3.ogg");

				sys.wait(duration * 0.75);

				$camera_notes_mover.accelTime(.25);
				$camera_notes_mover.time(1.75);
				$camera_notes_mover.decelTime(.125);
				$camera_notes_mover.move(0, 15);

				sys.wait(duration * 0.25);

				Beat(.75);

				thread Lee4Subs();
				duration = CharacterSaysNoWait($speaker_lee_1, "sound/vo/e1m5_2/BensonHouse/Planning/Lee4.ogg");

				$camera_notes_mover.accelTime(.25);
				$camera_notes_mover.time(30);
				$camera_notes_mover.move(DOWN, 4);

				sys.wait(duration);
			}

			// Show Map
			{
				Beat(1.25);

				sys.trigger($camera_oldoakmotel);
				
				thread Lee5Subs();
				duration = CharacterSaysNoWait($speaker_lee_1, "sound/vo/e1m5_2/BensonHouse/Planning/Lee5.ogg");

				sys.wait(.5);

				CharacterSaysNoWait($player1, "sound/shav/e1m5_2/sharpie.ogg");
				$mark_oldoak.move(UP, 2);
				
				sys.wait(duration - 1.0);

				sys.trigger($camera_restaurant);
				$mark_oldoak.hide();
				$mark_oldoak_flat.show();

				CharacterSaysNoWait($player1, "sound/shav/e1m5_2/sharpie.ogg");
				$mark_town.move(UP, 2);

				sys.wait(.5);
				
				Beat(1.25);

				thread Lee6Subs();
				duration = CharacterSaysNoWait($speaker_lee_1, "sound/vo/e1m5_2/BensonHouse/Planning/Lee6.ogg");

				sys.wait(duration * 0.5);

				sys.trigger($camera_bensonhouse);
				
				$mark_town.hide();
				$mark_town_flat.show();

				sys.wait(duration * 0.5 - .5);

				CharacterSaysNoWait($player1, "sound/shav/e1m5_2/sharpie.ogg");
				$mark_bensonhouse.move(UP, 2);

				Beat(2);

				// DO SOMETHING SO THE WHISPERING ISN'T SUPER WEIRD

				thread Lee7Subs();
				duration = CharacterSaysNoWait($speaker_lee_1, "sound/vo/e1m5_2/BensonHouse/Planning/Lee7.ogg");

				sys.wait(duration * 0.5);

				//sys.trigger($camera_bensonhouse);

				sys.wait(duration * 0.5);

				Beat(.75);

				thread Lee8Subs();
				duration = CharacterSaysNoWait($speaker_lee_1, "sound/vo/e1m5_2/BensonHouse/Planning/Lee8.ogg");			

				sys.wait(2);

				duration -= 2;

				sys.trigger($camera_barn);
				$mark_bensonhouse.hide();
				$mark_bensonhouse_flat.show();

				sys.wait(2);
				duration -= 2;

				CharacterSaysNoWait($player1, "sound/shav/e1m5_2/sharpie.ogg");
				$mark_barn.move(UP, 2);

				sys.wait(duration);
			}

			Beat(1.25);

			// Show Benson House Map
			{
				$camera_bensonhousemap_photo_mover.moveTo($target_null_20);
				sys.trigger($camera_bensonhousemap_photo);

				$mark_barn.hide();
				$mark_barn_flat.show();

				sys.wait(.25);

				CharacterSays($speaker_lee_1, "sound/shav/e1m5_3/footsteps_on_carpet.ogg");

				sys.wait(.25);
				
				thread Lee9Subs();
				duration = CharacterSaysNoWait($speaker_lee_2, "sound/vo/e1m5_2/BensonHouse/Planning/Lee9.ogg");
				
				sys.wait(12.5);
				duration -= 12.5;

				$camera_bensonhousemap_shed_mover.moveTo($target_null_18);
				sys.trigger($camera_bensonhousemap_shed);

				sys.wait(3.5);
				duration -= 3.5;

				$camera_bensonhousemap_mover.moveTo($camera_bensonhousemap_target);
				sys.trigger($camera_bensonhousemap);

				sys.wait(8.5);
				duration -= 8.5;

				CharacterSaysNoWait($player1, "sound/shav/e1m5_2/sharpie.ogg");
				$mark_office.move(0, 2);
				
				sys.wait(9);
				duration -= 9;

				$mark_office.hide();
				$mark_office_flat.show();

				$camera_bensonhousemap_upstairs_mover.moveTo($target_null_19);
				sys.trigger($camera_bensonhousemap_upstairs);

				sys.wait(11.5);
				duration -= 11.5;

				$camera_finalmap_mover.move(UP, 64);
				sys.trigger($camera_finalmap);

				sys.wait(8);
				duration -= 8;

				$camera_outshot_mover.move(DOWN, 256);
				sys.trigger($camera_outshot);

				sys.wait(14);
				duration -= 14;

				sys.fadeTo('0 0 0', 1, 0);

				sys.wait(duration);
				sys.wait(2);
			}
		}

		// Spawn in motel again to use door to take bus to benson
		sys.trigger($SpeakerBefore);
		sys.trigger($motel_later_text_camera);
		sys.fadeTo('0 0 0', 0, .25);
		sys.wait(3);
		sys.fadeTo('0 0 0', 1, 0);
		sys.wait(1);
		sys.fadeTo('0 0 0', 0, .25);
		sys.trigger($motel_later_text_camera);
		$go_bus_item.show();
		$camera_notes_light.hide();
		$Motel_Map_Light.hide();
		sys.trigger($info_player_teleport_2);
	}

	float onBalcony = 1;
	void UpdateBalconyCameraAngle()
	{			
		while(onBalcony)
		{			
			vector angles = $player1.getViewAngles();
			angles_y += 180;
			$motel_balcony_camera.setAngles(angles);
			sys.wait(GAME_FRAMETIME);
		}
	}

	void GetOutOfChair()
	{
		$coffee_level.show();

		$motel_balcony_camera_clicker.hide();

		onBalcony = 0;
		
		vector angles = $player1.getViewAngles();
		angles_y += 180;
		$player1.setViewAngles(angles);
		sys.trigger($motel_balcony_camera);

		$SpeakerTheLastDate.fadeSound(SND_CHANNEL_ANY, -25,5);

		sys.trigger($speaker_coffee_maker);

		$coffee_level_mover.move(UP, 6);
	}	

	void main_intro()
	{			
		sys.trigger($info_portalsky_2);
		
		sys.fadeTo('0 0 0', 1, 0);		

		if(show_establishing_shot)
		{
		// Chapter text		
		{
			sys.trigger($chapter_text_camera);

			sys.wait(1);

			sys.trigger($chapter_text_speaker);

			sys.fadeTo('0 0 0', 0, 2);

			sys.wait(4);

			sys.fadeTo('0 0 0', 1, 2);
			
			sys.wait(3);

			sys.trigger($chapter_text_camera);
		}
		
		sys.trigger($establish_camera_1);		
		
		sys.trigger($SpeakerTheLastDate);
		
		sys.wait(3);		
		
		sys.fadeTo('0 0 0', 0, 2);		

		// Show Motel
		{
			$establish_camera_1_mover.move(315, 256);
			$establish_camera_1_mover.rotateOnce('0 45 0');

			sys.wait(12);
		}

		// Show ALTAN
		{
			sys.trigger($camera_altanman_1);
			$camera_altanman_1_mover.move(UP, 512);
			$camera_altanman_1_mover.rotateOnce('0 0 45');

			sys.wait(12);
		}

		// Establishing shot of the motel
		{
		sys.trigger($func_cameraview_1);
			$motel_camera_1_mover.moveTo($target_null_13);
			sys.wait(7);
		}
		
		// Show the inside of the motel
		{			
			sys.trigger($camera_inside_corner);						
			$camera_inside_corner_mover.move(270, 64);
			
			sys.wait(10);
		}				

		// Show beds
		{
			sys.trigger($camera_beds);
			$camera_beds_mover.move(DOWN, 32);

			sys.wait(8);
		}

		// Show planning table
		{
			sys.trigger($camera_inside_table);
			$camera_inside_table_mover.move(0, 32);

			sys.wait(8);
		}

		// Show missing closet doors
		{
			sys.trigger($camera_closet);
			$camera_closet_mover.move(90, 32);
			$camera_closet_mover.rotateOnce('0 45 0');

			sys.wait(8);
		}

		// Show outside
		{
			$camera_outside_mover.moveTo($motel_balcony_camera);
			sys.trigger($camera_outside);

			sys.waitFor($camera_outside_mover);
		}

		//sys.fadeTo('0 0 0', 1, 2);
		
		//sys.wait(3);

		}
		else
		{
			$LeeNoteUwu.setKey("click_item", 1);
		}

		// Go to balcony cam
		{
			$player1.setViewAngles($camera_outside.getAngles() + '0 180 0');
			thread UpdateBalconyCameraAngle();
			sys.trigger($motel_balcony_camera);
		}

		// Open bathroom door
		$door_bathroom_mover.rotateOnce('0 -105 0');

		// Rotate alarm clock
		$outro_alarmclock.rotateOnce('0 -15 0');
		
		// Set influence
		sys.trigger($setinfluence_bensonhouse);
		
		// Turn on local sounds
		sys.trigger($Speaker_Motel_AC);

		//sys.fadeTo('0 0 0', 0, 2);		
	}	
}