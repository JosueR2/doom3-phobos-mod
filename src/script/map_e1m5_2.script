	float PUMPS_RUNNING = 1;
	
	void cycle_pump3() {
		sys.wait(1);
		while( PUMPS_RUNNING ) {
			$slime_pump_01.time(3);
			$slime_pump_01.move( UP, 96 );
			sys.waitFor( $slime_pump_01 );
			sys.trigger($speaker_pump3);
			$slime_pump_01.time(1);
			$slime_pump_01.move( DOWN, 96 );
			sys.waitFor( $slime_pump_01 );
		}
	}

