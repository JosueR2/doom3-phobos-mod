	void Start_Struggle()
	{
		sys.trigger($setinfluence_motel);

		// Open up the vault door
		$vault_door_hinge.accelTime(0);
		$vault_door_hinge.decelTime(0);
		$vault_door_hinge.time(0.01);
		$vault_door_hinge.rotateOnce('0 90 0');

		// Set up the phone
		$motel_phone_mover.rotateOnce('0 10 0');

		//StartMotelStruggleBarnScene();
		//return;

		// TEST DUALSCREEN FUN
		if(0)
		{
			sys.trigger($portalsky_motel);
			sys.trigger($func_cameraview_1);

			sys.wait(1);
			
			$portalview_barnmotel.bind($func_mover_9);
			$func_mover_9.rotateOnce('0 -90 0');
			$func_mover_10.rotateOnce('0 90 0');

			sys.wait(2);

			$func_mover_9.rotateOnce('0 -90 0');
			//$func_mover_10.rotateOnce('0 90 0');

			return;
		}

		// VAULT SCENE
		if(1)
		{
			$player1.startSoundShader("sound/shav/e1m5_4/box_found.ogg", SND_CHANNEL_ANY);

			sys.trigger($intro_scene_portalsky);

			// Set up the scene
			sys.fadeTo('0 0 0', 1, 0);
			$motel_front_door_hinge.rotateOnce('0 -20 0');
			$motel_bathroom_door_hinge.rotateOnce('0 -85 0');				

			Benson_House_Call_Scene();
		}


		// Goto barn
		{
			sys.fadeTo('0 0 0', 1, .125);
			sys.wait(.5);
			//sys.wait($player1.startSoundShader("sound/shav/e1m1/ominoushorn.ogg", SND_CHANNEL_ANY) + 1);

			sys.wait(3.5);

			sys.trigger($barn_teleport);

			sys.wait(0.5);

			// Establish the location (The Barn)
			$benson_barn_cam_mover.move(DOWN, 192);
			sys.trigger($start_barn_cam);
			sys.trigger($Speaker_TheLastCall);
			sys.fadeTo('0 0 0', 0, .25);

			sys.wait(6);
			
			sys.trigger($start_barn_cam);
		}
	}
	
	float SKIP_ALL = 0;
	float SKIP_INTRO = 0;
	
	void main()
	{
		if(!SKIP_ALL)
		{
			thread setup();		

			if(SKIP_INTRO == 0)
			{
				Start_Struggle();
			}
			else
			{
				StartPhobosSkyBoxGlitching();
				Back_To_Level();
				sys.wait(3);
				//StartMuseumPart1();
				sys.trigger($setinfluence_motel);
			}
		}
		else
		{
			SetupMallLights();
			SetupMuseumLights();
		}
	}
}