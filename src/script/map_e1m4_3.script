	vector noLight = '0 0 0';
	vector lampTexColor = '0.9 0.4 0.28';
	vector lampLightColor = '0.32 0.21 0.13';
	vector lampGlareColor = '0.419608 0.180392 0.129412';
	vector lampEffectColor = '0.45 0.2 0.14';
	float lightCounter = 0;

	void ToggleLight()
	{
		if(lightCounter < 5)
		{			
			$LightClicker.startSoundShader("switch_02", SND_CHANNEL_ANY);

			if(lightCounter % 2 == 0)
			{				
				thread crossFadeEnt ($LampLight, noLight, lampLightColor, .0625);
				thread crossFadeEnt ($LampGlare, noLight, lampGlareColor, .0625);
				thread crossFadeEnt ($LampTex, noLight, lampTexColor, .0625);
				thread crossFadeEnt ($LampEffect, noLight, lampEffectColor, .0625);
			}
			else
			{				
				thread crossFadeEnt ($LampLight, lampLightColor, noLight, .0625);
				thread crossFadeEnt ($LampGlare, lampGlareColor, noLight, .0625);
				thread crossFadeEnt ($LampTex, lampTexColor, noLight, .0625);
				thread crossFadeEnt ($LampEffect, lampEffectColor, noLight, .0625);
			}			

			lightCounter++;

			if(lightCounter > 4)
			{
				sys.trigger($LightClicker);
				$player1.startSoundShader("e1m4_3_Rooms", SND_CHANNEL_ANY);
				sys.trigger($SpeakerValleyDefense);
				sys.trigger($SpeakerCrickets);
				sys.trigger($BlueWorldPortalSky);
				sys.trigger($BlueWorldSkyPortal);

				sys.wait(1);
				
				OpenRoomDoorSlightly();
			}
		}
	}

