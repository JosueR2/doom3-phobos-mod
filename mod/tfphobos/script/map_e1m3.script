	void officeglass_fall()	
	{
		$wallsec_swing.accelTime (.1);
        $wallsec_swing.time (.25);
        $wallsec_swing.rotateOnce ('0 0 -7');
        sys.wait(.15);
		sys.trigger($officeglass_relay1);
        
        $wallsec_swing2.accelTime (.1);
        $wallsec_swing2.time (.25);
        $wallsec_swing2.rotateOnce ('0 0 -11');
		sys.wait(.1);
		$ballistrade_swing.unbind();
		$ballistrade_swing.accelTime (.1);
        $ballistrade_swing.time (.3);
        $ballistrade_swing.rotateOnce ('10 0 0');
		sys.wait(.05);
		sys.trigger($officeglass_relay2);
		
		sys.waitFor($ballistrade_swing);
		sys.trigger($ballistrade_slam);
		$ballistrade_swing.accelTime (0);
        $ballistrade_swing.time (.07);
        $ballistrade_swing.rotateOnce ('-2 0 0');
		sys.waitFor($ballistrade_swing);
		$ballistrade_swing.rotateOnce ('2 0 0');
		sys.waitFor($ballistrade_swing);
		$ballistrade_swing.time (.05);
		$ballistrade_swing.rotateOnce ('-1 0 0');
		sys.waitFor($ballistrade_swing);
		$ballistrade_swing.rotateOnce ('1 0 0');
		sys.trigger($trigger_once_368);
	}
	
	void ceiling_collapse()
	{
		$ceilsec_swing.accelTime (.2);
        $ceilsec_swing.time (.7);
		$ceilsec_swing2.accelTime (0);
        $ceilsec_swing2.time (.1);
		$ceilsec_swing3.accelTime (0);
        $ceilsec_swing3.time (.1);
        $ceilsec_swing.rotateOnce ('0 0 27');		
		sys.waitFor($ceilsec_swing);
		$ceilsec_swing2.unbind();
		$ceilsec_swing2.rotateOnce ('0 0 3.5');
		$ceilsec_swing3.unbind();
		$ceilsec_swing3.rotateOnce ('0 0 1.75');
		sys.trigger($ceilsec_slam);
		$ceilsec_swing.accelTime (0);
        $ceilsec_swing.time (.15);
        $ceilsec_swing.rotateOnce ('0 0 -4');
		sys.waitFor($ceilsec_swing);
		$ceilsec_swing.rotateOnce ('0 0 4');
		sys.waitFor($ceilsec_swing);
		sys.trigger($ceilsec_slam2);
		$ceilsec_swing.time (.05);
		$ceilsec_swing.rotateOnce ('0 0 -1');
		sys.waitFor($ceilsec_swing);
		$ceilsec_swing.rotateOnce ('0 0 1');
		sys.trigger($trigger_relay_702);
	}

	void ceiling_collapse2()
	{
		$ceilsec_swingagain.unbind();
		$ceilsec_swing2.bind($ceilsec_swingagain);
		$ceilsec_swing3.bind($ceilsec_swingagain);
		$ceilsec_swingagain.accelTime (.1);
        $ceilsec_swingagain.time (.5);
        $ceilsec_swingagain.rotateOnce ('0 0 -27');		
		
		sys.waitFor($ceilsec_swingagain);
		sys.trigger($ceilsec_slam);
		$ceilsec_swingagain.accelTime (0);
        $ceilsec_swingagain.time (.15);
        $ceilsec_swingagain.rotateOnce ('0 0 4');
		sys.waitFor($ceilsec_swingagain);
		$ceilsec_swingagain.rotateOnce ('0 0 -4');
		sys.waitFor($ceilsec_swingagain);
		sys.trigger($ceilsec_slam2);
		$ceilsec_swingagain.time (.05);
		$ceilsec_swingagain.rotateOnce ('0 0 1');
		sys.waitFor($ceilsec_swingagain);
		$ceilsec_swingagain.rotateOnce ('0 0 -1');
		sys.trigger($ceilsec_clip);
		sys.trigger($light_relay);
	}
	
	void floorhatch_open()	
	{			
		sys.trigger($func_aas_obstacle_9);	
		sys.trigger($func_portal_1);
		$floor_panel.move(-2, 2);
		sys.waitFor($floor_panel);
		$floor_panel.move(180, 60);		
	}
	
	void floorhatch_close()	
	{			
		$floor_panel.move(0, 60);
		sys.waitFor($floor_panel);
		$floor_panel.move(-1, 2);
		sys.waitFor($floor_panel);
		sys.trigger($func_portal_1);
		sys.trigger($func_aas_obstacle_9);		
	}
	
	void CloseDrawer01()
	{
		$drawer01.move(360, 20);
	}

	void CloseDrawer03()
	{
		$drawer03.move(180, 12);
	}

	void the_hangar_opening()
	{
		toggle_hangar();

		sys.wait(1);
		
		sys.trigger($darkstar_speaker);		
				
		$darkstar_mover.move(UP, 2048);
		$darkstar_mover.rotateOnce('25 145 0');
		
		sys.wait(12);

		sys.wait(1);

		sys.trigger($darkstar_speaker2);
		
		sys.trigger($func_emitter_333);
		sys.trigger($func_emitter_334);
		sys.trigger($func_emitter_335);
		sys.trigger($func_emitter_336);
		
		$darkstar_mover.time(2);
		$darkstar_mover.accelTime(.5);
		$darkstar_mover.decelTime(.25);
		$darkstar_mover.move(REL_BACK, 20480);

		sys.wait(10.25);

		$player1.startSoundShader("sound/shav/e1m3/leaving.ogg", SND_CHANNEL_ANY);

		sys.wait(1.6);
		
		sys.fadeTo('0 0 0', 1, .125);
		
		sys.wait(.15);
		
		activeDepartureCam = 4;
		sys.trigger($PreOutroCam);

		sys.wait(4);

		sys.wait($player1.startSoundShader("sound/shav/intro/thorn_07.ogg", SND_CHANNEL_ANY));
		
		sys.wait(3);
		
		//lets go to outro
		sys.trigger($PreOutroCam);
		activeDepartureCam = 0;
		departureActive = 0;
		canSkipDeparture = 0;
		PhobosSetCanSkip(0);
		sys.trigger($info_player_teleport_outro);
		sys.wait(.1);
		sys.trigger($setinfluence_outro);
		sys.fadeTo('0 0 0', 0, 1);
	}
	
	void FceChatterSub()
	{
		sys.wait(5.7);
	
		PhobosShowSubtitle_e1m3("Special Agent Simmons", "Mars Depature T-8150. Special Agent Simmons here.");

		sys.wait(3.7);

		PhobosShowSubtitle_e1m3("Special Agent Simmons", "We had a delay due to some unexpected interference.\nIt has been taken care of. Ready for takeoff.");
		
		sys.wait(7.8);
		
		PhobosShowSubtitle_e1m3("Captain Rigel", "This is Captain Rigel of the Enforcer.\nAffirmative agent Simmons.");

		sys.wait(4.4);
		
		PhobosShowSubtitle_e1m3("Captain Rigel", "You're expected at the Bulwark in 10 minutes.\nYou're clear for take-off.");

		sys.wait(4.7);
		
		sys.hideSubtitles();
	}
	
	void fce_departure()
	{	
		departureActive = 1;
		departureSkipped = 0;
		canSkipDeparture = 0;
		activeDepartureCam = 0;
		thread EnableDepartureSkipTimer();

		goInfluenceLoop = 0;

		thread the_hangar_opening();

		thread FceChatterSub();
		$player1.startSoundShader("sound/vo/e1m3/fce_departure_chatter.ogg", SND_CHANNEL_ANY);		

		sys.wait(2.75);

		sys.trigger($SpeakerDeparture);

		sys.wait(2.5);
		
		sys.trigger($remove_monsters);
		
		activeDepartureCam = 1;
		sys.trigger($hangar_scene_camera_above);
		$hangar_scene_camera_above_mover.move(DOWN, 96);
		$hangar_scene_camera_above_rotator.rotateOnce('0 15 0');

		sys.wait(11);

		activeDepartureCam = 2;
		sys.trigger($hangar_scene_camera_side);
		$hangar_scene_camera_side_mover.moveTo($func_static_99070_camdest);
		$hangar_scene_camera_side_rotator.rotateOnce('0 -25 0');

		sys.wait(9);

		activeDepartureCam = 3;
		sys.trigger($hangar_scene_camera_below);
		$hangar_scene_camera_below_mover.move(DOWN, 384);
		$hangar_scene_camera_below_rotator.rotateOnce('0 -270 0');		
	}
	
