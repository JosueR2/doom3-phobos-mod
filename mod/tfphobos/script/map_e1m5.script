	float hiding_places_inspected = 0;
	void CheckCloset()
	{
		return;
		if(hiding_places_inspected == 2)
		{
			$hide_closet_clicker.setKey("click_item", "1");
		}
	}

	void HideBehindCurtain()
	{
		HideOnAltan();
		return;

		sys.disableItemGroup("motel_hiding");
		
		hiding_places_inspected++;		
		
		thread ShowSubtitles("Sam", "They might go outside.", 2);
		CharacterSays($player1, "sound/vo/e1m5/motelcloset/player24.ogg");

		sys.enableItemGroups();

		CheckCloset();
	}
	
	void HideInBathroom()
	{
		sys.disableItemGroup("motel_hiding");

		hiding_places_inspected++;		
		
		thread ShowSubtitles("Sam", "Great hiding place until he decides to take a dump.", 2);
		CharacterSays($player1, "sound/vo/e1m5/motelcloset/player25.ogg");

		sys.enableItemGroups();

		CheckCloset();
	}	
	
