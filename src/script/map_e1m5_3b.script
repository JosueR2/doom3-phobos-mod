	float panel1State = 0;
	void PushPanel1()
	{
		if(panel1State == 0)
		{
			$house_panel_1.accelTime(0);
			$house_panel_1.decelTime(0);
			$house_panel_1.time(.125);
			$house_panel_1.startSoundShader("sound/shav/e1m5_2/HandleRot.ogg", SND_CHANNEL_ANY);

			$house_panel_1.move(90, 4);

			sys.waitFor($house_panel_1);

			panel1State = 1;

			$house_panel_1_clicker.setKey("item_action", "Move");
			$house_panel_1_clicker.setKey("clickonce", 1);
			$house_panel_1_clicker.setKey("item_disabled", 0);			
		}
		else
		{			
			sys.trigger($house_panel_1_portal);

			$house_panel_1.accelTime(.125);
			$house_panel_1.decelTime(.0625);
			$house_panel_1.time(2.25);
			$house_panel_1.startSoundShader("sound/shav/e1m1/slidingdoor.ogg", SND_CHANNEL_ANY);

			$house_panel_1.move(0, 36);

			$house_panel_1_clicker.hide();
		}
	}

	void PushPanel2()
	{
		$house_panel_2.startSoundShader("sound/shav/e1m5_2/locked_door2.ogg", SND_CHANNEL_ANY);
		
		sys.wait(0.5);
		
		$house_panel_1_clicker.setKey("click_item", 1);
	}

	float basementLight1State = 0;
	float basementLight2State = 0;
	float basementBookcaseState = 0;

	vector basementVaultLight1_2;
	vector basementVaultLight3_4;
	vector basementVaultLight5;
	vector basementVaultLightSpotsFixture;
	vector basementVaultLightSpotsFlare;

	void BasementLightSwitch1()
	{
		if(basementLight2State == 1	)
		{
			if(basementLight1State == 0)
			{
				$player1.startSoundShader("sound/shav/e1m5_2/light_switch.ogg", SND_CHANNEL_ANY);
				
				thread crossFadeEnt ($basement_vault_light_1, '0 0 0', basementVaultLight1_2, 0.25);				
				thread crossFadeEnt ($basement_vault_light_2, '0 0 0', basementVaultLight1_2, 0.25);
				thread crossFadeEnt ($basement_vault_light_3, '0 0 0', basementVaultLight3_4, 0.25);
				thread crossFadeEnt ($basement_vault_light_4, '0 0 0', basementVaultLight3_4, 0.25);
				thread crossFadeEnt ($basement_vault_light_5, '0 0 0', basementVaultLight5, 0.25);
				thread crossFadeEnt ($basement_vault_light_spots_fixture, '0 0 0', basementVaultLightSpotsFixture, 0.25);
				
				// Only light up the flares when the bookcase has been moved or they will bleed through the bookcase
				if(basementBookcaseState == 1)
				{
					thread crossFadeEnt ($basement_vault_light_spots_flare, '0 0 0', basementVaultLightSpotsFlare, 0.25);
				}

				sys.wait(.5);

				basementLight1State = 1;
			}
			else
			{
				$player1.startSoundShader("sound/shav/e1m5_2/light_switch.ogg", SND_CHANNEL_ANY);

				thread crossFadeEnt ($basement_vault_light_1, basementVaultLight1_2, '0 0 0', 0.25);				
				thread crossFadeEnt ($basement_vault_light_2, basementVaultLight1_2, '0 0 0', 0.25);
				thread crossFadeEnt ($basement_vault_light_3, basementVaultLight3_4, '0 0 0', 0.25);
				thread crossFadeEnt ($basement_vault_light_4, basementVaultLight3_4, '0 0 0', 0.25);
				thread crossFadeEnt ($basement_vault_light_5, basementVaultLight5, '0 0 0', 0.25);
				thread crossFadeEnt ($basement_vault_light_spots_fixture, basementVaultLightSpotsFixture, '0 0 0', 0.25);
				thread crossFadeEnt ($basement_vault_light_spots_flare, basementVaultLightSpotsFixture, '0 0 0', 0.25);

				sys.wait(.5);

				basementLight1State = 0;
			}			

			$basement_light_switch_1.setKey("item_disabled", 0);
		}
		else
		{
			$player1.startSoundShader("sound/shav/e1m5_2/light_switch.ogg", SND_CHANNEL_ANY);

			sys.wait(.5);
			$basement_light_switch_1.setKey("item_disabled", 0);
		}

		if(basementLight1State == 1 && basementLight2State == 1)
		{
			$BasementVaultLightInspectClicker.setKey("click_item", 1);
		}
		else
		{
			$BasementVaultLightInspectClicker.setKey("click_item", 0);
		}
	}
	
	vector basementLightGlare;
	vector basementLightFlare;
	vector basementLightFixture;
	vector basementLight;
	vector basementLightOff;
	vector basementLight2_7;
	vector basementLightSpotsFixture;
	vector basementLightSpotsFlare;
	float vaultLightInspected = 0;

	void BasementLightSwitch2()
	{
		if(basementLight2State == 0)
		{
			// TURN OFF LIGHT

			$player1.startSoundShader("sound/shav/e1m5_2/light_switch.ogg", SND_CHANNEL_ANY);

			thread crossFadeEnt ($basement_light_1_glare, basementLightGlare, '0 0 0', 0.25);
			thread crossFadeEnt ($basement_light_1_flare, basementLightFlare, '0 0 0', 0.25);
			thread crossFadeEnt ($basement_light_1_fixture, basementLightFixture, '0 0 0', 0.25);
			thread crossFadeEnt ($basement_light_1, basementLight, basementLightOff, 0.25);			
			thread crossFadeEnt ($basement_light_2, basementLight2_7, '0 0 0', 0.25);
			thread crossFadeEnt ($basement_light_3, basementLight2_7, '0 0 0', 0.25);
			thread crossFadeEnt ($basement_light_4, basementLight2_7, '0 0 0', 0.25);
			thread crossFadeEnt ($basement_light_5, basementLight2_7, '0 0 0', 0.25);
			thread crossFadeEnt ($basement_light_6, basementLight2_7, '0 0 0', 0.25);
			thread crossFadeEnt ($basement_light_7, basementLight2_7, '0 0 0', 0.25);
			thread crossFadeEnt ($basement_light_spots_fixture, basementLightSpotsFixture, '0 0 0', 0.25);
			thread crossFadeEnt ($basement_light_spots_flare, basementLightSpotsFlare, '0 0 0', 0.25);

			if(basementLight1State == 1)
			{
				thread crossFadeEnt ($basement_vault_light_3, '0 0 0', basementVaultLight3_4, 0.25);
				thread crossFadeEnt ($basement_vault_light_4, '0 0 0', basementVaultLight3_4, 0.25);
			}

			$basement_vault_knob_left_clicker.setKey("click_item", 0);
			$basement_vault_knob_right_clicker.setKey("click_item", 0);

			sys.wait(.5);

			basementLight2State = 1;
		}
		else
		{
			// TURN ON LIGHT

			$player1.startSoundShader("sound/shav/e1m5_2/light_switch.ogg", SND_CHANNEL_ANY);

			thread crossFadeEnt ($basement_light_1_glare, '0 0 0', basementLightGlare, 0.25);
			thread crossFadeEnt ($basement_light_1_flare, '0 0 0', basementLightFlare, 0.25);
			thread crossFadeEnt ($basement_light_1_fixture, '0 0 0', basementLightFixture, 0.25);
			thread crossFadeEnt ($basement_light_1, basementLightOff, basementLight, 0.25);
			thread crossFadeEnt ($basement_light_2, '0 0 0', basementLight2_7, 0.25);
			thread crossFadeEnt ($basement_light_3, '0 0 0', basementLight2_7, 0.25);
			thread crossFadeEnt ($basement_light_4, '0 0 0', basementLight2_7, 0.25);
			thread crossFadeEnt ($basement_light_5, '0 0 0', basementLight2_7, 0.25);
			thread crossFadeEnt ($basement_light_6, '0 0 0', basementLight2_7, 0.25);
			thread crossFadeEnt ($basement_light_7, '0 0 0', basementLight2_7, 0.25);
			thread crossFadeEnt ($basement_light_spots_fixture, '0 0 0', basementLightSpotsFixture, 0.25);
			thread crossFadeEnt ($basement_light_spots_flare, '0 0 0', basementLightSpotsFlare, 0.25);

			if(basementLight1State == 1)
			{
				thread crossFadeEnt ($basement_vault_light_3, basementVaultLight3_4, '0 0 0', 0.25);
				thread crossFadeEnt ($basement_vault_light_4, basementVaultLight3_4, '0 0 0', 0.25);
			}
			
			if(vaultLightInspected == 1)
			{
				$basement_vault_knob_left_clicker.setKey("click_item", 1);
				$basement_vault_knob_right_clicker.setKey("click_item", 1);

				$BasementVaultLightInspectClicker.hide();
			}

			sys.wait(.5);

			basementLight2State = 0;
		}

		$basement_light_switch_2.setKey("item_disabled", 0);

		if(basementLight1State == 1 && basementLight2State == 1)
		{
			$BasementVaultLightInspectClicker.setKey("click_item", 1);
		}
		else
		{
			$BasementVaultLightInspectClicker.setKey("click_item", 0);
		}
	}

	void OpenVault()
	{
		thread ShowSubtitles("Sam", "Gotcha!", 2);
		CharacterSays($player1, "sound/vo/e1m5_2/BensonHouse/VaultOpeningReaction.ogg");

		$vault_handles_clicker.hide();
		$vault_handles_hinge.rotateOnce('-1440 0 0');
		$vault_handles_hinge.startSoundShader("sound/shav/e1m5_2/vault_handle.ogg", SND_CHANNEL_ANY);

		sys.waitFor($vault_handles_hinge);

		$vault_handles_hinge.time(.5);
		$vault_handles_hinge.accelTime(.25);
		$vault_handles_hinge.decelTime(.125);
		$vault_handles_hinge.rotateOnce('3 0 0');

		sys.waitFor($vault_handles_hinge);

		sys.wait(1);

		$vault_door_hinge.rotateOnce('0 90 0');
		$vault_door_hinge.startSoundShader("sound/shav/e1m5_2/vault_open.ogg", SND_CHANNEL_ANY);
	}

