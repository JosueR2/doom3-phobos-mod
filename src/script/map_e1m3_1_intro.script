	float lightSwitchState = 0;
	
	void RestartGenerator()
	{
		$item_light_switch_on.setKey("click_item", 1);
		
		thread Intro_CharacterSays($func_static_53945, "e1m3_1_generator_start");
		
		sys.wait(0.025);
		
		$fuse_light_2.hide();
		$fuse_light_2_on.show();
		
		crossFadeEnt ($fuse_light_2_on, '1 0 0', '0 1 0', .01);
		
		sys.trigger($speaker_intro_generator);
		sys.trigger($func_shaking_intro_generator);

		while(lightSwitchState == -1)
		{
			sys.waitFrame();
		}

		lightSwitchState = 2;
	}	
	
	void TurnOnSwitchTwo()
	{		
		HideIntroClickers();

		$func_mover_intro_switch.rotateOnce('-90 0 0');
		$func_mover_intro_switch.startSoundShader("one_shot_electrical_switch_heavy_1", SND_CHANNEL_ANY);
		
		$switch_light_1.hide();
		$switch_light_1_on.show();
		
