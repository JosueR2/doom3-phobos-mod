	void PlayerDeadEnd2Sub()
	{
		ShowNPCSubtitles("Sam", "So...There's no way.\nThere are some really thick bars, like we suspected.", 7);
		ShowNPCSubtitles("Sam", "Even if we snuck in the equipment necessary to break them, we would face a huge drop.", 5);	
		ShowNPCSubtitles("Sam", "Could we rappel down using some rope, the stationed guards would find us in no time.", 4.25);
	}

	void SewerDeadEndTalkPart1()
	{
		$SpeakerPling.fadeSound (SND_CHANNEL_ANY, -100, 10);
		
		sys.trigger($SpeakerDarkAtmosphere);

		$sewer_deadend_cam1_mover.moveTo($sewer_deadend_cam1_target);
		sys.trigger($sewer_deadend_cam1);

		sys.wait(6);
		
		$sewer_deadend_cam2_mover.moveTo($sewer_deadend_cam2_target);
		sys.trigger($sewer_deadend_cam2);
		$sewer_deadend_cam1_mover.stopMoving();

		sys.wait(6);

		$sewer_deadend_cam3_mover.moveTo($sewer_deadend_cam3_target);
		sys.trigger($sewer_deadend_cam3);
		$sewer_deadend_cam2_mover.stopMoving();

		sys.wait(6);

		sys.trigger($SpeakerPling);

		sys.trigger($sewer_deadend_cam3);
		$sewer_deadend_cam3_mover.stopMoving();

		sys.wait(1);

		thread ShowNPCSubtitles("Sam", "I'm here.", 2);
		CharacterSays($player1, "sound/vo/e1m4/sewer/deadend/Player1.ogg");
		Beat(.75);
	
		thread ShowNPCSubtitles("Lee", "Wait. Say something again. Louder.", 2);
		CharacterSays($player1, "sound/vo/e1m4/sewer/deadend/Lee1.ogg");
		CharacterSays($player1, "sound/shav/e1m3_1/walkie_talkie_beep.ogg");
		Beat(.75);

		thread ShowNPCSubtitles("Sam", "I'm here! By the exit...", 2);
		CharacterSays($player1, "sound/vo/e1m4/sewer/deadend/Player1_2.ogg");

		Beat(.5);

		thread ShowNPCSubtitles("Lee", "I think I can hear you. Two sec...", 2);
		CharacterSays($player1, "sound/vo/e1m4/sewer/deadend/Lee1_1.ogg");
		CharacterSays($player1, "sound/shav/e1m3_1/walkie_talkie_beep.ogg");		
		
		Beat(1.5);
		
		sys.trigger($snd_lee_sliding_vent);
		
		Beat(6);
		
		thread ShowNPCSubtitles("Lee", "The ventilation route is a complete bust. No way through. So...?", 8);
		CharacterSays($speaker_lee_vent, "sound/vo/e1m4/sewer/deadend/Lee2.ogg");
		Beat(.5);
		
		thread PlayerDeadEnd2Sub();
		CharacterSays($player1, "sound/vo/e1m4/sewer/deadend/Player2.ogg");
		Beat(.5);
		
		thread ShowNPCSubtitles("Lee", "There are guards?", 2);
		CharacterSays($speaker_lee_vent, "sound/vo/e1m4/sewer/deadend/Lee3.ogg");
		Beat(.6);
		
		thread ShowNPCSubtitles("Sam", "Yup. And a searchlight.\nThis is the mountains all over again.", 3.25);
		CharacterSays($player1, "sound/vo/e1m4/sewer/deadend/Player3.ogg");
		Beat(.4);
		
		thread ShowNPCSubtitles("Lee", "Ugh...don't remind me.\nI'm sorry.", 4);
		CharacterSays($speaker_lee_vent, "sound/vo/e1m4/sewer/deadend/Lee4.ogg");
		Beat(.5);
		
		thread ShowNPCSubtitles("Sam", "Me too.", 2);
		CharacterSays($player1, "sound/vo/e1m4/sewer/deadend/Player4.ogg");
		Beat(1.75);
		
		thread ShowNPCSubtitles("Lee", "Sam...could you sit down for a minute? I have something to say.", 5.15);
		CharacterSays($speaker_lee_vent, "sound/vo/e1m4/sewer/deadend/Lee5.ogg");
		Beat(.25);
	
		$sewer_dead_end_talk_part_2_item.setKey("click_item", "1");
	}
	
	float sitting = 0;
	void UpdateCameraAngle2()
	{			
		while(sitting == 1)
		{						
			vector angles = $player1.getViewAngles();
			angles_y += 90;
			$sewerexit_sit_camera.setAngles(angles);
			sys.wait(GAME_FRAMETIME);
		}
	}

	void CityCamShow(float num)
	{
		entity camera = sys.getEntity("sewer_deadend_cam" + num);
		entity mover = sys.getEntity("sewer_deadend_cam" + num + "_mover");
		entity target = sys.getEntity("sewer_deadend_cam" + num + "_target");

		mover.stopMoving();
		mover.restorePosition();
		camera.setOrigin('0 0 0');
		mover.moveTo(target);
		sys.trigger(camera);

		sys.wait(10);
	}

	float cityCamLooping = 1;
	void CityCamLoop()
	{
		while(cityCamLooping)
		{
			CityCamShow(2);

			if(cityCamLooping == 0)
			{
				break;
			}

			CityCamShow(4);

			if(cityCamLooping == 0)
			{
				break;
			}

			CityCamShow(1);

			if(cityCamLooping == 0)
			{
				break;
			}

			CityCamShow(3);
			
			if(cityCamLooping == 0)
			{
				break;
			}

			CityCamShow(5);

		}

		$SpeakerFindNothing.fadeSound (SND_CHANNEL_ANY, -100, 10);

		sys.fadeTo('0 0 0', 1, 6);

		sys.wait(6);

		sys.trigger($Seweruwu2_intermediate_cam);

		sys.wait(4);

		sys.trigger($Seweruwu2_intermediate_cam);

		sys.trigger($SpeakerFindNothing);
		
		$commscreen.hide();
		$commscreen_offline.show();
		$calloscreen_offline.hide();
		$calloscreen_online.show();

		// AFTER SEWER FLASHBACK END
		sys.trigger($SwitchReplacementPickupClicker);
		$miles_conf_door.setKey("no_touch", 0);		

		sys.trigger($PostSeweruwu2_teleport);
		
		sys.fadeTo('0 0 0', 0, 3);

		sys.wait(4);
		
		$e1m1_fce_guard_1.remove();
		$e1m1_fce_guard_2.remove();

		thread ShowNPCSubtitles("Sam", "Miles? I'll find him for you.", 3.15);
		CharacterSays($player1, "sound/vo/e1m4/MilesCall/Player14.ogg");
		
		SpeakerAmbience_fadein2();
		
		sys.trigger($monster_demon_arachnotron_3);
		sys.trigger($trigger_once_266);

		sys.wait(3.5);
		sys.trigger($scene_target_setinfluence_1);
		$miles_conf_door.lock(0);	
		sys.trigger($monster_flying_lostsoul_71);
			
		sys.wait(1);	
		
		sys.quickSave("Night Walk - Checkpoint 8");
		
		sys.wait(1);		
	}
	
	void skipCinematic()
	{
		sys.trigger($comm_beep);
		
		$commscreen.hide();
		$commscreen_offline.show();
		$calloscreen_offline.hide();
		$calloscreen_online.show();

		// AFTER SEWER FLASHBACK END
		sys.trigger($SwitchReplacementPickupClicker);
		
		thread ShowNPCSubtitles("Sam", "Miles? I'll find him for you.", 3);
		CharacterSays($player1, "sound/vo/e1m4/MilesCall/Player14.ogg");
		
		sys.trigger($monster_demon_arachnotron_3);
		sys.trigger($trigger_once_266);

		sys.wait(3.5);
		sys.trigger($monster_flying_lostsoul_71);
			
		sys.wait(1);	
		
		sys.quickSave("Night Walk - Checkpoint 8");
		
		sys.wait(1);	
	}
	
	void LeeDeadend6Sub()
	{
		ShowNPCSubtitles("Lee", "You asked me why we're running...there's something I've been meaning to tell you.\nBut I've never found a way to say it.", 8);
		ShowNPCSubtitles("Lee", "Do you remember back at the hospital? In the last few weeks?", 4.15);
	}
	
	void LeeDeadend7Sub()
	{
		ShowNPCSubtitles("Lee", "Do you remember what kind of state mom was in?\nAll she could do was lie in bed.", 6.15);
		ShowNPCSubtitles("Lee", "She couldn't talk, she couldn't even move her arms.\nThe staff had to turn her on her side.", 7);
		ShowNPCSubtitles("Lee", "She was fed through a tube. Whenever she wasn't numbed by morphine she was in pain.\nShe was trapped in her mind.", 10.15);
	}
	
	void LeeDeadend8Sub()
	{
		ShowNPCSubtitles("Lee", "Well, She wasn't living any kind of life worth living.\nShe literally couldn't do anything.", 7);
		ShowNPCSubtitles("Lee", "Dad was gone most of the time. My brother, the fuck, didn't visit her.\nAll she did was lie in bed, looking at me.", 10);
		ShowNPCSubtitles("Lee", "And there I was, looking back at her, hoping it was a smile behind those eyes.\nHoping she wasn't in pain.", 10);
		ShowNPCSubtitles("Lee", "Hoping she didn't think of me as a complete failure.\nThat her family hadn't abandoned her in her worst hour.", 7.15);
	}
	
	void LeeDeadend9Sub()
	{
		ShowNPCSubtitles("Lee", "So...but...every day the staff would come in.\nI saw exactly what they gave her for her pain and how they did it.", 9);
		ShowNPCSubtitles("Lee", "60 milligrams of morphine, 4 times a day. Sometimes I sat there.\nWishing they would give her more and end it all right there.", 9.25);
	}
	
	void LeeDeadend10Sub()
	{
		ShowNPCSubtitles("Lee", "But they didn't. Every time, 60 milligrams. Without fault.", 4.25);
		
		sys.wait(1);
		
		ShowNPCSubtitles("Lee", "So...one day I followed one of the nurses as she stashed the meds back into a room.", 6);
		ShowNPCSubtitles("Lee", "And I thought nothing of it at first.\nBut...as time went on.", 4.2);
		ShowNPCSubtitles("Lee", "Days of me looking into her eyes, trying to read them I felt a sudden connection to her.", 5.1);
		ShowNPCSubtitles("Lee", "As if I felt what she felt...so I made up my mind.", 4.5);
		
		sys.wait(2);
		
		ShowNPCSubtitles("Lee", "The next day after they had given her her injections, I snuck into the storage place and grabbed a little extra.", 7.75);
		ShowNPCSubtitles("Lee", "I went back and gave mom just a little more, looking into her eyes as I filled her body with painkiller.", 8.15);
		ShowNPCSubtitles("Lee", "With poison. I couldn't read her.", 3.5);
	}
	
	void LeeDeadend11Sub()
	{
		ShowNPCSubtitles("Lee", "But it made no difference. So the next day I gave her a little more.\nThen a little more. And a little more. Until.", 10);
		ShowNPCSubtitles("Lee", "The day that it happened.\nI was looking into her eyes, stroking her hair.", 5);
		ShowNPCSubtitles("Lee", "After giving her the injection, I kissed her on the forehead and said goodbye.\nFor the last time.", 7.15);
	}
	
	void LeeDeadend12Sub()
	{
		ShowNPCSubtitles("Lee", "And I watched as life slowly left her eyes.\nI saw her glide away into nothing before I realized what I had done.", 9);
		ShowNPCSubtitles("Lee", "I took the life of the woman who gave me mine.", 3);
		ShowNPCSubtitles("Lee", "I...killed her. I killed my own mom...", 6);
	}

	void SewerDeadEndTalkPart2()
	{
		sys.trigger($SpeakerFindNothing);

		sitting = 1;
		thread UpdateCameraAngle2();			
	
		sys.fadeTo('1 1 1', 1, .0625);
