	void main()
	{
		$EndPipe_Platform_Railing.move(UP, 50);
		$EndPipe_Platform.move(UP, 256);
		
		objects_setup();
		thread extract_tubes(); 
		thread piston_discs_down();
		thread pump1piston1_start();
		thread pump1piston2_start();
		thread crankshaft ();
		thread orangecyl_pumpsegs1();
		thread orangecyl_pumpsegs2();
		thread orangecyl_pumpsegs3();
		thread cycle_pump3 ();
		thread cycle_pump4 ();
		thread pist1_loop ();
		thread pist2_loop ();
		sys.trigger($cabfunc_static_96609);
		sys.trigger($cabenv_storagecabinet_5);
		sys.trigger($func_static_87974);
		sys.trigger($env_storagecabinet_4);
		sys.wait(5);
		thread chainsawfight();
		sys.wait(3);
		thread impfight();
		sys.wait(7);
		thread tritefight();
		sys.wait(10);
		thread maggotcacofight();
	}
