	void TweakClouds_Session(float from, float to, float total_time)
	{
		float now = sys.getTime();
		float then = now + total_time;

		float tsec = 1.0 / total_time;

		float t_travel = to - from;		

		while(1)
		{
			now = sys.getTime();

			if(now >= then)
			{
				$benson_clouds.setShaderParm(8, to);
				break;
			}

			float t = (total_time - (then - now)) * tsec;

			t = EaseInOutCubic(t);

			$benson_clouds.setShaderParm(8, t * t_travel + from);

			sys.waitFrame();
		}
	}

	void TweakClouds(vector from_color, float from_alpha)
	{
		float total_time = 4.0f;		
		sys.fadeFromTo(from_color, from_alpha, '1 1 1', .7f, total_time);				
		TweakClouds_Session(0.125, 0.9, total_time);
		
		sys.fadeFromTo('1 1 1', .7f, '1 1 1', 0, total_time);
		TweakClouds_Session(0.9, 0.125, total_time);
	}

