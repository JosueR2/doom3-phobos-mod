	void Player3Subs()
	{
		ShowSubtitles("Sam", "I don't recall working there.\nIn fact, I don't recall any of it.", 6.75);
		ShowSubtitles("Sam", "It...It has no meaning to me.\nI don't recognize that person, that...version of me, at all.", 8);
	}

	void Player4Subs()
	{
		ShowSubtitles("Sam", "Just call me Sam.", 2);
		ShowSubtitles("Sam", "I am going to find Calloway and I think you're right\nabout baggage; About having a clean slate.", 5);
		ShowSubtitles("Sam", "Who I was is not as important as where I'm going.\nFinding Calloway would at least do some good for someone.", 9);
	}

	void Miles1Subs()
	{
		ShowSubtitles("Samantha", "Sam?...Ethan?...", 4.5);
		ShowSubtitles("Samantha", "Look...I looked up your real name in our database.", 4);
		ShowSubtitles("Samantha", "You are Ethan Rom, aged 32, born and raised in Vancouver, British Columbia, Canada.", 8);
		ShowSubtitles("Samantha", "Where you left your parents to join the FCE at a young age.", 4);
		ShowSubtitles("Samantha", "You have worked in the listening station on Mars.\nAnd you have last been seen entering the receptacle.", 6);
		ShowSubtitles("Samantha", "That's all I have...now that I know your name.", 4);
	}

	void Miles2Subs()
	{
		ShowSubtitles("Samantha", "It seems so. That's...really weird.", 4);
		ShowSubtitles("Samantha", "You know. The doctor's office where we first met\nis awfully close to the listening station.", 5.25);
		ShowSubtitles("Samantha", "You know, the place you worked at.", 3);
	}	

	
	void StartMilesTalkGondolaPartOne()
	{
		thread ShowSubtitles("Sam", "Miles?", 2);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Player1.ogg");

		Beat(.75);

		thread ShowSubtitles("Samantha", "Hmm? Yeah?", 2);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Miles1.ogg");

		Beat(.75);

		thread ShowSubtitles("Sam", "I found a way to the detention center...might as well start there.", 4);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Player2.ogg");

		Beat(.5);

		thread ShowSubtitles("Samantha", "Good luck! Tell me if you need anything.", 3);
		CharacterSays($player1, "sound/vo/e1m5_5/MilesTalkGondola/Miles2.ogg");
	}
	
