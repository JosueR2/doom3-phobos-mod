	void CharacterSays(entity characterEntity, string line)
	{
		sys.wait(characterEntity.startSoundShader(line, SND_CHANNEL_ANY));
	}

	float CharacterSaysNoWait(entity characterEntity, string line)
	{
		return characterEntity.startSoundShader(line, SND_CHANNEL_ANY);
	}

	void select_code()
	{
		float codeselect;

		while (1)
		{
			codeselect = sys.random(15);
		
				if (codeselect <= 5){
					sys.trigger ($code_config1);
					sys.wait(1);
				} else if (codeselect >= 11){
					sys.trigger ($code_config2);
					sys.wait(1);
				} 
				  else {
					sys.trigger ($code_config3);
					sys.wait(1);
				}
		}
	}
	
	void kill_code_selection()
	{
		sys.killthread ("map_e1m5_4::select_code");
	}
	
