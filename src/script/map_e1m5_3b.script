	void TryFrontDoor()
	{	
		sys.disableItemGroup("frontdoor");

		$house_front_door.startSoundShader("sound/shav/e1m5_2/locked_door.ogg", SND_CHANNEL_ANY);

		$house_front_door_handle.rotateOnce('-15 0 0');

		float angle = 0.5;
		$house_front_door_hinge.rotateOnce('0 0.5 0' * angle);

		float i = 0;
		while( i < 2 )
		{
			sys.waitFor($house_front_door_hinge);
			$house_front_door_hinge.rotateOnce('0 -1 0' * angle);
			sys.waitFor($house_front_door_hinge);
			$house_front_door_hinge.rotateOnce('0 1 0' * angle);
			i++;
		}	
		
		sys.waitFor($house_front_door_hinge);

		$house_front_door_hinge.rotateOnce('0 -0.5 0' * angle);

		$house_front_door_handle.rotateOnce('15 0 0');

		$house_front_door_clicker.hide();
		
		sys.wait(0.5);
		
		thread ShowSubtitles("Sam", "That would have been too easy.", 2);
		CharacterSays($player1, "sound/vo/e1m5_2/BensonHouse/FrontDoorReaction.ogg");

		sys.enableItemGroups();
	}

