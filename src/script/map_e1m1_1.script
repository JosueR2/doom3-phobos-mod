	{
		PhobosShowSubtitle_e1m1_1("...", "Miles. Hey.\nThe doctor mentioned you might be able to help me.");
		
		sys.wait(3);
		
		PhobosShowSubtitle_e1m1_1("...", "You know. Remembering.\nYou called me Sam?");
	}

	void Miles3Sub()
	{
		PhobosShowSubtitle_e1m1_1("Miles", "Still struggling with your memory I see.\nIt's more like half a year since we met.");
		
		sys.wait(4.25);
		
		PhobosShowSubtitle_e1m1_1("Miles", "I can't tell you exactly who you are. I don't know you that well.\nBut I know someone who does.");
		
		sys.wait(6.25);
		
		PhobosShowSubtitle_e1m1_1("Miles", "We have a mutual friend and colleague through whom I met you.");
		
		sys.wait(4);
		
		PhobosShowSubtitle_e1m1_1("Miles", "His name is Calloway.\nHe's currently at the Bulwark stationed.");
	}
	
	void Miles4Sub()
	{
		PhobosShowSubtitle_e1m1_1("Miles", "Sorry. I keep forgetting.");
		
		sys.wait(2.25);
		
		PhobosShowSubtitle_e1m1_1("Miles", "The Bulwark is the main base of operations for the Federacy here on Mars.");
		
		sys.wait(4.5);
		
		PhobosShowSubtitle_e1m1_1("Miles", "I'll be heading there now.\nBut you can tag along if you want.");
		
		sys.wait(5.75);
		
		PhobosShowSubtitle_e1m1_1("Miles", "The only way there right now, is with a shuttle from the Landing Terminal.");
		
		sys.wait(3);
		
		PhobosShowSubtitle_e1m1_1("Miles", "We should meet up there.");
	}

	void Player4Sub()
	{
		PhobosShowSubtitle_e1m1_1("Sam", "Look Milly. Something is seriously wrong with this place.");
		
		sys.wait(2.25);
		
		PhobosShowSubtitle_e1m1_1("Sam", "The whole city is shaking, lights are going out.\nIt's raining elevators.");
		
		sys.wait(6);
		
		PhobosShowSubtitle_e1m1_1("Sam", "And last time I checked.\nThat route was blocked.");
	}
	
	void Miles5Sub()
	{
		PhobosShowSubtitle_e1m1_1("Miles", "It's Miles. I don't know exactly what's going on.");
		
		sys.wait(4);
		
		PhobosShowSubtitle_e1m1_1("Miles", "Things are very chaotic right now.");
		
		sys.wait(4);
		
		PhobosShowSubtitle_e1m1_1("Miles", "I'll be looking for an alternate route myself.\nI would advice you to do the same.");
		
		sys.wait(4);
		
		PhobosShowSubtitle_e1m1_1("Miles", "I think the station at Recreation might have a shortcut.\nYou could try that.");
	}
	
	float callmileslock = 0;
	void CallMiles()
	{
		if(callmileslock == 0)
		{
			sys.trigger($trigger_once_28);

			callmileslock = 1;

			PhobosShowSubtitle_e1m1_1("Miles", "Agent Miles.");
			CallMilesCS($Comm_Holder, "sound/vo/e1m1/milescall2/miles1.ogg");
			CallMilesBeat(.125);
			
			thread Player1Sub();
			CallMilesCS(playerC, "sound/vo/e1m1/milescall2/player1.ogg");
			CallMilesBeat(.125);

			sys.trigger($func_earthquake_1);
			thread crossFadeEnt ($light_63500, '0 0 0', '0.33 0.42 0.49', 12);
			thread crossFadeEnt ($light_63531, '0 0 0', '0.33 0.42 0.49', 15);
			thread crossFadeEnt ($light_63501, '0 0 0', '0.49 0.54 0.61', 12);
			thread crossFadeEnt ($light_63502, '0 0 0', '0.49 0.54 0.61', 17);			
			thread crossFadeEnt ($light_63507, '0 0 0', '0.33 0.42 0.49', 12);			
			
			$speaker_105.fadeSound(SND_CHANNEL_ANY, -5, 3);
			$speaker_99.fadeSound(SND_CHANNEL_ANY, -5, 3);
			$speaker_98.fadeSound(SND_CHANNEL_ANY, -5, 3);			
			
			PhobosShowSubtitle_e1m1_1("Miles", "Yes! You're Sam.\nDo you have any recollection of me? Perchance?");
			CallMilesCS($Comm_Holder, "sound/vo/e1m1/milescall2/miles2.ogg");

			sys.trigger($SpeakerYesYoureSam);

			CallMilesBeat(.125);
			
			PhobosShowSubtitle_e1m1_1("Sam", "Perchance?\nWe met like half an hour ago.");
			CallMilesCS(playerC, "sound/vo/e1m1/milescall2/player2.ogg");
			CallMilesBeat(.125);
			
			thread Miles3Sub();
			CallMilesCSInterupt($Comm_Holder, "sound/vo/e1m1/milescall2/miles3.ogg", 0.3);
			
			PhobosShowSubtitle_e1m1_1("Sam", "The Bulwark?");
			CallMilesCS(playerC, "sound/vo/e1m1/milescall2/player3.ogg");
			CallMilesBeat(.125);
			
			thread Miles4Sub();
			CallMilesCS($Comm_Holder, "sound/vo/e1m1/milescall2/miles4.ogg");
			CallMilesBeat(.125);

			sys.trigger($func_earthquake_4);
			thread crossFadeEnt ($light_63531, '0 0 0', '0.33 0.42 0.49', 15);
			thread crossFadeEnt ($light_63502, '0 0 0', '0.49 0.54 0.61', 12);
			thread crossFadeEnt ($light_63501, '0 0 0', '0.49 0.54 0.61', 17);			
			thread crossFadeEnt ($light_63518, '0 0 0', '0.33 0.42 0.49', 12);

			thread Player4Sub();
			CallMilesCS(playerC, "sound/vo/e1m1/milescall2/player4.ogg");
			CallMilesBeat(.125);			
			
			thread Miles5Sub();
			CallMilesCS($Comm_Holder, "sound/vo/e1m1/milescall2/miles5.ogg");
			
			CallMilesBeat(.125);			

			thread ShowNPCSubtitles("Sam", "Alright. Yeah. I'll check it out.\nI guess I'll see you there then.", 4);
			CallMilesCS(playerC, "sound/vo/e1m1/milescall2/player5.ogg");
			
			$speaker_105.fadeSound(SND_CHANNEL_ANY, 0, 3);
			$speaker_99.fadeSound(SND_CHANNEL_ANY, 0, 3);
			$speaker_98.fadeSound(SND_CHANNEL_ANY, 0, 3);
			
			sys.trigger($func_earthquake_9);
			thread crossFadeEnt ($light_63531, '0 0 0', '0.33 0.42 0.49', 15);
			thread crossFadeEnt ($light_63501, '0 0 0', '0.49 0.54 0.61', 12);
			thread crossFadeEnt ($light_63502, '0 0 0', '0.49 0.54 0.61', 17);
			
			CallMilesBeat(.125);		

			if(callMilesCompleted == 0)
			{
				playerC.startSoundShader("sound/shav/e1m1/intercomclick2.ogg", SND_CHANNEL_ANY);
			}
			
			$comm_snapin.hide();

			CallMilesBeat(1);
			sys.trigger($trigger_completeCallMiles);		
			
			sys.trigger($func_earthquake_10);
			thread crossFadeEnt ($light_63531, '0 0 0', '0.33 0.42 0.49', 15);
			thread crossFadeEnt ($light_63502, '0 0 0', '0.49 0.54 0.61', 12);
			sys.trigger($light_64910);

			sys.wait(.1);
			$commscreen.hide();
			sys.wait(.1);
			$commscreen_offline.show();
			
			//hide broken down train in outside area.
			sys.trigger($removeBrokenTrain);
			
			//hide angry marine and guard on train station
			sys.trigger($func_remove_1);

			sys.trigger($TriggerRailLoop2);

			sys.trigger($SpeakerGoingToRecreation);

			sys.trigger($HideNoReasonToGoBack);

			sys.trigger($LockMCLights);
			
			sys.trigger($Trigger_Checkpoint2);
		}
	}

	void InsertSnapin()
	{
		$Comm_Holder.setKey ("click_item", "0");

		$player1.startSoundShader("sound/shav/e1m1/intercomclick1.ogg", SND_CHANNEL_ANY);

		$comm_snapin.show();
		sys.trigger($comm_beep);
		$comm_blinker_tex.hide();
		$comm_blinking_light.hide();
		sys.wait(.1);
		$commscreen_online.hide();
		sys.wait(.1);
		$commscreen.show();
		sys.wait(.2);
		
		$commscreen.setGuiParm("gui_parm41", 1);
		sys.trigger($commscreen);

		sys.wait(1.6);
		CallMiles();
	}	

