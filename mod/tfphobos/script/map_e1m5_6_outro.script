	void Outro_Update_Blur(entity ent, float from, float to, float duration)
	{
		float interval = (to - from);

		float time_before = sys.getTime();
		float time_end = time_before + duration;

		float value = from;
		float elapsed = 0;

		//sys.println("FROM: " + from + " -> TO: " + to);

		while(sys.getTime() < time_end)
		{
			ent.setShaderParm(3, value);
			sys.waitFrame();
			
			elapsed = sys.getTime() - time_before;

			value = from + (elapsed / duration * interval);

			//sys.println(value);
		}
		ent.setShaderParm(3, to);
	}
	
