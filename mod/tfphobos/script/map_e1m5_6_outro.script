		sys.trigger($outro_target_setinfluence_1);
		sys.trigger($SpeakerCrickets);
		$outro_phone_room_mover.rotateOnce('0 -14 0');
		
		$benson_barn_car_light_rotator.rotateOnce('0 180 0');

		sys.wait(2);

