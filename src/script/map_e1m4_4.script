			$invoice_item.setKey("click_item", "0");
			$lee_bag_inspect.setKey("click_item", "0");
			$lee_bag.hide();
			$lee_flannel_jacket.hide();
		}				
		
		// SET UP MISC. OBJECTS 
		{
			sys.trigger ($func_static_108110);
		}
		}
		// START UP REALM
		StartupRealm();
				
		//sys.fadeTo('0 0 0', 1, 0);
		//BackToVoid();
	}		
