	void TightenVice()
	{
		HideIntroClickers();

		//Move vice and make sounds etc.
		sys.trigger($func_rotating_vice_handle);
		
		Intro_CharacterSays($player1, "e1m3_1_vicecreak");
		
		Beat(.25);
		
		Intro_CharacterSays($player1, "e1m3_1_boxcreak");
		
		sys.trigger($func_rotating_vice_handle);
		
		//Snap off vice handle handle
		$vice_outer.startSoundShader("e1m3_1_vent_step03", SND_CHANNEL_ANY);
		$vice_handle.hide();
		$vice_handle_2.show();
		sys.trigger($moveable_vice_handle);

		$vice_outer.move(0, 1);
		$box_mover.move(0, 0.5);
		$box_mover.rotateOnce('0 5 0');		

		Beat(.25);
	
		Intro_CharacterSays($vice_handle_2, "e1m3_1_metalbar_drop");
		
		Beat(.10);
	
		thread ShowNPCSubtitles("Sam", "Oh fuck! Old piece of shit.", 2.25);
		Intro_CharacterSays($player1, "e1m3_1_intro_Player14");
		
		$LeeStepSpeaker.startSoundShader("e1m3_1_Leestep1", SND_CHANNEL_ANY);

		Beat(1);
		
		thread ShowNPCSubtitles("Lee", "Hey! Told you it wouldn't work.\nOh I think I found something. You're gonna love this.", 6.5);
		Intro_CharacterSays($player1, "e1m3_1_intro_Lee13");
		Intro_CharacterSays($player1, "e1m3_1_walkie_beep");
		
		Beat(.20);
		
		thread ShowNPCSubtitles("Sam", "What?", 2);
		Intro_CharacterSays($player1, "e1m3_1_intro_Player15");
		
		Beat(.75);
		
		MoveBear();

		sys.wait(.5);

		ShowIntroClickers();
	}

	void showTextCam(string text, entity e)
	{		
		e.setGuiParm("gui_parm1", text);
		e.setGuiParm("gui_parm2", 0);
		sys.trigger(e);

		sys.fadeTo('0 0 0', 0, 2);

		sys.wait(7);

		e.setGuiParm("gui_parm2", 1);
		sys.trigger(e);

		sys.fadeTo('0 0 0', 1, 1);

		sys.wait(1);		
	}

	void showText(string text)
	{
		entity e = sys.getEntity("cameraGui1");
		showTextCam(text, e);
	}

	float eqPeak = 5;

	void ManageEq()
	{
		sys.wait(114);

		float i = 0;
		while(i < 5)
		{
			eqPeak--;
			sys.wait(.5);
			i++;
		}

		sys.wait(6);

		i = 0;
		while(i < 5)
		{
			eqPeak++;
			sys.wait(.5);
			i++;
		}		
	}

	void StartIntroTalk()
	{				
		sys.fadeTo('0 0 0', 1, 0.01);
		sys.trigger($introCameraEp2);
		
		thread Intro_CharacterSays($player1, "e1m3_1_wind");
		
		if(1)
		{
			Beat(10);
			
			thread ShowNPCSubtitles("Sam", "Lee?", 2);
			Intro_CharacterSays($player1, "e1m3_1_intro_Player1");
		
			Beat(3.5);
			
			thread ShowNPCSubtitles("Sam", "Lee are you still there?", 2);
			Intro_CharacterSays($player1, "e1m3_1_intro_Player2");
		
			Beat(1.75);
			
			thread Intro_CharacterSays($player1, "e1m3_1_smallwind");
						
			thread ShowNPCSubtitles("Lee", "I can't see.", 2);
			Intro_CharacterSays($player1, "e1m3_1_intro_Lee1");
							
			Beat(1.75);
			
			thread ShowNPCSubtitles("Sam", "Tell me about the device. The box. ", 2);
			Intro_CharacterSays($player1, "e1m3_1_intro_Player3");
			
			Beat(1.75);
			
			thread ShowNPCSubtitles("Lee", "Its...been so long.", 2);
			Intro_CharacterSays($player1, "e1m3_1_intro_Lee2");
			
			Beat(1.75);
			
			thread ShowNPCSubtitles("Sam", "Why do you need me to find it?", 2);
			Intro_CharacterSays($player1, "e1m3_1_intro_Player4");
			
			Beat(1.75);			
			
			thread ShowNPCSubtitles("Lee", "Its a key. Our only chance to get out.", 3.5);
			Intro_CharacterSays($player1, "e1m3_1_intro_Lee3");
			
			thread showText("TEAM FUTURE PRESENTS");			

			Beat(1.75);
			
			thread ShowNPCSubtitles("Sam", "A key? But we had it. What happened?", 4);
			Intro_CharacterSays($player1, "e1m3_1_intro_Player5");
					
			Beat(1.75);			

			thread ShowNPCSubtitles("Lee", "I...I was in the attic. You were down below.", 4);
			Intro_CharacterSays($player1, "e1m3_1_intro_Lee4");
		}
		
		Beat(3.5);
		
		sys.trigger($speaker_summer);

		sys.trigger($intro_camera_0_1);
		sys.fadeTo('0 0 0', 0, 1);
		
		sys.wait(4);
		
		$target_null_intro_camera_0_1_mover.move(DOWN, 96);
		
		sys.wait(1);
		
		sys.trigger($speaker_intro_music_global);		
		
		sys.wait(8);

		float del = 0.05;

		$mc_636987864932753974_func_static_99297.setGuiParm("gui_parm3", "D");		
		sys.wait(del);
		$mc_636987864932753974_func_static_99297.setGuiParm("gui_parm3", "DI");		
		sys.wait(del);
		$mc_636987864932753974_func_static_99297.setGuiParm("gui_parm3", "DIS");		
		sys.wait(del);
		$mc_636987864932753974_func_static_99297.setGuiParm("gui_parm3", "DISR");		
		sys.wait(del);
		$mc_636987864932753974_func_static_99297.setGuiParm("gui_parm3", "DISRU");		
		sys.wait(del);
		$mc_636987864932753974_func_static_99297.setGuiParm("gui_parm3", "DISRUP");		
		sys.wait(del);
		$mc_636987864932753974_func_static_99297.setGuiParm("gui_parm3", "DISRUPT");		
		sys.wait(del);
		$mc_636987864932753974_func_static_99297.setGuiParm("gui_parm3", "DISRUPTI");		
		sys.wait(del);
		$mc_636987864932753974_func_static_99297.setGuiParm("gui_parm3", "DISRUPTIO");		
		sys.wait(del);
		$mc_636987864932753974_func_static_99297.setGuiParm("gui_parm3", "DISRUPTION");		
		sys.wait(del);

		sys.wait(1 - (del * 10));

		sys.wait(6);
		
		float dt = 1.0;
		sys.fadeTo('0 0 0', 1, dt * 0.67);
		float max = 4;
		float interval = dt / (max / .25); 
		float i = 0;
		while(i < max)
		{
			$blurscreen.setShaderParm( 3, i );
			i += .25;
			sys.wait(interval);
		}
		
		sys.trigger($intro_camera_2);
		$intro_camera_2_mover.move(90, 128);			
		sys.fadeTo('0 0 0', 0, .5);

		sys.wait(9.875);

		sys.fadeTo('0 0 0', 1, 1.75);

		sys.wait(1.75);

		sys.trigger($intro_camera_1);
		$intro_camera_1_mover.move(90, 64);
		
		sys.fadeTo('0 0 0', 0, 1.75);

		sys.wait(5.825);
		sys.fadeTo('0 0 0', 1, 0.125);
		sys.wait(0.0625);

		sys.trigger($func_cameraview_eq_closeup);
		sys.fadeTo('0 0 0', 0, 0.0625);

		$func_mover_eq_closeup.move(225, 64);

		sys.wait(3.9);
		
		sys.trigger($intro_camera_map);
		$intro_camera_mover_map.move(270, 64);

		sys.wait(4.5);

		sys.trigger($intro_camera_box);
		$intro_camera_mover_box.moveTo($target_null_box);

		sys.wait(5);

		sys.trigger($intro_camera_3);
		$movable_intro_camera_3.move(UP, 64);

		sys.wait(4.5);

		$intro_lee_walkietalkie.hide();
		
		$item_intro_todolist.setKey("click_item", 1);
		$item_intro_vice_reaction.setKey("click_item", 1);
		
		sys.trigger($speaker_intro_music_global);
		sys.trigger($speaker_intro_music);		
		sys.trigger($speaker_intro_creaking);
		sys.trigger($speaker_summer);
		sys.trigger($speaker_summer_low);	
		
		$tag_water_the_plants.show();
		
		sys.trigger($intro_camera_3);
		sys.trigger($intro_target_setinfluence_1);

		ManageEq();
	}
	
	void ViceReaction()
	{	
		HideIntroClickers();

		thread ShowNPCSubtitles("Sam", "We tried to open this box gently. Now it's time for force.", 4);
		Intro_CharacterSays($player1, "e1m3_1_intro_Player6");
		
		Beat(1.5);

		$LeeStepSpeaker.startSoundShader("e1m3_1_Leestep2", SND_CHANNEL_ANY);

		Beat(4);
		
		thread ShowNPCSubtitles("Lee", "Hey cowgirl. Grab the walkie.", 2.25);
		Intro_CharacterSays($LeeAtticSpeaker, "e1m3_1_intro_Lee5");
		
		Beat(.75);
		
		thread ShowNPCSubtitles("Sam", "Cowgirl? Seriously?", 2.5);
		Intro_CharacterSays($player1, "e1m3_1_intro_Player7");
		
		Beat(2);
	
		thread ShowNPCSubtitles("Lee", "Testing testing. Hello?", 2);
		Intro_CharacterSays($LeeWalkieSpeaker, "e1m3_1_intro_Lee6");
		Intro_CharacterSays($LeeWalkieSpeaker, "e1m3_1_walkie_beep");

		sys.wait(.5);

		ShowIntroClickers();
		
		$item_intro_sam_walkietalkie.setKey("click_item", 1);
		
		while(stillCalling == 1)
		{
			sys.wait(5);
			
			if(stillCalling == 0)
				break;			
			
			thread ShowNPCSubtitles("Lee", "Hellloooooo...", 2);
			Intro_CharacterSays($LeeWalkieSpeaker, "e1m3_1_intro_Lee7");
			Intro_CharacterSays($LeeWalkieSpeaker, "e1m3_1_walkie_beep");

			sys.wait(5);

			if(stillCalling == 0)
				break;				

			thread ShowNPCSubtitles("Lee", "Hey! Fuckwad.", 2);
			Intro_CharacterSays($LeeWalkieSpeaker, "e1m3_1_intro_Lee7_3");
			Intro_CharacterSays($LeeWalkieSpeaker, "e1m3_1_walkie_beep");

			sys.wait(5);

			if(stillCalling == 0)
				break;

			thread ShowNPCSubtitles("Lee", "Hello?", 2);
			Intro_CharacterSays($LeeWalkieSpeaker, "e1m3_1_intro_Lee7_1");
			Intro_CharacterSays($LeeWalkieSpeaker, "e1m3_1_walkie_beep");

			sys.wait(5);

			if(stillCalling == 0)
				break;
			
			thread ShowNPCSubtitles("Lee", "Fuckwaaad...", 2);
			Intro_CharacterSays($LeeWalkieSpeaker, "e1m3_1_intro_Lee7_2");
			Intro_CharacterSays($LeeWalkieSpeaker, "e1m3_1_walkie_beep");
		}

	}
	
