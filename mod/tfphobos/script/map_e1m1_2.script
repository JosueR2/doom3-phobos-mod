	float scoreCycleState = 0;
	
	void ScoreLight_Glow(string team, float lightNum)
	{		
		entity dust = sys.getEntity("scorelight_" + team + "_dust_" + lightNum);
		entity flare = sys.getEntity("scorelight_" + team + "_flare_" + lightNum);
		entity light = sys.getEntity("scorelight_" + team + "_light_" + lightNum);
		entity texOn = sys.getEntity("scorelight_" + team + "_tex_on_" + lightNum);
		entity texOff = sys.getEntity("scorelight_" + team + "_tex_off_" + lightNum);

		dust.show();
		light.show();
		flare.show();
		texOn.show();
		texOff.hide();

		sys.wait(.125);

		dust.hide();
		light.hide();
		flare.hide();
		texOn.hide();
		texOff.show();
	}

	void ScoreLight_Cycle(string team, float iterations)
	{
		if(scoreCycleState == 0)
		{
			scoreCycleState = 1;		
			thread crossFadeEnt ($bball_court_light_1, '0.49 0.54 0.61', '0.12 0.14 0.15', .5);
			thread crossFadeEnt ($bball_court_light_2, '0.49 0.54 0.61', '0.12 0.14 0.15', .5);
			thread crossFadeEnt ($bball_court_light_3, '0.49 0.54 0.61', '0.12 0.14 0.15', .5);
			thread crossFadeEnt ($bball_court_light_4, '0.49 0.54 0.61', '0.12 0.14 0.15', .5);

			float i = 0;
		
			while(i < iterations)
			{
				float l = 1;

				while(l < 10)
				{
					thread ScoreLight_Glow(team, l);
					sys.wait(.05);
					l++;
				}
				i++;
			}

			thread crossFadeEnt ($bball_court_light_1, '0.12 0.14 0.15', '0.49 0.54 0.61', .5);
			thread crossFadeEnt ($bball_court_light_2, '0.12 0.14 0.15', '0.49 0.54 0.61', .5);
			thread crossFadeEnt ($bball_court_light_3, '0.12 0.14 0.15', '0.49 0.54 0.61', .5);
			crossFadeEnt ($bball_court_light_4, '0.12 0.14 0.15', '0.49 0.54 0.61', .5);

			scoreCycleState = 0;
		}
	}

	float blueScoreMajor = 0;
	float blueScoreMinor = 0;

	void ScorePointBlue()
	{
		thread ScoreLight_Cycle("blue", 16);
		blueScoreMinor++;

		if(blueScoreMinor == 10)
		{	
			blueScoreMinor = 0;
			blueScoreMajor++;
		}

		float digit = 0;
		while(digit < 10)
		{
			sys.getEntity("scoreboard_blue_" + digit).hide();
			sys.getEntity("scoreboard_blue_0_" + digit).hide();

			digit++;
		}

		sys.getEntity("scoreboard_blue_" + blueScoreMajor).show();
		sys.getEntity("scoreboard_blue_0_" + blueScoreMinor).show();
	}

	float redScoreMajor = 0;
	float redScoreMinor = 0;

	void ScorePointRed()
	{
		thread ScoreLight_Cycle("red", 16);
		redScoreMinor++;

		if(redScoreMinor == 10)
		{	
			redScoreMinor = 0;
			redScoreMajor++;
		}

		float digit = 0;
		while(digit < 10)
		{
			sys.getEntity("scoreboard_red_" + digit).hide();
			sys.getEntity("scoreboard_red_0_" + digit).hide();

			digit++;
		}

		sys.getEntity("scoreboard_red_" + redScoreMajor).show();
		sys.getEntity("scoreboard_red_0_" + redScoreMinor).show();
	}
	
	void cokemachine_fall()
	{
		$cokemachine_swing.accelTime (.4);
        $cokemachine_swing.time (.5);
        $cokemachine_swing.rotateOnce ('0 0 90');
        sys.waitFor ($cokemachine_swing);
		sys.trigger($cokemachine_slam);
		sys.trigger($cokemachine_dust);
                
        $cokemachine_swing.accelTime (.05);
        $cokemachine_swing.time (.05);
        $cokemachine_swing.rotateOnce ('0 0 -4');
        sys.waitFor ($cokemachine_swing);
        $cokemachine_swing.rotateOnce ('0 0 4');
        sys.waitFor ($cokemachine_swing);

        $cokemachine_swing.time (.05);
        $cokemachine_swing.rotateOnce ('0 0 -2');
        sys.waitFor ($cokemachine_swing);
        $cokemachine_swing.rotateOnce ('0 0 2');
	}

