	float boxFirstTime = 1;
	void InsertBoxKey()
	{
		$boxkey_askey.show();
		$boxkey_askey.move(0, 4);
		$boxkey_askey.startSoundShader("shav_general_insert", SND_CHANNEL_ANY);
		sys.waitFor($boxkey_askey);
		sys.wait(.5);

		sys.wait($boxkey_askey_clicker.startSoundShader("shav_general_keycard", SND_CHANNEL_ANY));

		if(boxtimes == 0)
		{
			$boxkey_askey_clicker.startSoundShader("shav_general_alarm5", SND_CHANNEL_ANY);
		}
		else
		{
			$boxkey_askey_clicker.startSoundShader("shav_general_accepted", SND_CHANNEL_ANY);
		}

		sys.wait(1.75);
		$boxkey_askey.move(180, 4);
		$boxkey_askey.startSoundShader("shav_general_extract", SND_CHANNEL_ANY);
		sys.waitFor($boxkey_askey);
		sys.wait(.5);
		$boxkey_askey.hide();
		$player1.startSoundShader("e1m3_1_pickupbox", SND_CHANNEL_ANY);

		sys.wait(1);

		if(boxFirstTime == 1)
		{
			boxFirstTime = 0;
			thread ShowNPCSubtitles("Lee", "Let it burn.", 2.1);
			sys.wait($player1.startSoundShader("e1m1_intro_Lee19", SND_CHANNEL_ANY));
		}		

		if(boxtimes == 0)
		{
			$hospital_pick_box_from_burner.setKey("item_action", "Place");
			$hospital_pick_box_from_burner.setKey("click_item", 1);
			boxtimes++;
		}
		else if(boxtimes == 2)
		{
			thread KittySwitch();

			$boxkey_door_mover.rotateOnce('0 -85 0');
			$boxkey_door_mover.startSoundShader("e1m4_door_creek_1", SND_CHANNEL_ANY);
			sys.waitFor($boxkey_door_mover);
		}
		else
		{
			$boxkey_askey_clicker.setKey("click_item", 1);
		}
	}		
	
