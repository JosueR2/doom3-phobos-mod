	float officeBlinds = 1; //0 = closed, 1 = open, 2 = in transition
	void ToggleOfficeBlinds()
	{		
		if( officeBlinds != 2 )
		{				
			float i = 1;	
			if( officeBlinds == 0 )
			{			
				//Open them up
				officeBlinds = 2;

				while( i <= 9)
				{
					entity e = sys.getEntity("cargo_office_shutters_" + i);
					e.rotateOnce('-48 0 0');
					e.move(UP, (6 * (i-1)));
					sys.wait(.0625);
					i++;
				}
				
				sys.waitFor($cargo_office_shutters_9);

				officeBlinds = 1;
			}
			else
			{			
				//Close them down
				officeBlinds = 2;
				
				while( i <= 9)
				{
					float ie = 10 - i;
					entity ee = sys.getEntity("cargo_office_shutters_" + ie);
					ee.rotateOnce('48 0 0');
					ee.move(DOWN, (6 * (ie-1)));
					sys.wait(.0625);
					i++;
				}

				sys.waitFor($cargo_office_shutters_9);

				officeBlinds = 0;
			}
		}
	}

