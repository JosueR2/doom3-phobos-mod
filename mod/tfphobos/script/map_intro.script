	}

	void PushSwing()
	{
		vector o1 = $intro_swingset_push_clicker.getOrigin();
		vector o2 = $player1.getOrigin();
		
		float sign = -1;

		if(o2_x < o1_x)
		{
			sign = 1;
		}

		$SwingRotator.accelTime(.0625);
		$SwingRotator.time(1);
		$SwingRotator.decelTime(.5);

		$SwingRotator.startSoundShader("sound/shav/intro/swingset.ogg", SND_CHANNEL_ANY);
		$SwingRotator.rotateOnce(sign * '-10 0 0');

		sys.waitFor($SwingRotator);
		$SwingRotator.accelTime(.5);		

		float angle = 20;
		vector rotAngle = '1 0 0';

		while(angle > 0)
		{
			vector sa = sign * angle * rotAngle;

			$SwingRotator.rotateOnce(sa);
			//$SwingRotator.startSoundShader("sound/shav/intro/swingset.ogg", SND_CHANNEL_ANY);
			sys.waitFor($SwingRotator);

			sign *= -1;
			angle -= 2;
		}
	}
	
	void Lee4Sub()
	{
		PhobosShowSubtitle_intro("Girl", "I remember how we used to signal to eachother, after our parents had gone to bed.");
		
		sys.wait(5);
		
		ShowNPCSubtitles("Girl", "We would turn a lamp.\nOn and off three times.", 4);
	}
	
	void Gogo()
	{		
		ToggleLight();

		sys.fadeTo('0 0 0', 1, 0.01);

		sys.trigger($introCamera);
		activeCam = 1;

		sys.wait(3.5);
		
		thread showText("Emerald Valley, Oregon\nFederal Commonwealth of Earth");

		sys.wait(10);

		PhobosShowSubtitle_intro("Girl", "Hey. How did you get here?\nI almost didn't recognize you.");
		Intro_CharacterSays($introCamera, "sound/vo/e1m1/Intro/Lee1.ogg");

		Beat(1.5);

		PhobosShowSubtitle_intro("...", "I don't even recognize myself.\nWhere are you?");
		Intro_CharacterSays($introCamera, "sound/vo/e1m1/Intro/Player1.ogg");

		Beat(1.5);

		PhobosShowSubtitle_intro("Girl", "I'm here.");
		Intro_CharacterSays($introCamera, "sound/vo/e1m1/Intro/Lee2.ogg");

		Beat(1);
		thread showText("TEAM FUTURE PRESENTS");

		thread ShowNPCSubtitles("Girl", "I need your help. Do you remember the last night?\nBefore everything changed.", 7);
		Intro_CharacterSaysInterupt($introCamera, "sound/vo/e1m1/Intro/Lee3.ogg", 3);
		
		sys.wait(2.5);

		sys.trigger($SpeakerRemember);

		sys.wait(2);			
		
		sys.trigger($introCamera);
		activeCam = 0;
		sys.trigger($intro_target_setinfluence_1);
		
		sys.fadeTo('0 0 0', 0, 2);

		sys.wait(1);

		sys.wait(8);

		thread Lee4Sub();
		Intro_CharacterSays($player1, "sound/vo/e1m1/Intro/Lee4.ogg");
		
		sys.wait(1);
		
		thread turnOffHouseLights();

		crossFadeEnt ($LeeLight, offColor, onColor, .0625);

		sys.wait(.25);

		crossFadeEnt ($LeeLight, onColor, offColor, .0625);

		sys.wait(.75);

		crossFadeEnt ($LeeLight, offColor, onColor, .0625);

		sys.wait(.25);

		crossFadeEnt ($LeeLight, onColor, offColor, .0625);

		sys.wait(.75);

		crossFadeEnt ($LeeLight, offColor, onColor, .0625);

		sys.wait(.25);

		crossFadeEnt ($LeeLight, onColor, offColor, .0625);

		sys.wait(.5);

		sys.trigger($LightClicker);
	}
}