	float sewers_a2_bridge_lock = 1;
	float sewers_a3_bridge_lock = 1;

	vector motel_light_thunder_color = '0.51 0.26 0.22';

	void showTextCam(string text, entity e)
	{
		e.setGuiParm("gui_parm1", text);
		e.setGuiParm("gui_parm2", 0);
		sys.trigger(e);

		sys.fadeTo('0 0 0', 0, 2);

		sys.wait(7);

		e.setGuiParm("gui_parm2", 1);
		sys.trigger(e);

		sys.fadeTo('0 0 0', 1, 1);

		sys.wait(1);
	}
	
	void showText(string text)
	{
		entity e = sys.getEntity("cameraGui1");
		showTextCam(text, e);
	}	

	float GetRandom(float min, float variance)
	{
		return sys.random(variance) + min;
	}

	void LockBridgeDoor(float room, float direction)
	{
		entity door			= sys.getEntity("sewers_a" + room + "_" + direction + "_door");
		entity doorframe	= sys.getEntity("sewers_a" + room + "_" + direction + "_doorframe");
		entity doorlights	= sys.getEntity("sewers_a" + room + "_" + direction + "_doorlights");
		
		door.lock(2);
		doorframe.setShaderParm(7, 0);
		doorlights.setColor(0.5, 0, 0);
	}
	
	void OpenBridgeDoor(float room, float direction)
	{		
		entity door			= sys.getEntity("sewers_a" + room + "_" + direction + "_door");
		entity doorframe	= sys.getEntity("sewers_a" + room + "_" + direction + "_doorframe");
		entity doorlights	= sys.getEntity("sewers_a" + room + "_" + direction + "_doorlights");
		
		door.lock(0);
		doorframe.setShaderParm(7, 1);
		doorlights.setColor(0, 0.5, 0);
	}
	
	float TurnABridge(float room, float direction, float wing)
	{		
		entity sewerControls = sys.getEntity("sewers_a" + room + "_controls");

		sewerControls.setGuiParm ("gui_parm13", 1);
		sys.trigger(sewerControls);

		float directionOne = direction;
		float directionTwo = direction * wing;
		if( directionTwo > RC_WEST )
			directionTwo = directionTwo / (RC_WEST * 2);

		LockBridgeDoor(room, directionOne);
		LockBridgeDoor(room, directionTwo);

		entity bridgeCore = sys.getEntity("sewers_a" + room + "_bridgecore");
		bridgeCore.rotateOnce('0 -90 0');
		sys.waitFor(bridgeCore);

		direction = direction * 2;
		if( direction > RC_WEST )
			direction = RC_NORTH;
		
		directionOne = direction;
		directionTwo = direction * wing;
		if( directionTwo > RC_WEST )
			directionTwo = directionTwo / (RC_WEST * 2);
		
		OpenBridgeDoor(room, directionOne);
		OpenBridgeDoor(room, directionTwo);

		sewerControls.setGuiParm ("gui_parm13", 0);
		sys.trigger(sewerControls);		

		return direction;
	}

	void FloodgateBrightLight()
	{
		sys.wait(.25);

		sys.fadeTo('1 1 1', 1, .25);

		sys.wait(1);

		sys.fadeTo('1 1 1', 0, 1.25);

		$player1.startSoundShader("sound/shav/e1m5/floodgate_boom.ogg", SND_CHANNEL_ANY);		
		sys.trigger($SpeakerFloodgateMusic);

		sys.wait(1.5);

		sys.fadeTo('1 1 1', 1, 4.25);

		sys.wait(4.5);

		sys.fadeTo('1 1 1', 0, 4);
	}
	
	void UpdateMaps()
	{		
		$sewermap01.setGuiParm ("gui_parm12", sewers_a1_bridge_direction);
		$sewermap02.setGuiParm ("gui_parm12", sewers_a1_bridge_direction);
		$sewermap03.setGuiParm ("gui_parm12", sewers_a1_bridge_direction);
		$sewermap04.setGuiParm ("gui_parm12", sewers_a1_bridge_direction);
		$sewermap05.setGuiParm ("gui_parm12", sewers_a1_bridge_direction);
		
		$sewermap01.setGuiParm ("gui_parm13", sewers_a2_bridge_direction);
		$sewermap02.setGuiParm ("gui_parm13", sewers_a2_bridge_direction);
		$sewermap03.setGuiParm ("gui_parm13", sewers_a2_bridge_direction);
		$sewermap04.setGuiParm ("gui_parm13", sewers_a2_bridge_direction);
		$sewermap05.setGuiParm ("gui_parm13", sewers_a2_bridge_direction);
		
		$sewermap01.setGuiParm ("gui_parm14", sewers_a3_bridge_direction);
		$sewermap02.setGuiParm ("gui_parm14", sewers_a3_bridge_direction);
		$sewermap03.setGuiParm ("gui_parm14", sewers_a3_bridge_direction);
		$sewermap04.setGuiParm ("gui_parm14", sewers_a3_bridge_direction);
		$sewermap05.setGuiParm ("gui_parm14", sewers_a3_bridge_direction);
		
		sys.trigger($sewermap01);		
		sys.trigger($sewermap02);		
		sys.trigger($sewermap03);		
		sys.trigger($sewermap04);		
		sys.trigger($sewermap05);		
	}
	
	void UnlockA1Bridge()
	{
		sewers_a1_bridge_lock = 2;
	}
	
	void UnlockA2Bridge()
	{
		sewers_a2_bridge_lock = 2;
	}
	
	void UnlockA3Bridge()
	{
		sewers_a3_bridge_lock = 2;
	}
	
	void TurnA1Bridge()
	{
		if( sewers_a1_bridge_lock == 2 )
		{	
			sewers_a1_bridge_direction = TurnABridge( SEWERS_A1_ROOM, sewers_a1_bridge_direction, SEWERS_A1_BRIDGE_SECONDWING);
		
			UpdateMaps();
		}
	}
	
	void TurnA2Bridge()
	{
		if( sewers_a2_bridge_lock == 2 )
		{	
			sewers_a2_bridge_direction = TurnABridge( SEWERS_A2_ROOM, sewers_a2_bridge_direction, SEWERS_A2_BRIDGE_SECONDWING);
			UpdateMaps();
		}
	}
	
	void TurnA3Bridge()
	{
		if( sewers_a3_bridge_lock == 2 )
		{	
			sewers_a3_bridge_direction = TurnABridge( SEWERS_A3_ROOM, sewers_a3_bridge_direction, SEWERS_A3_BRIDGE_SECONDWING);
			UpdateMaps();
		}
	}
			
	void OpenSewerDrainHatch(float state)
	{
		if( state == SEWERS_DRAINS_STATE_NONE )
		{			
			return;
		}
				
		entity upperHatch = sys.getEntity("sewers_a" + state + "_hatch_upper");
		entity lowerHatch = sys.getEntity("sewers_a" + state + "_hatch_lower");
		entity portal = sys.getEntity("sewers_a" + state + "_hatch_portal");			
	
		sys.trigger(portal);
		upperHatch.move(UP, 48);
		lowerHatch.move(DOWN, 48);
		sys.waitFor(upperHatch);
	}
	
	void CloseSewerDrainHatch(float state)
	{
		if( state == SEWERS_DRAINS_STATE_NONE )
		{			
			return;
		}
		entity upperHatch = sys.getEntity("sewers_a" + state + "_hatch_upper");
		entity lowerHatch = sys.getEntity("sewers_a" + state + "_hatch_lower");
		entity portal = sys.getEntity("sewers_a" + state + "_hatch_portal");			
	
		upperHatch.move(DOWN, 48);
		lowerHatch.move(UP, 48);
		sys.waitFor(upperHatch);
		sys.trigger(portal);
	}

	entity GetSewerPos(float sds)
	{
		if(sds == 0)		
			return sys.getEntity("sewer_none_pos");
			
		return sys.getEntity("sewer_a" + sds + "_pos");
	}

	entity GetSewerLight(float sds)
	{
		if(sds == 0)		
			return sys.getEntity("sewers_none_light");
			
		return sys.getEntity("sewers_a" + sds + "_light");
	}

	entity GetSewerLightPos1(float sds)
	{					
		return sys.getEntity("sewers_a" + sds + "_poslight1");
	}

	entity GetSewerLightPos2(float sds)
	{			
		return sys.getEntity("sewers_a" + sds + "_poslight2");
	}

	void DrainASubs(float sds)
	{
		if(sds == 0){
			PhobosShowSubtitle_e1m5("PA", "Drain closed.");
		}
		if(sds == 1){
			PhobosShowSubtitle_e1m5("PA", "A1 Open.");
		}
		if(sds == 2){
			PhobosShowSubtitle_e1m5("PA", "A2 Open.");
		}
		if(sds == 3){
			PhobosShowSubtitle_e1m5("PA", "A3 Open.");
		}

		sys.wait(2);
		sys.hideSubtitles();
	}

	string GetSewerSound(float sds)
	{
		thread DrainASubs(sds);
		if(sds == 0)
			return "sound/shav/e1m5/drainnone.ogg";
		
		return "sound/shav/e1m5/draina" + sds + ".ogg";
	}
	
	float sewercontrolsactive = 0;
	float sewerlightactive = 0;

	void SewerLightBlink(entity sl, entity slp1, entity slp2)
	{
		sewerlightactive = 1;
		while(sewerlightactive==1)
		{
			sl.setColor(0.55, 0.55, 0.15);
			slp1.setColor(0.35, 0.35, 0.05);
			slp2.setColor(0.35, 0.35, 0.05);
			sys.wait(.2);			
			sl.setColor(0.15, 0.15, 0.15);
			slp1.setColor(0.35, 0.05, 0.05);
			slp2.setColor(0.35, 0.05, 0.05);
			sys.wait(.2);
		}
		sl.setColor(0.05, 0.35, 0.05);
		slp1.setColor(0.05, 0.35, 0.05);
		slp2.setColor(0.05, 0.35, 0.05);
	}

	void SewerLightBlinkA(entity sl)
	{
		sewerlightactive = 1;
		while(sewerlightactive==1)
		{
			sl.setColor(0.55, 0.55, 0.15);
			sys.wait(.2);			
			sl.setColor(0.15, 0.15, 0.15);
			sys.wait(.2);
		}
		sl.setColor(0.15, 0.55, 0.15);
	}

	void ToggleSewerDrains()
	{				
		if( sewercontrolsactive == 0)
		{
			$Drain_Control_Switch.setKey("click_item", "0");

			sewercontrolsactive = 1;
			thread CloseSewerDrainHatch( sewers_drains_state );	
			
			entity sl = GetSewerLight(sewers_drains_state);
			sl.setColor(0.25, 0.05, 0.05);

			if( sewers_drains_state != 0 )
			{
				entity slp1 = GetSewerLightPos1(sewers_drains_state);
				entity slp2 = GetSewerLightPos2(sewers_drains_state);			
			
				slp1.setColor(0.35, 0.05, 0.05);
				slp2.setColor(0.35, 0.05, 0.05);
			}
			sewers_drains_state = sewers_drains_state + 1;
			if( sewers_drains_state > SEWERS_DRAINS_STATE_A3 )
				sewers_drains_state = SEWERS_DRAINS_STATE_NONE;		

			$sewer_handle.moveTo(GetSewerPos(sewers_drains_state));
			$sewer_handle.startSoundShader("one_shot_electrical_switch_heavy_1", SND_CHANNEL_ANY);		

			sl = GetSewerLight(sewers_drains_state);
			
			if( sewers_drains_state != 0)
			{
				entity slp12 = GetSewerLightPos1(sewers_drains_state);
				entity slp22 = GetSewerLightPos2(sewers_drains_state);

				thread SewerLightBlink(sl, slp12, slp22);
			}
			else
				thread SewerLightBlinkA(sl);

			OpenSewerDrainHatch( sewers_drains_state );

			$sewer_drains_speaker.startSoundShader(GetSewerSound(sewers_drains_state), SND_CHANNEL_ANY);
			
			sewerlightactive = 0;		

			sys.wait(1);			

			sewercontrolsactive = 0;			

			$Drain_Control_Switch.setKey("click_item", "1");
		}
	}
	
	void service_ladder()
	{
		sys.trigger($ladder_slick);
		sys.trigger($func_static_68003);
		$func_static_68012.show();
		sys.trigger($func_static_67909);
		$func_mover_63.move( 90, 176 );
		sys.trigger($speaker_983);
		sys.waitFor($func_mover_63);
		sys.trigger($trigger_relay_206);
		$func_mover_62.move( -1, 256 );
		sys.trigger($speaker_984);		
	}

	void elev_hatch1()
	{
		sys.trigger($openhatch_1);
		$func_mover_67.rotateDownTo(Z_AXIS, 270);
		$func_mover_68.rotateUpTo(Z_AXIS, 90);
	}

	void elev_hatch1_close()
	{
		sys.trigger($closehatch_1);
		$func_mover_67.rotateUpTo(Z_AXIS, 0);
		$func_mover_68.rotateDownTo(Z_AXIS, 0);
	}


	#define GBO_NORTH 0
	#define GBO_EAST 1
	#define GBO_SOUTH 2
	#define GBO_WEST 3

	float goobridge_01_arm01 = GBO_EAST;
	float goobridge_01_arm02 = GBO_SOUTH;

	float goobridge_02_arm01 = GBO_EAST;
	float goobridge_02_arm02 = GBO_SOUTH;

	float goobridge_03_arm01 = GBO_EAST;
	float goobridge_03_arm02 = GBO_SOUTH;

	float goobridge_04_arm01 = GBO_EAST;
	float goobridge_04_arm02 = GBO_SOUTH;

	void DetractArm(string armName, float armDirection, string inout)//float bridgeNum, float armNum, float dir)
	{		
		entity arm = sys.getEntity(armName);
		entity light = sys.getEntity(armName + "_light");
		entity flare = sys.getEntity(armName + "_flare");
		entity tex = sys.getEntity(armName + "_tex");
		entity steam1a = sys.getEntity(armName + "_steam1a");
		entity steam2a = sys.getEntity(armName + "_steam2a");
		entity steam1b = sys.getEntity(armName + "_steam1b");
		entity steam2b = sys.getEntity(armName + "_steam2b");
		entity armPos = sys.getEntity(armName + "_" + inout);
		entity alarm = sys.getEntity(armName + "_speaker");
		entity drip = sys.getEntity(armName + "_drip");		

		thread crossFadeEnt (steam1a, '0 0 0', '0.411765 0.290196 0.27451', .35);
		thread crossFadeEnt (steam2a, '0 0 0', '0.411765 0.290196 0.27451', .35);
		thread crossFadeEnt (steam1b, '0 0 0', '0.160 0.120 0.040', .35);
		thread crossFadeEnt (steam2b, '0 0 0', '0.160 0.120 0.040', .35);

		arm.startSoundShader ("al4_cushions", SND_CHANNEL_ANY );

		sys.wait(.25);

		thread crossFadeEnt (steam1a, '0.411765 0.290196 0.27451', '0 0 0', .35);
		thread crossFadeEnt (steam2a, '0.411765 0.290196 0.27451', '0 0 0', .35);
		thread crossFadeEnt (steam1b, '0.160 0.120 0.040', '0 0 0', .35);
		thread crossFadeEnt (steam2b, '0.160 0.120 0.040', '0 0 0', .35);

		sys.wait(.5);

		light.On();		
		tex.show();
		flare.show();
		alarm.startSoundShader ("geoff_alarm", SND_CHANNEL_ANY );

		sys.wait(0.4);
		
		thread crossFadeEnt (steam1a, '0 0 0', '0.411765 0.290196 0.27451', .35);
		thread crossFadeEnt (steam2a, '0 0 0', '0.411765 0.290196 0.27451', .35);
		thread crossFadeEnt (steam1b, '0 0 0', '0.160 0.120 0.040', .35);
		thread crossFadeEnt (steam2b, '0 0 0', '0.160 0.120 0.040', .35);
	
		arm.moveTo(armPos);

		sys.trigger(drip);

		sys.waitFor(arm);

		thread crossFadeEnt (steam1a, '0.411765 0.290196 0.27451', '0 0 0', .35);
		thread crossFadeEnt (steam2a, '0.411765 0.290196 0.27451', '0 0 0', .35);
		thread crossFadeEnt (steam1b, '0.160 0.120 0.040', '0 0 0', .35);
		thread crossFadeEnt (steam2b, '0.160 0.120 0.040', '0 0 0', .35);

		sys.wait(.5);

		thread crossFadeEnt (steam1a, '0 0 0', '0.411765 0.290196 0.27451', .35);
		thread crossFadeEnt (steam2a, '0 0 0', '0.411765 0.290196 0.27451', .35);
		thread crossFadeEnt (steam1b, '0 0 0', '0.160 0.120 0.040', .35);
		thread crossFadeEnt (steam2b, '0 0 0', '0.160 0.120 0.040', .35);
		arm.startSoundShader ("al4_cushions", SND_CHANNEL_ANY );

		sys.wait(.25);		

		thread crossFadeEnt (steam1a, '0.411765 0.290196 0.27451', '0 0 0', .35);
		thread crossFadeEnt (steam2a, '0.411765 0.290196 0.27451', '0 0 0', .35);
		thread crossFadeEnt (steam1b, '0.160 0.120 0.040', '0 0 0', .35);
		thread crossFadeEnt (steam2b, '0.160 0.120 0.040', '0 0 0', .35);

		light.Off();		
		tex.hide();
		flare.hide();
		alarm.stopSound(SND_CHANNEL_ANY,0);
	}

