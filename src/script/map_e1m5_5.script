			$motel_as_lee_door_banger.move(90, -.25);
			sys.waitFor($motel_as_lee_door_banger);
			n++;
		}
	}

	void bang_door_04()
	{
		float n = 0;
		while(n < 2)
		{
			$motel_as_lee_door_banger.move(90, .25);
			sys.waitFor($motel_as_lee_door_banger);
			
			$motel_as_lee_door_banger.move(90, -.25);
			sys.waitFor($motel_as_lee_door_banger);
			n++;
		}
	}

	void LeeAnswersMotelQuestion()
	{
		sys.wait(.25);
	
		thread LeeBarnSub2();
		float lee1duration = CharacterSaysNoWait($player1, "sound/vo/e1m5_4/Barn/Lee2.ogg");

		sys.wait(4);
		lee1duration -= 4;

		sys.wait(lee1duration);

		Beat(.5);

		thread ShowSubtitles("Sam", "Oh? Did he have any news?", 3);
		float p3delay = CharacterSaysNoWait($player1, "sound/vo/e1m5_4/Barn/Player3.ogg");
		
		sys.wait(p3delay * 0.75);

		sys.trigger($SpeakerTVShow);

		sys.wait(p3delay * 0.25);

		Beat(.5);

		thread LeeBarnSub3();
		CharacterSays($player1, "sound/vo/e1m5_4/Barn/Lee3.ogg");				

		Beat(.5);

		thread ShowSubtitles("Sam", "That's great!", 2);
		CharacterSays($player1, "sound/vo/e1m5_4/Barn/Player4.ogg");
		
		Beat(.25);
		
		CharacterSays($SpeakerKnockKnock, "sound/shav/e1m5_5/knock01.ogg");	

		Beat(1.5);		

		CharacterSays($SpeakerKnockKnock, "sound/shav/e1m5_5/knock02.ogg");	

		Beat(.5);

		thread ShowSubtitles("Sam", "Lee?", 2);
		CharacterSays($player1, "sound/vo/e1m5_4/Barn/Player5.ogg");

		Beat(1.25);

		thread ShowSubtitles("Lee", "Someone's here.", 2);
		CharacterSays($player1, "sound/vo/e1m5_4/Barn/Lee4.ogg");		

		Beat(.5);
		
		thread PlayerBarnSub6();
		float p6d = CharacterSaysNoWait($player1, "sound/vo/e1m5_4/Barn/Player6.ogg");

		sys.wait(7);
		p6d -= 7;
		thread bang_door_03();
		CharacterSays($SpeakerKnockKnock, "sound/shav/e1m5_5/knock03.ogg");

		sys.wait(p6d);

		Beat(.5);

		thread bang_door_03();
		CharacterSays($SpeakerKnockKnock, "sound/shav/e1m5_5/knock03.ogg");

		Beat(.75);

		thread ShowSubtitles("Lee", "It's James...I...I don't.", 3);
		CharacterSays($player1, "sound/vo/e1m5_4/Barn/Lee5.ogg");	

		Beat(.5);

		thread bang_door_03();
		CharacterSays($SpeakerKnockKnock, "sound/shav/e1m5_5/knock03.ogg");

		thread ShowSubtitles("Sam", "Leave! Crawl out the back!", 3);
		CharacterSays($player1, "sound/vo/e1m5_4/Barn/Player7.ogg");	

		Beat(.5);

		sys.fadeTo('0 0 0', 1, 0);

		thread ShowSubtitles("Lee", "I'm...I'm sorry.", 3);
		CharacterSays($player1, "sound/vo/e1m5_4/Barn/Lee6.ogg");

		sys.fadeTo('0 0 0', 0, .125);

		thread UpdateStruggleKnockCamera(110, 45, 1.5);
		$cam_knock_on_door_mover.move(270, 160);
		sys.trigger($cam_knock_on_door);

		thread bang_door_04();
		float k4d = CharacterSaysNoWait($SpeakerKnockKnock, "sound/shav/e1m5_5/knock04.ogg");

		sys.wait(1.25);
		k4d -= 1.25;

		sys.fadeTo('0 0 0', 1, 0);

		sys.wait(k4d);
		
		$SpeakerTVShow.fadeSound(SND_CHANNEL_ANY, -100, 20);
		thread CharacterSays($player1, "sound/shav/e1m5_4/limbo.ogg");

		sys.wait(8);

		sys.fadeTo('0 0 0', 0, .125);

		//sys.trigger($motel_phone_gui);
		$sam_cam_2_mover.move(UP, 32);
		sys.trigger($sam_cam_2);

		sys.trigger($info_player_teleport_barn_back);
		vector angles = $after_ko_cam.getAngles();
		$player1.setViewAngles(angles);
		
		float yd = CharacterSaysNoWait($player1, "sound/shav/e1m5_5/yelling.ogg");

		sys.wait(yd - 1.3);

		$motel_phone_gui.setGuiParm("gui_parm1", 0);
		sys.trigger($motel_phone_gui);
		$motel_phone_light.hide();

		sys.wait(1.3);

		sys.trigger($sam_cam_2);

		$item_leave_barn_for_motel.setKey("click_item", 1);		
		$mc_637248963990923996_func_static_99986.hide();
	}

