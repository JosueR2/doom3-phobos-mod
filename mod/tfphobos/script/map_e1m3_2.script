	void coolant_tubes_insert()
	{
		vector fromColor = '0 0.2 0.3';
		vector toColor = '0 0.1 0.2';

		while(1)
		{
			$cl_tube1_clasp1.decelTime(0.15);
			$cl_tube1_clasp1.accelTime(0.35);
			$cl_tube1_clasp1.time(1);
			$cl_tube1.decelTime(0.15);
			$cl_tube1.accelTime(0.35);
			$cl_tube1.time(1);
			$cl_tube3_clasp1.decelTime(0.15);
			$cl_tube3_clasp1.accelTime(0.35);
			$cl_tube3_clasp1.time(1);
			$cl_tube3.decelTime(0.15);
			$cl_tube3.accelTime(0.35);
			$cl_tube3.time(1);
			$cl_tube1_clasp1.move(-2, 82);
			$cl_tube1.move(-2, 82);
			$cl_tube3_clasp1.move(-2, 82);
			$cl_tube3.move(-2, 82);
			sys.trigger($sp_cl_rot_relay);
			$quad_pipes_rot.rotateOnce ( '90 0 0' );
			$quad_pipes_rot2.rotateOnce ( '0 0 -90' );
			sys.waitFor($quad_pipes_rot);
			$cl_tube1.move(270, 128);
			$cl_tube3.move(180, 128);
			sys.trigger($sp_cl_tube_insert_relay);
			sys.waitFor($cl_tube1);
			sys.trigger($sp_cl_tube_whomp_relay);
			sys.wait(.125);
			sys.trigger($sp_clt_beam_warmup_relay);
			sys.trigger($cl_lightfade_in);
			sys.trigger($cl_flarefade_in);
			sys.trigger($cl_flarefade_in2);
			sys.trigger($cl_tube_beamstartend_relay);
			sys.trigger($cl_beam_relay);
			sys.wait(1.25);
			sys.trigger($sp_clt_beam_loop_relay);
			sys.wait(5);
			sys.trigger($cl_beam_relay);
			sys.wait(.25);
			sys.trigger($cl_tube_beamstartend_relay);
			thread crossFadeEnt ($cl_light1, fromColor, toColor, 2);
			thread crossFadeEnt ($cl_light2, fromColor, toColor, 2);
			thread crossFadeEnt ($cl_light3, fromColor, toColor, 2);
			thread crossFadeEnt ($cl_light5, fromColor, toColor, 2);
			sys.trigger($cl_flarefade_out);
			sys.wait(.25);
			sys.trigger($sp_clt_beam_loop_relay);
			sys.wait(.5);
			$cl_tube1.move(270, 128);
			$cl_tube3.move(180, 128);
			sys.trigger($sp_cl_tube_exit_relay);
			$cl_tube2_clasp1.restorePosition();
			$cl_tube2.restorePosition();
			$cl_tube4_clasp1.restorePosition();
			$cl_tube4.restorePosition();
			sys.wait(1.25);
			$cl_tube1.decelTime(0);
			$cl_tube1.accelTime(0.25);
			$cl_tube1.time(3);
			$cl_tube1_clasp1.decelTime(0);
			$cl_tube1_clasp1.accelTime(0.25);
			$cl_tube1_clasp1.time(3);
			$cl_tube3.decelTime(0);
			$cl_tube3.accelTime(0.25);
			$cl_tube3.time(3);
			$cl_tube3_clasp1.decelTime(0);
			$cl_tube3_clasp1.accelTime(0.25);
			$cl_tube3_clasp1.time(3);
			$cl_tube1.move(-2, 704);
			$cl_tube1_clasp1.move(-2, 704);
			$cl_tube3.move(-2, 704);
			$cl_tube3_clasp1.move(-2, 704);
			$cl_tube2_clasp1.decelTime(0.15);
			$cl_tube2_clasp1.accelTime(0.35);
			$cl_tube2_clasp1.time(1);
			$cl_tube2.decelTime(0.15);
			$cl_tube2.accelTime(0.35);
			$cl_tube2.time(1);
