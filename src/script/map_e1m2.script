				sys.wait(.75);
								
				$Fork2.move(DOWN, 176);
				sys.trigger($func_aas_obstacle_2);
				sys.waitFor($Fork2);
				
				fork2State = 0;
			}

			$CarForkSwitch2.setKey("click_item", "1");
		}
	}
	
	float garageElevatorState = 0;

	void MaintainGarageElevatorCallers()
	{
		if(garageElevatorState == 0)	
		{		
			$garage_elevator_call_item_1.setKey("click_item", "0");
			$garage_elevator_call_item_2.setKey("click_item", "0");
			$garage_elevator_call_item_3.setKey("click_item", "1");
			$garage_elevator_call_item_4.setKey("click_item", "1");
		}
		else
		{
			$garage_elevator_call_item_1.setKey("click_item", "1");
			$garage_elevator_call_item_2.setKey("click_item", "1");
			$garage_elevator_call_item_3.setKey("click_item", "0");
			$garage_elevator_call_item_4.setKey("click_item", "0");
		}
	}

	void FlashCallLight(entity tex, entity flare, entity light)
	{
		tex.setColor(0,1,0);
		flare.show();
		light.show();
		
		sys.wait(0.125);
		
		tex.setColor(0.125,0,0);
		flare.hide();
		light.hide();
	}

	void AnimateGarageElevatorCall(float station)
	{
		entity callItem = sys.getEntity("garage_elevator_call_item_" + station);
		callItem.setKey("click_item", "0");

		entity button = sys.getEntity("garage_elevator_call_button_" + station);
		float direction = button.getFloatKey("direction");
		
		button.move(direction, 1);
		button.startSoundShader("sound/shav/e1m1/intercomclick1.ogg", SND_CHANNEL_ANY);
		sys.waitFor(button);
		sys.wait(.125);
		button.startSoundShader("sound/shav/e1m1/intercomclick2.ogg", SND_CHANNEL_ANY);
		button.move(direction + 180, 1);

		entity tex1 = sys.getEntity("garage_elevator_call_tex_" + station + "_1");
		entity tex2 = sys.getEntity("garage_elevator_call_tex_" + station + "_2");
		entity tex3 = sys.getEntity("garage_elevator_call_tex_" + station + "_3");
		entity toptex = sys.getEntity("garage_elevator_top_tex");
		entity bottomtex = sys.getEntity("garage_elevator_bottom_tex");

		entity flare1 = sys.getEntity("garage_elevator_call_flare_" + station + "_1");
		entity flare2 = sys.getEntity("garage_elevator_call_flare_" + station + "_2");
		entity flare3 = sys.getEntity("garage_elevator_call_flare_" + station + "_3");
		entity topflare = sys.getEntity("garage_elevator_top_flare");
		entity bottomflare = sys.getEntity("garage_elevator_bottom_flare");

		entity light1 = sys.getEntity("garage_elevator_call_light_" + station + "_1");
		entity light2 = sys.getEntity("garage_elevator_call_light_" + station + "_2");
		entity light3 = sys.getEntity("garage_elevator_call_light_" + station + "_3");
		entity toplight = sys.getEntity("garage_elevator_top_light");
		entity bottomlight = sys.getEntity("garage_elevator_bottom_light");

		while(garageElevatorState == 2)
		{
			thread FlashCallLight(toptex, topflare, toplight);			
			FlashCallLight(tex1, flare1, light1);
			thread FlashCallLight(bottomtex, bottomflare, bottomlight);
			FlashCallLight(tex2, flare2, light2);
			FlashCallLight(tex3, flare3, light3);
		}

		if(garageElevatorState == 1)
		{
			toptex.setColor(0,1,0);
			topflare.show();
			toplight.show();

			bottomtex.setColor(0.125,0,0);
			bottomflare.hide();
			bottomlight.hide();
		}
		else
		{
			bottomtex.setColor(0,1,0);
			bottomflare.show();
			bottomlight.show();

			toptex.setColor(0.125,0,0);
			topflare.hide();
			toplight.hide();
		}		
	}
	
	void ToggleGarageElevatorInner(float callSound)
	{		
		//17*64 - 24 = 1064
		
		if(garageElevatorState != 2 )
		{
			$garage_elevator_item.setKey ("click_item", "0");			

			if(callSound == 1)
			{
				thread ShowNPCSubtitles("PA", "Calling elevator.", 2.25);
				sys.trigger($speaker_garagevoice_call);
			}

			thread AnimateGarageElevatorCall(1);
			thread AnimateGarageElevatorCall(2);
			thread AnimateGarageElevatorCall(3);
			thread AnimateGarageElevatorCall(4);

			if( garageElevatorState == 0 )
			{
				garageElevatorState = 2;

				$garage_elevator_handle.move(UP, 12);
				$garage_elevator_handle.startSoundShader("sound/shav/e1m5_3/large_switch.ogg", SND_CHANNEL_ANY);
				
				sys.wait(.75);

				$bigelev_lowerdoor_1.move(UP, 50);
				sys.wait(.25);				
				$bigelev_lowerdoor_2.move(UP, 50);
				
				sys.waitFor($bigelev_lowerdoor_2);
				
				$GarageElevator.move(UP, 1064);

				$GarageElevator_wheel_east_1.rotateOnce('3200 0 0');
				$GarageElevator_wheel_east_2.rotateOnce('3200 0 0');
				$GarageElevator_wheel_east_3.rotateOnce('3200 0 0');
				$GarageElevator_wheel_east_4.rotateOnce('3200 0 0');
				$GarageElevator_wheel_west_1.rotateOnce('-3200 0 0');
				$GarageElevator_wheel_west_2.rotateOnce('-3200 0 0');
				$GarageElevator_wheel_west_3.rotateOnce('-3200 0 0');
				$GarageElevator_wheel_west_4.rotateOnce('-3200 0 0');
				
				sys.waitFor($GarageElevator);
				
				$GarageElevator.startSoundShader("c1_pipeupaway", SND_CHANNEL_ANY);
				
				$bigelev_upperdoor_1.move(DOWN, 50);
				sys.wait(.25);				
				$bigelev_upperdoor_2.move(DOWN, 50);
				
				sys.waitFor($bigelev_upperdoor_2);
				
				garageElevatorState = 1;

				thread ShowNPCSubtitles("PA", "Elevator has arrived.", 2.25); 
				sys.trigger($speaker_garagevoice_arrive);
			}
			else if( garageElevatorState == 1 )
			{
				garageElevatorState = 2;

				$garage_elevator_handle.move(DOWN, 12);
				$garage_elevator_handle.startSoundShader("sound/shav/e1m5_3/large_switch.ogg", SND_CHANNEL_ANY);
				
				sys.wait(.75);

				$bigelev_upperdoor_1.move(UP, 50);
				sys.wait(.25);				
				$bigelev_upperdoor_2.move(UP, 50);
				
				sys.waitFor($bigelev_upperdoor_2);
				
				$GarageElevator.move(DOWN, 1064);

				$GarageElevator_wheel_east_1.rotateOnce('-3200 0 0');
				$GarageElevator_wheel_east_2.rotateOnce('-3200 0 0');
				$GarageElevator_wheel_east_3.rotateOnce('-3200 0 0');
				$GarageElevator_wheel_east_4.rotateOnce('-3200 0 0');
				$GarageElevator_wheel_west_1.rotateOnce('3200 0 0');
				$GarageElevator_wheel_west_2.rotateOnce('3200 0 0');
				$GarageElevator_wheel_west_3.rotateOnce('3200 0 0');
				$GarageElevator_wheel_west_4.rotateOnce('3200 0 0');
				
				sys.waitFor($GarageElevator);
				
				$GarageElevator.startSoundShader("c1_pipeupaway", SND_CHANNEL_ANY);
				
				$bigelev_lowerdoor_1.move(DOWN, 50);
				sys.wait(.25);				
				$bigelev_lowerdoor_2.move(DOWN, 50);
				
				sys.waitFor($bigelev_lowerdoor_2);

				
				garageElevatorState = 0;
			}			
			$garage_elevator_item.setKey ("click_item", "1");
			MaintainGarageElevatorCallers();
		}		
	}

	void ToggleGarageElevator()
	{
		ToggleGarageElevatorInner(1);
	}

	void ToggleGarageElevatorNoSound()
	{
		ToggleGarageElevatorInner(0);
	}
	
	void CallGarageElevatorTop()
	{
		if( garageElevatorState == 0 )
		{			
			ToggleGarageElevator();
		}
	}
	
	void CallGarageElevatorBottom()
	{
		if( garageElevatorState == 1 )
		{
			ToggleGarageElevator();
		}
	}
	
	void CharacterSays(entity characterEntity, string line)
	{
		sys.wait(characterEntity.startSoundShader(line, SND_CHANNEL_ANY));
	}

	float ConfScreenReady = 0;

	void TurnOnScreen(entity screen)
	{
		
		screen.setGuiParm("gui_parm91", "0");
		screen.startSoundShader("guisounds_open", SND_CHANNEL_ANY);
		sys.trigger(screen);		
	}
	
	void ConferenceScene()
	{
		//Flare
		thread crossFadeEnt ($func_static_89141, '0 0 0', '0.458824 0.415686 0.364706', 1);

		//Lamp
		thread crossFadeEnt ($func_static_98772, '0 0 0', '1 1 1', 1);
		
		//Lights
		thread crossFadeEnt ($light_59951, '0 0 0', '0.65 0.64 0.53', 1);
		thread crossFadeEnt ($light_59950, '0 0 0', '0.65 0.64 0.53', 1);			

		sys.wait(1.5);

		TurnOnScreen(sys.getEntity("func_static_89138"));
		sys.wait(.25);
		TurnOnScreen(sys.getEntity("func_static_89140"));
		sys.wait(.25);
		TurnOnScreen(sys.getEntity("func_static_98773"));		
	}
	
	void endMilesConvo()
	{
		sys.trigger($intercom_click_spkr);
		$comm_snapin.hide();
		
		sys.wait(.1);
		$commscreen.hide();
		sys.wait(.1);
		$commscreen_offline.show();
		sys.wait(1);
		sys.trigger($trigger_relay_231);

		sys.quickSave("Stranger in a Strange Land - Checkpoint 9");
		
		ConferenceScene();		
	}
	
	void InsertSnapin()
	{
		sys.trigger($comm_beep);
		$comm_blinker_tex.hide();
		$comm_blinking_light.hide();
		sys.wait(.1);
		$commscreen_online.hide();
		sys.wait(.1);
		$commscreen.show();
		sys.wait(.1);
		$player1.startSoundShader("sound/shav/e1m1/intercomclick1.ogg", SND_CHANNEL_ANY);
		$comm_snapin.show();
		sys.wait(.1);
		$Comm_Holder.setKey ("click_item", "0");

		$commscreen.setGuiParm("gui_parm41", 1);
		sys.trigger($commscreen);

		sys.wait(1.6);
		sys.trigger($trigger_once_306);
		sys.trigger($convo_start_relay);
	}		
	
