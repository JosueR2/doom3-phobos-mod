	float breakDoorState = 0;
	void BreakDoor()
	{
		if(breakDoorState == 0)
		{
			$deck_door.startSoundShader("sound/shav/e1m5_2/HandleRot.ogg", SND_CHANNEL_ANY);
			$deck_door.time(.125);
			$deck_door.move(0, 2);

			sys.waitFor($deck_door);
			sys.wait(.5);
			
			$deck_door_crowbar_clicker.setKey("item_type", "action");
			$deck_door_crowbar_clicker.setKey("item_action", "Open");
			$deck_door_crowbar_clicker.setKey("clickonce", 1);
			$deck_door_crowbar_clicker.setKey("item_disabled", 0);

			breakDoorState = 1;

			// Hide all the try clickers. They are no longer relevant
			$house_front_door_clicker.hide();
			$garage_door_try_clicker.hide();
		}
		else
		{
			$deck_door.startSoundShader("sound/shav/e1m1/slidingdoor.ogg", SND_CHANNEL_ANY);
			$deck_door.time(2.25);
			$deck_door.move(0, 50);
			$deck_door_crowbar_clicker.hide();
		}
	}

	float garageDoorState = 0;

	void OpenGarageDoor()
	{
		if(garageDoorState == 1)
		{
			return;
		}

		garageDoorState = 2;

		$garage_door_speaker.stopSound(SND_CHANNEL_ANY,0);

		sys.trigger($garage_door_speaker);
		sys.trigger($garage_portal);
		if(debug)
		sys.println("The portal is triggered");
		
		$garage_door_1_rotator.rotateOnce('0 0 -90');
		$garage_door_2_rotator.rotateOnce('0 0 -90');
		$garage_door_3_rotator.rotateOnce('0 0 -90');
		$garage_door_4_rotator.rotateOnce('0 0 -90');
		
		sys.waitFor($garage_door_4_rotator);

		$garage_door_clip.hide();

		$garage_door_1_mover.move(UP, 4);
		$garage_door_2_mover.move(UP, 32);
		$garage_door_3_mover.move(UP, 60);
		$garage_door_4_mover.move(UP, 88);
		
		$garage_door_clicker.setKey("item_action", "Close");
		sys.waitFor($garage_door_4_mover);

		garageDoorState = 1;
	}

	void CloseGarageDoor()
	{
		if(garageDoorState == 0)
		{
			return;
		}
		
		garageDoorState = 2;

		$garage_door_speaker.stopSound(SND_CHANNEL_ANY,0);

		sys.trigger($garage_door_speaker);

		$garage_door_1_mover.move(DOWN, 4);
		$garage_door_2_mover.move(DOWN, 32);
		$garage_door_3_mover.move(DOWN, 60);
		$garage_door_4_mover.move(DOWN, 88);
		
		sys.waitFor($garage_door_4_mover);

		$garage_door_1_rotator.rotateOnce('0 0 90');
		$garage_door_2_rotator.rotateOnce('0 0 90');
		$garage_door_3_rotator.rotateOnce('0 0 90');
		$garage_door_4_rotator.rotateOnce('0 0 90');

		sys.waitFor($garage_door_4_rotator);

		$garage_door_clip.hide();
		$garage_door_clicker.setKey("item_action", "Open");
		sys.trigger($garage_portal);
		if(debug)
		sys.println("The portal is triggered");

		garageDoorState = 0;
	}

	void ToggleGarageDoor()
	{
		if(garageDoorState == 2)
		{
			return;
		}

		$garage_door_clip.show();

		if(garageDoorState == 0)
		{
			OpenGarageDoor();
		}
		else
		{
			CloseGarageDoor();
		}

		sys.wait(.5);

		$garage_door_clicker.setKey("item_disabled", 0);
	}

