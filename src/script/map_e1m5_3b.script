	void PantryHatchKnob()
	{
		$player1.startSoundShader("sound/shav/e1m5_2/knobrot.ogg", SND_CHANNEL_ANY);
		$pantry_knob_mover.rotateOnce('0 0 90');
		pantryKnobState = (pantryKnobState + 1) % 4;

		if(pantryKnobState == 2)
		{
			$player1.startSoundShader("sound/shav/e1m5_2/knobwin.ogg", SND_CHANNEL_ANY);
			$cellar_hatch_clicker.setKey("click_item", 1);

			sys.wait(.25);

			if(pantryKnobDidSomething == 0)
			{
				pantryKnobDidSomething = 1;
				thread ShowSubtitles("Sam", "That did something.", 2);
				$player1.startSoundShader("sound/vo/player/general/thatdidsomethinginternal.ogg", SND_CHANNEL_ANY);
			}
		}
		else
		{
			$cellar_hatch_clicker.setKey("click_item", 0);
		}

		sys.waitFor($pantry_knob_mover);
		sys.wait(.25);

		$pantry_knob_clicker.setKey("item_action", "Rotate");
		$pantry_knob_clicker.setKey("item_disabled", 0);		
