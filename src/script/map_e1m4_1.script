	void EnableArachLifts()
	{	
		$arach_elev_south_clicker_nope.hide();
		$arach_elev_north_clicker_nope.hide();
	
		$arach_lifts_clicker.setKey("click_item", "0");
		sys.trigger($arach_lift_whirr_spkr);
		$arach_lifts_handle.rotateDownTo(X_AXIS, 0);
		
		sys.waitFor($arach_lifts_handle);
		
		$arach_elev_south_top_clicker.show();
		$arach_elev_south_clicker.show();
		$arach_elev_north_top_clicker.show();
		$arach_elev_north_clicker.show();
		$arach_elev_south_bottom_light.setColor(0, 0.5, 0);
		$arach_elev_south_top_light.setColor(0, 0.5, 0);
		$arach_elev_north_bottom_light.setColor(0, 0.5, 0);
		$arach_elev_north_top_light.setColor(0, 0.5, 0);
		$arach_elev_south_top_flare.setColor(0, 0.501961, 0);
		$arach_elev_south_bottom_flare.setColor(0, 0.501961, 0);
		$arach_elev_north_top_flare.setColor(0, 0.501961, 0);
		$arach_elev_north_bottom_flare.setColor(0, 0.501961, 0);
		$arach_elev_south_top_tex.setColor(0, 0.501961, 0);
		$arach_elev_south_bottom_tex.setColor(0, 0.501961, 0);
		$arach_elev_north_top_tex.setColor(0, 0.501961, 0);
		$arach_elev_north_bottom_tex.setColor(0, 0.501961, 0);
