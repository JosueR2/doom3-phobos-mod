	void objects_setup()	
	{		
		$tube1.bind($tube_extracter);
		$tube_extracter.moveTo($extracter_outside);
		sys.trigger($tube_compartment);
		$tube1.show();
		$tube1_tipa.show();
		$tube1_tipb.show();
		sys.trigger($tlight1);
		$tube1b.show();
		$tube1_tipa2.show();
		$tube1_tipb2.show();
		sys.trigger($tlight1b);
		sys.waitFor($tube_extracter);
		
		$orange_pumpcyl_master.rotateOnce ('-45 0 0');
		
		$pist1.bind($pistbase);
		$pistcasing.bind($pistbase);
		$pistlight1.bind($pistbase);
		$pistlight2.bind($pistbase);
		$pistbase.rotateOnce ( '-45 0 0' );
		
		$pist2.bind($pistbase2);
		$pistcasing2.bind($pistbase2);
		$pistlight3.bind($pistbase2);
		$pistlight4.bind($pistbase2);
		$pistbase2.rotateOnce ( '0 0 -45' );
		
		$func_mover_112.bind($crank_master);
		$func_mover_116.bind($crank_master);
		$crank_master.move(0, 640);
		sys.waitFor($crank_master);
		$crank_master.rotateOnce ('0 -45 0');
		sys.waitFor($crank_master);
		
		$func_mover_112.unbind();
		$func_mover_116.unbind();
		$pistrod1.unbind();
		$pistrod2.unbind();

		sys.wait(.1);
		
		$func_mover_112.bind($piston1);
		$func_mover_116.bind($piston2);
		$pistrod1.bind($piston1);
		$pistrod2.bind($piston2);
	}

