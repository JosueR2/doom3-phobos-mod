	void ArachLifts_Denied()
	{
		$arach_elev_north_clicker_nope.setKey("click_item", "0");
		$arach_elev_south_clicker_nope.setKey("click_item", "0");
		sys.trigger($arach_lifts_disabled_spkr);
		sys.wait(1);
		sys.trigger($elevator_locked_spkr);
		sys.wait(3);
		$arach_elev_north_clicker_nope.setKey("click_item", "1");
		$arach_elev_south_clicker_nope.setKey("click_item", "1");
	}
	
	void Imp_Lift_Malfunction()
	{
		sys.trigger($target_setkeyval_1);
		sys.trigger($target_setinfluence_8);
		sys.trigger($poweroff_relay);
		sys.trigger($emerpower_relay);
		sys.trigger($sp_pwr_down);
		$implift_gui_bot.setGuiParm( "gui_parm5", 4 );
		$implift_gui_top.setGuiParm( "gui_parm5", 4 );
		$implift_gui_bot_frm.setShaderParm( 7, 0 );
		$implift_gui_top_frm.setShaderParm( 7, 0 );
		
		sys.wait(.7);
		
		sys.trigger($elegui_fadeout_spkr);
		
		sys.wait(2.3);
		
		$implift_gui_bot.hide();
		$implift_gui_top.hide();
		$implift_gui_bot_frm.setSkin( "skins/doorlight_shaderparmoff" );
		$implift_gui_top_frm.setSkin( "skins/doorlight_shaderparmoff" );
		
		sys.trigger($impbreath_relay);
		
		sys.trigger($impattack_relay);	
	}
	
	void Lift_Malfunction_Fix()
	{
		sys.trigger($emerpower_relay);
		sys.wait(3.25);
		sys.trigger($sp_pwr_up);
		sys.trigger($target_setinfluence_8);
		sys.wait(1.75);
		sys.trigger($elegui_blink_spkr);
		sys.trigger($poweroff_relay);
		$implift_gui_bot_fix.show();
		$implift_gui_top.show();
		$implift_gui_bot_frm.setSkin( "skins/doorlight_shaderparmon" );
		$implift_gui_top_frm.setSkin( "skins/doorlight_shaderparmon" );
		sys.wait(.25);
		$implift_gui_bot_fix.setGuiParm( "gui_parm5", 0 );
		$implift_gui_top.setGuiParm( "gui_parm5", 0 );
		$implift_gui_bot_frm.setShaderParm( 7, 1 );
		$implift_gui_top_frm.setShaderParm( 7, 1 );
		sys.trigger($target_setkeyval_2);	
	}
	
