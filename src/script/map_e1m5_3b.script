	float hideSubTime = 0;
	float letsGoQuesting = 0;

	float show_planning = 1;
	float show_establishing_shot = 1;

	void SubtitlesRunning()
	{
		while(hideSubTime > sys.getTime())
		{			
			sys.waitFrame();
		}
		sys.hideSubtitles();
	}

	void ShowSubtitles(string name, string titles, float duration)
	{
		PhobosShowSubtitle_e1m5_2(name, titles);
		hideSubTime = sys.getTime() + duration;
		sys.wait(duration);
		if(hideSubTime <= sys.getTime())
		{
			sys.hideSubtitles();
		}
		else
		{
			thread SubtitlesRunning();
		}
	}

	float CharacterSaysNoWait(entity characterEntity, string line)
	{
		return characterEntity.startSoundShader(line, SND_CHANNEL_ANY);
	}

	void CharacterSays(entity characterEntity, string line)
	{
		sys.wait(characterEntity.startSoundShader(line, SND_CHANNEL_ANY));
	}

	void LeeTexts(string text)
	{
		float textTime = sys.strLength(text) * 0.125;

		sys.showTextTyping();
		sys.wait(textTime);
		sys.hideTextTyping();
		sys.showTextMessage(text, 0);
	}
	
	void Beat(float delay)
	{
		sys.wait(delay);
	}

	void precache()
	{
		sys.cacheSoundShader ("switch_02");
	}

	string lg_main = "main";
	float lg_main_num = 83;

	void RestoreLightGroup(string name, float num)
	{
		float i = 0;
		while(i < num)
		{
			entity light = sys.getEntity("house_light_group_" + name + "_" + (i + 1));
			vector color = light.getColor();
			vector ogcolor = light.getVectorKey("ogcolor");
			
			thread crossFadeEnt (light, color, ogcolor, 0.25);
			i++;
		}
	}

	void StoreLightGroup(string name, float num)
	{
		float i = 0;
		while(i < num)
		{
			entity light = sys.getEntity("house_light_group_" + name + "_" + (i + 1));
			vector ogcolor = light.getColor();
			light.setKey("ogcolor", ogcolor);
			light.setColor(0, 0, 0);
			i++;
		}
	}

	void PushSwing()
	{
		vector o1 = $intro_swingset_push_clicker.getOrigin();
		vector o2 = $player1.getOrigin();
		
		float sign = -1;

		if(o2_y > o1_y)
		{
			sign = 1;
		}

		$SwingRotator.accelTime(.0625);
		$SwingRotator.time(1);
		$SwingRotator.decelTime(.5);

		$SwingRotator.startSoundShader("sound/shav/intro/swingset.ogg", SND_CHANNEL_ANY);
		$SwingRotator.rotateOnce(sign * '0 0 -10');

		sys.waitFor($SwingRotator);
		$SwingRotator.accelTime(.5);		

		float angle = 20;
		vector rotAngle = '0 0 1';

		while(angle > 0)
		{
			vector sa = sign * angle * rotAngle;

			$SwingRotator.rotateOnce(sa);
			//$SwingRotator.startSoundShader("sound/shav/intro/swingset.ogg", SND_CHANNEL_ANY);
			sys.waitFor($SwingRotator);

			sign *= -1;
			angle -= 2;
		}

		$intro_swingset_push_clicker.setKey("click_item", 1);
	}	

