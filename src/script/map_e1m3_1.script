	void EnterMarsCity()
	{
		sys.trigger($SpeakerAbandonedFields);
		sys.trigger($SpeakerAmbience_relay);

		sys.wait(6);

		sys.trigger($camview_hangar);
		sys.trigger($trigger_fade_12);

		sys.wait(3);

		$camview_hangar_mover.time(24);

		$camview_hangar_mover.move(UP, 1572.25);

		sys.wait(2);

		$camview_hangar_rotator.time(16);
		$camview_hangar_rotator.rotateOnce('0 180 0');

		sys.wait(17);

		$camview_hangar_rotator.rotateOnce('0 0 90');

		sys.waitFor($camview_hangar_mover);
		$camview_hangar_mover.move(270, 640);

		$camview_hangar_mover.accelTime(1);
		$camview_hangar_mover.time(4);
		
		sys.waitFor($camview_hangar_mover);
		sys.trigger($camview_hangar);

		sys.trigger($speaker_68);
		sys.trigger($speaker_69);
		sys.trigger($speaker_70);
		sys.trigger($speaker_1009);
		sys.trigger($speaker_677);
		sys.trigger($speaker_51);

		sys.wait(5);
		sys.trigger($trigger_relay_641);		
	}
	
	float hasFrankIdReaction = 0;	
	
	void FrankIdReaction()
	{		
		if(hasFrankIdReaction == 0)
		{
			$func_static_100001.hide();
			hasFrankIdReaction = 1;

			if(talkingToMiles == 0)
			{
				thread ShowNPCSubtitles("Sam", "Frank. I thought you left me behind.\nMaybe you should have.", 4.25);
				CharacterSays($player1,"e1m3_1_Player_FrankLeftBehind");
			}
			$func_static_100001.show();
		}
	}

	void FrankGunnedDownReaction()
	{
		$func_static_100000.hide();
		thread ShowNPCSubtitles("Sam", "These people were gunned down.\nWho would do this?", 3.5);
		CharacterSays($player1,"e1m3_1_Player_GunnedDown");
		$func_static_100000.show();
	}
	
	void PostObjectives()
	{		
		sys.quickSave("The Beginning of The End - Checkpoint 1");

		sys.wait(2);
		
		thread ShowNPCSubtitles("Sam", "Stranded...I should call Miles.", 3.15);
		$player1.startSoundShader("e1m3_1_Player_Stranded", SND_CHANNEL_ANY);		
	}
	
