	float OutroChairPosition = 1;
	float OutroPicturePosition = 1;
	float OutroBooksPosition = 1;
	
	float OutroItemSettingsSuccess()
	{
		if(OutroChairPosition == 3 && OutroPicturePosition == 3 && OutroBooksPosition == 3)
		{
			$player1.startSoundShader("shav_general_fnote", SND_CHANNEL_ANY);
		
			$outro_books_item_1.hide();
			$outro_books_item_2.hide();
			$outro_books_item_correct.hide();
			$outro_chair_alter_item.hide();
			$outro_picture_alter_item.hide();

			$outro_door_out_mover.accelTime(.125);
			$outro_door_out_mover.time(.5);
			$outro_door_out_mover.decelTime(.125);			

			$outro_door_out_mover.rotateOnce('0 -90 0');
			$outro_door_out_mover.startSoundShader("e1m3_1_placebox", SND_CHANNEL_ANY);
			sys.waitFor($outro_door_out_mover);
			sys.trigger($outro_portal_1);
			
			$outro_closet_1_item.setKey("click_item", "1");

			return 1;
		}

		return 0;
	}

	void ShowRelevantBook()
	{
		if(OutroBooksPosition == 2)
		{
			$outro_books_item_1.setKey("click_item", "1");
		}
		else if(OutroBooksPosition == 3)
		{			
			$outro_books_item_correct.setKey("click_item", "1");
		}
		else if(OutroBooksPosition == 1)
		{
			$outro_books_item_2.setKey("click_item", "1");
		}	
	}

	void HideMirrorClickers()
