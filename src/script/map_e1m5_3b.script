	float garage_light = 0;
	float garage_light_time = 0;
	vector garage_light_player_position = '0 0 0';

	void GarageLightSleeper()
	{
		float garage_light_duration = 20;

		while(garage_light)
		{
			if(garage_light_time + garage_light_duration <= sys.getTime())
			{
				StoreLightGroup("garage", 20);
				$garage_door_clicker.startSoundShader("sound/shav/e1m5_2/light_switch.ogg", SND_CHANNEL_ANY);
				
				garage_light = 0;
			}

			sys.waitFrame();
		}
	}
	
	void TurnOnGarageLight()
	{
		vector player_origin = $player1.getOrigin();
		
		if(garage_light == 0)
		{
			if(player_origin == garage_light_player_position)
			{
				return;
			}
			garage_light_player_position = player_origin;

			garage_light = 1;
			garage_light_time = sys.getTime();

			RestoreLightGroup("garage", 20);
			$player1.startSoundShader("sound/shav/e1m5_2/light_switch.ogg", SND_CHANNEL_ANY);

			thread GarageLightSleeper();
		}
		else
		{
			if(player_origin == garage_light_player_position)
			{
				return;
			}

			// If the light is already on, just update the time and place so it doesn't turn off
			garage_light_time = sys.getTime();
			garage_light_player_position = player_origin;
		}
	}

