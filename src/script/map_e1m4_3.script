		$player1.startSoundShader("shav_general_accepted", SND_CHANNEL_ANY);
		$player1.setOrigin($FourRoomsEndDestination.getOrigin());

		sys.wait(2);

		$Speaker4RoomsRev.fadeSound(SND_CHANNEL_ANY, -100, 20);
		sys.trigger($FourRoomsSpeakerBreathing);

		sys.wait(4);

		$player1.startSoundShader("e1m4_3_StrikeMatch", SND_CHANNEL_ANY);	

		vector plOrigin = $player1.getOrigin();
		vector fireBackLightOrigin = $FourRoomsEndDestination_FireBackLight.getOrigin();
		plOrigin_z = fireBackLightOrigin_z;
		$FourRoomsEndDestination_FireBackLight.setOrigin(plOrigin);
		$FourRoomsEndDestination_FireBackLight.bind($player1);

		vector fireLightOrigin = $FourRoomsEndDestination_FireLight.getOrigin();
		plOrigin_z = fireLightOrigin_z;
		$FourRoomsEndDestination_FireLight.setOrigin(plOrigin);
		$FourRoomsEndDestination_FireLight.bind($player1);

		sys.wait(2);

		thread crossFadeEnt ($FourRoomsEndDestination_FireBackLight, '0 0 0', '0.69 0.48 0.44', 0.6);
		thread crossFadeEnt ($FourRoomsEndDestination_FireLight, '0 0 0', '1 0.6 0.42', 0.6);

		sys.wait(1);

		thread crossFadeEnt ($FourRoomsEndDestination_FireBackLight, '0.69 0.48 0.44', '0.39 0.28 0.24', 0.4);
		thread crossFadeEnt ($FourRoomsEndDestination_FireLight, '1 0.6 0.42', '0.71 0.4 0.22', 0.4);

		sys.wait(5);

		$player1.startSoundShader("e1m4_3_MatchOut", SND_CHANNEL_ANY);
		thread crossFadeEnt ($FourRoomsEndDestination_FireBackLight, '0.39 0.28 0.24', '0 0 0', 0.1);
		thread crossFadeEnt ($FourRoomsEndDestination_FireLight, '0.71 0.4 0.22', '0 0 0', 0.1);
		sys.wait(.1);
		
		$player1.setOrigin($BarnStartDestination.getOrigin());

		sys.wait(4);

		$player1.startSoundShader("e1m4_3_StrikeMatch", SND_CHANNEL_ANY);	

		plOrigin = $player1.getOrigin();
		fireBackLightOrigin = $BarnStartDestination_FireBackLight.getOrigin();
		plOrigin_z = fireBackLightOrigin_z;
		$BarnStartDestination_FireBackLight.setOrigin(plOrigin);
		$BarnStartDestination_FireBackLight.bind($player1);

		fireLightOrigin = $BarnStartDestination_FireLight.getOrigin();
		plOrigin_z = fireLightOrigin_z;
		$BarnStartDestination_FireLight.setOrigin(plOrigin);
		$BarnStartDestination_FireLight.bind($player1);

		sys.wait(2);

		thread crossFadeEnt ($BarnStartDestination_FireBackLight, '0 0 0', '0.69 0.48 0.44', 0.6);
		thread crossFadeEnt ($BarnStartDestination_FireLight, '0 0 0', '1 0.6 0.42', 0.6);

		sys.wait(1);

		thread crossFadeEnt ($BarnStartDestination_FireBackLight, '0.69 0.48 0.44', '0.39 0.28 0.24', 0.4);
		thread crossFadeEnt ($BarnStartDestination_FireLight, '1 0.6 0.42', '0.71 0.4 0.22', 0.4);

		sys.trigger($SpeakerWeFailed);

		MatchLoop();
	}
	
	void RunClock()
	{
		// Setup positions
		$outro_clock_largehand.rotateOnce('-42 0 0');
		$outro_clock_smallhand.rotateOnce('-120 0 0');

		sys.waitFor($outro_clock_largehand);
		sys.waitFor($outro_clock_smallhand);
		sys.wait(.5);
		
		while(clockRunning)
		{
			$outro_clock_largehand.rotateOnce('-6 0 0');
			$outro_clock_smallhand.rotateOnce('-1 0 0');
			sys.waitFor($outro_clock_largehand);
			sys.waitFor($outro_clock_smallhand);
			sys.wait(.25);

			if(!clockRunning)
				return;
			
			$outro_clock_largehand.rotateOnce('6 0 0');
			$outro_clock_smallhand.rotateOnce('1 0 0');
			sys.waitFor($outro_clock_largehand);
			sys.waitFor($outro_clock_smallhand);

			sys.wait(0.5);
		}
	}
	
	void FourRooms1()
	{
		if(fourRooms1Target > 5 && clockRunning == 0)
		{
			clockRunning = 1;
			sys.trigger($outro_boxroom_c_relay);
			thread RunClock();
		}
		else
		{
			fourRooms1Target = FourRoomsIncrement("c", 2, fourRooms1Target);
			if(fourRooms1Target == 5)
			{
				$outro_boxroom_d_door.hide();
				$outro_boxroom_d_door_handle_1.hide();
				$outro_boxroom_d_door_handle_2.hide();
			}
		}
	}
	
