	void MotelLightning(float fadeInTime, float fadeOutTime, float staying, float intensity)
	{
		thread crossFadeEnt ($outro_motel_lightning, '0 0 0', '0.47 0.54 0.71' * intensity, fadeInTime);
		thread crossFadeEnt ($outro_motel_ambient, '0.04 0.05 0.06', '0.16 0.21 0.23' * intensity, fadeInTime);
		thread crossFadeEnt ($outro_motel_ambient2, '0.09 0.07 0.06', '0.16 0.12 0.11' * intensity, fadeInTime);
		thread crossFadeEnt ($outro_motel_cloudrain, '0.03 0.03 0.04', '0.27 0.27 0.3 * intensity', fadeInTime);		
		thread crossFadeEnt ($outro_motel_treelight1, '0.10 0.10 0.14', '0.33 0.38 0.47' * intensity, fadeInTime);
		thread crossFadeEnt ($outro_motel_treelight2, '0.10 0.10 0.14', '0.33 0.38 0.47' * intensity, fadeInTime);
		thread crossFadeEnt ($outro_motel_treelight3, '0.10 0.10 0.14', '0.33 0.38 0.47' * intensity, fadeInTime);
 
		sys.wait(staying);

		thread crossFadeEnt ($outro_motel_lightning, '0.47 0.54 0.71' * intensity, '0 0 0', fadeOutTime);
		thread crossFadeEnt ($outro_motel_ambient, '0.16 0.21 0.23' * intensity, '0.04 0.05 0.06', fadeOutTime);
		thread crossFadeEnt ($outro_motel_ambient2, '0.16 0.12 0.11' * intensity, '0.09 0.07 0.06', fadeOutTime);
		thread crossFadeEnt ($outro_motel_cloudrain, '0.27 0.27 0.3' * intensity, '0.03 0.03 0.04', fadeOutTime);
		thread crossFadeEnt ($outro_motel_treelight1, '0.33 0.38 0.47' * intensity, '0.10 0.10 0.14', fadeInTime);
		thread crossFadeEnt ($outro_motel_treelight2, '0.33 0.38 0.47' * intensity, '0.10 0.10 0.14', fadeInTime);
		thread crossFadeEnt ($outro_motel_treelight3, '0.33 0.38 0.47' * intensity, '0.10 0.10 0.14', fadeInTime);
	}

