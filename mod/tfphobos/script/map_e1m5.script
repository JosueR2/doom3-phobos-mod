	void Start_Motel_Scene()
	{
		sys.fadeTo('0 0 0', 1, .5);

		$speaker_212.fadeSound (SND_CHANNEL_ANY, -100, 5);
		$speaker_209.fadeSound (SND_CHANNEL_ANY, -100, 5);
		$speaker_216.fadeSound (SND_CHANNEL_ANY, -100, 5);
		$speaker_210.fadeSound (SND_CHANNEL_ANY, -100, 5);
		$speaker_217.fadeSound (SND_CHANNEL_ANY, -100, 5);
		$speaker_211.fadeSound (SND_CHANNEL_ANY, -100, 5);
		$speaker_178.fadeSound (SND_CHANNEL_ANY, -100, 5);
		$speaker_215.fadeSound (SND_CHANNEL_ANY, -100, 5);
		
		sys.wait(1);

		sys.trigger($SpeakerCoral);
		sys.trigger($teleport_motel);
		sys.trigger($setinfluence_motel);
		sys.trigger($portal_valley);
		thread(UpdateMotel());

		sys.disableItemGroup("motel_storm");

		sys.wait(3);

		sys.fadeTo('0 0 0', 0, .5);

		sys.wait(3);

		thread ShowSubtitles("Sam", "Storm's getting closer.", 2.25); 
		CharacterSays($player1, "sound/vo/e1m5/stormcloser.ogg");

		sys.enableItemGroups();
	}

	float SKIP_INTRO = 0;
	void main()
	{

		GoToLevel();

		if(0)
		{
		if(SKIP_INTRO)
		{
			sys.trigger($SpeakerCoral);
			sys.trigger($setinfluence_motel);
		}
		else
		{
			//sys.trigger($PortalTrain)

			sys.trigger($setinfluence_motel);

			thread(UpdateMotel());

			sys.disableItemGroup("motel_storm");

			sys.wait(3);
		
			thread ShowSubtitles("Sam", "Storm's getting closer.", 2.25); 
			CharacterSays($player1, "sound/vo/e1m5/stormcloser.ogg");

			sys.enableItemGroups();
		}
		}
		
		thread select_monsterconfig1();
	
		OpenSewerDrainHatch( sewers_drains_state );
		sys.trigger($trigger_count_41);
		sys.trigger($trigger_count_57);
		
		thread InitBridge1();		
		thread InitBridge2();
		thread InitBridge3();
		thread InitBridge4();
		
		sys.trigger($goobridge_01_triggercount_disable);
		sys.trigger($goobridge_01_triggercount_disable);
		sys.trigger($goobridge_01_triggercount_disable);
		
		thread pump_piston1_start();
		sys.wait(1.25);
		thread pump_piston2_start();
		
		thread pump_piston1_nozzle1();
		sys.wait(.25);
		thread pump_piston1_nozzle2();
		
		thread cycle_pump1();
		thread cycle_pump4();
		sys.wait(1);
		thread cycle_pump2();
		sys.wait(1.5);
		thread cycle_pump3();
	}
