	void mover_startsound (entity ent) {
		ent.startSoundShader ("m1_start", SND_CHANNEL_VOICE);
		sys.wait (0.75);
		ent.startSoundShader ("m1_loop", SND_CHANNEL_VOICE2);
	}

	void mover_stopsound (entity ent) {
		ent.startSoundShader ("m1_stop", SND_CHANNEL_VOICE2);
		ent.startSoundShader ("rec1_pump_endclack_01", SND_CHANNEL_ITEM );
	}
	
	void pump_piston1_start ()
	{
		while (1)
		{ 
				$pump_piston1.accelTime (.5);
				$pump_piston1.decelTime (.2);
				$pump_piston1.time (1);
				thread mover_startsound ($pump_piston1);
				$pump_piston1.move (DOWN, 96);
				sys.waitFor ($pump_piston1);
				mover_stopsound ($pump_piston1);
		        
				sys.wait (1);
		        
				$pump_piston1.accelTime (.5);
				$pump_piston1.decelTime (.8);
				
				thread mover_startsound ($pump_piston1);
				
				$pump_piston1.time (1.6);
				$pump_piston1.move (UP, 96);
				sys.waitFor ($pump_piston1);
				
				mover_stopsound ($pump_piston1);
		}
	}

	void pump_piston2_start ()
	{
		while (1)
		{              
				$pump_piston2.time (1.5);
				thread mover_startsound ($pump_piston2);
				$pump_piston2.move (DOWN, 96);
				sys.waitFor ($pump_piston2);
				mover_stopsound ($pump_piston2);

				sys.wait (.5);

				$pump_piston2.time (2);
				thread mover_startsound ($pump_piston2);
				$pump_piston2.move (UP, 96);
				sys.waitFor ($pump_piston2);
				mover_stopsound ($pump_piston2);
				sys.wait (.5);
		}
	}
	
