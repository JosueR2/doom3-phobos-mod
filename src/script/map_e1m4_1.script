	void SewerExitSearchlight()
	{
		$sewerexit_searchlight.rotateOnce('0 45 0');
		sys.waitFor($sewerexit_searchlight);
		sys.wait(2);

		while(1)
		{
			$sewerexit_searchlight.rotateOnce('0 -135 0');
			sys.waitFor($sewerexit_searchlight);
			sys.wait(4);
			$sewerexit_searchlight.rotateOnce('0 135 0');
			sys.waitFor($sewerexit_searchlight);
			sys.wait(4);
		}
	}
	
	void CallowayMessageSub()
	{
		ShowNPCSubtitles("Calloway", "Samantha. I have been a terrible friend, I know,\nbut it has not been without reason.", 8.6);
		ShowNPCSubtitles("Calloway", "I...I think I may have been right after all.", 4.5);
		ShowNPCSubtitles("Calloway", "Kaylee...Kaylee may still be alive.", 6.6);
		ShowNPCSubtitles("Calloway", "As we both know the official records state that Kaylee died in the fire.\nHer body identified by DNA.", 6.7);
		ShowNPCSubtitles("Calloway", "What tipped me off back then was the sheer amount of security surrounding the incident.", 5);
		ShowNPCSubtitles("Calloway", "Local fires usually aren't locked down like this with soldiers,\nscientists in hazmat suits and higher ups being alerted.", 7.6);
		ShowNPCSubtitles("Calloway", "And you know what? The hazmat guys came from here. From Mars.\nSo I went to investigate.", 8);
		ShowNPCSubtitles("Calloway", "Being a fully initiated member of Receptacle base.\nAnd a high ranking officer at the Bulwark.", 5); 
		ShowNPCSubtitles("Calloway", "I have access to many places and heaps of information.", 3.9); 
		ShowNPCSubtitles("Calloway", "The records of the federal police is out of my reach.\nBut knowing the right people and a little sneakiness goes a long way.", 6.5);
		ShowNPCSubtitles("Calloway", "I've finally obtained access to the unofficial records for the fire that supposedly claimed her life.", 7.4);
		ShowNPCSubtitles("Calloway", "I haven't seen many records of the sort.\nBut I'm sure they're not supposed to be this brief.", 5.9);
		ShowNPCSubtitles("Calloway", "They called in the higher ups.\nAnd the Mars division really early in the process.", 4.3);
		ShowNPCSubtitles("Calloway", "Yes, they did find the blood and DNA of Kaylee, but Samantha, they never found a body!", 8);
		ShowNPCSubtitles("Calloway", "So why did they claim otherwise?\nAnd why did they need to reinforce and lock down the investigation?", 7);
		ShowNPCSubtitles("Calloway", "They found something else at the site. Something that wasn't supposed to be there.\nSomething from Mars.", 8.4);
		ShowNPCSubtitles("Calloway", "This linked her to an old case about theft of federal property and it linked her to federal personnel.", 6.6);
		ShowNPCSubtitles("Calloway", "But before they came knocking on my door.\nFor reasons unknown.", 3.7);
		ShowNPCSubtitles("Calloway", "The investigation was cut short and the item was reclaimed and returned to Mars.", 5.2);
		ShowNPCSubtitles("Calloway", "Guess who was the ranking officer on the case? Benson.\nBenson, Benson, Benson. It's always him.", 12.25);
		ShowNPCSubtitles("Calloway", "I think my curiosity may have caught the interest of the wrong people.", 3.8);
		ShowNPCSubtitles("Calloway", "I am quite sure I'm being watched and my time here may be cut short.\nSo I'm reaching out to you. For Kaylee.", 9);
		ShowNPCSubtitles("Calloway", "I know this is a lot to take in after all these years, but I need your help.\nCome to the Bulwark, Samantha. Quickly!", 9);
	}
	
	void Miles15Sub()
	{
		ShowNPCSubtitles("Miles", "Exactly! I can't just go wherever I please.\nI have orders. Superiors I have to answer to.", 6);		
		ShowNPCSubtitles("Miles", "It's fair if you don't trust me, an apparent complete stranger to you.", 5.1);
		ShowNPCSubtitles("Miles", "But in this current situation, your best bet is to reach the Bulwark.", 3.6);		
		ShowNPCSubtitles("Miles", "For your own safety. Calloway or not.", 2.1);
	}

	void PlayCallowayMessage()
	{			
		entity playerC = sys.getEntity("player1");		
		
		thread CallowayMessageSub();
		CharacterSays($Comm_Holder, "sound/vo/e1m4/milescall/calloway_message.ogg");

		$calloscreen.hide();
		$calloscreen_offline.show();

		Beat(.5);
		thread ShowNPCSubtitles("Miles", "That's all I have...but I can't get in touch with him now.\nI just hope they didn't get to him.", 5);
		CharacterSays($Comm_Holder, "sound/vo/e1m4/milescall/miles12.ogg");
		Beat(1);
		thread ShowNPCSubtitles("Sam", "So, this Benson fellow. Is that the same guy I found burning to a crisp?", 4);
		CharacterSays(playerC, "sound/vo/e1m4/milescall/player8.ogg");
		Beat(.25);
		thread ShowNPCSubtitles("Miles", "The very same.", 2);
		CharacterSays($Comm_Holder, "sound/vo/e1m4/milescall/miles13.ogg");
		Beat(1.25);
		thread ShowNPCSubtitles("Sam", "That's...kinda suspicious.\nWhy was it you didn't go find Calloway yourself?", 5.15);
		CharacterSays(playerC, "sound/vo/e1m4/milescall/player9.ogg");
		Beat(.25);
		thread ShowNPCSubtitles("Miles", "I know this must all be really confusing to you, but let's not jump to conclusions.\nI can't go because I have duties.", 6.5);
		CharacterSays($Comm_Holder, "sound/vo/e1m4/milescall/miles14.ogg");
		Beat(.25);
		thread ShowNPCSubtitles("Sam", "On Phobos...", 2);
		CharacterSays(playerC, "sound/vo/e1m4/milescall/player10.ogg");
		Beat(.5);
		thread Miles15Sub();
		CharacterSays($Comm_Holder, "sound/vo/e1m4/milescall/miles15.ogg");
		Beat(3);
		thread ShowNPCSubtitles("Miles", "Sam. Something I noticed. Right at the beginning of this call, you mentioned you don't remember much\nSo you remember something?", 10);
		CharacterSays($Comm_Holder, "sound/vo/e1m4/milescall/miles16.ogg");

		Beat(.75);
		thread ShowNPCSubtitles("Sam", "I do.\nI'm starting to remember small things.", 4);
		CharacterSays(playerC, "sound/vo/e1m4/milescall/player11.ogg");
		Beat(.25);
		sys.fadeTo('0 0 0', 1, 2.25);
		Beat(1.5);
		thread ShowNPCSubtitles("Sam", "From when I was a kid.", 2);
		CharacterSays(playerC, "sound/vo/e1m4/milescall/player11_b.ogg");
		Beat(2);
		thread ShowNPCSubtitles("Sam", "Like my room.", 2);
		CharacterSaysImmediate(playerC, "sound/vo/e1m4/milescall/player11_c.ogg");
		Beat(1.25);
		$Flashback_Cam_Mover.move(0, 8);
		sys.trigger($Flashback_Cam);
		sys.fadeTo('0 0 0', 0, .0625);
		sys.trigger($SpeakerPling);
			
		Beat(2);
		thread ShowNPCSubtitles("Miles", "That's great. Tell me about it.", 2);
		CharacterSays($Comm_Holder, "sound/vo/e1m4/milescall/miles17.ogg");
		Beat(2);
		$Flashback_Cam2_Mover.move(315, 8);
		sys.trigger($Flashback_Cam2);
		thread ShowNPCSubtitles("Sam", "I remember I had a desk close to the windows.\nI could see the stars from there. And trees.", 7.15);
		CharacterSaysImmediate(playerC, "sound/vo/e1m4/milescall/player12.ogg");
		Beat(4.3);		
		sys.trigger($Flashback_Cam3);
		sys.wait(1);
		$Flashback_Cam3_Mover.rotateOnce('-35 0 0');
		Beat(3.5);
		thread ShowNPCSubtitles("Miles", "Anything else?", 2);
		CharacterSays(playerC, "sound/vo/e1m4/milescall/miles18.ogg");
		Beat(2);
		thread ShowNPCSubtitles("Sam", "There was someone.\nA girl.", 2.15);
		CharacterSays(playerC, "sound/vo/e1m4/milescall/player13.ogg");
		Beat(.5);

		$player1.startSoundShader("sound/shav/e1m4/spotlight.ogg", SND_CHANNEL_ANY );
		sys.trigger($Seweruwu2_teleport);
		sys.trigger($Flashback_Cam3);
		
		$comm_snapin.hide();

		$func_mover_airplane.move(180, 1400);

		thread SewerExitSearchlight();
	}
	
	void Miles7Sub()
	{
		ShowNPCSubtitles("Miles", "Well, I...I care about you, Sam.", 3);
		ShowNPCSubtitles("Miles", "Look. Calm down. I've known Calloway for some time now. We're good friends.\nBack on Earth, we lost someone. Someone real close.", 11);
		ShowNPCSubtitles("Miles", "But according to Calloway she may not be gone after all.", 4);
		ShowNPCSubtitles("Miles", "Here, let me show you. This is the last I heard from him.", 4);
	}
	
	void Miles10Sub()
	{
		ShowNPCSubtitles("Miles", "Did you find it?", 2);		
		sys.wait(3);		
		ShowNPCSubtitles("Miles", "Sam? Can you turn on the display?", 4);		
		sys.wait(2);		
		ShowNPCSubtitles("Miles", "What are you waiting for?", 2);
	}
	
	void Player2Sub()
	{
		ShowNPCSubtitles("Sam", "It's just...this is bullshit.\nI wake up in this hellhole and...and everything is fucked.", 6.25);		
		ShowNPCSubtitles("Sam", "I don't remember much about my past. I don't know anyone. ", 3.15);		
		ShowNPCSubtitles("Sam", "The only living things I see are those...fuckers! ", 3.15);		
		ShowNPCSubtitles("Sam", "The only contact out of this place I have is to a soft-voiced drill sergeant that might as well be a robot...", 6.5);
	}
	
	float stillCalling = 1;
	void CallMiles()
	{
		SpeakerAmbience_fadeout();

		entity playerC = sys.getEntity("player1");

		sys.trigger($scene_target_setinfluence_1);
	
		Beat(.5);
		thread ShowNPCSubtitles("Miles", "Hey Sam. Did you get to The Bulwark yet?", 2);
		CharacterSays($Comm_Holder, "sound/vo/e1m4/milescall/miles1.ogg");
		Beat(.75);
		thread ShowNPCSubtitles("Sam", "What? No. I was going in the right direction and then things kind of...curved off.\nI'm stuck in a stupid cargo line.", 9.15);
		CharacterSays(playerC, "sound/vo/e1m4/milescall/player1.ogg");
		Beat(.25);
		thread ShowNPCSubtitles("Miles", "A conga line? Sounds fun.", 2.15);
		CharacterSays($Comm_Holder, "sound/vo/e1m4/milescall/miles2.ogg");
		Beat(1.5);
		thread ShowNPCSubtitles("Miles", "Look. I'm sure you'll get there. I trust you, Sam.\nWhat do you need?", 4.25);
		CharacterSays($Comm_Holder, "sound/vo/e1m4/milescall/miles3.ogg");
		Beat(1);
		thread Player2Sub();
		CharacterSays(playerC, "sound/vo/e1m4/milescall/player2.ogg");
		Beat(.25);
		thread ShowNPCSubtitles("Miles", "Hey!?", 1);
		CharacterSays($Comm_Holder, "sound/vo/e1m4/milescall/miles4.ogg");
		Beat(.5);
		thread ShowNPCSubtitles("Sam", "I want out. I don't want to do this...",  2);
		CharacterSays(playerC, "sound/vo/e1m4/milescall/player3.ogg");
		Beat(.25);
		thread ShowNPCSubtitles("Miles", "I'm not a robot.", 2);
		CharacterSays($Comm_Holder, "sound/vo/e1m4/milescall/miles5.ogg");
		Beat(1.5);
		thread ShowNPCSubtitles("Sam", "Why is it so important we find this Calloway guy anyway?\nIt can't all be for my memory. What is it to you?", 6.25);
		CharacterSays(playerC, "sound/vo/e1m4/milescall/player4.ogg");
		Beat(.75);
		thread ShowNPCSubtitles("Miles", "I'm trying to help you Sam! It's not my fault you ended up in this situation.\nI even arranged for your escape!", 7.15);
		CharacterSays($Comm_Holder, "sound/vo/e1m4/milescall/miles6.ogg");
		Beat(.5);
		thread ShowNPCSubtitles("Sam", "Yeah that went well! Come on. I'm doing all the legwork.\nSwimming through fuel and...and...riding platforms. Why do you care?", 10);
		CharacterSays(playerC, "sound/vo/e1m4/milescall/player5.ogg");
		Beat(.75);
		thread Miles7Sub();
		CharacterSays($Comm_Holder, "sound/vo/e1m4/milescall/miles7.ogg");
		
		Beat(3.5);
		
		thread ShowNPCSubtitles("Miles", "Do you see it?", 2);
		CharacterSays($Comm_Holder, "sound/vo/e1m4/milescall/miles8.ogg");
		Beat(.75);
		thread ShowNPCSubtitles("Sam", "What?", 2);
		CharacterSays(playerC, "sound/vo/e1m4/milescall/player6.ogg");
		Beat(1.5);
		thread ShowNPCSubtitles("Miles", "Oh, right. I'm such an idiot. The display is off. Could you turn it on?\nIt should be right next to the communications device.", 6.5);
		CharacterSays($Comm_Holder, "sound/vo/e1m4/milescall/miles9.ogg");
		
		sys.trigger($calloclicker);

		while(stillCalling == 1)
		{
			sys.wait(5);

			if(stillCalling == 0)
				break;
			thread Miles10Sub();
			CharacterSays($Comm_Holder, "sound/vo/e1m4/milescall/miles10.ogg");			
		}
	}

	void TurnOnStreamingDevice()
	{
		stillCalling = 0;
		entity playerC = sys.getEntity("player1");
		$Comm_Holder.stopSound(SND_CHANNEL_ANY,0);
		
		$calloscreen_empty.hide();
		
		$calloscreen.setGuiParm("gui_parm41", 1);
		sys.trigger($calloscreen);
		$calloscreen.show();

		Beat(.5);
		thread ShowNPCSubtitles("Sam", "There! Should be on.", 2);
		CharacterSays(playerC, "sound/vo/e1m4/milescall/player7.ogg");
		Beat(.5);
		thread ShowNPCSubtitles("Miles", "Perfect. It should stream now.", 2);
		CharacterSays($Comm_Holder, "sound/vo/e1m4/milescall/miles11.ogg");

		sys.trigger($SpeakerCallowaysMessage);

		sys.wait(1);

		PlayCallowayMessage();
	}	
	
	void InsertSnapin()
	{
		// We need to lock for this scene seeing how it's mandatory because of the sewer flashback end
		// And some crucial information for the story. That sucks, but its an easy & fast fix.
		$miles_conf_door.lock(2);
		$miles_conf_door.setKey("no_touch", 1);

		$player1.startSoundShader("e1m1_intercomclick1", SND_CHANNEL_ANY);
		
		sys.trigger($comm_beep);

		$comm_snapin.show();
		$comm_blinker_tex.hide();
		$comm_blinking_light.hide();
		sys.wait(.1);
		$commscreen_online.hide();
		sys.wait(.1);
		$commscreen.setGuiParm("gui_parm41", 1);		
		sys.trigger($commscreen);
		$commscreen.show();

		sys.wait(2.5);
		CallMiles();
	}

	void ToggleArachElevatorSouth()
	{
		if(arachElevatorSouthState != 2)
		{
			$arach_elev_south_top_clicker.setKey ("click_item", "0");
			$arach_elev_south_bottom_clicker1.setKey ("click_item", "0");
			$arach_elev_south_bottom_clicker2.setKey ("click_item", "0");

			if(arachElevatorSouthState == 0)
			{
				arachElevatorSouthState = 2;

				$arach_elev_south_handle.move(UP, 12);
				$arach_elev_south_handle.startSoundShader("e1m5_3_large_switch", SND_CHANNEL_ANY);				

				sys.waitFor($arach_elev_south_handle);

				$arach_elev_south_top_flare.show();
				$arach_elev_south_bottom_flare.hide();
				$arach_elev_south_top_light.show();
				$arach_elev_south_bottom_light.hide();

				sys.wait(.5);

				$arach_elev_south.move(UP, 5 * 64);

				$arach_elev_south.startSoundShader("c1_pipeupaway", SND_CHANNEL_ANY);

				sys.waitFor($arach_elev_south);

				ArachDoors("south", DOWN);

				arachElevatorSouthState = 1;
				
				$arach_elev_south_bottom_clicker1.setKey ("click_item", "1");
				$arach_elev_south_bottom_clicker2.setKey ("click_item", "1");
			}
			else if(arachElevatorSouthState == 1)
			{
				arachElevatorSouthState = 2;				

				$arach_elev_south_handle.move(DOWN, 12);
				$arach_elev_south_handle.startSoundShader("e1m5_3_large_switch", SND_CHANNEL_ANY);

				sys.waitFor($arach_elev_south_handle);

				$arach_elev_south_top_flare.hide();
				$arach_elev_south_bottom_flare.show();
				$arach_elev_south_top_light.hide();
				$arach_elev_south_bottom_light.show();

				sys.wait(.5);

				ArachDoors("south", UP);

				$arach_elev_south.move(DOWN, 5 * 64);

				$arach_elev_south.startSoundShader("c1_pipeupaway", SND_CHANNEL_ANY);				

				sys.waitFor($arach_elev_south);

				arachElevatorSouthState = 0;

				$arach_elev_south_top_clicker.setKey ("click_item", "1");
			}
		}
	}

	void ClickCacheButton(entity button)
	{
		float direction = button.getFloatKey("direction");
		button.move(direction, 1);
		button.startSoundShader("e1m1_intercomclick1", SND_CHANNEL_ANY);
		sys.waitFor(button);

		sys.wait(.125);
		button.startSoundShader("e1m1_intercomclick2", SND_CHANNEL_ANY);
		button.move(direction + 180, 1);
	}

	void CallArachElevatorNorthTop()
	{
		if(arachElevatorNorthState == 0)
		{
			ClickCacheButton(sys.getEntity("arach_elev_north_top_button"));
			ToggleArachElevatorNorth();			
		}
	}

	void CallArachElevatorNorthBottom()
	{
		if(arachElevatorNorthState == 1)
		{
			ClickCacheButton(sys.getEntity("arach_elev_north_bottom_button"));
			ToggleArachElevatorNorth();
		}
	}

	void CallArachElevatorSouthTop()
	{
		if(arachElevatorSouthState == 0)
		{
			ClickCacheButton(sys.getEntity("arach_elev_south_top_button"));
			ToggleArachElevatorSouth();			
		}
	}

	void CallArachElevatorSouthBottom()
	{
		if(arachElevatorSouthState == 1)
		{
			thread ClickCacheButton(sys.getEntity("arach_elev_south_bottom_button1"));
			ClickCacheButton(sys.getEntity("arach_elev_south_bottom_button2"));
			ToggleArachElevatorSouth();
		}
	}
	
