	entity playerC;
	entity doctorC;
	float m1trainstate = 1;	

	float COLD = 0;
	float STARTUP = 1;
	float SLOWDOWN = 2;
	float STARTANDSTOP = 3;	

	float STATIONRIGHT = 1;
	float STATIONLEFT = 2;
	float STATIONBOTH = 3;

	float TRAIN_SPEED_FAST = 550;
	float TRAIN_SPEED_SLOW = 350;
	float TRAIN_SPEED_VERY_SLOW = 210;
	
	float AIRLOCK_MALFUNCTION = 0;

	float hideSubTimeTrain = 0;

	void SubtitlesRunningTrain()
	{
		while(hideSubTimeTrain > sys.getTime())		
		{			
			sys.waitFrame();
		}
		sys.hideSubtitles();
	}

	void ShowNPCSubtitlesTrain(string name, string titles, float duration)
	{
		PhobosShowSubtitle_e1m1_1(name, titles);
		hideSubTimeTrain = sys.getTime() + duration;
		sys.wait(duration);
		if(hideSubTimeTrain <= sys.getTime())
		{
			sys.hideSubtitles();
		}
		else
		{
			thread SubtitlesRunningTrain();
		}
	}

	void CharacterSays(entity characterEntity, string line)
	{
		sys.wait(characterEntity.startSoundShader(line, SND_CHANNEL_ANY));
	}

	void Beat(float delay)
	{
		sys.wait(delay);
	}

	float firstSpline = 0;

	void MoveTrainSpline(float distance, float desiredSpeed, float moveType, entity spline)
	{		
		float adTime = 5.546f;
		float acceleration = desiredSpeed / adTime;
		
		float accel = 0;
		float decel = 0;

		float totalAdTime = 0;
		float distanceTraveled = 0.0f;

		float adDis = 0.5f * acceleration * adTime * adTime;

		if( moveType == STARTUP || moveType == STARTANDSTOP )
		{
			$Looptrain1.accelTime(adTime);
			accel = 1;
			distanceTraveled += adDis;
			totalAdTime += adTime;
		}
		else
			$Looptrain1.accelTime(0);

		if( moveType == SLOWDOWN || moveType == STARTANDSTOP )		
		{
			$Looptrain1.decelTime(adTime);
			decel = 1;
			distanceTraveled += adDis;
			totalAdTime += adTime;
		}
		else
			$Looptrain1.decelTime(0);		

		float remainingDistance  = distance-distanceTraveled;
		float remainingTime = remainingDistance / desiredSpeed;
		float moveTime = totalAdTime + remainingTime;
				
		$Looptrain1.time(moveTime);

		$Looptrain1.startSpline(spline);
		if(firstSpline == 0)
			$Looptrain1.removeInitialSplineAngles();
		
		firstSpline++;

		float spentTime = 0;

		if(accel == 1)
		{
			$train_speaker.startSoundShader("sound/shav/general/pfft.ogg", SND_CHANNEL_BODY);
			$train_speaker2.stopSound(SND_CHANNEL_BODY2, false);
			sys.wait($train_speaker.startSoundShader("sound/shav/e1m1/train_speedup.ogg", SND_CHANNEL_BODY2) - 0.2);
		}

		$train_speaker2.startSoundShader("sound/shav/e1m1/train_travel.ogg", SND_CHANNEL_BODY2);
		
		if(remainingTime > 0.2)
		{			
			sys.wait(remainingTime + 0.2);
		}

		if(decel == 1)
		{		
			$train_speaker2.stopSound(SND_CHANNEL_BODY2, false);
			//sys.print("deceleration");
			sys.trigger($train_brakes);
			sys.wait($train_speaker.startSoundShader("sound/shav/e1m1/train_slowdown.ogg", SND_CHANNEL_BODY2) - 0.2);
			$train_speaker.startSoundShader("sound/shav/general/pfft.ogg", SND_CHANNEL_BODY);
			sys.wait(.1);
			$train_speaker2.startSoundShader("sound/shav/e1m1/train_idle.ogg", SND_CHANNEL_BODY2);
		}		

		sys.waitFor($Looptrain1);
	}

	void RotateTrain(entity anchor)
	{
		$Looptrain1.bind(anchor);
		anchor.rotateOnce('0 -90 0');
		sys.waitFor(anchor);
		$Looptrain1.unbind();		
	}

