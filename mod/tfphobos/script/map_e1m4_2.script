	float coreDrained = 0;
	//0 = no
	//1 = yes
	
	void DrainCore()
	{
		sys.trigger($target_lock_1);
	
		sys.wait(1.5);
		
		// Make sure the bridge inspection clicker is gone
		$bridge_coreisfull_clicker.setKey ("click_item", "0");
		$bridge_coreisfull_clicker.move(UP, 1024);

		$corebridge_nogogui.hide();
		$corebridge_gui.show();
			
		sys.trigger($SetGearsRoomUnlockLights);

		sys.trigger($remove_wraith_pretrigs);
		
		sys.trigger($hellshock_relay);				
		
		sys.trigger($sp_hellcrash1);
		sys.wait(.15);
		sys.trigger($sp_hellcrash2);
		sys.wait(1.5);
		sys.trigger($sp_hellcrash3);
		sys.wait(2.2);
		sys.trigger($sp_hellcrash4);
		sys.wait(1);
		sys.trigger($sp_hellcrash5);
		sys.wait(2.15);
		sys.trigger($sp_hellcrash6);
		sys.wait(1.2);
		sys.trigger($sp_hellcrash7);
		sys.wait(.5);
		sys.trigger($sp_hellcrash8);
		sys.wait(.3);
		sys.trigger($sp_hellcrash9);
		sys.wait(1.25);
		sys.trigger($sp_hellcrash10);
		sys.wait(1.5);
		sys.trigger($sp_hellcrash11);
		sys.trigger($giant_growl_sp1);
		sys.trigger($growl_sp_relay);
		
		sys.quickSave("Live together, Die alone - Checkpoint 1");
		
		sys.wait(1);

		thread ShowNPCSubtitles("Sam", "What the fuck?", 2.25);
		$player1.startSoundShader("sound/vo/player/general/WhatTheFuckInternal.ogg", SND_CHANNEL_BODY);

		sys.wait(3);
		
		sys.trigger($item_objective_4);
		
		sys.wait(7);
		
		sys.trigger($show_hellstuff_relay);
		sys.trigger($fuel_drain_sfx_relay);
		sys.trigger($postdrain_wraith_relay);
		sys.trigger($wraith_warning_sp_relay);
		sys.trigger($trigger_post_coredrain_stuff);
		sys.trigger($fuel_drain_sfx1);
		sys.trigger($wraith_config_activate_relay);

		$fuel_indicator_north_liquid.move(0, 64);
		thread crossFadeEnt ($fuel_indicator_north_flare, '0.023529 0.403922 0.521569', '0 0 0', 4);
		thread crossFadeEnt ($fuel_indicator_north_light, '0.11 0.63 1', '0 0 0', 4);
		sys.wait(.5);
		$fuel_indicator_center_liquid.move(0, 64);
		thread crossFadeEnt ($fuel_indicator_center_flare, '0.023529 0.403922 0.521569', '0 0 0', 4);
		thread crossFadeEnt ($fuel_indicator_center_light, '0.11 0.63 1', '0 0 0', 4);
		sys.wait(.5);
		$fuel_indicator_south_liquid.move(0, 64);
		thread crossFadeEnt ($fuel_indicator_south_flare, '0.023529 0.403922 0.521569', '0 0 0', 4);
		thread crossFadeEnt ($fuel_indicator_south_light, '0.11 0.63 1', '0 0 0', 4);		

		$mcwatermass.hide();
		$mcwaterfog.hide();
		sys.trigger($mcwaterfog_post);
		sys.trigger($fuel_core_liquid_post);
		coreDrained = 1;
		
		$first_puzzle_fuel_glass_light.hide();
		$first_puzzle_fuel_glass_water.hide();
	}
	
