	void StartCrusher(float crusherNum)
	{	
		entity crusher = sys.getEntity("crusher" + crusherNum);
		entity crusherlift = sys.getEntity("crusherlift" + crusherNum);
		entity crusherlift_dest1 = sys.getEntity("crusherlift" + crusherNum + "_dest_1");
		entity crusherlift_dest2 = sys.getEntity("crusherlift" + crusherNum + "_dest_2");
		entity crusherlift_dest3 = sys.getEntity("crusherlift" + crusherNum + "_dest_3");
		entity crusher_poundspkr = sys.getEntity("crusher" + crusherNum + "_poundspkr");
		entity crusherlift_door = sys.getEntity("crusherlift" + crusherNum + "_door_r");
		entity crusherlift_door_in = sys.getEntity("crusherlift" + crusherNum + "_door_r_in");
		entity crusher_spkrdown = sys.getEntity("crusher" + crusherNum + "_spkrdown");
		entity crusher_spkrup = sys.getEntity("crusher" + crusherNum + "_spkrup");
		entity crusher_aas = sys.getEntity("crusher" + crusherNum + "_aas");
		entity crusher_portal = sys.getEntity("crusherportal" + crusherNum);
		entity klaxon_relay = sys.getEntity("crusher" + crusherNum + "_klaxon_relay");
		
		float crusherRaised = crusher.getFloatKey("crusherRaised");
		
		if( crusherRaised == 1)
		{
		
			crusher.setKey("crusherRaised", 0);
		
			crusher.time(.85);
			crusher.decelTime(0);
			crusher.accelTime(.25);
			sys.wait(1);
			sys.trigger(klaxon_relay);
			crusherlift.moveTo(crusherlift_dest1);
			sys.waitFor(crusherlift);
			crusherlift.bind(crusher);
			sys.wait(.5);
			sys.trigger(crusher_aas);
			sys.trigger(crusher_spkrdown);
			crusher.move(DOWN, 264);
			sys.waitFor(crusher);
			sys.trigger(crusher_poundspkr);
			crusherlift.unbind();
			sys.wait(.65);
			crusherlift.moveTo(crusherlift_dest2);
			sys.wait(.75);
	
		{
			float numBarrels = sys.random(3);
			float spawnPlace = sys.random(4);			

			if( spawnPlace >= 4 )
				spawnPlace = 0;
			else if( spawnPlace >= 3)
				spawnPlace = 2;
			else if( spawnPlace >= 2)
				spawnPlace = 1;
			else
				spawnPlace = 0;			
				
			entity barrelOne;
			entity barrelTwo;
			entity spawner;
			
			if( numBarrels >= 1 )
			{
				barrelOne = sys.spawn("moveable_explodingbarrel_slime");
				spawner = sys.getEntity("crusherlift" + crusherNum + "_barrelspawn" + (spawnPlace + 1));
				barrelOne.setOrigin(spawner.getOrigin());				
			}
			
			if( numBarrels >= 2 )
			{
				barrelTwo = sys.spawn("moveable_explodingbarrel_slime");
				spawner = sys.getEntity("crusherlift" + crusherNum + "_barrelspawn" + (spawnPlace + 2));
				barrelTwo.setOrigin(spawner.getOrigin());				
			}
				
		}
		
			sys.wait(.75);
			crusher.time(5);
			crusher.decelTime(1);
			crusher.accelTime(.5);
			sys.trigger(crusher_spkrup);
			crusher.move(UP, 264);
			sys.wait(2);
			sys.trigger(crusher_portal);
			sys.trigger(klaxon_relay);
			sys.trigger(crusherlift_door);
			sys.trigger(crusherlift_door_in);
			sys.wait(1.5);
			crusherlift.moveTo(crusherlift_dest3);
			sys.waitFor(crusher);
			crusher.setKey("crusherRaised", 1);
			sys.trigger(crusher_aas);
			sys.trigger(crusherlift_door);
			sys.trigger(crusherlift_door_in);
			sys.waitFor(crusherlift);
		
		if( numBarrels >= 1 )
			{
				barrelOne.remove();
			}
			
		if( numBarrels >= 2 )
			{
				barrelTwo.remove();
			}
		crusherlift.restorePosition();
		}
		
		else if( crusherRaised == 0 && debug){sys.println("crusher " + crusherNum + " is not ready!");}
	}
	
	
