	float archPosition1 = 0;
	float archPosition2 = 0; 
	float archPosition3 = 0; 	
	float archPosition4 = 0; 
	float archPosition5 = 0; 
	float archPosition6 = 0; 
	
	void set_arch_pos1()
	{
		archPosition1 = 1;
		archPosition2 = 0;
		archPosition3 = 0;
		archPosition4 = 0;
		archPosition5 = 0;
		archPosition6 = 0;
		$arch_repel_trig1.enable();
	}
	
