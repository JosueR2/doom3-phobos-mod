	void LeePhone()
	{
		while(1)
		{
			sys.wait(5);
			$func_static_3.startSoundShader("sound/shav/e1m3/phone_bleep1.ogg", SND_CHANNEL_ANY);
			$func_static_3.setGuiParm("gui_parm1", 1);		
			sys.trigger($func_static_3);
			
			sys.wait(5);				
			$func_static_3.startSoundShader("sound/shav/e1m3/phone_bleep1.ogg", SND_CHANNEL_ANY);
			$func_static_3.setGuiParm("gui_parm1", 2);
			sys.trigger($func_static_3);
			sys.wait(.25);
			$func_static_3.startSoundShader("sound/shav/e1m3/pickupphone.ogg", SND_CHANNEL_ANY);

			sys.wait(5);		
			$func_static_3.startSoundShader("sound/shav/e1m3/phone_bleep2.ogg", SND_CHANNEL_ANY);
			$func_static_3.setGuiParm("gui_parm1", 0);
			sys.trigger($func_static_3);
		}
	}
