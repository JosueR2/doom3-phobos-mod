	void TimelinePosters()
	{
		while(1)
		{
			thread ManageTimeline1();
			thread ManageTimeline2();
			thread ManageTimeline3();
			thread ManageTimeline4();
			thread ManageTimeline5();
			thread ManageTimeline6();
			sys.wait(.25);
		}
	}

	void hologram_button(string buttonName, string fromName, string toName)
	{
		entity button = sys.getEntity(buttonName);
		entity from = sys.getEntity(fromName);
		entity to = sys.getEntity(toName);
		
		button.moveTo(to);				
		button.startSoundShader("e1m1_intercomclick1", SND_CHANNEL_ANY);
		sys.waitFor(button);

		sys.wait(.125);
		button.startSoundShader("e1m1_intercomclick2", SND_CHANNEL_ANY);
		button.moveTo(from);	
	}

	float ShowHoloSubtitles = 0;

