	void CargoTrackCollapse()
	{
		sys.trigger($func_remove_10);
		$trigger_multiple_24.disable();
		$hlturn_anchor01.bind($cargotrack_swing);
		$hlturn_anchor01.accelTime(0);
		$hlturn_anchor01.decelTime(1.85);
		$hlturn_anchor01.time(4.5238934208);
		sys.trigger($track_sec_temp);
		sys.trigger($track_sec1);
		sys.trigger($track_sec3_l);
		sys.trigger($track_sec3_r);
		sys.trigger($track_sec2_l);
		sys.trigger($track_sec2_r);
		sys.trigger($track_sec4);
		$hlturn_cratehook02.move(270, 1328);
		sys.waitFor($hlturn_cratehook02);
		$hlturn_cratehook02.bind($hlturn_anchor01);
		sys.trigger($hlturn_cratehook02_sparks1);
		sys.trigger($hlturn_cratehook02_sparks2);
		$hlturn_anchor01.rotateOnce('0 -120 0');
		sys.trigger($sparks_relay);
		
		$cargotrack_swing.accelTime (.1);
        $cargotrack_swing.time (.65);
		$cargotrack_swing2.accelTime (.1);
        $cargotrack_swing2.time (.35);
        $cargotrack_swing3.time (.1);
		$cargotrack_swing4.accelTime (.1);
        $cargotrack_swing4.time (.8);
		
		sys.trigger($cargotrack_collapse_spkr);
		
        $cargotrack_swing.rotateOnce ('-15 0 0');
		$cargotrack_swing2.rotateOnce ('-7 0 0');
		
			sys.wait(.15);
			
		$cargotrack_swing4.rotateOnce ('0 0 9');
		
			sys.wait(.5);
			
		$cargotrack_swing.accelTime (.1);
        $cargotrack_swing.time (.25);
		$cargotrack_swing.rotateOnce ('4 0 0');
		$cargotrack_swing3.rotateOnce ('-2 0 0');
		
			sys.wait(.1);
			
		$cargotrack_swing3.time (.05);
		$cargotrack_swing3.rotateOnce ('1 0 0');
		
			sys.wait(.05);
			
		$track_sec3_r_clip.unbind();
		sys.trigger($track_sec3_r_clip);
		$cargotrack_swing3.rotateOnce ('-1 0 0');
		
			sys.wait(.05);
			
		$cargotrack_swing3.rotateOnce ('1 0 0');
		
			sys.wait(.05);
		
		$cargotrack_swing.rotateOnce ('-4 0 0');	
		$cargotrack_swing3.rotateOnce ('-1 0 0');
		
			sys.wait(.05);
		
		$track_sec2_l_clip.unbind();
		sys.trigger($track_sec2_l_clip);
			
			sys.wait(.2);
		
		$cargotrack_swing.accelTime (.05);
        $cargotrack_swing.time (.15);
		
		$cargotrack_swing.rotateOnce ('2 0 0');
		
			sys.wait(.15);
			
		$track_sec2_r_clip.unbind();
		sys.trigger($track_sec2_r_clip);
		$cargotrack_swing.rotateOnce ('-2 0 0');
	}
	
