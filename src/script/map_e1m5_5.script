	void select_archvile_teleportdest()
	{
		float arch_tele_dest;

		while (1)
		{
			arch_tele_dest = sys.random(30);
		
			if (arch_tele_dest <= 5){
				sys.trigger ($arch_dest1);
				//sys.println("arch_teledest1 selected");
				sys.wait(.5);
			} else if (arch_tele_dest <= 10 && arch_tele_dest >= 6){
				sys.trigger ($arch_dest2);
				//sys.println("arch_teledest2 selected");
				sys.wait(.5);
			} else if (arch_tele_dest <= 15 && arch_tele_dest >= 11){
				sys.trigger ($arch_dest3);
				//sys.println("arch_teledest3 selected");
				sys.wait(.5);
			} else if (arch_tele_dest <= 20 && arch_tele_dest >= 16){
				sys.trigger ($arch_dest4);
				//sys.println("arch_teledest4 selected");
				sys.wait(.5);
			} else if (arch_tele_dest <= 25 && arch_tele_dest >= 21){
				sys.trigger ($arch_dest5);
				//sys.println("arch_teledest5 selected");
				sys.wait(.5);
			}
				else {
				sys.trigger ($arch_dest6);
				//sys.println("arch_teledest6 selected");
				sys.wait(.5);
			}
		}
	}

	
