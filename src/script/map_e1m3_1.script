	float hangar_state = 1;
	float hangar_lock_state = 0;
	float hangar_alt_objective_state = 0;

	void ClickCacheButton(entity button)
	{
		float direction = button.getFloatKey("direction");
		button.move(direction, 1);
		button.startSoundShader("e1m1_intercomclick1", SND_CHANNEL_ANY);
		sys.waitFor(button);

		sys.wait(.125);
		button.startSoundShader("e1m1_intercomclick2", SND_CHANNEL_ANY);
		button.move(direction + 180, 1);
	}

	void SetClickerState(entity clicker, float state)
	{
		clicker.setKey ("click_item", "" + state);
	}

	void DisableClickers()
	{
		SetClickerState(sys.getEntity("HangarLock_Clicker"), 0);
		SetClickerState(sys.getEntity("HangarLock_Inner_Clicker"), 0);
		SetClickerState(sys.getEntity("HangarLock_Outer_Clicker"), 0);
	}

	void EnableClickers()
	{
		SetClickerState(sys.getEntity("HangarLock_Clicker"), 1);

		if(hangar_lock_state == 1)
		{
			SetClickerState(sys.getEntity("HangarLock_Inner_Clicker"), 1);
		}
		else
		{
			SetClickerState(sys.getEntity("HangarLock_Outer_Clicker"), 1);
		}
	}

	float CycleHangarLock(float state)
	{	
		float newState = state;

		entity innerRDoor = sys.getEntity("hangarlock_inner_r");
		entity outerRDoor = sys.getEntity("hangarlock_outer_r");
		entity innerLDoor = sys.getEntity("hangarlock_inner_l");
		entity outerLDoor = sys.getEntity("hangarlock_outer_l");
		entity centerClicker = sys.getEntity("HangarLock_Clicker");
				
		if( state == 0 && hangar_state == 0)
		{
			// if the player is leaving, force complete the call
			CompleteCallMiles();
	
			sys.trigger($hangarlock_inner_close_spkr);
			sys.trigger($hangarlock_inner_clip);
			innerRDoor.move(0, 56);
			innerLDoor.move(180, 56);
			sys.waitFor(innerRDoor);

			centerClicker.startSoundShader("movement_5seconds", SND_CHANNEL_ANY);
			sys.wait(5);

			sys.trigger($hangarlock_outer_open_spkr);
			sys.trigger($hangarlock_outer_clip);
			outerRDoor.move(180, 56);
			outerLDoor.move(0, 56);
			sys.waitFor(outerRDoor);

			newState = 1;
		}
		else if( state == 0 && hangar_state == 1)
		{
			thread ShowNPCSubtitles("AP", "Hangar can not be accessed while Hangar doors are open.", 5.5);
			sys.wait($player1.startSoundShader("e1m3_1_hangardoorsopen", SND_CHANNEL_VOICE2 ));
			
			//Objective
			if(hangar_alt_objective_state == 0)
			{
				hangar_alt_objective_state = 1;
				sys.trigger($trigger_relay_647);
			}
		}
		else if( state == 1 && hangar_state == 1 )
		{
			thread ShowNPCSubtitles("AP", "Hangar can not be accessed while Hangar doors are open.", 5.5);
			sys.wait($player1.startSoundShader("e1m3_1_hangardoorsopen", SND_CHANNEL_VOICE2 ));
		}
		else if( state == 1 && hangar_state == 0)
		{
			// if the player is leaving, force complete the call
			CompleteCallMiles();

			sys.trigger($hangarlock_outer_close_spkr);
			sys.trigger($hangarlock_outer_clip);
			outerRDoor.move(0, 56);
			outerLDoor.move(180, 56);
			sys.waitFor(outerRDoor);

			centerClicker.startSoundShader("movement_5seconds", SND_CHANNEL_ANY);
			sys.wait(5);

			sys.trigger($hangarlock_inner_open_spkr);
			sys.trigger($hangarlock_inner_clip);
			innerRDoor.move(180, 56);
			innerLDoor.move(0, 56);
			sys.waitFor(innerRDoor);

			newState = 0;
		}		

		return newState;
	}	

	void CallHangarLock_Inner()
	{
		DisableClickers();
		
		ClickCacheButton(sys.getEntity("HangarLock_Inner_Button"));
		hangar_lock_state = CycleHangarLock(hangar_lock_state);
		
		EnableClickers();
	}

	void CycleHangarLock_Middle()
	{
		DisableClickers();

		ClickCacheButton(sys.getEntity("HangarLock_Button"));
		hangar_lock_state = CycleHangarLock(hangar_lock_state);

		EnableClickers();
	}

	void CallHangarLock_Outer()
	{
		DisableClickers();

		ClickCacheButton(sys.getEntity("HangarLock_Outer_Button"));
		hangar_lock_state = CycleHangarLock(hangar_lock_state);

		EnableClickers();
	}
	
	float hasTriedKeyCardOnce = 0;
	
	void MaintenanceKey_Grabbed()
	{
		hasTriedKeyCardOnce = 1;
		$Keycard_Slot.setKey ("item_type", "action");
	}

	void MaintenanceKey_Test()
	{	
		sys.trigger($trigger_relay_618);
		
		if(hasTriedKeyCardOnce == 0)
		{
			hasTriedKeyCardOnce = 1;
			entity playerC = sys.getEntity("player1");
			thread ShowNPCSubtitles("Sam", "Gotta be around here somewhere. I hope", 3.15);
			CharacterSays(playerC, "e1m3_1_Player_GottaBeAroundHereSomewhere");						
		}
	}
	
	void MaintenanceKey_Valid()
	{	
		SetClickerState(sys.getEntity("Keycard_Slot"), 0);
		sys.trigger($func_static_97389);
		
		$KeyMover.moveTo($KeyDestination);
	}

	void toggle_hangar_lights()
	{
		sys.trigger($hangar_alert);
		sys.trigger($hangar_light_01);
		sys.trigger($hangar_blink01);
		sys.trigger($hangar_light_02);
		sys.trigger($hangar_blink02);
		sys.trigger($hangar_light_03);
		sys.trigger($hangar_blink03);
		sys.trigger($hangar_light_04);
		sys.trigger($hangar_blink04);
	}

	void toggle_hangar()
	{	
		SetClickerState($HangarDoorClicker, 0);
		
		sys.trigger($SpeakerLonelyCaverns);
		
		toggle_hangar_lights();
	
		if(hangar_state == 0)
		{
			$hangar_doors_handle.rotateOnce('0 0 90');
			$hangar_doors_handle.startSoundShader("e1m5_3_large_switch", SND_CHANNEL_ANY);

			sys.wait(1.5);

			sys.trigger($hangar_portal);
			$hangar_door01.move( 90, 384);
			sys.wait(.5);
			$hangar_door02.move( 270, 384);
			$hangar_bit.move(270, 192);			
			
			sys.waitFor($hangar_door02);
						
			hangar_state = 1;
		}
		else
		{
			sys.trigger($post_hangar_relay);
		
			$hangar_doors_handle.rotateOnce('0 0 -90');
			$hangar_doors_handle.startSoundShader("e1m5_3_large_switch", SND_CHANNEL_ANY);

			sys.wait(1.5);

			$hangar_door01.move( 270, 384);
			sys.wait(.5);
			$hangar_door02.move( 90, 384);
			$hangar_bit.move(90, 192);
			
			sys.waitFor($hangar_door02);
			sys.trigger($hangar_portal);
			
			$hangar_door01.startSoundShader("chamber_core_down_speaker", SND_CHANNEL_ANY);
			
			hangar_state = 0;				
		}
		
		toggle_hangar_lights();
		
		sys.wait(5);
		
		//Objective
		sys.trigger($trigger_relay_650);
		
		sys.wait(3.75);
		
		if(hangar_alt_objective_state == 1)
		{			
			//Objective
			sys.trigger($trigger_relay_648);
		}
	}
	
	//0 = closed, 1 = opened, 2 = transferring
	float hugewindow = 1;

	void OpenHugeWindow()
	{
		if( hugewindow == 0 )
		{
			hugewindow = 2;
			
			$hugewindow_west.move(WEST, 128);
			$hugewindow_east.move(EAST, 128);			
			sys.waitFor($hugewindow_east);

			hugewindow = 1;
		}
	}

	void CloseHugeWindow()
	{
		if( hugewindow == 1 )
		{
			hugewindow = 2;

			$hugewindow_west.move(EAST, 128);
			$hugewindow_east.move(WEST, 128);
			sys.waitFor($hugewindow_east);

			hugewindow = 0;
		}
	}
		
	void floorhatch_open()
	{
		sys.trigger($func_portal_1);
		$floor_panel.move(-2, 4);
		sys.waitFor($floor_panel);
		$floor_panel.move(0, 60);		
	}
	
	void floorhatch_close()	
	{			
		$floor_panel.move(180, 60);
		sys.waitFor($floor_panel);
		$floor_panel.move(-1, 4);
		sys.waitFor($floor_panel);
		sys.trigger($func_portal_1);	
	}
		
	void floorhatch2_open()	
	{		
		sys.trigger($func_portal_2);
		$floor_panel2.move(-2, 4);
		sys.waitFor($floor_panel2);
		$floor_panel2.move(0, 60);		
	}
		
	void floorhatch2_close()	
	{		
		$floor_panel2.move(180, 60);
		sys.waitFor($floor_panel2);
		$floor_panel2.move(-1, 4);
		sys.waitFor($floor_panel2);
		sys.trigger($func_portal_2);		
	}

