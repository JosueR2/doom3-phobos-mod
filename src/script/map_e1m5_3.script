	float power4 = 0;

	#define POWER_STATE_OFF 0
	#define POWER_STATE_ON 1
	#define POWER_STATE_TRANSITION 2

	float power1_state = POWER_STATE_OFF;
	float power2_state = POWER_STATE_OFF;
	float power3_state = POWER_STATE_OFF;

	void OpenBrokenSomaDoor()
	{
		entity door = $somadoor_round_3;
		float openDir = door.getFloatKey("openDir");		
		vector rv = door.getVectorKey("rotateVector");

		door.startSoundShader("sound/doors/large/hugedoor_01_open.wav", SND_CHANNEL_VOICE);
		
		$somadoor3_gui_a.setShaderParm( 7, 2 );
		$somadoor3_gui_b.setShaderParm( 7, 2 );
		sys.trigger($soma3_guilights_blue);
		
		sys.trigger($soma_aas_obstacle_3);
			
		door.accelTime(2);
		door.decelTime(2);
		door.time(4.5);

		door.move(openDir, 80);
		door.rotateOnce(rv * 56.25);
		
		sys.waitFor(door);
		
		$somadoor3_gui_a.setShaderParm( 7, 1 );
		$somadoor3_gui_b.setShaderParm( 7, 1 );
		sys.trigger($soma3_guilights_green);
	}

	void PowerUp(float station)
	{
		entity handle = sys.getEntity("power_station_handle_" + station);
		entity gui = sys.getEntity("power_station_gui_" + station);
		entity redPanelOff = sys.getEntity("power_station_redlight_off_" + station);
		entity redPanelOn = sys.getEntity("power_station_redlight_on_" + station);
		entity redLight = sys.getEntity("power_station_redlight_light_" + station);
		entity greenPanelOff = sys.getEntity("power_station_greenlight_off_" + station);
		entity greenPanelOn = sys.getEntity("power_station_greenlight_on_" + station);
		entity greenLight = sys.getEntity("power_station_greenlight_light_" + station);
		entity speaker_start = sys.getEntity("power_station_speaker_start_" + station);
		entity speaker_loop = sys.getEntity("power_station_speaker_loop_" + station);
		entity beep_speaker = sys.getEntity("power_station_beepspeaker_" + station);

		vector rv = handle.getVectorKey("rotaxis");

		gui.hide();
		
		handle.startSoundShader("one_shot_electrical_switch_heavy_1", SND_CHANNEL_ANY);
		handle.rotateOnce(rv * 90);
		sys.waitFor(handle);

		redPanelOff.show();
		redPanelOn.hide();
		redLight.hide();

		greenPanelOff.hide();
		greenPanelOn.show();
		greenLight.show();

		sys.trigger(speaker_start);
		sys.trigger(beep_speaker);

		sys.wait(2.75);
				
		sys.trigger(speaker_loop);
	}

