		sys.wait(.5);

		$outro_clock_largehand.rotate('1200 0 0');
		$outro_clock_smallhand.rotate('40 0 0');		

		$outro_boxroom_c_backwall.show();
		$outro_boxroom_c_backwall_light.show();		
		$light_62924.show();				
	}

	void FourRoomsBloodWall()
	{
		while(1)
		{
			float r = $player1.distanceTo($fourrooms_bloodwall);

			float maxDist = 256;

			r /= 256;
			
			if(r > 1)
				r = 1;
			
			r = 1 - r;
			r/=2;
			r+= 0.5f;
		
			$fourrooms_bloodwall.setColor(r, .5, .5);

			sys.waitFrame();
		}
	}
	
	void MatchLoop()
	{
		while(usingMatches == 1)
		{
			sys.wait(11.5);

			if(usingMatches == 0 || usingMatches == 2)
				return;

			// Match goes out
			$player1.startSoundShader("e1m4_3_MatchOut", SND_CHANNEL_ANY);
			thread crossFadeEnt ($BarnStartDestination_FireBackLight, '0.39 0.28 0.24', '0 0 0', 0.1);
			thread crossFadeEnt ($BarnStartDestination_FireLight, '0.71 0.4 0.22', '0 0 0', 0.1);
			sys.wait(.1);

			sys.wait(2);

			if(usingMatches == 0)
				return;

			$player1.startSoundShader("e1m4_3_StrikeMatch", SND_CHANNEL_ANY);

			sys.wait(2);

			thread crossFadeEnt ($BarnStartDestination_FireBackLight, '0 0 0', '0.69 0.48 0.44', 0.6);
			thread crossFadeEnt ($BarnStartDestination_FireLight, '0 0 0', '1 0.6 0.42', 0.6);

			sys.wait(1);

			thread crossFadeEnt ($BarnStartDestination_FireBackLight, '0.69 0.48 0.44', '0.39 0.28 0.24', 0.4);
			thread crossFadeEnt ($BarnStartDestination_FireLight, '1 0.6 0.42', '0.71 0.4 0.22', 0.4);
		}
	}

	void BarnEntrance()
	{
		$FourRoomsSpeakerBreathing.fadeSound(SND_CHANNEL_ANY, -100, 2);

		usingMatches = 2;
	}

	void FourRoomsEnd2()
	{
		$boxkey_askey.show();
		$boxkey_askey.move(270, 4);
		$boxkey_askey.startSoundShader("shav_general_insert", SND_CHANNEL_ANY);
