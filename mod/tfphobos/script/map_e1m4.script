	void SewerFinalLee3Sub()
	{		
		ShowNPCSubtitles("Lee", "My dad? Yeah, I guess I never really told you about him.\nLet me tell you about my dad.", 9);
		ShowNPCSubtitles("Lee", "My dad stopped existing right around when my mom died.\nActually, probably somewhere in the last couple of weeks of her life.", 10);
		ShowNPCSubtitles("Lee", "My dad is gone, Sam. He drinks all day and is gone all night\nWhen he isn't unconscious.", 8);
		ShowNPCSubtitles("Lee", "Remember my camping trip with him last fall?\nYeah. That wasn't a camping trip. That was another trip to the clinic.", 10);
