namespace map_e1m3_2
{
	float hideSubTime = 0;

	void SubtitlesRunning()
	{
		while(hideSubTime > sys.getTime())		
		{			
			sys.waitFrame();
		}
		sys.hideSubtitles();
	}

	void ShowNPCSubtitles(string name, string titles, float duration)
	{
		PhobosShowSubtitle_e1m3_2(name, titles);
		hideSubTime = sys.getTime() + duration;
		sys.wait(duration);
		if(hideSubTime <= sys.getTime())
		{
			sys.hideSubtitles();
		}
		else
		{
			thread SubtitlesRunning();
		}
	}

	float fuckydoorstate = 1;

	float fuelLock1State = 0;
	float fuelLock2State = 0;

	void ClickCacheButton(entity button)
	{
		float direction = button.getFloatKey("direction");		
		button.move(direction, 1);
		button.startSoundShader("e1m1_intercomclick1", SND_CHANNEL_ANY);
		sys.waitFor(button);

		sys.wait(.125);
		button.startSoundShader("e1m1_intercomclick2", SND_CHANNEL_ANY);
		button.move(direction + 180, 1);
	}

	void SetClickerState(entity clicker, float state)
	{
		clicker.setKey ("click_item", "" + state);
	}

	void DisableClickers(float lockNumber)
	{
		SetClickerState(sys.getEntity("FuelLock" + lockNumber + "_Clicker"), 0);
		SetClickerState(sys.getEntity("FuelLock" + lockNumber + "_Inner_Clicker"), 0);
		SetClickerState(sys.getEntity("FuelLock" + lockNumber + "_Outer_Clicker"), 0);
	}

	void EnableClickers(float lockNumber, float state)
	{
		SetClickerState(sys.getEntity("FuelLock" + lockNumber + "_Clicker"), 1);

		if(state == 0)
			SetClickerState(sys.getEntity("FuelLock" + lockNumber + "_Inner_Clicker"), 1);
		else
			SetClickerState(sys.getEntity("FuelLock" + lockNumber + "_Outer_Clicker"), 1);
	}

	float FuelCacheFullReaction_State = 0;
	float CycleFuelLock(float state, float lockNumber)
	{	
		float newState = state;		
		
		float fuel1level = $fms_mainscreen.getGuiParmFloat (1, "gui_parm7");

		entity innerRDoor = sys.getEntity("fuellock_inner_r" + lockNumber);
		entity innerLDoor = sys.getEntity("fuellock_inner_l" + lockNumber);
		entity outerRDoor = sys.getEntity("fuellock_outer_r" + lockNumber);
		entity outerLDoor = sys.getEntity("fuellock_outer_l" + lockNumber);
		entity outerDoorClip = sys.getEntity("fuellock_outer_clip" + lockNumber);
		entity innerDoorClip = sys.getEntity("fuellock_inner_clip" + lockNumber);
		entity innerDoorCloseSpeaker = sys.getEntity("fuellock_inner_close_spkr" + lockNumber);
		entity innerDoorOpenSpeaker = sys.getEntity("fuellock_inner_open_spkr" + lockNumber);
		entity outerDoorCloseSpeaker = sys.getEntity("fuellock_outer_close_spkr" + lockNumber);
		entity outerDoorOpenSpeaker = sys.getEntity("fuellock_outer_open_spkr" + lockNumber);
		entity centerClicker = sys.getEntity("FuelLock" + lockNumber + "_Clicker");
				
		if(state == 0)
		{
			if( fuel1level <= 4 )
			{
				sys.trigger(outerDoorCloseSpeaker);
				sys.trigger(outerDoorClip);
				outerRDoor.move(270, 56);
				outerLDoor.move(90, 56);
				sys.waitFor(outerRDoor);

				centerClicker.startSoundShader("rec1_1_2s_movement", SND_CHANNEL_ANY);
				sys.wait(2);

				sys.trigger(innerDoorOpenSpeaker);
				sys.trigger(innerDoorClip);
				innerRDoor.move(90, 56);
				innerLDoor.move(270, 56);
				sys.waitFor(innerRDoor);

				newState = 1;
			}
			else
			{
				thread ShowNPCSubtitles("PA", "Fuel cache is full. Can not cycle.", 4.65);
				sys.wait($player1.startSoundShader("fuel_cache_full", SND_CHANNEL_VOICE2 ));
				
				if(FuelCacheFullReaction_State == 0)
				{
					sys.wait(0.25);

					thread ShowNPCSubtitles("Sam", "Can't go out there with all that fuel.", 2);
					$player1.startSoundShader("cant_go_with_fuel", SND_CHANNEL_VOICE2);
					FuelCacheFullReaction_State = 1;
				}
			}
		}
		else
		{
			sys.trigger(innerDoorCloseSpeaker);
			sys.trigger(innerDoorClip);
			innerRDoor.move(270, 56);
			innerLDoor.move(90, 56);
			sys.waitFor(innerRDoor);

			centerClicker.startSoundShader("rec1_1_2s_movement", SND_CHANNEL_ANY);
			sys.wait(2);

			sys.trigger(outerDoorOpenSpeaker);
			sys.trigger(outerDoorClip);
			outerRDoor.move(90, 56);
			outerLDoor.move(270, 56);
			sys.waitFor(outerRDoor);

			newState = 0;
		}		

		return newState;
	}	

	void CallFuelLock2_Inner()
	{
		DisableClickers(2);
		
		ClickCacheButton(sys.getEntity("FuelLock2_Inner_Button"));
		fuelLock2State = CycleFuelLock(fuelLock2State, 2);
		
		EnableClickers(2, fuelLock2State);
	}

