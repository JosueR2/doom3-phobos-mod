	void CoffinTalk()
	{
		PhobosShowSubtitle_e1m1_1("Girl", "As she felt her muscles wither away she tried to keep a brave face.");
		CharacterSays($player1, "sound/vo/e1m1/Scanner/Lee21.ogg");
		sys.wait(1.5);
		
		PhobosShowSubtitle_e1m1_1("Girl", "But when I looked into her eyes.\nI could see the fear staring back at me.");
		CharacterSays($player1, "sound/vo/e1m1/Scanner/Lee22.ogg");
		sys.wait(1.5);
		
		PhobosShowSubtitle_e1m1_1("Girl", "I wanted to console her.\nBe there for her as she had for me.");
		CharacterSays($player1, "sound/vo/e1m1/Scanner/Lee23.ogg");
		sys.wait(3);
		
		thread Lee24Sub();
		CharacterSays($player1, "sound/vo/e1m1/Scanner/Lee24.ogg");
	}

	void BurnCoffin()
	{			
		$m1_hospital.fadeSound(SND_CHANNEL_ANY, -60, 24);

		$hospital_incinerator_button.move(90, 1);
		$hospital_incinerator_button.startSoundShader("sound/shav/e1m1/intercomclick1.ogg", SND_CHANNEL_ANY);
		sys.waitFor($hospital_incinerator_button);
		sys.wait(.125);
		$hospital_incinerator_button.startSoundShader("sound/shav/e1m1/intercomclick2.ogg", SND_CHANNEL_ANY);
		$hospital_incinerator_button.move(-90, 1);
		
		sys.wait(2);
		
		thread CoffinTalk();

		sys.wait(3);

		sys.trigger($outro_speaker_goodbye);

		$outro_coffin_table_cylinder_lower.move(UP, 8);
		$outro_coffin_table_cylinder_upper.move(UP, 16);

		sys.waitFor($outro_coffin_table_cylinder_upper);

		sys.wait(1);

		$outro_coffin_door.move(UP, 56);

		sys.waitFor($outro_coffin_door);
		sys.wait(1);

		$outro_coffin.move(90, 192);

		sys.waitFor($outro_coffin);

		$outro_coffin.unbind();

		$outro_coffin_door.move(DOWN, 56);		
		$outro_coffin_table_cylinder_lower.move(DOWN, 8);
		$outro_coffin_table_cylinder_upper.move(DOWN, 16);

		sys.wait(5.7);
		$outro_coffin_door.startSoundShader("sound/shav/e1m1/burn.ogg", SND_CHANNEL_ANY);
		
		sys.wait(6.75);
		
		sys.trigger($outro_speaker_goodbye2);
		
		//turn on fall dust
		sys.trigger($outro_fallback_emitter_4);

		$outro_coffin.bind($outro_fallback);

		sys.wait(3);

		sys.trigger($outro_earthquake);

		sys.wait(.75);
		
		//Turn on fall dust
		sys.trigger($outro_fallback_emitter_5);
		
		//Smoke
		sys.trigger($outro_fallback_emitter_1);
		sys.wait(4);		
		sys.trigger($outro_fallback_emitter_2);
		sys.wait(2);
		sys.trigger($outro_fallback_emitter_3);
				
		sys.wait(2);		
		
		//Hide smoke again
		sys.trigger($outro_fallback_emitter_1);
		sys.trigger($outro_fallback_emitter_2);
		sys.trigger($outro_fallback_emitter_3);

		//Turn off fall dust
		sys.trigger($outro_fallback_emitter_4);
		sys.trigger($outro_fallback_emitter_5);
		
		$player1.startSoundShader("sound/ambient/metals/1shot_metalhit_01.ogg", SND_CHANNEL_ANY);
		$player1.startSoundShader("sound/ambient/metals/1shot_metalhit_10.ogg", SND_CHANNEL_ANY);
		
		//Switch railings right side
		$hospital_railing_right_on.hide();
		$hospital_railing_right_off.show();
		
		//Switch railings left side
		$hospital_railing_left_on.hide();
		$hospital_railing_left_off.show();

		$outro_fallback_root.move(90, 4096);
		$outro_fallback.rotateOnce('10 15 36');

		sys.wait(4);

		$outro_fallback_onebrick.rotateOnce('30 -70 46');
		$outro_fallback_twobrick.rotateOnce('25 75 21');

		sys.wait(24);

		// Turn off lights
		sys.trigger($outro_fallback_light1);
		sys.wait(0.5);
		sys.trigger($outro_fallback_light2);
		sys.wait(0.75);
		sys.trigger($outro_fallback_light3);
		sys.wait(1);
		sys.trigger($outro_fallback_light4);
		sys.trigger($outro_fallback_light5);
		sys.wait(1);
		sys.trigger($outro_fallback_light6);
		sys.wait(.25);
		sys.trigger($outro_switch_light);

		sys.wait(2);

		sys.trigger($light_62782_hospital);

		sys.wait(3);

		thread crossFadeEnt ($outro_burner_glare_inner, '0 0 0', '1 1 1', 8);
		thread crossFadeEnt ($outro_burner_glare_outer, '0 0 0', '1 0.31 0', 8);

		sys.wait(2.25);

		$player1.startSoundShader("sound/shav/e1m1/wineglass.ogg", SND_CHANNEL_ANY);
		sys.wait(3.75);
		sys.fadeTo('1 1 1', 1, 2);
	
		sys.wait(2);
		
		thread ShowNPCSubtitles("Girl", "Don't trust her.", 2);
		$player1.startSoundShader("sound/vo/e1m1/scanner/Donttrusther.ogg", SND_CHANNEL_ANY);

		//Lets go to the scanner
		sys.trigger($info_player_teleport_2);
		ScannerSceneEnd();
	}
	
