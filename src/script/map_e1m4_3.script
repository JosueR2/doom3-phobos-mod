	void DejCrooks_Sound_Loop() 
	{
		$dejcrook_panel.startSoundShader ("al3_crane_loop", SND_CHANNEL_VOICE2 );
	}

	void DejCrooks_Sound_Stop() 
	{
		$dejcrook_panel.startSoundShader ("al3_crane_end", SND_CHANNEL_VOICE2 );
	}

	void DejCrooks_Move( entity wheel, float dir, float amount, float stopOnCommand )
	{
		float cmd;

		if ( amount < 0.01 )
		{		
			return;
		}
		
		DejCrooks_Sound_Loop();
	
		//part.move( dir, amount );		
		//float rotTime = amount / 50;
		//wheel.time(.34);

		float revolutions = amount / 50.27;
				
		//wheel.rotateOnce('0 0 360' * revolutions * dir);		

		if ( !stopOnCommand )
		{
			sys.waitFor( wheel );
		}
		else
		{
			cmd = dejcrooks_state;
			while( dejcrooks_state == cmd )
			{
				wheel.rotateOnce('0 0 360' * revolutions * dir);
				sys.waitFor( wheel );
				sys.waitFrame();				
			}
			/*
			if ( !wheel.isMoving() )
				{
					break;
				}				
				*/
			//wheel.stopRotating();			
		}	
		DejCrooks_Sound_Stop();
	}

	void DejCrooksLoop()
	{
		float amount = 1;
		while( 1 )
		{
			dejcrooks_state = 0;
			while( dejcrooks_state == 0 )
			{							
				sys.waitFrame();
			}

			if ( dejcrooks_state == 2 )
			{
				thread DejCrooks_Move( $dejcrook01, -1, amount, true );
				thread DejCrooks_Move( $dejcrook02, 1, amount, true );
				DejCrooks_Move( $dejcrook03, -1, amount, true );
			}
			else if ( dejcrooks_state == 1 )
			{				
				thread DejCrooks_Move( $dejcrook01, 1, amount, true );
				thread DejCrooks_Move( $dejcrook02, -1, amount, true );
				DejCrooks_Move( $dejcrook03, 1, amount, true );
			}
		}
	}

	void DejCrooks()
	{		
		$dejcrook01.rotateOnce('0 0 -11.25');
		$dejcrook02.rotateOnce('0 0 22.5');

		sys.waitFor($dejcrook01);

		thread DejCrooksLoop();
		TurnOffScreen($dejcrooks_panel_gui, $dejcrooks_panel_gui_flare);

		StartScannerRings();
	}
		
	void CallMiles()
	{
		sys.trigger($scene_target_setinfluence_1);

		Beat(.25);
		thread ShowNPCSubtitles("Miles", "Hmm?", 2);
		Outro_CharacterSays($Comm_Holder, "e1m4_3_MilesCall_Miles1");
		Beat(.5);
		thread ShowNPCSubtitles("Sam", "You mentioned a pipeline leading to the Bulwark!?\nI think I found it a couple of steps back. Blown out. Impassable.", 6.25);
		Outro_CharacterSays($player1, "e1m4_3_MilesCall_Player1");
		Beat(.75);
		thread ShowNPCSubtitles("Miles", "You've got to be fucking kidding me...Where are you?", 4.15);
		Outro_CharacterSays($Comm_Holder, "e1m4_3_MilesCall_Miles2");
		Beat(.4);
		thread ShowNPCSubtitles("Sam", "In some sort of communication room. Well obviously\nclose to the...you know, I...I'm not sure at this point.", 7);
		Outro_CharacterSays($player1, "e1m4_3_MilesCall_Player2");
		Beat(.5);
		thread ShowNPCSubtitles("Miles", "Mmm...can you give me the CMID? It's a unique ID that designates any Comm. Room.\nStarts with a CM dash.", 6.15);
		Outro_CharacterSays($Comm_Holder, "e1m4_3_MilesCall_Miles3");
		Beat(.6);
		thread ShowNPCSubtitles("Sam", "Mmm. Sure. Let's see.\nCM dash. CM dash.", 6);
		Outro_CharacterSays($player1, "e1m4_3_MilesCall_Player3");
		
		$comm_room_number.show();
	}
	
