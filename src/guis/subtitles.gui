windowDef Desktop {
	forceaspectwidth 1120
	rect	0 ,0 ,1120 ,480 
	backcolor	0 ,0 ,0 ,0 
	visible "gui::subtitle1_visible"
	float "sub_scale" 0.275

	editDef SizeSync
	{
		rect 0, 0, 0, 0
		visible 1
		noevents 1
		cvar "g_subSize"
		liveUpdate 1
		text "gui::sub_scale"
	}
	
	windowDef Subtitles_4_3
	{						
		rect 0, 385, 640, 95
		backcolor 0, 0, 0, .5

		visible "gui::aspect_0_visible"

		windowDef Name
		{
			rect 0, 2, 640, 22
			forecolor 1, .5, .25, 1
			text "gui::subtitle1_name"
			textalign 1
			textscale "gui::sub_scale"
			shadow 1
			font "fonts/an"
		}

		windowDef Text
		{	
			rect 0, 24, 640, 68
			forecolor .5, .75, 1, 1		
			text "gui::subtitle1_text"
			textalign 1
			textscale "gui::sub_scale"
			shadow 1
			font "fonts/an"
		}
	}

