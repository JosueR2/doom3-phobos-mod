	void keyscan_blue()
	{
		$bluekey_insert.show();
		$bluekey_insert.startSoundShader( "sound/shav/e1m5_4/insertkey.ogg", SND_CHANNEL_VOICE );
		$bluekey_insert.move(180, 10);
		sys.waitFor($bluekey_insert);
			
		sys.trigger($keyinsert_spkr_blue);
		
		sys.wait(.35);
			
		$bluekey_insert.move(0, 8);
		$bluekey_insert.startSoundShader( "sound/shav/e1m5_4/removekey.ogg", SND_CHANNEL_VOICE );
		sys.waitFor($bluekey_insert);
		$bluekey_insert.hide();
	}
	
