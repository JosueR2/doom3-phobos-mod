	void OpenHospitalFakesideDoor()
	{
		sys.trigger($doorknob_fakeside_item_1);

		//Lets go back to original hallway
		vector diff2 = $player1.getOrigin() - $outsidescene_center2.getOrigin();
		$player1.setOrigin($outsidescene_center1.getOrigin() + diff2);
		
		$door_fakeside_1.startSoundShader("sound/shav/e1m1/doorknobopen.ogg", SND_CHANNEL_ANY);
		$door_fakeside_1.rotateOnce('-30 0 0');
		sys.waitFor($doorknob_fakeside_1);
		$door_fakeside_1.rotateOnce('0 -95 0');
		$doorknob_fakeside_1.rotateOnce('30 0 0');
	}
	
	void Lee13Sub()
	{
		PhobosShowSubtitle_e1m1_1("Girl", "One evening my dad noticed a slight slur when my mom spoke.");
		
		sys.wait(4);
		
		PhobosShowSubtitle_e1m1_1("Girl", "They quickly dismissed it.");
		
		sys.wait(1.5);
		
		PhobosShowSubtitle_e1m1_1("Girl", "But it came back.");
		
		sys.wait(2);
		
		ShowNPCSubtitles("Girl", "And it got worse.", 2);		
	}
	
	void Lee14Sub()
	{
		PhobosShowSubtitle_e1m1_1("Girl", "The doctors couldn't identity at first.");
		
		sys.wait(2);
		
		PhobosShowSubtitle_e1m1_1("Girl", "They suspected it to be a virus.");
		
		sys.wait(2);
		
		ShowNPCSubtitles("Girl", "And the only thing they had was to give it time.\nSo they did.", 4);
	}

	void HospitalSymptoms()
	{
