	void monsterconfig1()
	{
		float monsterselect1;

		while (1)
		{
			monsterselect1 = sys.random(15);
		
				if (monsterselect1 <= 5){
					sys.trigger ($monster_config1);
					sys.println("monster_config1 selected");
					sys.wait(.5);
				} else if (monsterselect1 >= 11){
					sys.trigger ($monster_config2);
					sys.println("monster_config2 selected");
					sys.wait(.5);
				} 
				  else {
					sys.trigger ($monster_config3);
					sys.println("monster_config3 selected");
					sys.wait(.5);
				}
		}
	}
	
	void kill_monster_selection1()
	{
		sys.killthread ("map_e1m3::monsterconfig1");
	}	
	
