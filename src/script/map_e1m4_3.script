	}

	void SetBombTime( float one, float two, float three, float four, float five)
	{
		$bomb.setGuiParm("gui_parm11", one);
		$bomb.setGuiParm("gui_parm12", two);
		$bomb.setGuiParm("gui_parm13", three);
		$bomb.setGuiParm("gui_parm14", four);
		$bomb.setGuiParm("gui_parm15", five);
		sys.trigger($bomb);
	}

	void FadeOutBombBack()
	{
		float max = 2;
		float timeToSpend = 20;
		float timeDelay = 0.0625;
		float interval = max / (timeToSpend / timeDelay);

		//sys.println(interval);

		float i = 0;
		while(i < max)
		{
			$bomb_blurback.setShaderParm(3, i);
			i += interval;
			sys.wait(timeDelay);
		}		
	}
					
	void SomeTest()
	{
		$player1.startSoundShader("e1m4_3_thebomb", SND_CHANNEL_ANY);

		$func_mover_1.move(90, 32);
		$func_mover_2.rotateOnce(' -25 0 0');
		sys.trigger($func_cameraview_1);

		sys.trigger($func_static_3);

		thread FadeOutBombBack();

		float max = 3;

		float one = 0;
		float two = 0;
		float three = 0;
		float four = 0;
		float five = 0;

		float secondCounter = 0;
		float minuteCounter = 108;
		
		while( max >= 0 )
		{						
			float minutes = (max / 60);
			minutes = int(minutes);
			
			float seconds = (max % 60);
			seconds = int(seconds);
		
			one = (minutes / 100);
			one = int(one);
			
			two = ((minutes - (one * 100)) / 10);
			two = int(two);
			
			three = ((minutes - (one * 100)) % 10);
			three = int(three);
			
			four = (seconds / 10 );
			four = int(four);
			
			five = (seconds % 10);
			five = int(five);

			SetBombTime( one, two, three, four, five);

			max--;
			
			if(max >= 0)
			{
				sys.wait(27.5);
			}
		}

		sys.fadeTo('0 0 0', 1, 0.0625);
	}

	void MoveSearchlight()
	{
		$outro_searchlight_mover.rotateOnce('45 0 0');
		sys.waitFor($outro_searchlight_mover);		

		while(1)
		{
			sys.waitFor($outro_searchlight_mover);
			sys.wait(3);

			$outro_searchlight_mover.rotateOnce('0 -90 0');
			sys.waitFor($outro_searchlight_mover);
			sys.wait(3);
			$outro_searchlight_mover.rotateOnce('0 90 0');			
		}
	}
	
	void ValleyLampFunInstance(float num)
	{
		entity lamp = sys.getEntity("ValleyOutLamp0" + num);
		entity light = sys.getEntity("ValleyOutLamp0" + num + "_light");

		crossFadeEnt (lamp, '0.7 0.6 0.2', '0 0 0', .0625);
		crossFadeEnt (light, '0.4 0.4 0.1', '0 0 0', .0625);
		sys.wait(0.125);
		crossFadeEnt (lamp, '0 0 0', '0.7 0.6 0.2', .0625);
		crossFadeEnt (light, '0 0 0', '0.4 0.4 0.1', .0625);
	}

	void ValleyLampFun()
	{
		thread ValleyLampFunInstance(2);
		sys.wait(.1);
		thread ValleyLampFunInstance(3);
		sys.wait(.0625);
		thread ValleyLampFunInstance(1);
		sys.wait(.05);
		thread ValleyLampFunInstance(4);
		sys.wait(.1);
	}

