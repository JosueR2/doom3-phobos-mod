	void hologram_button(string buttonName) 
	{
		entity button = sys.getEntity(buttonName);
		vector button_in = button.getVectorKey("button_in");
		vector button_out = button.getVectorKey("button_out");
		
		button.moveToPos(button_in);				
		button.startSoundShader("e1m1_intercomclick1", SND_CHANNEL_ANY);
		sys.waitFor(button);

		sys.wait(.125);
		button.startSoundShader("e1m1_intercomclick2", SND_CHANNEL_ANY);
		button.moveToPos(button_out);	
	}	

	void MuseumPart2Subs()
	{
		ShowSubtitles2("Tour Guide", "Mars and its moons used to be the host of a great civilization,\ninhabited by what is commonly referred to as 'The Ancients'.", 8.7);
		ShowSubtitles2("Tour Guide", "Further studies into discovered tablets and texts\nreveal that they were called 'the Praeleanthor'.", 6.5);
		ShowSubtitles2("Tour Guide", "Their civilization was heavily class-based and successful at that.", 4.6);
		ShowSubtitles2("Tour Guide", "But according to researchers, at some point in their history.", 4.1);
		ShowSubtitles2("Tour Guide", "A clash occurred with a resulting divide that fragmented their community.", 4.35);
		ShowSubtitles2("Tour Guide", "The dissidents were eventually captured by the leaders of the old\nand banished into a different realm.", 5.8);
		ShowSubtitles2("Tour Guide", "What is commonly referred to as the Dark Realm.\nOne of the two realms of the Praeleanthor.", 6);
	}

	void MuseumPart3Subs()
	{
		ShowSubtitles2("Tour Guide", "The Praeleanthor were a race of duplicity.", 3.35);
		ShowSubtitles2("Tour Guide", "While they revered their leaders and idols,\nthey feared and loathed their enemies.", 6.45);
		ShowSubtitles2("Tour Guide", "This attribute colored their entire existence\nas is evident in how they viewed the world and their discoveries.", 7.5);
		ShowSubtitles2("Tour Guide", "The two realms of the Praeleanthor were no exception.", 4.15);
		ShowSubtitles2("Tour Guide", "Their efforts into scientific discovery yielded promising results\nwhen they revealed the existence of two extra dimensions.", 8.3);
		ShowSubtitles2("Tour Guide", "Something they quickly polarized into what is known as\nthe Light Realm and the Dark Realm.", 6.2);
	}

	void MuseumPart4Subs()
	{
		ShowSubtitles2("Tour Guide", "The Dark Realm of the Praeleanthor is referred to as the world\nwhere bad entities are exiled to live out their lifes.", 7.2);
		ShowSubtitles2("Tour Guide", "Or even die an early death.", 2.4);
		ShowSubtitles2("Tour Guide", "Recovered stone tablets show that a particularly malevolent entity\nwas once banished into the dark.", 7);
		ShowSubtitles2("Tour Guide", "There are no mentions of his fate or records of his crimes.", 4.6);
		ShowSubtitles2("Tour Guide", "Should we as the human species ever come across the portal to this realm.", 5);
		ShowSubtitles2("Tour Guide", "We should highly consider the risks\nand consequences of further investigation.", 5.25);
	}

	void MuseumPart5Subs()
	{
		ShowSubtitles2("Tour Guide", "The Light Realm of the Praeleanthor\nwas considered to be a higher plane of existence.", 5.5);
		ShowSubtitles2("Tour Guide", "That only the best and brightest of their people could enter.", 3.7);
		ShowSubtitles2("Tour Guide", "It is conjectured that the majority of the Praeleanthor\nfled into this dimension as a consequence of a cataclysmic event.", 7.7);
		ShowSubtitles2("Tour Guide", "Some sort of great filter that was destined to wipe out their civilization\nor at the very least set it back thousands of years.", 8.9);
		ShowSubtitles2("Tour Guide", "Research into the connection between the two realms is scarce,\nbut we speculate that an intermediate passage must exist.", 9.4);
	}

	void MuseumPart6Subs()
	{
		ShowSubtitles2("Tour Guide", "This artifact was initially found deep within the crust of Mars.\nBeing a highly prioritized historical finding.", 9.35);
		ShowSubtitles2("Tour Guide", "It was rushed to be scrutinized by the premiere scientists\nand archeologists that any human organization has to offer.", 8.74);
		ShowSubtitles2("Tour Guide", "Interrupting this important work, the artifact was stolen from its place\nand disappeared for the better part of a decade.", 7.95);
		ShowSubtitles2("Tour Guide", "After a thorough investigation, it was recovered on Earth\nand returned to its rightful owner; the glorious federacy.", 8.44);
		ShowSubtitles2("Tour Guide", "Who stole it and why remains a mystery.", 3.5);
	}

	void MuseumPart7Subs()
	{
		ShowSubtitles2("Tour Guide", "Despite the tireless efforts of the best in their field,\nthe function and purpose of the artifact remains unknown.", 9.2);
		ShowSubtitles2("Tour Guide", "Experiments and tests show that it draws from an unseen power source,\nmaintaining a pulsing glow and a constant temperature.", 9.08);
		ShowSubtitles2("Tour Guide", "Attempts at cutting through the material and opening it up have failed.", 4.79 );
		ShowSubtitles2("Tour Guide", "While the scientific investigation into this artifact has been put on hold.", 5.7);
		ShowSubtitles2("Tour Guide", "Researchers note that it bears a striking resemblance\nto the texture and general properties of the receptacle found on Phobos.", 9.1);
		ShowSubtitles2("Tour Guide", "It is presumed that this is no coincidence.", 3.4);
	}

	void MuseumPart8Subs()
	{
		ShowSubtitles2("Tour Guide", "Phobos is the latest venture of the FCE.", 3.5);
		ShowSubtitles2("Tour Guide", "The artifacts found on the moon of Mars\nfar outpace those on Mars in terms of scientific value.", 8.2);
		ShowSubtitles2("Tour Guide", "Not only did the Praeleanthor, surprisingly,\nalso have a presence on Phobos.", 5.6);
		ShowSubtitles2("Tour Guide", "It is speculated that they even arrived\nin our solar system by utilizing so far unknown technology.", 8.5);
		ShowSubtitles2("Tour Guide", "One of the main attractions is the Phobos Monolith.", 4);
		ShowSubtitles2("Tour Guide", "It is thought that this may very well\nbe the anchor that tied itself to Mars, figuratively speaking.", 7.2);
		ShowSubtitles2("Tour Guide", "More recent discoveries include the receptacle\nat the aptly named receptacle base. ", 6.3);
		ShowSubtitles2("Tour Guide", "The federal involvement and engagement on Phobos\nremains a priority to further the lives of everyone.", 7.1);
	}

	void MuseumPart9Subs()
	{
		ShowSubtitles2("Tour Guide", "Receptacle base is the crown jewel of any extra-terrestrial endeavor.", 5.47);
		ShowSubtitles2("Tour Guide", "Our highly advanced and modern facility contains and protects\nthe most incredible of our discoveries; the receptacle.", 8.33);
		ShowSubtitles2("Tour Guide", "Initial interpretations of ancient tablets and texts\nreveal that this is a sort of gateway to another dimension.", 7.4);
		ShowSubtitles2("Tour Guide", "Incredible as it sounds,\npreliminary tests have supported this hypothesis.", 5.43);
		ShowSubtitles2("Tour Guide", "Subjects, both organic and not,\ndisappear without a trace when the receptacle is engaged.", 6.94);
		ShowSubtitles2("Tour Guide", "A particular frequency of current will trigger the inner workings of the device.", 5.2);
		ShowSubtitles2("Tour Guide", "Brave and adventurous volunteers have passed into this realm,\nbut so far none have returned.", 7);
		ShowSubtitles2("Tour Guide", "More luck has been had with inorganic materials\nthat have resurfaced into one of our listening stations on Mars.", 7);
	}

	void MuseumPart10Subs()
	{
		ShowSubtitles2("Tour Guide", "The most prominent of our listening stations is located in Mars City.", 4.9);
		ShowSubtitles2("Tour Guide", "While the area surrounding the listening station\nwas initially a mundane apartment for UAC workers on Mars.", 7.75);
		ShowSubtitles2("Tour Guide", "It is now transformed into a vanguard of scientific research.\nBeing closely linked to the receptacle.", 7.9);
		ShowSubtitles2("Tour Guide", "Experiments have shown a metaphysical connection\nwith our most prized artifact on Phobos.", 6.5);
		ShowSubtitles2("Tour Guide", "We have still not managed to get a reliable transfer of objects\ngoing from the receptacle to the listening station.", 7.55);
		ShowSubtitles2("Tour Guide", "But a host of objects have gone through.\nMost with notable mutations of either color, texture or form.", 9.5);
		ShowSubtitles2("Tour Guide", "To the best of our current understanding,\nsome sort of teleportation is invoked.", 5.95);
	}

	void MuseumPart11Subs()
	{
		ShowSubtitles2("Tour Guide", "The link between the receptacle and the listening station is not direct.", 5.37);
		ShowSubtitles2("Tour Guide", "It is assumed that it goes through a different dimension\nand its journey depends on factors unknown to us inside the realm.", 8.2);
		ShowSubtitles2("Tour Guide", "If we could harness this technology,\nit would be a game changer for humanity.", 5.3);
		ShowSubtitles2("Tour Guide", "The ability to perform teleportation of objects and people.", 3.7);
		ShowSubtitles2("Tour Guide", "Would have immense effect on our future development\nas a race and a collective organism.", 5.25);
		ShowSubtitles2("Tour Guide", "There is still a long way to go, but the results so far are very promising.", 5.75);
	}

	float museum_8_on = 0;
	void OnMuseumPart8Start()
	{
		
		
		sys.trigger($phobos_hologram_yellow);
		
		phobos_hologram_scanlines();
		
		sys.wait(1.5);
		sys.trigger($phobos_hologram_green);
		sys.wait(.5);
		
		$phobos_monolith_beam.show();
		sys.trigger($phobos_monolith_beam_light);

		museum_8_on = 1;		
	}

	void OnMuseumPart8End()
	{
		sys.disableItemGroup("museum");

		$phobos_monolith_beam.hide();
		sys.trigger($phobos_monolith_beam_light);
		
		sys.trigger($phobos_hologram_blue);
		sys.wait(1.3);

		museum_8_on = 0;
		sys.enableItemGroups();
	}	

