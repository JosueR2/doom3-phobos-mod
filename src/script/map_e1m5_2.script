	void chainsawfight()
	{
		float trigselect1;

		while (1)
		{
			trigselect1 = sys.random(15);
		
				if (trigselect1 <= 8){
					sys.trigger ($cabtrigger_once_110);
					sys.wait(1);
				}  
				  else {
					sys.trigger ($cabtrigger_once_111);
					sys.wait(1);
				}
		}
	}
	
