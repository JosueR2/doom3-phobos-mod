	void CargoLoopRed()
	{
		float length = 0;

		float index = 0;
		while(index < Track_Red_Nodes)
		{
			float a = index;
			float b = index + 1;
			if( b >= Track_Red_Nodes)
				b = 0;

			entity one = sys.getEntity("track_red_" + (a+1));
			entity two = sys.getEntity("track_red_" + (b+1));

			length += one.distanceTo(two);

			index++;
		}		

		float dis = length / 8;
		dis = dis / 80;
		
		float i = 0;
		while( i < 8 )
		{
			thread CargoLoopRedPlatform(sys.getEntity("track_red_platform_" + (i + 1)));
			sys.wait(dis);
			i++;
		}
	}

	void CargoLoopOrange()
	{
		float length = 0;

		float index = 0;
		while(index < Track_Orange_Nodes)
		{
			float a = index;
			float b = index + 1;
			if( b >= Track_Orange_Nodes)
				b = 0;

			entity one = sys.getEntity("track_orange_" + (a+1));
			entity two = sys.getEntity("track_orange_" + (b+1));

			length += one.distanceTo(two);

			index++;
		}

		float dis = length / (10);
		dis = dis / 80;
		float i = 0;
		while( i < 10 )
		{
			thread CargoLoopOrangePlatform(sys.getEntity("track_orange_platform_" + (i + 1)));
			sys.wait(dis);
			i++;
		}
	}

