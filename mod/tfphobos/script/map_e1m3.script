	void TriggerInfluence1()
	{
		if(goInfluenceLoop == 1)
			sys.trigger($target_setinfluence_1);
	}

	void InfluenceLoop()
	{
		while(goInfluenceLoop == 1)
		{
			TriggerInfluence1();
			sys.wait(1);
			TriggerInfluence1();
			sys.wait(1.5);
			TriggerInfluence1();
			sys.wait(.75);
			TriggerInfluence1();
			sys.wait(.25);
			TriggerInfluence1();
			sys.wait(2.25);
			TriggerInfluence1();
			sys.wait(.25);
			TriggerInfluence1();
			sys.wait(.75);
		}
	}
	
