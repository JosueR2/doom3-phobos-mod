	void BombCountdown2()
	{
		// Set up the bomb
		$bomb2.setGuiParm ("gui_parm61", 1);
		$bomb2.setKey("gui_noninteractive", 1);
		sys.trigger($bomb2);					

		// Max is how long the timer should be - in milliseconds
		float max = 5000;		

		float one = 0;
		float two = 0;
		float three = 0;
		float four = 0;
		float five = 0;

		// Store the start in lastFrame. We will wait one frame before starting so we know how long has passed.
		float lastFrame = sys.getTime();

		while( max >= 0 )
		{
			sys.waitFrame();
			float timeDiff = sys.getTime() - lastFrame;

			float seconds = (max / 1000);
			float milliseconds = max % 1000;			

			// DecaSeconds
			one = seconds / 10;
			one = int(one);

			// Seconds
			two = seconds % 10;
			two = int(two);
			
			// Tenths
			three = milliseconds / 100;
			three = int(three);
			
			// Hundredths
			four = (milliseconds % 100) / 10;
			four = int(four);

			// Milliseconds
			five = milliseconds % 10;
			five = int(five);

			SetBombTime2( one, two, three, four, five);
			
			max -= (timeDiff * 1000);

			lastFrame = sys.getTime();
		}

		sys.trigger($bomb_explosion);
		sys.trigger($bomb_hatch);
		$bomb2.hide();	
	}
	
	void select_monsterconfig1()
	{
		float monsterselect1;

		while (1)
		{
			monsterselect1 = sys.random(15);
		
				if (monsterselect1 <= 8){
					sys.trigger ($monster_select_count1a);
					//sys.println("monster_select_count1a selected");
					sys.wait(.5);
				}
				  else {
					sys.trigger ($monster_select_count1b);
					//sys.println("monster_select_count1b selected");
					sys.wait(.5);
				}
		}
	}
	
	void kill_monster_selection1()
	{
		sys.killthread("map_e1m4_4::select_monsterconfig1");
	}
	
