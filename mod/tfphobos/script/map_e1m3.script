		$m3_action_music_speaker3.stopSound(SND_CHANNEL_ANY, false);
		$m3_action_music_speaker4.stopSound(SND_CHANNEL_ANY, false);
		$m3_action_music_speaker5.stopSound(SND_CHANNEL_ANY, false);		

