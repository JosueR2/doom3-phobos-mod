	void main()
	{
		sys.trigger($trigger_count_9);
		
		thread select_monsterconfig2();
		thread select_monsterconfig3();
		
		sys.wait(15);
		
		thread select_monsterconfig4();
		thread select_monsterconfig5();
		
		sys.wait(30);
		
		thread monsterconfig1();
		thread select_monsterconfig6();
		thread select_monsterconfig7();
		thread select_monsterconfig10();
		
		sys.wait(10);
		
		thread select_monsterconfig8();
		thread select_monsterconfig9();
		
		sys.wait(7);
		
		thread select_monsterconfig11();
		thread select_monsterconfig12();
		thread select_monsterconfig13();
		
		$outro_alarmclock.rotateOnce('0 -35 0');
		$outro_signthing.rotateOnce('0 25 0');
		$outro_phone_model.rotateOnce('0 -15 0');
	}	

	float musicRequest = 0;
	float musicState = 0;
	float currentBeat = 0;	

