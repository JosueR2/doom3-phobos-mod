	float PUMPS_RUNNING = 1;
	
	void cycle_pump(float pump_num) {
	
	entity slime_pump = sys.getEntity("slime_pump_" + pump_num);
	entity speaker_pump = sys.getEntity("speaker_pump" + pump_num);
		
		
		sys.wait(1);
		while( PUMPS_RUNNING ) {
			slime_pump.time(3);
			slime_pump.move( UP, 96 );
			sys.waitFor( slime_pump );
			sys.trigger(speaker_pump);
			slime_pump.time(1);
			slime_pump.move( DOWN, 96 );
			sys.waitFor( slime_pump );
		}
	}

	void cycle_pump1() {
	
	 cycle_pump(1);
	
	}
	
	void cycle_pump2() {
	
	 cycle_pump(2);
	
	}
	
	void cycle_pump3() {
	
	 cycle_pump(3);
	
	}
	
	void cycle_pump4() {
	
	 cycle_pump(4);
	
	}
	
	float hideSubTime = 0;
	// Motel scene stuff below
	void SubtitlesRunning()
	{
		while(hideSubTime > sys.getTime())
		{			
			sys.waitFrame();
		}
		sys.hideSubtitles();
	}

	void ShowSubtitles(string name, string titles, float duration)
	{
		PhobosShowSubtitle_e1m5(name, titles);
		hideSubTime = sys.getTime() + duration;
		sys.wait(duration);
		if(hideSubTime <= sys.getTime())
		{
			sys.hideSubtitles();
		}
		else
		{
			thread SubtitlesRunning();
		}
	}

	void LeeTexts(string text)
	{
		float textTime = sys.strLength(text) * 0.125;

		sys.showTextTyping();
		sys.wait(textTime);
		sys.hideTextTyping();
		sys.showTextMessage(text, 0);
	}

	void CharacterSays(entity characterEntity, string line)
	{
		sys.wait(characterEntity.startSoundShader(line, SND_CHANNEL_ANY));
	}
	
	float CharacterSays_NoWait(entity characterEntity, string line)
	{
		return characterEntity.startSoundShader(line, SND_CHANNEL_ANY);
	}
	
	void Beat(float delay)
	{
		sys.wait(delay);
	}

	void precache()
	{
		sys.cacheSoundShader ("switch_02");
	}

	void HideUnderBed()
	{
		$hide_curtain_clicker.setKey("click_item", "1");
		$hide_bathroom_clicker.setKey("click_item", "1");
	
		sys.disableItemGroup("motel_hiding");

		thread ShowSubtitles("Sam", "Could lead to something so awkward.", 2);
		CharacterSays($player1, "sound/vo/e1m5/motelcloset/player23.ogg");

		sys.enableItemGroups();
	}
	
	float trainSequenceState = 1;
	vector camera_train_anchor_position;

	void UpdateTrainView()
	{
		vector lastBobAngle = '0 0 0';		
		vector lastBobMove = '0 0 0';

		while(trainSequenceState)
		{
			vector angle = $player1.getViewAngles() - lastBobAngle;
			lastBobAngle = $camera_train_bobber.getAngles();
			$player1.setViewAngles(angle + lastBobAngle);

			vector position = $player1.getWorldOrigin() - lastBobMove;
			lastBobMove = $camera_train_bobber.getWorldOrigin() - camera_train_anchor_position;
			$player1.setOrigin(position + lastBobMove);

			sys.wait(GAME_FRAMETIME);
		}
		
	}

	void ContinueWithTheExtraLights()
	{
		float i = 0;
		while(i++ < 4)
		{
			$train_out_window_light_mover.move(90, 480);
			sys.waitFor($train_out_window_light_mover);
			$train_out_window_light_mover.setOrigin($train_out_window_light_anchor.getOrigin());
		}
	}

	void GrabLights()
	{
		sys.wait(3);
		ContinueWithTheExtraLights();
	}

	float train_in_tunnel = 1;
	void TrainTrip()
	{	
		float tunnel_frac = 0.9;
		float train_frac = 0.1;
		float total_distance = 628;
		float segment_distance = 152;
		float tunnel_distance = 544*2;
		float total_speed = 200;
		float train_speed = total_speed * train_frac;
		float tunnel_speed = total_speed * tunnel_frac;

		while(train_in_tunnel)
		{
			$train_out_window_light_mover.move(90, 480);
			$PortalTrain_Mover.move(270, segment_distance * train_frac);
			$PortalTrain_Mover_Tunnel.move(90, segment_distance * tunnel_frac);
			sys.waitFor($PortalTrain_Mover);
			$train_out_window_light_mover.setOrigin($train_out_window_light_anchor.getOrigin());
			$PortalTrain_Mover.setOrigin($PortalTrain_Mover_Anchor.getOrigin());
			$PortalTrain_Mover_Tunnel.setOrigin($PortalTrain_Mover_Tunnel_Anchor.getOrigin());
		}

		thread ContinueWithTheExtraLights();
		$PortalTrain_Mover.move(270, total_distance);
		$PortalTrain_Mover_Tunnel.move(90, tunnel_distance);

		float train_time = total_distance/train_speed;
		float tunnel_time = tunnel_distance/tunnel_speed;

		sys.wait(train_time-tunnel_time);

		thread GrabLights();
		
		$PortalTrain_Mover_Tunnel_2.move(90, tunnel_distance);

		train_in_tunnel = 1;
		sys.waitFor($PortalTrain_Mover);

		while(train_in_tunnel)
		{
			$train_out_window_light_mover.move(90, 480);
			$PortalTrain_Mover.move(270, segment_distance * train_frac);
			$PortalTrain_Mover_Tunnel_2.move(90, segment_distance * tunnel_frac);
			sys.waitFor($PortalTrain_Mover);
			$train_out_window_light_mover.setOrigin($train_out_window_light_anchor.getOrigin());
			$PortalTrain_Mover.setOrigin($PortalTrain_Mover_Anchor_2.getOrigin());
			$PortalTrain_Mover_Tunnel_2.setOrigin($PortalTrain_Mover_Tunnel_Anchor_2.getOrigin());
		}
	}

	void StartTrainStuff()
	{		
		sys.trigger($PortalTrain);

		$camera_train_pendulum.setNeverDormant(1);
		$camera_train_bobber.setNeverDormant(1);
		$camera_train_anchor.setNeverDormant(1);


		thread TrainTrip();				

		$hide_closet_clicker.setKey("click_item", 1);
		$hide_closet_clicker.setKey("item_action", "Open");
		$hide_closet_clicker.setKey("call", "map_e1m5::GoToTrain");
		
		sys.trigger($motel_closet_clip);
		sys.trigger($motel_closet_light);		
		sys.trigger($train_slider_left);
		sys.trigger($train_slider_right);		

		sys.trigger($train_speaker_1);
		sys.trigger($train_speaker_2);

		camera_train_anchor_position = $camera_train_anchor.getOrigin();

		thread UpdateTrainView();

		sys.wait(2);

		sys.trigger($SpeakerHorn1);		
	}

	
	void Lee12Subs()
	{
		ShowSubtitles("Lee", "It was a really dark night.", 3);
		ShowSubtitles("Lee", "I was alone on the train, the train leaving my home.\nHeaded to the valley, to here, looking out at the world going by.", 10.5);
	}

	void OpenTrainDoors()
	{
		$train_slider_left.move(90, 30);
		sys.trigger($TrainSliderLeftSpeaker);

		sys.wait(.125);
		
		$train_slider_right.move(270, 30);

		thread Lee12Subs();
		CharacterSays($player1, "sound/vo/e1m5/motelcloset/lee12.ogg");

		$SitInTrainClicker.setKey("item_disabled", 0);
	}

	void CloseTrainDoors()
	{
		$train_slider_left.move(270, 30);
		sys.trigger($TrainSliderLeftSpeaker);

		sys.wait(.125);
		
		$train_slider_right.move(90, 30);
	}
	
	float inCloset = 1;
	
	void UpdateClosetCameraAngle()
	{			
		while(inCloset)
		{			
			vector angles = $player1.getViewAngles();
			angles_x *= 0.15f;
			angles_x -= 80;
			//angles_z *= 0.25f;
			angles_y *= 0.25f;
			//angles_y += 45;
			//angles_y -= 90;
			$motel_closet_camera.setAngles(angles);
			sys.wait(GAME_FRAMETIME);
		}
	}

	void Lee11Subs()
	{
		ShowSubtitles("Lee", "My closest friends had organized a farewell party, going late into the evening.", 6);
		ShowSubtitles("Lee", "My family and I were leaving on that day,\nbut my mom arranged for a later departure. Just for me.", 7.5);
		ShowSubtitles("Lee", "So I could have one last evening with my friends.", 3.5);
		ShowSubtitles("Lee", "And I did.", 2);
	}

	void Benson4Subs()
	{
		ShowSubtitles("James Benson", "It's been great, Lee.\nI know it's a bit...off...to get you a room at a motel.", 6.5);
		ShowSubtitles("James Benson", "But I didn't want to pressure you by inviting you to stay at my house.", 5);
	}

	void GoToTrain()
	{
		$hide_closet_clicker.hide();

		//Open closet
		$SliderLeft.move(90, 30);
		$train_slider_left.move(90, 30);
		sys.trigger($SliderLeftSpeaker);

		sys.wait(.125);

		//Open closet
		$SliderRight.move(270, 30);
		$train_slider_right.move(270, 30);	
		
		sys.waitFor($SliderRight);

		thread Lee11Subs();
		CharacterSays($player1, "sound/vo/e1m5/motelcloset/lee11.ogg");

		sys.wait(0.5);

		thread Lee12Subs();
		CharacterSays($player1, "sound/vo/e1m5/motelcloset/lee12.ogg");

		$SitInTrainClicker.setKey("item_disabled", 0);
	}	

	float sittingInTrain = 0;

	void UpdateTrainSitCameraAngle()
	{
		while(sittingInTrain)
		{			
			vector angles = $player1.getViewAngles();
			angles_y += 180;
			$motel_train_sitcam.setAngles(angles);
			sys.wait(GAME_FRAMETIME);
		}
	}

	void Lee13Subs()
	{
		ShowSubtitles("Lee", "Leaving my previous life and my friends behind.\nIt felt like the end.", 5);
		ShowSubtitles("Lee", "Like the hills, houses and people flying by were the end credits of my life.", 8);
		ShowSubtitles("Lee", "No matter how hard I tried to keep water towers,\ntrees or landmarks in view they would always disappear over the horizon.", 10);
		ShowSubtitles("Lee", "Eventually.\nJust like all the people I knew.", 6.5);
	}

	void SitInTrain()
	{
		sittingInTrain = 1;
		
		// Head out of the tunnel
		train_in_tunnel = 0;

		vector initial_angles = $motel_train_sitcam_angle.getAngles();
		initial_angles_y += 180;
		$player1.setViewAngles(initial_angles);

		thread UpdateTrainSitCameraAngle();

		sys.trigger($motel_train_sitcam);		

		thread Lee13Subs();
		CharacterSays($player1, "sound/vo/e1m5/motelcloset/lee13.ogg");

		sys.wait(0.25);

		$train_letter_item.setKey("click_item", "1");
	}

	void UpdateBedCameraAngle()
	{			
		while(1)
		{			
			vector angles = $player1.getViewAngles();
			angles_y += 90;
			$motel_bed_camera.setAngles(angles);
			sys.wait(GAME_FRAMETIME);
		}
	}	

