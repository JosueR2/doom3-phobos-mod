	void plastube_load()	
	{
		while (1)
		{		
			sys.trigger($plastube_lights_red);
			sys.trigger($plastube_red);
			
			$plastube_mover.time(2.25);
			$plastube_mover.decelTime(0.25);
			$plastube_mover.accelTime(0.15);
			
			$plastube_carrier_magnet.move(-2, 288);
			$plastube_carrier_cage.move(-2, 288);
			$plastube_mover.move(-2, 288);
			sys.wait(.25);
			sys.trigger($sp_carrier_desc);
			sys.waitFor($plastube_carrier_magnet);
			sys.trigger($sp_carrier_clickcatch);
			$plastube_mover.time(1.25);
			$plastube_mover.decelTime(0.1);
			$plastube_mover.accelTime(0.05);
			$plastube_carrier_spinners.time(1.25);
			$plastube_carrier_spinners.decelTime(0.1);
			$plastube_carrier_spinners.accelTime(0.05);
			$plastube_carrier.time(1.25);
			$plastube_carrier.decelTime(0.1);
			$plastube_carrier.accelTime(0.05);
			sys.wait(.35);
			$plastube_carrier_cage.move(-1, 288);
			sys.trigger($sp_carrier_cage_asc);
			sys.wait(.15);
			$plastube_carrier_magnet.move(-1, 288);
			sys.wait(.1);
			sys.trigger($sp_plastube_carrier_rot);
			$plastube_mover.rotateOnce( '90 0 0' );
			$plastube_carrier_cyl.rotateOnce( '90 0 0' );
			$plastube_carrier_spinners.rotateOnce( '90 0 0' );
			$plastube1.move(180, 320);
			sys.waitFor($plastube1);
			sys.trigger($sp_plastube_lock);
			$plastube1.bind($plastube_carrier);
			$plastube_carrier_cyl.bind($plastube_carrier_arms);
			sys.wait(.15);
			sys.trigger($sp_plastube_carrier_cylinder_rot);
			$plastube_carrier.rotateOnce( '0 -90 0' );
			$plastube_carrier_cyl_disc.rotateOnce( '0 -90 0' );
			$plastube2.move(180, 320);
			sys.waitFor($plastube2);
			sys.trigger($sp_plastube_lock);
			$plastube2.bind($plastube_carrier);
			sys.wait(.15);
			sys.trigger($sp_plastube_carrier_cylinder_rot);
			$plastube_carrier.rotateOnce( '0 -90 0' );
			$plastube_carrier_cyl_disc.rotateOnce( '0 -90 0' );
			$plastube3.move(180, 320);
			sys.waitFor($plastube3);
			sys.trigger($sp_plastube_lock);
			$plastube3.bind($plastube_carrier);
			sys.wait(.15);
			sys.trigger($sp_plastube_carrier_cylinder_rot);
			$plastube_carrier.rotateOnce( '0 -90 0' );
			$plastube_carrier_cyl_disc.rotateOnce( '0 -90 0' );
			$plastube4.move(180, 320);
			sys.waitFor($plastube4);
			sys.trigger($sp_plastube_lock);
			$plastube4.bind($plastube_carrier);
			sys.trigger($plastube_lights_blue);
			sys.trigger($plastube_blue);
			$plastube_carrier_spinners.bind($plastube_carrier_arms);
			sys.wait(.05);
			$plastube_mover.bind($plastube_carrier_arms);
			$plastube_carrier_arms.move(-2, 24);
			sys.trigger($sp_plastube_carrier_arms_desc);
			sys.waitFor($plastube_carrier_arms);
			$plastube_mover.unbind();
			sys.wait(.15);
			$plastube_light_mover.bind($plastube_mover);
			$plastube_mover.time(4);
			$plastube_mover.decelTime(0);
			$plastube_mover.accelTime(0.2);
			$plastube_mover.move(180, 992);
			sys.trigger($sp_plastube_carrier_trip);
			sys.wait(1);
			$plastube_carrier_spinners.rotateOnce( '-90 0 0' );
			$plastube_carrier_cyl.rotateOnce( '-90 0 0' );
			$plastube_carrier_arms.move(-1, 24);
			sys.trigger($sp_plastube_carrier_arms_asc);
			sys.trigger($sp_plastube_carrier_rot);
			sys.waitFor($plastube_mover);
			$plastube_light_mover.unbind();
			$plastube_carrier_spinners.unbind();
			$plastube_carrier_cyl.unbind();
			$plastube_mover.unbind();
			$plastube_light_mover.restorePosition();
			$plastube_carrier_mover.restorePosition();
			$plastube_mover.restorePosition();
			$plastube1.unbind();
			$plastube2.unbind();
			$plastube3.unbind();
			$plastube4.unbind();
			$plastube1.restorePosition();
			$plastube2.restorePosition();
			$plastube3.restorePosition();
			$plastube4.restorePosition();		
		}
	}	
	
	void FMSEngage()
	{
		if(fms_state == 0)
		{			
			fms_state = 2;
			
			sys.trigger($fms_panelclip);
			
			$FMS_InZone_trigger.disable();

			$fms_pole.move(DOWN, 88);

			sys.trigger($func_emitter_452);
			sys.trigger($func_emitter_453);
			$func_emitter_453.startSoundShader("rec1_steamchuff", SND_CHANNEL_ANY);
			
			sys.wait( 1.5 );

			sys.trigger($func_emitter_452);
			sys.trigger($func_emitter_453);
			
			$fms_bottomrotator.startSoundShader("al4_spinner_2second", SND_CHANNEL_ANY);
			$fms_bottomrotator.rotateOnce('145 0 0');			
			
			sys.wait(.1);
			
			$fms_rightrotator.startSoundShader("al4_spinner_2second", SND_CHANNEL_ANY);			
			$fms_rightrotator.rotateOnce('0 -145 0');
			
			sys.wait(.1);
			
			$fms_leftrotator.startSoundShader("al4_spinner_2second", SND_CHANNEL_ANY);
			$fms_leftrotator.rotateOnce('0 145 0');
			
			sys.wait(.5);
				
			$fms_keyboard.rotateOnce('-75 0 0');
			
			$fms_thirdscreen.rotateOnce('0 25 0');
			$fms_fourthscreen.rotateOnce('0 25 0');
			
			$fms_firstscreen.rotateOnce('0 -25 0');						
			$fms_secondscreen.rotateOnce('0 -25 0');
						
			sys.wait(2);	
			
			sys.trigger($fms_panelclip);
			
			TurnOnScreen($fms_mainscreen, $fms_mainscreen_flare);		
			
			sys.wait(.1);			
			TurnOnScreen($fms_thirdscreen, $fms_thirdscreen_flare);		
			
			sys.wait(.1);			
			TurnOnScreen($fms_firstscreen, $fms_firstscreen_flare);		
			
			sys.wait(.1);			
			TurnOnScreen($fms_fourthscreen, $fms_fourthscreen_flare);		
						
			sys.wait(.1);
			TurnOnScreen($fms_secondscreen, $fms_secondscreen_flare);
		
			sys.trigger($speaker_910);

			sys.trigger($fms_fourthscreen_clicker);

			fms_state = 1;						
			
			$FMS_OutZone_trigger.enable();
		}
	}

	void FMSDisengage()
	{
		if(fms_state == 1)
		{						
			fms_state = 2;
			
			sys.trigger($fms_panelclip);
			
			$FMS_OutZone_trigger.disable();

			sys.trigger($fms_fourthscreen_clicker);

			TurnOffScreen($fms_mainscreen, $fms_mainscreen_flare);					
			
			sys.wait(.1);
			TurnOffScreen($fms_thirdscreen, $fms_thirdscreen_flare);
			
			sys.wait(.1);
			TurnOffScreen($fms_firstscreen, $fms_firstscreen_flare);
			
			sys.wait(.1);
			TurnOffScreen($fms_fourthscreen, $fms_fourthscreen_flare);
						
			sys.wait(.1);
			TurnOffScreen($fms_secondscreen, $fms_secondscreen_flare);
			
			$fms_leftrotator.startSoundShader("al4_spinner_2second", SND_CHANNEL_ANY);
			$fms_leftrotator.rotateOnce('0 -145 0');
			
			sys.wait(.1);
			
			$fms_rightrotator.startSoundShader("al4_spinner_2second", SND_CHANNEL_ANY);			
			$fms_rightrotator.rotateOnce('0 145 0');					
			
			sys.wait(.1);
			
			$fms_bottomrotator.startSoundShader("al4_spinner_2second", SND_CHANNEL_ANY);
			$fms_bottomrotator.rotateOnce('-145 0 0');			
			
			sys.wait( .5 );
			
			$fms_secondscreen.rotateOnce('0 25 0');
			$fms_firstscreen.rotateOnce('0 25 0');
			
			$fms_fourthscreen.rotateOnce('0 -25 0');
			$fms_thirdscreen.rotateOnce('0 -25 0');
			
			$fms_keyboard.rotateOnce('75 0 0');
						
			sys.wait( 1.5 );
			
			sys.trigger($fms_panelclip);
			
			$fms_pole.move(UP, 88);	

			sys.waitFor($fms_pole);

			sys.trigger($speaker_910);
			
			fms_state = 0;			
			
			$FMS_InZone_trigger.enable();
		}
	}

	float insideFMSZone = 0;

	void FMS_Activator()
	{
		while(fms_disabled == 0)
		{
			if(insideFMSZone == 1 && fms_disabled == 0)
			{
				FMSEngage();
			}
			else
			{
				FMSDisengage();
			}

			sys.wait(1);
		}

		if(fms_disabled == 1)
		{
			FMSDisengage();
		}
	}

	void FMS_InZone()
	{
		insideFMSZone = 1;
	}

	void FMS_OutZone()
	{
		insideFMSZone = 0;
	}

