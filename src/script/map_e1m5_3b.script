	float foundTreasureNote = 0;
	void TryGirlRoomDoor()
	{	
		//Try door
		if(foundTreasureNote == 0)		
		{
			$girl_room_door.startSoundShader("sound/shav/e1m5_2/locked_door.ogg", SND_CHANNEL_ANY);

			$girl_room_door_handle.rotateOnce('0 0 -15');

			float angle = 0.5;
			$girl_room_door_hinge.rotateOnce('0 0.5 0' * angle);

			float i = 0;
			while( i < 2 )
			{
				sys.waitFor($girl_room_door_hinge);
				$girl_room_door_hinge.rotateOnce('0 -1 0' * angle);
				sys.waitFor($girl_room_door_hinge);
				$girl_room_door_hinge.rotateOnce('0 1 0' * angle);
				i++;
			}	
		
			sys.waitFor($girl_room_door_hinge);

			$girl_room_door_hinge.rotateOnce('0 -0.5 0' * angle);

			$girl_room_door_handle.rotateOnce('0 0 15');

			sys.wait(0.5);
			
			$girl_room_keyhole_item.setKey("click_item", "1");
		}
		
		//Open door
		if(foundTreasureNote == 1)
		{
			sys.wait($girl_room_door_hinge.startSoundShader("sound/shav/e1m5_2/unlock.ogg", SND_CHANNEL_ANY) + 0.5);

			$girl_room_door_hinge.accelTime(0.5);
			$girl_room_door_hinge.decelTime(0.5);
			$girl_room_door_hinge.time(3);

			$girl_room_door_handle.startSoundShader("e1m1_doorknobopen", SND_CHANNEL_ANY);
			$girl_room_door_handle.rotateOnce('0 0 -30');
			
			$girl_room_door_hinge.rotateOnce('0 85 0');
			$girl_room_door_handle.startSoundShader("e1m4_3_door_creak_2", SND_CHANNEL_ANY);
			
			sys.wait(.5);

			$girl_room_door_handle.rotateOnce('0 0 30');
		}		
	}

	float lookingIntoGirlRoom = 0;	
	void UpdateCameraAngle2()
	{			
		while(lookingIntoGirlRoom)
		{
			vector angles = $player1.getViewAngles();
			angles_x = angles_x * 0.5;
			$girl_room_camera_mover.setAngles(angles + '0 90 0');
			sys.wait(GAME_FRAMETIME);
		}
	}

	vector originalStalkerViewAngles;

	void LookIntoGirlRoom()
	{
		if(lookingIntoGirlRoom == 2)
		{
			return;
		}

		float new_state = lookingIntoGirlRoom;
		lookingIntoGirlRoom = 2;

		sys.fadeTo('0 0 0', 1, .125);

		sys.wait(.125);

		if(new_state == 0)
		{
			new_state = 1;

			originalStalkerViewAngles = $player1.getViewAngles();
			
			$func_static_100940.show();

			sys.trigger($girl_room_peek_teleport);
			thread UpdateCameraAngle2();
			sys.trigger($GirlRoomBreathing);
		}
		else
		{
			new_state = 0;

			$func_static_100940.hide();
			
			$girl_room_keyhole_item.setKey("click_item", 1);
			sys.trigger($girl_room_teleport);

			$player1.setViewAngles(originalStalkerViewAngles);
			sys.trigger($GirlRoomBreathing);
		}

		sys.trigger($girl_room_camera);
		sys.wait(.125);
		
		sys.fadeTo('0 0 0', 0, .125);

		sys.wait(.125);

		lookingIntoGirlRoom = new_state;
	}

	void BreakSummerCam()
	{
		LookIntoGirlRoom();
	}

	void DepressHatch()
	{
		$cellar_hatch.accelTime(0);
		$cellar_hatch.decelTime(0);
		$cellar_hatch.time(.125);
		$cellar_hatch.startSoundShader("sound/shav/e1m5_2/HandleRot.ogg", SND_CHANNEL_ANY);

		$cellar_hatch.move(DOWN, 2);

		sys.waitFor($cellar_hatch);
	}

	void OpenHatch()
	{
		$pantry_knob_clicker.hide();

		DepressHatch();

		sys.wait(2);

		thread Music_Suspense_Advance();

		sys.trigger($cellar_hatch_portal);
		$cellar_hatch.accelTime(1);
		$cellar_hatch.decelTime(1);
		$cellar_hatch.time(10);
		$cellar_hatch.startSoundShader("sound/shav/e1m4/rolling.ogg", SND_CHANNEL_ANY);

		$cellar_hatch.move(180, 128);
		sys.waitFor($cellar_hatch);

		thread ShowSubtitles("Sam", "What are you hiding down here James?", 2);
		CharacterSays($player1, "sound/vo/e1m5_2/BensonHouse/CellarOpeningReaction.ogg");		
	}

	void LeeEnding1Subs()
	{
		ShowSubtitles("Lee", "You're amazing!! We can't talk for long, I made up an excuse.\nHow much time do you need?", 5.75);
		ShowSubtitles("Lee", "To cover your tracks and get out of there I mean.\nI can't wait to get out of here and back to you.", 6.5);
	}

	void LeeEnding2Subs()
	{
		ShowSubtitles("Lee", "Kara? I think that's his daughter's friend.\nShe went missing some time ago, I know they're still looking for her.", 10);
	}

	void LeeEnding3Subs()
	{
		ShowSubtitles("Lee", "Ugh. How could I have been so blind?\nWe really need to make a clean getaway.", 6.5);
	}

	void LeeEnding4Subs()
	{
		ShowSubtitles("Lee", "So, the plan. You stash the box back at our place.", 5);
		ShowSubtitles("Lee", "Once I've told him off I'll go back to the motel,\ngrab all of our stuff and meet you at the barn.", 5);
	}

	void LeeEnding5Subs()
	{
		ShowSubtitles("Lee", "I appreciate that, but if things go sour, the box is our bargaining chip.\nWe can do this. We need to do this!", 6.75);
		ShowSubtitles("Lee", "This is the end of the beginning!\nI really have to go. Thanks for...", 5.25);
		ShowSubtitles("Lee", "...well you know.", 3);
	}

	void PlayerEnding2Subs()
	{
		ShowSubtitles("Sam", "I think James has something to do with it.", 2.75);
		ShowSubtitles("Sam", "I found a creepy box with her name on it and his wife mentioned something about her in an email.", 5);
		ShowSubtitles("Sam", "This guy is bad news. Worse news. Please be careful!", 6);
	}

	void Player1EndingSubs()
	{
		ShowSubtitles("Sam", "Cover my tracks? Sadly, some of them can't be covered.\nI'll try to hurry. Be careful.", 8);
		ShowSubtitles("Sam", "Erm.\nDoes the name Kara mean anything to you?", 4);
	}

	void PickUpRevolver()
	{
		sys.disableItemGroup("vault_items");

		//Revolver
		$func_static_91.hide();
		$player1.startSoundShader("e1m3_1_pickupbox", SND_CHANNEL_ANY);

		thread ShowSubtitles("Sam", "You've done enough damage with this.", 2);
		CharacterSays($player1, "sound/vo/e1m5_2/BensonHouse/RevolverReaction.ogg");

		sys.enableItemGroups();

		boxUwuCounter++;
