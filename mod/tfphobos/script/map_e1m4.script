	float Track_Red_Nodes = 4;
	float Track_Green_Nodes = 10;
	float Track_Orange_Nodes = 14;
	float Track_Blue_Nodes = 10;
	
	float Track_Red_Direction = 1;
	float Track_Orange_Direction = -1;
	float Track_Blue_Direction = 1;
	float Track_Green_Direction = 1;
	float Track_Direction_CW = 1;
	float Track_Direction_CCW = -1;

	float CargoSuspended = 0;

	void CargoLoopOrangePlatform(entity platform)
	{		
		while(true)
		{
			if( CargoSuspended == 1 )
			{
				sys.waitFrame();
				continue;
			}

			float nodeIndex = platform.getFloatKey("current_node");
			float nextIndex = nodeIndex + Track_Orange_Direction;

			if( nextIndex < 1 )
				nextIndex = Track_Orange_Nodes;
			else if( nextIndex > Track_Orange_Nodes )
				nextIndex = 1;
			
			entity destination = sys.getEntity("track_orange_" + nextIndex);

			platform.moveTo(destination);
			
			sys.waitFor(platform);			

			if( CargoSuspended == 0 )
			{
				platform.setKey("current_node", nextIndex);
			}
		}
	}
	
