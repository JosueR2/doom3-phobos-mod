	float hmm = 0;

	void CheckHmm(string hmm_text, string hmm_sound)
	{
		sys.disableItemGroup("pantry_inspection");

		float hmm_duration = $player1.startSoundShader(hmm_sound, SND_CHANNEL_ANY);

		thread ShowSubtitles("Sam", hmm_text, hmm_duration * 2);
		sys.wait(hmm_duration);

		if(hmm++ >= 4)
		{
			$pantry_door_closer.setKey("click_item", 1);
		}

		sys.enableItemGroups();
	}


