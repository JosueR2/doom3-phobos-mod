	void RotateBridge1()
	{
		if(goobridge_01_lock == 1)
		{
			thread BridgeL1LockSubs();
			sys.wait($goobridge_01_lockspeaker.startSoundShader("sound/shav/e1m5/bridge1lock.ogg", SND_CHANNEL_ANY));
			$goobridge_01_gui.setKey("click_item", "1");
		}
		else
		{
			if(initBridge1Done == 1)
			{
				TriggerBridgeObjective();
			}

			sys.trigger($goobridge_01_triggercount_relay);
			RotateBridge("goobridge_01", goobridge_01_arm01, goobridge_01_arm02, 1);
			goobridge_01_arm01 = (goobridge_01_arm01 + 1) % 4;		
			goobridge_01_arm02 = (goobridge_01_arm02 + 1) % 4;			

			UpdateMapCompletion();
		}
	}

