	float mancubus_state = 0; 
	// 0 = not spawned, 1 = spawned, 2 = dead
	
	void check_mancubus()
	{
		if(mancubus_state == 0)
		{
		if(debug)
			sys.println("Mancubus is not spawned");
		}
		else if(mancubus_state == 1)
		{
			sys.trigger($monster_demon_mancubus_1);
		}
		else if(mancubus_state == 2)
		{
		if(debug)
			sys.println("Mancubus is dead");
		}
	}
	
	void flag_manc_spawned()
	{
		mancubus_state = 1;
	}
	
	void flag_manc_dead()
	{
		mancubus_state = 2;
	}
	
		
