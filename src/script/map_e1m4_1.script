		sys.fadeTo('1 1 1', 0, .0625);

		thread LeeDeadend6Sub();
		CharacterSays($speaker_lee_vent, "sound/vo/e1m4/sewer/deadend/Lee6.ogg");
		Beat(.75);
		
		thread ShowNPCSubtitles("Sam", "Yeah?", 2);
		CharacterSays($player1, "sound/vo/e1m4/sewer/deadend/Player5.ogg");
		Beat(.6);
		
		thread LeeDeadend7Sub();
		CharacterSays($speaker_lee_vent, "sound/vo/e1m4/sewer/deadend/Lee7.ogg");
		Beat(.4);
		
		thread ShowNPCSubtitles("Sam", "I remember.", 2);
		CharacterSays($player1, "sound/vo/e1m4/sewer/deadend/Player6.ogg");
		Beat(.75);
		
		thread CityCamLoop();

		thread LeeDeadend8Sub();
		CharacterSays($player1, "sound/vo/e1m4/sewer/deadend/Lee8.ogg");
		Beat(.5);
		
		thread ShowNPCSubtitles("Sam", "I'm sorry, Lee...", 2);
		CharacterSays($player1, "sound/vo/e1m4/sewer/deadend/Player7.ogg");
		Beat(1.5); 
		
		thread LeeDeadend9Sub();
		CharacterSays($player1, "sound/vo/e1m4/sewer/deadend/Lee9.ogg");
		Beat(.75);

		thread ShowNPCSubtitles("Sam", "Lee...", 2);
		CharacterSays($player1, "sound/vo/e1m4/sewer/deadend/Player8.ogg");
		Beat(.5);
		
		thread LeeDeadend10Sub();
		CharacterSays($player1, "sound/vo/e1m4/sewer/deadend/Lee10.ogg");
		Beat(.75);
		
		thread LeeDeadend11Sub();
		CharacterSays($player1, "sound/vo/e1m4/sewer/deadend/Lee11.ogg");
		Beat(1.5);
		
		thread LeeDeadend12Sub();
		CharacterSays($player1, "sound/vo/e1m4/sewer/deadend/Lee12.ogg");
		Beat(.5);

		cityCamLooping = 0;		
	}

