	void LockBridgeMap(float b, float armState1, float armState2, float red, float green)
	{
		float c = 0;
		while(c < 3)
		{
			entity bridgeLight = sys.getEntity("c" + (c + 1) + "_s" + b);
			bridgeLight.setColor(red,green,0);

			entity light = sys.getEntity("c" + (c + 1) + "_s" + b + "_d" + armState1);
			light.setColor(red,green,0);

			light = sys.getEntity("c" + (c + 1) + "_s" + b + "_d" + armState2);
			light.setColor(red,green,0);

			c++;
		}	
	}

	void InitBridge1()
	{
		RotateBridge1();
		RotateBridge1();

		goobridge_01_lock = 1;
		initBridge1Done = 1;

