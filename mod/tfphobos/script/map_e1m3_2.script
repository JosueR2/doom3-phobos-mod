	void FuelAlarmSub()
	{
		ShowNPCSubtitles("PA", "Area is in lockdown. Unctrolled fire.\nExplosion imminent.", 6.35);
	}
	
	void CallMiles()
	{
		SpeakerAmbience_fadeout();
		
		Beat(.25);
		thread ShowNPCSubtitles("Miles", "Yeah?", 2);
		CharacterSays($Comm_Holder, "milescall1_miles1");
		Beat(.75);
		sys.trigger($SpeakerBurnedToACrisp);
		thread ShowNPCSubtitles("Sam", "I found Benson. He's dead. Burned to a crisp.", 3.25);
		CharacterSays($player1, "milescall1_player1");
		Beat(1.25);
		thread ShowNPCSubtitles("Miles", "Oh. That's too bad...", 2);
		CharacterSays($Comm_Holder, "milescall1_miles2");
		Beat(1.5);
		thread ShowNPCSubtitles("Sam", "I'm sorry?", 2);
		CharacterSays($player1, "milescall1_player2");
		Beat(.5);
		thread ShowNPCSubtitles("Miles", "Don't be. He wasn't exactly what you would call a nice guy.", 3.15);
		CharacterSays($Comm_Holder, "milescall1_miles3");
		Beat(.75);
		thread ShowNPCSubtitles("Sam", "Who was Benson anyway? How did you know him?", 2.25);
		CharacterSays($player1, "milescall1_player3");
		Beat(.5);
		thread ShowNPCSubtitles("Miles", "I knew him through the academy. He's a federal Agent like Calloway and I.\nHe had a run-in with him a few years ago.", 6.25);
		CharacterSays($Comm_Holder, "milescall1_miles4");
		Beat(.25);
		thread ShowNPCSubtitles("Sam", "What happened?", 2);
		CharacterSays($player1, "milescall1_player4");
		Beat(.5);
		thread ShowNPCSubtitles("Miles", "He took something that was too beautiful for this world and turned it into ash.\nHe violated our trust and turned against us.", 6.25);
		CharacterSays($Comm_Holder, "milescall1_miles5");
		sys.trigger($radio_chatter_sp);
		Beat(.5);
		thread ShowNPCSubtitles("Sam", "I...I guess it's good he's gone then.", 2.15);
		CharacterSays($player1, "milescall1_player5");
		Beat(.25);
		thread ShowNPCSubtitles("Miles", "Sam I don't want people to die, but I'm not going to start caring about Benson.", 4.25);
		CharacterSays($Comm_Holder, "milescall1_miles6");
		Beat(1.75);
		thread ShowNPCSubtitles("Sam", "Samantha...What did he turn into ash?", 2.45);
		CharacterSays($player1, "milescall1_player6");
		Beat(.75);
		thread ShowNPCSubtitles("Miles", "I...I really don't want to talk about that now. We have work to do.", 6.6);
		CharacterSays($Comm_Holder, "milescall1_miles7");
		
		$player1.startSoundShader("e1m1_intercomclick2", SND_CHANNEL_ANY);
		$comm_snapin.hide();
		
		sys.wait(.1);
		$commscreen.hide();
		sys.wait(.1);
		$commscreen_offline.show();
		
		sys.trigger($monster_zsec_shotgun2_7);
		
		Beat(2.75);
		
		thread ShowNPCSubtitles("Sam", "I'm sorry, Samantha.", 2);
		CharacterSays($player1, "milescall1_player7");
		
		Beat(2.5);
		
		sys.trigger($bulkhead_portal);
		
		$fucky_door_fuck_you.time(8);
		$fucky_door_fuck_you.move(UP, 112);
		sys.trigger($bulkhead_aas_obstacle);
		
		sys.trigger($trigger_relay_614);

		sys.quickSave("The Beginning of The End - Checkpoint 6");
	}
	
	void InsertSnapin()
	{
		$player1.startSoundShader("e1m1_intercomclick1", SND_CHANNEL_ANY);

		sys.trigger($comm_beep);

		$comm_snapin.show();
		$comm_blinker_tex.hide();
		$comm_blinking_light.hide();
		sys.wait(.1);
		$commscreen_online.hide();
		sys.wait(.1);
		$commscreen.setGuiParm("gui_parm41", 1);		
		sys.trigger($commscreen);
		$commscreen.show();

		sys.wait(2.5);
		CallMiles();
	}
	
	float reactingToAgent = 0;
	float BensonCardReaction_State = 0;

	void BensonCardReaction()
	{
		if(BensonCardReaction_State == 0 && reactingToAgent == 0)
		{
			BensonCardReaction_State = 1;
			sys.wait(0.25);
			thread thread ShowNPCSubtitles("Sam", "James Benson? I guess we now know why you missed your flight.\nOur flight.", 5.1);
			$player1.startSoundShader("know_why_missed_flight", SND_CHANNEL_ANY);
		}
	}	
	
	void FederalAgentReaction()
	{
		reactingToAgent = 1;

		thread thread ShowNPCSubtitles("Sam", "Is that a federal agent?", 2);
		sys.wait($player1.startSoundShader("is_that_fed_agent", SND_CHANNEL_ANY));

		reactingToAgent = 0;
	}
	
	float FuelMainControlReaction_State = 0;
	void FuelMainControlReaction()
	{
		if(FuelMainControlReaction_State == 0 && reactingToAgent == 0)
		{
			thread thread ShowNPCSubtitles("Sam", "Locked. I guess this room can empty the fuel cache.", 3.25);
			$player1.startSoundShader("this_room_empty_fuel", SND_CHANNEL_ANY);
			FuelMainControlReaction_State = 1;
		}
	}

	void FuckYouDoor()
	{		
		// move door into fuck you position
		sys.trigger($bulkhead_portal);
		$fucky_door_fuck_you.move(UP, 48);
		sys.waitFor($fucky_door_fuck_you);

		while(fuckydoorstate == 0)
		{			
			// find a random distance to drop
			float dist = sys.random(16);

			// find a random time to delay before moving
			float del = sys.random(3);

			if(fuckydoorstate == 0)
				sys.wait(del);

			$fucky_door_fuck_you.move(DOWN, dist);
			sys.waitFor($fucky_door_fuck_you);
			
			// find a new random delay before going back up
			del = sys.random(3);
			
			if(fuckydoorstate == 0)
				sys.wait(del);

			// move the door back up
			$fucky_door_fuck_you.move(UP, dist);
			sys.waitFor($fucky_door_fuck_you);
		}

		$fucky_door_fuck_you.move(DOWN, 48);
	}
	
	void BeginDoorFuckery()
	{
		fuckydoorstate = 0;
		thread FuckYouDoor();
	}
	
	float codeTalk = 0;

	void FuelTalk()
	{	
		$fms_fourthscreen_clicker.setKey("click_item", 0);

		if(codeTalk == 0)
		{
			thread ShowNPCSubtitles("Sam", "So I guess all of these needs to be green.", 2.25);
			sys.trigger($speaker_1013);
		}
		else
		{
			thread ShowNPCSubtitles("Sam", "Hmm. This doesn't look right.", 2.25);
			sys.trigger($speaker_1014);
		}

		// Flip
		codeTalk = 1 - codeTalk;

		// Don't reactivate for a while
		sys.wait(4);

		$fms_fourthscreen_clicker.setKey("click_item", 1);
	}
	
