	void EndTankDoor()
	{
		$EndTankHandle.rotateOnce('-90 0 0');
		$EndTankHandle.startSoundShader("e1m5_3_large_switch", SND_CHANNEL_ANY);

		sys.wait(1);
		
			$l_tankdoor.accelTime(.05);
			$r_tankdoor.accelTime(.05);
			$l_tankdoor.time(.35);
			$r_tankdoor.time(.35);
			sys.trigger($ltankdoor_spck);
			sys.trigger($rtankdoor_spck);
			$l_tankdoor.rotateDownTo(Y_AXIS, 357);
			$r_tankdoor.rotateUpTo(Y_AXIS, 3);
			sys.waitFor($r_tankdoor);
			sys.wait(.7);
			$l_tankdoor.accelTime(.35);
			$r_tankdoor.accelTime(.35);
			$l_tankdoor.time(6);
			$r_tankdoor.time(6);
			sys.trigger($ltankdoor_spro);
			sys.trigger($rtankdoor_spro);
			$l_tankdoor.rotateDownTo(Y_AXIS, 315);
			$r_tankdoor.rotateUpTo(Y_AXIS, 45);
			
		sys.waitFor($l_tankdoor);
		$EndPipe_Platform.move(DOWN, 256);
		sys.waitFor($EndPipe_Platform);
		$EndPipe_Platform_Railing.move(DOWN, 50);
		sys.trigger($EndPipe_Platform_Railing_Spkr);	
	}
	
	void SealEndTankDoors()
	{
			$l_tankdoor.decelTime(.35);
			$r_tankdoor.decelTime(.35);
			sys.trigger($ltankdoor_spro);
			sys.trigger($rtankdoor_spro);
			$l_tankdoor.rotateUpTo(Y_AXIS, 0);
			$r_tankdoor.rotateDownTo(Y_AXIS, 0);
			sys.wait(6);
			sys.trigger($ltankdoor_spck2);
			sys.trigger($rtankdoor_spck2);
	}

	float endLevelOnce = 0;
	void EndLevel()
	{
		if(endLevelOnce != 0)
			return;

		endLevelOnce = 1;
		
		sys.trigger($exit_clip);
		$EndPipe_Platform_Railing.move(UP, 50);
		sys.trigger($EndPipe_Platform_Railing_Spkr);
		sys.waitFor($EndPipe_Platform_Railing);
		sys.wait(1);
		$exit_clip.bind($EndPipe_Platform);
		SealEndTankDoors();

		$EndPipe_Platform.move(UP, 192);
		sys.waitFor($EndPipe_Platform);
		sys.wait(.5);

		$EndPipeLowerDoorNorth.move(90, 136);
		sys.wait(.125);
		$EndPipeLowerDoorSouth.move(270, 136);
