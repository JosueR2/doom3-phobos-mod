	// BEGIN TURRETS

	void DeactivateTurretLasers()
	{
			$turret_laser_flicker.hide();
			$turret_laser_flare.hide();
			$TurretLaserTrig.disable();
	}		

	void ActivateTurretLasers()
	{
			$turret_laser_flicker.show();
			$turret_laser_flare.show();
			$TurretLaserTrig.enable();
	}

	float point_turrets = 1;
	void UpdateTurrets()
	{		
		$sec_point_turret_1_barrel.rotate('360 0 0');

		while(point_turrets)
		{
			vector dir = $player1.getWorldOrigin() - $sec_point_turret_1.getWorldOrigin();
			dir = sys.vecNormalize(dir);

			vector angles = sys.VecToAngles(dir);
			angles_z = 180-angles_x;
			angles_x = 0;
			angles_y += -90;

			$sec_point_turret_1.setAngles(angles);

			sys.waitFrame();
		}

		$sec_point_turret_1.time (5);
		$sec_point_turret_1.accelTime (1);
		$sec_point_turret_1.decelTime (2);
		//$sec_point_turret_1.rotateTo('0 -90 15 ');

		$sec_point_turret_1.rotateOnce('0 -10 -15 ');
		$sec_point_turret_1_barrel.stopRotating();
		sys.wait(1.5);
		DeactivateTurretLasers();
		
	}

	// BEGIN SECURITY CAMERAS

	float security_camera_num;

	void UpdateCameras()
	{
		while(1)
		{
			float i = 0;
			while(i < security_camera_num)
			{
				entity onlycams = sys.getEntity("security_camera_" + i);

				// If the camera exists and therefor has an onlycams account, update it
				if(onlycams)
				{
					// We add 72 units to the z-component because the player world origin is his/her/kangaruwus feet.
					// 72 units up makes it look directly into your soul
					vector dir = ($player1.getWorldOrigin() + '0 0 72') - onlycams.getWorldOrigin();
					dir = sys.vecNormalize(dir);			
			
					vector angles = sys.VecToAngles(dir);
					
					// For some reason the vector components in the script and in the engine aren't the same
					// Z needs to be the inverted x
					angles_z = 180-angles_x;
					
					// X here is the roll component and we definitely do not need to spin the camera
					// Even if it's a neat trick
					angles_x = 0;

					// The model is -90 degrees off angle by default
					angles_y += -90;
			
					onlycams.setAngles(angles);
				}
				i++;
			}
			sys.waitFrame();
		}
	}

	void SetupSecurityCameras()
	{
		// Find all the cameras in the level. Right now the max is 64. That's lofty.
		// Should we need more, add to this number. If we end up using 16, just lower the number
		// NOTE: If you want to add more security cameras to the level, simply call it security_cam_[X]
		security_camera_num = 0;
		while(security_camera_num < 64)
		{
			entity ent = sys.getEntity("security_camera_" + security_camera_num);
			security_camera_num++;
		}
		
		// If we have cameras in the level, start updating them
		if(security_camera_num > 0)
		{
			thread UpdateCameras();
		}
	}

	float detentionUnlocked = 0;
	float detentionStarted = 0;
	float detentionTimeDone = 0;
	float detentionNextTrigger = 0;	
	float detentionProgNum = 0;

	void DetentionSecPoint()
	{
		if(detentionStarted == 2)
		{
			return;
		}

		if(detentionStarted == 0)
		{
			ActivateTurretLasers();
			detentionTimeDone = sys.getTime() + 3;
			detentionNextTrigger = sys.getTime() + 0.5;
			detentionStarted = 1;
			// Start the scanning sound
			sys.trigger($speaker_scanning);
		}

		if(sys.getTime() > detentionNextTrigger)
		{			
			// Stop the scanning sound
			$speaker_scanning.stopSound(SND_CHANNEL_ANY, 0);
			detentionStarted = 0;
			//$sec_point_turret_1_barrel.stopRotating();

			return; 
		}

		detentionNextTrigger = sys.getTime() + 0.5;

		float i = 0;
		while(i < 4)
		{
			entity prog = sys.getEntity("detention_sec_prog_" + i);

			vector color = '0 0.125 0';
			if(i == detentionProgNum)
			{
				color = '0 0.75 0';
			}

			prog.setColor(color_x, color_y, color_z);
			i++;
		}
		
		detentionProgNum = (detentionProgNum + 1) % 4;
			
		if(sys.getTime() > detentionTimeDone)
		{
			detentionStarted = 2;

			float fadeTime = 0.5;			

			i = 0;
			while(i < 4)
			{
				prog = sys.getEntity("detention_sec_prog_" + i);				
				prog.setColor(0, 0.75, 0);
				i++;
			}

			thread crossFadeEnt ($detention_sec_light_red, '0.75 0 0', '0 0 0', fadeTime);
			thread crossFadeEnt ($detention_sec_fixture_red, '1 1 1', '0.125 0 0', fadeTime);
			thread crossFadeEnt ($detention_sec_flare_red, '0.75 0 0', '0 0 0', fadeTime);

			thread crossFadeEnt ($detention_sec_light_green, '0 0 0', '0 0.75 0', fadeTime);
			thread crossFadeEnt ($detention_sec_fixture_green, '0 0.125 0', '1 1 1', fadeTime);
			thread crossFadeEnt ($detention_sec_flare_green, '0 0 0', '0 0.75 0', fadeTime);

			thread crossFadeEnt ($func_static_106650, '0.5 0 0', '1 0.823529 0.521569', fadeTime);
			thread crossFadeEnt ($light_67185, '1 0.03 0', '1 0.7 0', fadeTime);
			thread crossFadeEnt ($func_static_106826, '0.549020 0.125490 0.000000', '0.54902 0.392157 0', fadeTime);						

			sys.wait(fadeTime);

			$TurretLaserTrig.disable();
			point_turrets = 0;			
			detentionUnlocked = 1;
			$detention_main_door.lock(0);
			$detention_main_door_frame.setColor(1,0.823529,0.521569);
			sys.trigger($drippy_trigger);

			sys.wait(1);
			
			sys.trigger($turret_inactive_light_dec);
			sys.trigger($turret_active_light_dec);
			thread crossFadeEnt ($turret_active_light, '1 0.15 0.15', '0 1 0.31', fadeTime);

			i = 0;
			while(i < 4)
			{
				prog = sys.getEntity("detention_sec_prog_" + i);
				thread crossFadeEnt (prog, '0 0.75 0', '0 0.125 0', 4);
				i++;
			}
		}
	}

	// END SECURITY CAMERAS

	float first_cell_reaction = 0; 
	void ReactToCell()
	{
		if(first_cell_reaction > 0)
		{
			return;
		}

		first_cell_reaction = 1;
		sys.wait(.5);
		
		thread ShowSubtitles("Sam", "Shit...", 2);
		$player1.startSoundShader("sound/vo/player/general/ShitInternal.ogg", SND_CHANNEL_ANY);

		$CallPepperShakerClicker.setKey("click_item", 1);
	}
	
	// BEGIN PEPPER SHAKER
	
	float PEPPER_SHAKER_DOCK_OUT = 0;
	float PEPPER_SHAKER_DOCK_HOME = 1;	
	float PEPPER_SHAKER_DOCK_BLOCK_A = 2;
	float PEPPER_SHAKER_DOCK_BLOCK_B = 3;
	float PEPPER_SHAKER_DOCK_BLOCK_C = 4;
	float PEPPER_SHAKER_DOCK_BLOCK_D = 5;
	float PEPPER_SHAKER_MOVING = 6;
	
	float pepper_shaker_state = 0;

	void CallPepperShaker()
	{
		sys.trigger($TriggerMilesTalk);

		// bress the button, idiot
		$intercom_button.move(0, 1);
		$intercom_button.startSoundShader("sound/shav/e1m1/intercomclick1.ogg", SND_CHANNEL_ANY);
		sys.waitFor($intercom_button);
		sys.wait(.125);
		$intercom_button.startSoundShader("sound/shav/e1m1/intercomclick2.ogg", SND_CHANNEL_ANY);
		$intercom_button.move(180, 1);

		sys.wait(0.7);

		// open door to area
		$func_door_188619.lock(0);
		$func_static_103757.setColor(1, 0.823529, 0.521569);
		$light_65842.setColor(1, 0.7, 0);

		$peppershaker_main.startSoundShader("m3_start_low", SND_CHANNEL_ANY);

		float move_speed = 80.0;
		float time_to_move = 592.0 / move_speed;
		$peppershaker_feet.time(time_to_move);
		$peppershaker_feet.accelTime(1);
		$peppershaker_feet.decelTime(0);
		$peppershaker_feet.move(0, 592);

		sys.waitFor($peppershaker_feet);

		$peppershaker_feet.bind($peppershaker_turn_2);
		$peppershaker_turn_2.rotateOnce('0 -90 0');

		$peppershaker_axle_mover.rotateOnce('0 -90 0');

		sys.waitFor($peppershaker_turn_2);

		$peppershaker_feet.unbind();

		time_to_move = 928.0 / move_speed;
		$peppershaker_feet.time(time_to_move);
		$peppershaker_feet.accelTime(0);
		$peppershaker_feet.decelTime(0);
		$peppershaker_feet.move(270, 928);

		sys.waitFor($peppershaker_feet);

		$peppershaker_feet.bind($peppershaker_turn_1);
		$peppershaker_turn_1.rotateOnce('0 -90 0');
		$peppershaker_axle_mover.rotateOnce('0 -90 0');

		sys.waitFor($peppershaker_turn_1);

		$peppershaker_feet.unbind();

		time_to_move = 1792.0 / move_speed;
		$peppershaker_feet.time(time_to_move);
		$peppershaker_feet.accelTime(0);
		$peppershaker_feet.decelTime(4);
		$peppershaker_feet.move(180, 1792);

		sys.wait(time_to_move - 1);
		
		//$peppershaker_main.startSoundShader("al4_plat_stop", SND_CHANNEL_ANY);

		sys.waitFor($peppershaker_feet);		

		$func_mover_51.startSoundShader("sound/doors/Adoor1_open_low.wav", SND_CHANNEL_ANY);
		$func_mover_51.move(90, 30);
		$func_mover_52.move(270, 30);

		sys.waitFor($func_mover_52);

		sys.trigger($peppershaker_inside_trigger);
		
		$Peppershaker_Platform_Railing.move(DOWN, 48);
		sys.trigger($Peppershaker_Platform_Railing_Spkr);
		sys.waitFor($Peppershaker_Platform_Railing);
		sys.trigger($peppershaker_gateclip);	
	}

	void MovePepperShakerToCell()
	{
		// Fade out the music as it swells up
		$SpeakerAdrift16.fadeSound (SND_CHANNEL_ANY, -100, 30);
		sys.trigger($PeppershakerMusic);

		$func_mover_51.startSoundShader("sound/doors/Adoor1_close_low.wav", SND_CHANNEL_ANY);
		$func_mover_51.move(270, 30);
		$func_mover_52.move(90, 30);

		sys.waitFor($func_mover_52);
		
		$Peppershaker_Platform_Railing.move(UP, 48);
		sys.trigger($Peppershaker_Platform_Railing_Spkr);

		$peppershaker_main.startSoundShader("m3_start_low", SND_CHANNEL_ANY);
		
		float move_speed = 80.0;
		float time_to_move = 1792.0 / move_speed;
		$peppershaker_feet.time(time_to_move);
		$peppershaker_feet.accelTime(8);
		$peppershaker_feet.decelTime(0);
		$peppershaker_feet.move(0, 1792);

		sys.waitFor($peppershaker_feet);

		$peppershaker_feet.bind($peppershaker_turn_1);
		$peppershaker_turn_1.rotateOnce('0 90 0');
		$peppershaker_axle_mover.rotateOnce('0 90 0');
		sys.waitFor($peppershaker_turn_1);
		$peppershaker_feet.unbind();
		
		time_to_move = 112.0 / move_speed;
		$peppershaker_feet.time(time_to_move);
		$peppershaker_feet.accelTime(0);
		$peppershaker_feet.decelTime(4);
		$peppershaker_feet.move(90, 112);
		sys.waitFor($peppershaker_feet);

		$peppershaker_feet.bind($peppershaker_elevator);

		$peppershaker_elevator.move(DOWN, 560);
		sys.waitFor($peppershaker_elevator);

		sys.wait(1);

		$func_mover_51.startSoundShader("sound/doors/Adoor1_open_low.wav", SND_CHANNEL_ANY);
		$func_mover_51.move(270, 30);
		$func_mover_52.move(90, 30);

		sys.waitFor($func_mover_52);
	}

