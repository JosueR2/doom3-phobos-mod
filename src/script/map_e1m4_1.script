		$upperff_console_panel_replacement_mover.rotateOnce('0 -35 0');
		
		$swingladder.rotateOnce( '90 0 0' );		
		
		$arach_elev_south_top_clicker.hide();
		$arach_elev_south_clicker.hide();
		$arach_elev_north_top_clicker.hide();
		$arach_elev_north_clicker.hide();
		$arach_elev_south_bottom_light.setColor(0.5, 0, 0);
		$arach_elev_south_top_light.setColor(0.5, 0, 0);
		$arach_elev_north_bottom_light.setColor(0.5, 0, 0);
		$arach_elev_north_top_light.setColor(0.5, 0, 0);
		$arach_elev_south_top_flare.setColor(0.501961, 0, 0);
		$arach_elev_south_bottom_flare.setColor(0.501961, 0, 0);
		$arach_elev_north_top_flare.setColor(0.501961, 0, 0);
		$arach_elev_north_bottom_flare.setColor(0.501961, 0, 0);
		$arach_elev_south_top_tex.setColor(0.501961, 0, 0);
		$arach_elev_south_bottom_tex.setColor(0.501961, 0, 0);
		$arach_elev_north_top_tex.setColor(0.501961, 0, 0);
		$arach_elev_north_bottom_tex.setColor(0.501961, 0, 0);
		
		$arach_lifts_handle.rotateUpTo(X_AXIS, 90);
	}		

	void fade_ferris(entity e, vector a, vector b, vector c)
	{
		crossFadeEnt (e, a, b, 4);
		crossFadeEnt (e, b, c, 4);
		crossFadeEnt (e, c, a, 4);
	}

	void fade_ferris_spoke(vector a, vector b, vector c)
	{
		float i = 0;
		while(true)
		{
			vector from = a;
			vector to = b;
			vector col = a ;

			while(i < 15)
			{
				entity e = sys.getEntity("ferris_wheel_spoke_1_light_" + (i + 1));
				
				e.setColor(1, 0, 1);
			

				i++;
			}

			sys.wait(4.0 / 15.0);
		}
	}

	void ferris()
	{
		vector pink = '1 0 1';
		vector cyan = '0 1 1';
		vector yellow = '1 1 0';

		float i = 0;
		fade_ferris_spoke(pink,cyan,yellow);
		
	}
}