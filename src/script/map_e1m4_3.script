	void ContinueMilesCall1()
	{
		Beat(.25);
		
		thread ShowNPCSubtitles("Sam", "Found it! It's CM. Dash. AA. Dash. 23.", 4.7);
		Outro_CharacterSays($player1, "e1m4_3_MilesCall_Player4");
		Beat(.25);
		thread ShowNPCSubtitles("Miles", "Hmm?", 2);
		Outro_CharacterSays($Comm_Holder, "e1m4_3_MilesCall_Miles4");
		Beat(1.5);
		thread e1m4_3_MilesCall_Player6Sub();
		$player1.startSoundShader("e1m4_3_MilesCall_Player6", SND_CHANNEL_ANY);
		Outro_CharacterSays($Comm_Holder, "e1m4_3_MilesCall_Miles5");		
		Beat(.75);
		thread e1m4_3_MilesCall_Miles6Sub();
		Outro_CharacterSays($Comm_Holder, "e1m4_3_MilesCall_Miles6");
		Beat(.5);		
		thread ShowNPCSubtitles("Sam", "Okay. I'll see what I can find. Thanks Miley.", 2.25);
		Outro_CharacterSays($player1, "e1m4_3_MilesCall_Player5");
		Beat(.25);
		thread e1m4_3_MilesCall_Miles7Sub();
		Outro_CharacterSays($Comm_Holder, "e1m4_3_MilesCall_Miles7");
		
		$item_pickup_bomb.setKey("click_item", 1);
		$item_bomb_instructions.setKey("click_item", 1);

		sys.trigger($trigger_post_miles_call);

		$miles_conf_door.lock(0);
	}
	
	void e1m4_3_MilesCall_Player8Sub()
	{
		ShowNPCSubtitles("Sam", "Yeah. Earth. You know.\nThis is the first time I've thought about it.", 7);
		ShowNPCSubtitles("Sam", "We really are on Mars, aren't we? Well, I am.\nIt doesn't feel like I belong here...", 8);
		ShowNPCSubtitles("Sam", "I wonder if I still have a place back on Earth.\nI guess that's why I need to find your friend...", 6.15);
		ShowNPCSubtitles("Sam", "...so you can find that other friend.\nMore than a friend?", 5.25);
	}
	
	void e1m4_3_MilesCall_Miles8Sub()
	{
		ShowNPCSubtitles("Miles", "Well. Everything, I guess. I had a normal upbringing...more or less.\nWe had a regular house in an uneventful neighborhood.", 9);
		ShowNPCSubtitles("Miles", "My parents were strict, but loving.\nWe actually used to live outside federal soil.", 4.3);
		ShowNPCSubtitles("Miles", "But jobs were hard to come by so we eventually decided to migrate.", 3.8);
		ShowNPCSubtitles("Miles", "Life in the FCE controlled areas was much easier.", 3.25);
		ShowNPCSubtitles("Miles", "The universal basic income gave us a steady base and dad soon found a job...\nAnd then another.", 7.1);
		ShowNPCSubtitles("Miles", "He pulled double shifts for years to give us the best possible outlook.\nRight up until he...", 8);
		ShowNPCSubtitles("Miles", "Later on I joined the academy and now I'm here.", 5);
	}
	
	void e1m4_3_MilesCall_Miles12Sub()
	{
		ShowNPCSubtitles("Miles", "You ask him about your identity, grab a cold one and relax behind the fortified walls of safety.\n...Obviously. ", 6);
		ShowNPCSubtitles("Miles", "All I ask of you is...contact me and tell me he's safe.\nEven if it means going beyond those walls. Please.", 6.25);
	}
	
	void ContinueMilesCall2()
	{
		imTalkingToMiles = 1;
		sys.trigger($func_radiochatter_1);
		Beat(.25);
		thread ShowNPCSubtitles("Sam", "Samantha. I was wondering. About you.\nWhat do you remember from back home?", 6.2);
		Outro_CharacterSays($player1, "e1m4_3_MilesCall_Player7");
		Beat(1.75);
		thread e1m4_3_MilesCall_Miles8Sub();
		Outro_CharacterSays($player1, "e1m4_3_MilesCall_Miles8");
		Beat(.75);
		thread ShowNPCSubtitles("Sam", "Do you miss it? Life on earth?", 2);
		Outro_CharacterSays($player1, "e1m4_3_MilesCall_Player7_a");
		Beat(.75);
		thread ShowNPCSubtitles("Miles", "Do I miss it? Hmm, well. I miss mom. I miss the late summer evenings.\nI miss...you know how it is.", 9.15);
		Outro_CharacterSays($player1, "e1m4_3_MilesCall_Miles8_2");
		Beat(.75);
		thread e1m4_3_MilesCall_Player8Sub();
		Outro_CharacterSays($player1, "e1m4_3_MilesCall_Player8");
		Beat(.25);
		thread ShowNPCSubtitles("Miles", "What? Like sitting in a tree?", 2.1);
		Outro_CharacterSays($player1, "e1m4_3_MilesCall_Miles9");
		thread ShowNPCSubtitles("Sam", "K-I-S-S-I-N-G...", 2);
		Outro_CharacterSays($player1, "e1m4_3_MilesCall_Player9");
		Beat(.25);
		thread ShowNPCSubtitles("Miles", "Just get there you imbecile.", 2);
		Outro_CharacterSays($player1, "e1m4_3_MilesCall_Miles10");
		Beat(1);
		thread ShowNPCSubtitles("Sam", "I would kill to see a tree right now.", 2);
		Outro_CharacterSays($player1, "e1m4_3_MilesCall_Player10");
		Beat(.5);
		thread ShowNPCSubtitles("Miles", "Well...you may just have to.", 2);
		Outro_CharacterSays($player1, "e1m4_3_MilesCall_Miles11");
		Beat(.75);
		thread ShowNPCSubtitles("Sam", "Yeah...So when I find him, what do I do?", 4.15);
		Outro_CharacterSays($player1, "e1m4_3_MilesCall_Player11");
		Beat(.5);
		thread e1m4_3_MilesCall_Miles12Sub();
		Outro_CharacterSays($player1, "e1m4_3_MilesCall_Miles12");
		Beat(.75);
		thread ShowNPCSubtitles("Sam", "I will.", 2);
		Outro_CharacterSays($player1, "e1m4_3_MilesCall_Player12");
		
		milesConvoStarted = 1;
		
		if(bombTaken == 1)
		{
			sys.wait(2);

			sys.trigger($func_radiochatter_3);
			Beat(.25);
			thread ShowNPCSubtitles("Sam", "So I guess I'm going to the refinery.\nThe Marines left a bomb. Maybe I could blow my way in.", 6.15);
			Outro_CharacterSays($player1, "e1m4_3_MilesCall_Player13_a");
			Beat(.5);
			thread ShowNPCSubtitles("Miles", "Boom.", 2);
			Outro_CharacterSays($player1, "e1m4_3_MilesCall_Miles13");
			Beat(.5);
			thread ShowNPCSubtitles("Sam", "Boom.", 2);
			Outro_CharacterSays($player1, "e1m4_3_MilesCall_Player14");

			$place_bomb_item.setKey("click_item", 1);
			$broken_wall_item.setKey("click_item", 0);
		}

		imTalkingToMiles = 0;
	}
	
