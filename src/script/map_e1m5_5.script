	void phobos_hologram_scanlines()
		{
			sys.trigger($phobosgram_scanline1a_top);
			sys.trigger($phobosgram_scanline1b_top);
			sys.trigger($phobosgram_scanline2a_top);
			sys.trigger($phobosgram_scanline2b_top);
			sys.trigger($phobosgram_scanline3a_top);
			sys.trigger($phobosgram_scanline3b_top);
			sys.trigger($phobosgram_scanline4a_top);
			sys.trigger($phobosgram_scanline4b_top);
			sys.trigger($phobosgram_scanline1a);
			sys.trigger($phobosgram_scanline1b);
			sys.trigger($phobosgram_scanline2a);
			sys.trigger($phobosgram_scanline2b);
			sys.trigger($phobosgram_scanline3a);
			sys.trigger($phobosgram_scanline3b);
			sys.trigger($phobosgram_scanline4a);
			sys.trigger($phobosgram_scanline4b);
			sys.trigger($phobosgram_scanline1_spkr);
			sys.trigger($phobosgram_scanline2_spkr);
			sys.trigger($phobosgram_scanline3_spkr);
			sys.trigger($phobosgram_scanline4_spkr);
			$phobosgram_scanline1_mover.move(270, 384);
			$phobosgram_scanline2_mover.move(90, 384);
			$phobosgram_scanline3_mover.move(180, 288);
			$phobosgram_scanline4_mover.move(0, 288);
			sys.waitFor($phobosgram_scanline1_mover);
			$phobosgram_scanline1_mover.move(90, 384);
			$phobosgram_scanline2_mover.move(270, 384);
			$phobosgram_scanline3_mover.move(0, 288);
			$phobosgram_scanline4_mover.move(180, 288);
			sys.waitFor($phobosgram_scanline1_mover);
			sys.trigger($phobosgram_scanline1a_top);
			sys.trigger($phobosgram_scanline1b_top);
			sys.trigger($phobosgram_scanline2a_top);
			sys.trigger($phobosgram_scanline2b_top);
			sys.trigger($phobosgram_scanline3a_top);
