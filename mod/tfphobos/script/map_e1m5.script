	void GoPistonGo()
	{
		$Piston_Switch.setKey("click_item", "0");	

		$pistonhandle.moveTo($pistoncontrol_onpos);
		$pistonhandle.startSoundShader("one_shot_electrical_switch_heavy_1", SND_CHANNEL_ANY);
		
		$pistoncontrol_off.hide();
				
		sys.waitFor($pistonhandle);

		$pistoncontrol_on.show();

		sys.wait(.5);

		thread Initiatingpump3Subs();
		$pistonvoice.startSoundShader("sound/shav/e1m5/initiatingpump3.ogg", SND_CHANNEL_ANY);		

		sys.wait(5);

		$pistondoor_rotator.rotateOnce('0 43 0');
		$pistonhandle.startSoundShader("sound/doors/Idoor1_open.wav", SND_CHANNEL_ANY);		

		sys.wait(2);		

		sys.trigger($pistonspeaker);
		
		sys.wait(1);

		thread Pump3startedSubs();
		$pistonvoice.startSoundShader("sound/shav/e1m5/pump3started.ogg", SND_CHANNEL_ANY);

		while(1)
		{
			$pistonelev.move(DOWN, 256);
			sys.waitFor($pistonelev);
			$pistonelev.move(UP, 256);
			sys.waitFor($pistonelev);					
		}
	}
	
