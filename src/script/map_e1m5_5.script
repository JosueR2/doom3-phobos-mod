	void check_arch_pos1()
	{
		if(archPosition1 == 1)
		{
			sys.trigger($arch_tele_relay1);
			sys.trigger($arch_boney_forcefield_1);
			$arch_repel_trig1.disable();
			summon_boneys1(); 
		}
		else if(archPosition2 == 1)
		{
			sys.trigger($arch_tele_relay2);
			sys.trigger($arch_boney_forcefield_2);
			$arch_repel_trig2.disable();
			summon_boneys2(); 
		}
		else if(archPosition3 == 1)
		{
			sys.trigger($arch_tele_relay3);
			sys.trigger($arch_boney_forcefield_3);
			$arch_repel_trig3.disable();
			summon_boneys3();
		}
