	void crane_1_move( entity part, entity northWheel1, entity northWheel2, entity southWheel1, entity southWheel2, float dir, float amount, float stopOnCommand )
	{
		float cmd;

		if ( amount < 0.01 )
		{		
			return;
		}
		
		sound_crane_1_loop();
	
		part.move( dir, amount );
		
		float rotTime = amount / 50;

		southWheel1.time(rotTime);
		southWheel2.time(rotTime);

		northWheel1.time(rotTime);
		northWheel2.time(rotTime);

		float revolutions = amount / 50.27;
		float rotDir = 1;
		if(dir == EAST)
			rotDir = -1;

		southWheel1.rotateOnce('0 360 0' * revolutions * rotDir);
		southWheel2.rotateOnce('0 360 0' * revolutions * rotDir);
		northWheel1.rotateOnce('0 -360 0' * revolutions * rotDir);
		northWheel2.rotateOnce('0 -360 0' * revolutions * rotDir);


		if ( !stopOnCommand )
		{
			sys.waitFor( part );
		}
		else
		{
			cmd = crane_1_state;
			while( crane_1_state == cmd )
			{
				sys.waitFrame();			
				if ( !part.isMoving() )
				{
					break;
				}
			}
			part.stopMoving();
			southWheel1.stopRotating();
			southWheel2.stopRotating();
			northWheel1.stopRotating();
			northWheel2.stopRotating();
		}	
		sound_crane_1_stop();
	
		crane_1_pos = $crane_1.getWorldOrigin();
	}
	
	void crane_2_move( entity part, entity northWheel1, entity northWheel2, entity southWheel1, entity southWheel2, float dir, float amount, float stopOnCommand )
	{
		float cmd;

		if ( amount < 0.01 )
		{
		
			return;
		}

		sound_crane_2_loop();
	
	
		part.move( dir, amount );

		float rotTime = amount / 50;

		southWheel1.time(rotTime);
		southWheel2.time(rotTime);

		northWheel1.time(rotTime);
		northWheel2.time(rotTime);

		float revolutions = amount / 50.27;
		float rotDir = 1;
		if(dir == EAST)
			rotDir = -1;

		southWheel1.rotateOnce('0 360 0' * revolutions * rotDir);
		southWheel2.rotateOnce('0 360 0' * revolutions * rotDir);
		northWheel1.rotateOnce('0 -360 0' * revolutions * rotDir);
		northWheel2.rotateOnce('0 -360 0' * revolutions * rotDir);

		if ( !stopOnCommand )
		{
			sys.waitFor( part );
		}
		else
		{
			cmd = crane_2_state;
			while( crane_2_state == cmd )
			{
				sys.waitFrame();			
				if ( !part.isMoving() )
				{
					break;
				}
			}
			part.stopMoving();
			southWheel1.stopRotating();
			southWheel2.stopRotating();
			northWheel1.stopRotating();
			northWheel2.stopRotating();
		}	
		sound_crane_2_stop();
	
		crane_2_pos = $crane_2.getWorldOrigin();
	}

	void crane1loop()
	{
		while( 1 )
		{
			crane_1_state = M4CRANE_NONE;
			while( crane_1_state == M4CRANE_NONE )
			{							
				sys.waitFrame();
			}

			if ( crane_1_state == M4CRANE_WEST )
			{
				if ( crane_1_pos_x > crane_1_mins_x )
				{
					crane_1_move( $crane_1, $crane_1_wheel_north_1, $crane_1_wheel_north_2, $crane_1_wheel_south_1, $crane_1_wheel_south_2, WEST, crane_1_pos_x - crane_1_mins_x, true );
				}
			}
			else if ( crane_1_state == M4CRANE_EAST )
			{
				if ( crane_1_pos_x < crane_1_maxs_x )
				{
					crane_1_move( $crane_1, $crane_1_wheel_north_1, $crane_1_wheel_north_2, $crane_1_wheel_south_1, $crane_1_wheel_south_2, EAST, crane_1_maxs_x - crane_1_pos_x, true );
				}
			}			
		}
	}

	void crane2loop()
	{
		while( 1 )
		{
			crane_2_state = M4CRANE_NONE;
			while( crane_2_state == M4CRANE_NONE )
			{							
				sys.waitFrame();
			}

			if ( crane_2_state == M4CRANE_WEST )
			{
				if ( crane_2_pos_x > crane_2_mins_x )
				{
					crane_2_move( $crane_2,  $crane_2_wheel_north_1, $crane_2_wheel_north_2, $crane_2_wheel_south_1, $crane_2_wheel_south_2,WEST, crane_2_pos_x - crane_2_mins_x, true );
				}
			}
			else if ( crane_2_state == M4CRANE_EAST )
			{
				if ( crane_2_pos_x < crane_2_maxs_x )
				{
					crane_2_move( $crane_2,  $crane_2_wheel_north_1, $crane_2_wheel_north_2, $crane_2_wheel_south_1, $crane_2_wheel_south_2,EAST, crane_2_maxs_x - crane_2_pos_x, true );
				}
			}			
		}
	}

	void CargoLoop()
	{
		thread CargoLoopRed();
		thread CargoLoopBlue();
		thread CargoLoopOrange();
		sys.wait(9);
		thread CargoLoopGreen();
	}

	float cargofuelstate = 0;

	void SuspendCargo()
	{
		CargoSuspended = 1;

		float i = 0;
		while( i < 10 )
		{
			entity platform = sys.getEntity("track_orange_platform_" + (i + 1));
			platform.stopMoving();
			platform = sys.getEntity("track_green_platform_" + (i + 1));
			platform.stopMoving();
			platform = sys.getEntity("track_blue_platform_" + (i + 1));
			platform.stopMoving();

			if( i < 8 )
			{
				platform = sys.getEntity("track_red_platform_" + (i + 1));
				platform.stopMoving();
			}

			i++;
		}
	}
	
