	void CallDoctor()
	{
		$doctordoor.lock(2);
		sys.trigger($target_setkeyval_7);
		sys.trigger($target_setshaderparm_2);

		$intercom_button.move(0, 1);
		$intercom_button.startSoundShader("sound/shav/e1m1/intercomclick1.ogg", SND_CHANNEL_ANY);
		sys.waitFor($intercom_button);
		sys.wait(.125);
		$intercom_button.startSoundShader("sound/shav/e1m1/intercomclick2.ogg", SND_CHANNEL_ANY);
		$intercom_button.move(180, 1);

		sys.wait(0.7);

		PhobosShowSubtitle_e1m1("...", "Hello?");
		CharacterSays(playerC, "sound/vo/e1m1/doctorsappointment/Player1.ogg");
		
		Beat(0.5);
		
		PhobosShowSubtitle_e1m1("Dr. Nielsen", "Ehm. Hello?\nDid you take a wrong turn?");
		CharacterSays(doctorC, "sound/vo/e1m1/doctorsappointment/Doctor1.ogg");
		
		Beat(0.5);
		
		PhobosShowSubtitle_e1m1("...", "I was told to go here. I hit my head. Apparently.\nI'm not sure how it happened.");
		CharacterSays(playerC, "sound/vo/e1m1/doctorsappointment/Player2.ogg");
		
		Beat(0.5);
		
		PhobosShowSubtitle_e1m1("Dr. Nielsen", "State your name please.");
		CharacterSays(doctorC, "sound/vo/e1m1/doctorsappointment/Doctor1_2.ogg");
		
		Beat(0.5);
		
		PhobosShowSubtitle_e1m1("...", "Ehm...I... I don't know.");
		CharacterSays(doctorC, "sound/vo/e1m1/doctorsappointment/Player2_1.ogg");
		
		Beat(0.5);
		
		PhobosShowSubtitle_e1m1("Dr. Nielsen", "I see. Can you tell me where you are?");
		CharacterSays(doctorC, "sound/vo/e1m1/doctorsappointment/Doctor2.ogg");
		
		PhobosShowSubtitle_e1m1("...", "I'm In your office? On Mars? I think...\nWhy do you...");
		CharacterSaysInterupt(playerC, "sound/vo/e1m1/doctorsappointment/Player3.ogg", 0.5);
		
		PhobosShowSubtitle_e1m1("Dr. Nielsen", "Indulge me. It's standard procedure.\nCan you tell me who you are?");
		CharacterSays(doctorC, "sound/vo/e1m1/doctorsappointment/Doctor3.ogg");
		
		Beat(1.3);
		
		PhobosShowSubtitle_e1m1("...", "I can't. I woke up in this place. With a huge headache.");
		CharacterSays(playerC, "sound/vo/e1m1/doctorsappointment/Player4.ogg");		
		
		Beat(0.6);
		
		thread Doctor4Sub();
		thread CharacterSays(doctorC, "sound/vo/e1m1/doctorsappointment/Doctor4.ogg");
		
		Beat(5.5);

		sys.trigger($CallDoctorBlinkerRed);
		sys.trigger($CallDoctorBlinkerGreen);
		sys.trigger($target_entity_setcolor_13);

		thread PrepareScannerBed();
		Beat(2);
		
		Beat(4.5);
		
		PhobosShowSubtitle_e1m1("...", "Samantha Miles. Sounds familiar.");
		CharacterSays(playerC, "sound/vo/e1m1/doctorsappointment/Player5.ogg");
		sys.hideSubtitles();
	}

	void PowerUpLights()
	{
		sys.trigger($startup_alarm_speaker);
		sys.trigger($start_alarm_lights);

		sys.trigger($start_hall_light_1);
		sys.trigger($start_hall_light_2);
		sys.trigger($start_hall_light_3);
		sys.trigger($start_hall_light_3_flare);
		sys.trigger($start_hall_light_3_color);
		sys.trigger($start_hall_light_speaker_3);	

		sys.wait(.75);

		float i = 1;
		while(i < 9)
		{
			entity light = sys.getEntity("start_room_light_" + i);			
			entity flare = sys.getEntity("start_room_light_flare_" + i);
			entity speaker = sys.getEntity("start_room_light_speaker_" + i);									

			sys.trigger(light);								
            sys.trigger($start_room_light_color);
			sys.trigger(speaker);

			if(i < 6)
			{
				thread crossFadeEnt (flare, '0 0 0', '0.3 0.6 1', .5);
				entity fx = sys.getEntity("start_room_light_fx_" + i);
				sys.trigger(fx);				
				sys.wait(.15);
			}
			else
			{
				thread crossFadeEnt (flare, '0 0 0', '0.48 0.27 0.05', .5);	
				sys.wait(.25);
			}
			i++;
		}		

		sys.trigger($start_somadoor_relay);

		sys.wait(2);		
	}

	float power1_state = 0;

	void PowerUpStart()
	{		
		power1_state = 1;

		float station = 1;
		entity handle = sys.getEntity("power_station_handle_" + station);
		entity gui = sys.getEntity("power_station_gui_" + station);
		entity redPanelOff = sys.getEntity("power_station_redlight_off_" + station);
		entity redPanelOn = sys.getEntity("power_station_redlight_on_" + station);
		entity redLight = sys.getEntity("power_station_redlight_light_" + station);
		entity greenPanelOff = sys.getEntity("power_station_greenlight_off_" + station);
		entity greenPanelOn = sys.getEntity("power_station_greenlight_on_" + station);
		entity greenLight = sys.getEntity("power_station_greenlight_light_" + station);
		entity speaker_start = sys.getEntity("power_station_speaker_start_" + station);
		entity speaker_loop = sys.getEntity("power_station_speaker_loop_" + station);
		entity beep_speaker = sys.getEntity("power_station_beepspeaker_" + station);
		
		vector rv = handle.getVectorKey("rotaxis");
		
		handle.startSoundShader("one_shot_electrical_switch_heavy_1", SND_CHANNEL_ANY);
		handle.rotateOnce(rv * 90);
		sys.waitFor(handle);
		
		thread ShowNPCSubtitles("...", "Let there be light.\nI hope.", 3);
		CharacterSays(playerC, "sound/vo/player/general/LetThereBeLight.ogg");
		
		gui.hide();
		
		redPanelOff.show();
		redPanelOn.hide();
		redLight.hide();

		greenPanelOff.hide();
		greenPanelOn.show();
		greenLight.show();

		sys.trigger(speaker_start);
		sys.trigger(beep_speaker);

		sys.wait(2.75);
				
		sys.trigger(speaker_loop);

		sys.wait(.5);
		PowerUpLights();
		
		sys.trigger($trigger_open_box_relay);
	}

