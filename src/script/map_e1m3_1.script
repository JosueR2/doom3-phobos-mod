			ShowNPCSubtitles("AP", "The past is the key to the future.", 2.6);
		}
		if(ShowHoloSubtitles == 1)
		{
			ShowNPCSubtitles("AP", "As excavations suggest, Mars was once the host of a sprawling civilization.", 5.45);
		}
		if(ShowHoloSubtitles == 1)
		{
			ShowNPCSubtitles("AP", "The origin of the alien race and its technology remains a mystery to this day.", 5);
		}
		if(ShowHoloSubtitles == 1)
		{
			ShowNPCSubtitles("AP", "A mystery solvable only by the UAC.", 3.1);
		}
	}

	void HoloNarr2Sub()
	{
		if(ShowHoloSubtitles == 1)
		{
			ShowNPCSubtitles("AP", "Mars City is the cutting edge of UAC technology.\nAnd thereby the human endeavour in space.", 6.65);
