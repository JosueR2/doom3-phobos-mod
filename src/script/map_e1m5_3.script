	void trig_selection1()
	{
		float trigselect1;

		while (1)
		{
			trigselect1 = sys.random(15);
		
				if (trigselect1 <= 5){
					sys.trigger ($spawn_config1);
					sys.wait(1);
				} else if (trigselect1 >= 11){
					sys.trigger ($spawn_config2);
					sys.wait(1);
				} 
				  else {
					sys.trigger ($spawn_config3);
					sys.wait(1);
				}
		}
	}
	
	void kill_trig_selection1()
	{
		sys.killthread ("map_e1m5_3::trig_selection1");
	}
	
