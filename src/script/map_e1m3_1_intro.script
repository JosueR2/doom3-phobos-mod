	void HideBox()
	{
		thread Intro_CharacterSays($player1, "e1m3_1_placeboxecho");

		$the_box_hidden.show();
		
		sys.wait(0.25);
		
		sys.fadeTo('0 0 0', 1, 0.01);
		
		sys.trigger($intro_camera_0);

		sys.trigger($speaker_summer_low);

		// We stop sound instead of triggering it in case it's done
		$speaker_intro_music.stopSound(SND_CHANNEL_ANY,0);		

		sys.trigger($speaker_intro_generator);
		sys.trigger($speaker_intro_creaking);
		
		sys.wait(1);		

		sys.trigger($SpeakerDownTheLadder);
		
		Beat(10);
		
		thread ShowNPCSubtitles("Sam", "So are you all done up there?", 2);
		Intro_CharacterSays($player1, "e1m3_1_intro_Player23");		
		
		Beat(.5);
		
		thread ShowNPCSubtitles("Lee", "I can't find anything else we can use.\nI'll come down in a second.", 4);
		Intro_CharacterSays($player1, "e1m3_1_intro_Lee20");
		Intro_CharacterSays($player1, "e1m3_1_walkie_beep");

		$LeeStepSpeaker.startSoundShader("e1m3_1_Leestep4", SND_CHANNEL_ANY);		
		
		Beat(.75);

		sys.fadeTo('0 0 0', 0, 1);
		sys.trigger($intro_camera_4);
		$mover_intro_camera_4.moveTo($target_null_intro_camera_4);		

		Beat(.75);
		
		thread Intro_CharacterSays($player1, "e1m3_1_ladderdown");
		
		Beat(1);
		
		thread ShowNPCSubtitles("Lee", "By the way hotshot. I think I may know someone who can help us.\n You know...Get out of here.", 5.25);
		Intro_CharacterSays($player1, "e1m3_1_intro_Lee21");
		
		Beat(.5);			
		
		thread ShowNPCSubtitles("Sam", "Your boyfriend?", 2);
		Intro_CharacterSays($player1, "e1m3_1_intro_Player24");
		
		Beat(.5);
		
		thread ShowNPCSubtitles("Lee", "Maybe. Who knows.\nHe has connection with the feds. He knows my brother.", 4.75);
		Intro_CharacterSays($player1, "e1m3_1_intro_Lee22");
		
		Beat(.5);
		
		thread ShowNPCSubtitles("Sam", "He IS a fed! Remember? The bad guys!", 3);
		Intro_CharacterSays($player1, "e1m3_1_intro_Player25");
		
		Beat(.5);
		
		thread ShowNPCSubtitles("Lee", "I know. But he is not like that.", 3);
		Intro_CharacterSays($player1, "e1m3_1_intro_Lee23");
		
		Beat(1.5);
				
		thread ShowNPCSubtitles("Lee", "He's...different.", 2); 
		thread Intro_CharacterSays($player1, "e1m3_1_intro_Lee24");

		sys.wait(.9);

		//Fade to black
		sys.fadeTo('0 0 0', 1, 0.0625);

		sys.wait(3);

		thread Intro_CharacterSays($player1, "e1m3_1_lowkey");

		//DONE. CUT TO LANDING TERMINAL
		sys.trigger($info_player_teleport_1);
		sys.trigger($intro_target_setinfluence_1);
		sys.trigger($trigger_relay_624);
		sys.trigger($trigger_relay_610);
	}
	
