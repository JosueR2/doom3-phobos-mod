namespace map_e1m5_5
{
	float stop_talking_man = 0;

	float CharacterSaysNoWait(entity characterEntity, string line)
	{
		return characterEntity.startSoundShader(line, SND_CHANNEL_ANY);
	}

	// BEGIN MALL LIGHTS

	float mall_light_num;
	float mall_light_neon_num;

	void RestoreMallLights(string name, float num, float immediate)
	{
		float i = 0;
		while(i < num)
		{			
			entity light = sys.getEntity("mall_light_group" + name + "_" + i);
			vector color = light.getColor();
			vector ogcolor = light.getVectorKey("ogcolor");
			
			if(immediate > 0)
			{
				light.setColor(ogcolor_x, ogcolor_y, ogcolor_z);
				sys.wait(0.015);
			}
			else
			{
				thread crossFadeEnt (light, color, ogcolor, 1.25);
			}
			i++;
		}
	}

	void BreakBoxGlass()
	{
		sys.trigger($break_box_museum_glass_relay);
		
		sys.wait(0.35);

		$box_key_pickup_item_museum.setKey("click_item", "1");
	}
	
	void PowerOn_SoundscapeChange()
	{
		//ambient soundscape change
		sys.trigger($speaker_53);
		sys.trigger($speaker_54);
		sys.trigger($speaker_48);
		$speaker_75.fadeSound (SND_CHANNEL_ANY, -20, 3.5);
		$speaker_71.fadeSound (SND_CHANNEL_ANY, -20, 3.5);
		$speaker_77.fadeSound (SND_CHANNEL_ANY, -20, 3.5);
		$speaker_83.fadeSound (SND_CHANNEL_ANY, -10, 3.5);
		
		$speaker_85.fadeSound (SND_CHANNEL_ANY, 0, 3.5);
		$speaker_81.fadeSound (SND_CHANNEL_ANY, 0, 3.5);
		$speaker_87.fadeSound (SND_CHANNEL_ANY, 0, 5);
		$speaker_89.fadeSound (SND_CHANNEL_ANY, 0, 6.5);
		$speaker_100.fadeSound (SND_CHANNEL_ANY, 0, 3.5);
		$speaker_114.fadeSound (SND_CHANNEL_ANY, 0, 3.5);
		$speaker_115.fadeSound (SND_CHANNEL_ANY, 0, 3.5);
		sys.trigger($speaker_118);
		sys.trigger($speaker_125);
		sys.trigger($speaker_130);
		sys.trigger($speaker_123);
		sys.trigger($speaker_128);
	}
	
	void OpenAtriumShutters()
	{
		$atrium_shutter1.move(DOWN, 112);
		sys.trigger($shutterclack_relay1);
		sys.wait(.35);
		$atrium_shutter2.move(DOWN, 112);
		sys.trigger($shutterclack_relay2);
		sys.wait(.35);
		$atrium_shutter3.move(DOWN, 112);
		sys.trigger($shutterclack_relay3);
		sys.wait(.35);
		$atrium_shutter4.move(DOWN, 112);
		sys.trigger($shutterclack_relay4);
		
		thread PowerOn_SoundscapeChange();
		
		sys.wait(.35);
		$atrium_shutter5.move(DOWN, 112);
		sys.trigger($shutterclack_relay5);
		sys.wait(.35);
		$atrium_shutter6.move(DOWN, 112);
		sys.trigger($shutterclack_relay6);
		sys.wait(.35);
		$atrium_exit_elevatorgui.setSkin( "skins/doorlight_shaderparmon" );
		$atrium_exit_elevatorgui2.show();
	}

	void MallLightsBackOn()
	{
		RestoreMallLights("", mall_light_num, 0);
		RestoreMallLights("_neon", mall_light_neon_num, 1);

		sys.trigger($Mall_Lift_Switch);
	}

	void StoreMallLights(string name, float num)
	{
		float i = 0;
		while(i < num)
		{
			entity light = sys.getEntity("mall_light_group" + name + "_" + i);
			vector ogcolor = light.getColor();
			light.setKey("ogcolor", ogcolor);
			light.setColor(0, 0, 0);
			i++;
		}
	}

	void SetupMallLights()
	{		
		mall_light_num = 0;
		while(mall_light_num < 128)
		{
			entity ent = sys.getEntity("mall_light_group_" + mall_light_num);
			mall_light_num++;
		}

		StoreMallLights("", mall_light_num);

		mall_light_neon_num = 0;
		while(mall_light_neon_num < 256)
		{
			ent = sys.getEntity("mall_light_group_neon_" + mall_light_neon_num);
			mall_light_neon_num++;
		}

		StoreMallLights("_neon", mall_light_neon_num);
	}

	void mall_lights_on()
	{
		sys.trigger($mall_power_reset_trigger);
		sys.trigger($mall_klaxxon_relay);

		$power_reset_switch.startSoundShader("e1m5_3_large_switch", SND_CHANNEL_ANY);
		$power_reset_switch.move(-1, 8);
		sys.wait(1);
		sys.trigger($power_station_speaker_start_1);
		sys.wait(2.75);		
		sys.trigger($power_station_speaker_loop_1);
	}	

	void Flicker_Museum_Skybox()
	{
		while(1)
		{
			float wait_time = sys.random(1) + 0.1;
			sys.wait(wait_time);

			sys.trigger($museum_skybox_gui_0);
			sys.trigger($museum_skybox_gui_1);
			sys.trigger($museum_skybox_gui_2);
			sys.trigger($museum_skybox_gui_3);
			sys.trigger($museum_skybox_gui_4);

			wait_time = sys.random(1) + 0.1;
			sys.wait(wait_time);

			sys.trigger($museum_skybox_gui_0);
			sys.trigger($museum_skybox_gui_1);
			sys.trigger($museum_skybox_gui_2);
			sys.trigger($museum_skybox_gui_3);
			sys.trigger($museum_skybox_gui_4);
		}
	}

	void Toggle_Museum_Skyboxes()
	{
		while(1)
		{
			float wait_time = sys.random(1) + .25;
			sys.wait(wait_time);

			sys.trigger($info_portalsky_2);

			wait_time = sys.random(2) + .25;
			sys.wait(wait_time);

			sys.trigger($info_portalsky_1);
		}
	}

	void StartPhobosSkyBoxGlitching()
	{		
		thread Flicker_Museum_Skybox();
		thread Toggle_Museum_Skyboxes();
	}

