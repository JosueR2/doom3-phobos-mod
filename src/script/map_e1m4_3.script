	float firstTimeChair = 1;
	void SetChair()
	{
		HideMirrorClickers();
		
		$outro_chair_alter.startSoundShader("e1m3_1_slidebox", SND_CHANNEL_ANY);
		
		if(OutroChairPosition == 1)
		{
			$player1.startSoundShader("blueworld_toggle1", SND_CHANNEL_ANY);
			if(firstTimeChair != 1)
			{
				$outro_chair_alter.rotateOnce('0 -20 0');
			}
			else
			{
				$outro_chair_alter.rotateOnce('0 10 0');
			}
			
			OutroChairPosition = 2;
		}
		else if(OutroChairPosition == 2)
		{
			$player1.startSoundShader("blueworld_toggle2", SND_CHANNEL_ANY);
		
			$outro_chair_alter.rotateOnce('0 -35 0');
			OutroChairPosition = 3;
		}
		else if(OutroChairPosition == 3)
		{
			$player1.startSoundShader("blueworld_toggle3", SND_CHANNEL_ANY);
			$outro_chair_alter.rotateOnce('0 55 0');
			
			firstTimeChair = 0;
			OutroChairPosition = 1;
		}

		OutroItemSettingsSuccess();
		
		sys.waitFor($outro_chair_alter);		
		
		ShowMirrorClickers();
	}
	
