		$outro_garage_door_rotator.rotateOnce('0 -85 0');
		$outro_garage_door_handle.startSoundShader("e1m4_3_door_creak_2", SND_CHANNEL_ANY);

		sys.wait(.5);

		$outro_garage_door_handle.rotateOnce('0 0 -30');
	}

