	void Lee24Sub()
	{
		PhobosShowSubtitle_e1m1_1("Girl", "But every second with her was torture.");
		
		sys.wait(3);
		
		PhobosShowSubtitle_e1m1_1("Girl", "Right up until her last.");
		
		sys.wait(2.75);
		
		PhobosShowSubtitle_e1m1_1("Girl", "And then.");
		
