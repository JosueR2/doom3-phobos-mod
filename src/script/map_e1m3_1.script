	void Miles8Sub()
	{
		ShowNPCSubtitles("Miles", "Let's not get ahead of ourselves.\nRight now you're stuck in Mars City.", 5);		
		ShowNPCSubtitles("Miles", "You mentioned fuel lines.\nI know for a fact that The Bulwark has a thick pipeline heading up to its landing pad.", 7.15);
		ShowNPCSubtitles("Miles", "I would guess it connects back to the main Fuel Station.\nThe Landing Terminal where you're located obviously would as well.", 8); 
		ShowNPCSubtitles("Miles", "Sam. You need to pass through the Fuel Station.\nIt's the most direct route.", 6);
	}

	void Miles7Sub()
	{
		ShowNPCSubtitles("Miles", "James Benson? Yeah I knew him. Don't worry about that.\nI understand your confusion.", 6.1);
		ShowNPCSubtitles("Miles", "That's why it's so important that you find Calloway.", 3.3);
	}

	void Player5Sub()
	{
		ShowNPCSubtitles("Sam", "Hmm. You know. Back when the feds took over the shuttle.\nThey called out to some guy Benson about using the fuel lines.", 8);
		ShowNPCSubtitles("Sam", "He didn't get on the flight either.", 3);
	}

	float callmileslock = 0;

	void CallMiles()
	{
		if(callmileslock == 0)
		{
			callmileslock = 1;

			entity playerC = sys.getEntity("player1");
			CallMilesBeat(.5);
			thread ShowNPCSubtitles("Miles", "So. Did you hitch a ride?", 2);
			CallMilesCS($Comm_Holder, "e1m3_1_Miles1");
			CallMilesBeat(.5);
			thread ShowNPCSubtitles("Sam", "Did I hitch a ri...No! They fucking left. They left everyone behind.\nThe ships crew is dead. I thought you knew these guys.", 9.15);
			CallMilesCS(playerC, "e1m3_1_Player1");
			CallMilesBeat(.25);
			thread ShowNPCSubtitles("Miles", "Dead? Frank too?", 2);
			CallMilesCS($Comm_Holder, "e1m3_1_Miles2");
			CallMilesBeat(1.75);
			thread ShowNPCSubtitles("Sam", "Yeah. Frank too.", 2);
			CallMilesCS(playerC, "e1m3_1_Player2");
			CallMilesBeat(.25);
			thread ShowNPCSubtitles("Miles", "Shit! I...Frank...", 4);
			CallMilesCS($Comm_Holder, "e1m3_1_Miles3");
			CallMilesBeat(1);
			thread ShowNPCSubtitles("Sam", "I'm sorry. Did you know him well?", 2.5);
			CallMilesCS(playerC, "e1m3_1_Player3");
			CallMilesBeat(.5);
			thread ShowNPCSubtitles("Miles", "He...was an old friend of the family. One of my dads friends.\nI've known him since I was a little girl.", 8.5);
			CallMilesCS($Comm_Holder, "e1m3_1_Miles4");
			CallMilesBeat(.75);
			thread ShowNPCSubtitles("Sam", "Your dad. Does he also work for the Commonwealth?", 3);
			CallMilesCS(playerC, "e1m3_1_Player4");
			CallMilesBeat(.25);
			thread ShowNPCSubtitles("Miles", "He doesn't...He's not...no.\nLook we need to get you to The Bulwark. To Calloway. Somehow.", 8);
			CallMilesCS($Comm_Holder, "e1m3_1_Miles5");
			CallMilesBeat(.5);
			thread Player5Sub();
			CallMilesCS(playerC, "e1m3_1_Player5");
			CallMilesBeat(.125);
			thread ShowNPCSubtitles("Miles", "Benson? Okay.", 2);
			CallMilesCS($Comm_Holder, "e1m3_1_Miles6");
			CallMilesBeat(.5);
			thread ShowNPCSubtitles("Sam", "You know him?", 2);
			CallMilesCS(playerC, "e1m3_1_Player6");
			CallMilesBeat(.25);
			thread Miles7Sub();
			CallMilesCS($Comm_Holder, "e1m3_1_Miles7");
			CallMilesBeat(.5);
			thread ShowNPCSubtitles("Sam", "Find him? Isn't he at The Bulwark?", 2.25);
			CallMilesCS(playerC, "e1m3_1_Player7");
			CallMilesBeat(.125);
			thread Miles8Sub();
			CallMilesCS($Comm_Holder, "e1m3_1_Miles8");
			CallMilesBeat(.25);
			thread ShowNPCSubtitles("Sam", "What? Crawl through the fuel lines? Sounds safe.", 4);
			CallMilesCS(playerC, "e1m3_1_Player8");
			CallMilesBeat(.5);
			thread ShowNPCSubtitles("Miles", "Yeah well...you know.", 2.25);
			CallMilesCS($Comm_Holder, "e1m3_1_Miles9");
			CallMilesBeat(.75);
			thread ShowNPCSubtitles("Sam", "I'll watch out for your friends.", 2);
			CallMilesCS(playerC, "e1m3_1_Player9");
			CallMilesBeat(.25);
			thread ShowNPCSubtitles("Miles", "No friends of mine.", 2);
			CallMilesCS($Comm_Holder, "e1m3_1_Miles10");		
			CallMilesBeat(.125);
		
			playerC.startSoundShader("e1m1_intercomclick2", SND_CHANNEL_ANY);
			$comm_snapin.hide();
		
			sys.wait(.1);
			$commscreen.hide();
			sys.wait(.1);
			$commscreen_offline.show();
		
			CallMilesBeat(.25);
		
			//Objective
			sys.trigger($trigger_relay_644);		
		
			CallMilesBeat(3);
			thread ShowNPCSubtitles("Sam", "Fuel lines. Great!", 2);
			CallMilesCS(playerC, "e1m3_1_Player10");
		
			sys.wait(2.5);
		
			//Main Objective
			sys.trigger($trigger_relay_645);
		
			sys.wait(2.5);
		
			//Objective
			sys.trigger($trigger_relay_646);

			sys.quickSave("The Beginning of The End - Checkpoint 2");
		}
	}
	
	float talkingToMiles = 0;

	void InsertSnapin()
	{
		talkingToMiles = 1;

		$player1.startSoundShader("e1m1_intercomclick1", SND_CHANNEL_ANY);

		$comm_snapin.show();
		sys.trigger($comm_beep);
		$comm_blinker_tex.hide();
		$comm_blinking_light.hide();
		sys.wait(.1);
		$commscreen_online.hide();
		sys.wait(.1);
		$commscreen.setGuiParm("gui_parm41", 1);		
		sys.trigger($commscreen);
		$commscreen.show();

		sys.trigger($CancelMiles1);

		sys.wait(2.5);
		CallMiles();

		sys.wait(4);

		talkingToMiles = 0;
	}
		
	void activate_sentry()	
	{
		$sentry_glass_door.moveTo($sentry_door_close);
		sys.trigger($target_entity_fadein_1);
		sys.wait(.5);
		sys.trigger($sentry_scan_beam_relay);
		sys.trigger($sentry_scanner_spkr);
		$sentry_scan_rp.move(270, 64);
		$sentry_scan_lp.move(270, 64);
		$sentry_scan_rgear.rotate('0 270 0');
		$sentry_scan_lgear.rotate('0 -270 0');
		$sentry_scan_gearmove.move(270, 64);
		$sentry_scan_rs.rotate('0 0 360');
		$sentry_scan_ls.rotate('0 0 360');
		sys.waitFor($sentry_scan_rp);
		$sentry_scan_rp.move(90, 64);
		$sentry_scan_lp.move(90, 64);
		$sentry_scan_rgear.rotate('0 -270 0');
		$sentry_scan_lgear.rotate('0 270 0');
		$sentry_scan_gearmove.move(90, 64);
		sys.waitFor($sentry_scan_rp);
		$sentry_scan_rgear.stopRotating();
		$sentry_scan_lgear.stopRotating();
		$sentry_scan_rs.stopRotating();
		$sentry_scan_ls.stopRotating();
		sys.trigger($sentry_scan_beam_relay);
		sys.trigger($target_entity_fadeout_2);
		sys.trigger($sentry_door_open_spkr);
		$sentry_glass_door.moveTo($sentry_door_open);
	}
	
	float sentryBotReaction = 0;
	
	void close_sentry_door()	
	{
		sys.trigger($sentry_door_close_spkr);
		$sentry_glass_door.moveTo($sentry_door_close);
		
		if(sentryBotReaction == 0)
		{
			thread ShowNPCSubtitles("Sam", "Hey buddy!", 2);
			$player1.startSoundShader("e1m3_1_Player_SentryBotReaction", SND_CHANNEL_ANY);
			sentryBotReaction = 1;
		}
	}
	
	float sentryPath1 = 1; 
	float sentryAltPath1 = 0; 
	float sentryAltPath2 = 0;
	
	void sentry_path_check()
	{
		if(sentryPath1 == 1)
		{
			sys.trigger($comm1_sentry_2);
		}
		else if(sentryAltPath1 == 1)
		{
			sys.trigger($comm1_sentry_3);
		}
		else if(sentryAltPath2 == 1)
		{
			sys.trigger($comm1_sentry_4);
		}
	}
	
	void setup_sentryaltpath1()
	{
		sentryPath1 = 0;
		sentryAltPath1 = 1;
	}
	
	void setup_sentryaltpath2()
	{
		sentryAltPath1 = 0;
		sentryAltPath2 = 1;
	}
	
