		thread CharacterSays($Scare_Vent_1, "sewer_scare_Lee2_vent");
		CharacterSays($player1, "sewer_scare_Lee2");
		CharacterSays($player1, "e1m3_1_walkie_beep");
		Beat(.25);
		
		thread ShowNPCSubtitles("Sam", "I'm not sure you understand how tag works...", 2.15);
		CharacterSays($player1, "sewer_scare_Player3");
		Beat(.75);
		
		thread ShowNPCSubtitles("Lee", "Sure I do. You ready?", 2.15);
		thread CharacterSays($Scare_Vent_1, "sewer_scare_Lee3_vent");
		CharacterSays($player1, "sewer_scare_Lee3");
		CharacterSays($player1, "e1m3_1_walkie_beep");
		Beat(.5);
		
		thread ShowNPCSubtitles("Sam", "Well I am now.", 2);
		CharacterSays($player1, "sewer_scare_Player4");
		Beat(.25);
		
		thread ShowNPCSubtitles("Lee", "Perfect! This is it, you know. The last spot on the map.", 3.25);
		thread CharacterSays($Scare_Vent_1, "sewer_scare_Lee4_vent");
		CharacterSays($player1, "sewer_scare_Lee4");
		CharacterSays($player1, "e1m3_1_walkie_beep");
		Beat(.75);
		
		thread ShowNPCSubtitles("Sam", "I know. I'm still not sure what to expect.", 2.25);
		CharacterSays($player1, "sewer_scare_Player5");
		Beat(.4);
		
		thread ShowNPCSubtitles("Lee", "Can't be worse than the mountains up north.", 2);
		thread CharacterSays($Scare_Vent_1, "sewer_scare_Lee5_vent");
		CharacterSays($player1, "sewer_scare_Lee5");
		CharacterSays($player1, "e1m3_1_walkie_beep");
		Beat(.6);
		
		thread ShowNPCSubtitles("Sam", "Can't be worse than plan B!", 2);
		CharacterSays($player1, "sewer_scare_Player6");
		Beat(.25);
		
		thread ShowNPCSubtitles("Lee", "I like Plan B. He's charming.", 2.25);
		thread CharacterSays($Scare_Vent_1, "sewer_scare_Lee6_vent");
		CharacterSays($player1, "sewer_scare_Lee6");
		CharacterSays($player1, "e1m3_1_walkie_beep");
		Beat(.5);
		
		thread ShowNPCSubtitles("Sam", "He's dangerous.", 2);
		CharacterSays($player1, "sewer_scare_Player7");
		Beat(.75);
		
		thread ShowNPCSubtitles("Lee", "That's what makes it exciting.", 2);
		thread CharacterSays($Scare_Vent_1, "sewer_scare_Lee7_vent");
		CharacterSays($player1, "sewer_scare_Lee7");
		CharacterSays($player1, "e1m3_1_walkie_beep");
		
		Beat(1.5);
		
		thread ShowNPCSubtitles("Sam", "So. You're in a vent.", 2);
		CharacterSays($player1, "sewer_scare_Player8");
		Beat(.6);
		
		thread ShowNPCSubtitles("Lee", "I was thinking we should split up. Check several routes. Just to be sure.\nI picked the vents.", 5.15);
		thread CharacterSays($Scare_Vent_1, "sewer_scare_Lee8_vent");
		CharacterSays($player1, "sewer_scare_Lee8");
		CharacterSays($player1, "e1m3_1_walkie_beep");
		Beat(.5);
		
		thread ShowNPCSubtitles("Sam", "Great...I'm no fan of tiny spaces.", 2.20);
		CharacterSays($player1, "sewer_scare_Player9");
		Beat(.5);
		
		thread ShowNPCSubtitles("Lee", "I know.", 2);
		thread CharacterSays($Scare_Vent_1, "sewer_scare_Lee9_vent");
		CharacterSays($player1, "sewer_scare_Lee9");
		CharacterSays($player1, "e1m3_1_walkie_beep");
		Beat(.75);
		
		$sewer_scareplate.startSoundShader("sound/footsteps/ventilation/roam.wav", SND_CHANNEL_ANY );

		ShowSewerClickers();

		sys.wait(4);		

		float i = 1;
		while(i < 10)
		{			
			entity splate = sys.getEntity("sewer_plate_" + i);
			sys.trigger(splate);
			splate.startSoundShader("sound/footsteps/ventilation/step02.wav", SND_CHANNEL_ANY );

			if(i == 9)
			{
				break;
			}

			sys.wait(2.5);
			sys.trigger(splate);
			splate.startSoundShader("sound/footsteps/ventilation/step03.wav", SND_CHANNEL_ANY );
			sys.wait(1);
			i++;
		}

		leeAtFilter = 1;
	}
	
	
