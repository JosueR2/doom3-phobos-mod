	void CallManPoster(float num)
	{
		entity mover = sys.getEntity("manposter_" + num + "_mover");
		float state = mover.getFloatKey("state");
		if(state == 5)
			return;
		
		entity rotator = sys.getEntity("manposter_" + num + "_rotator");		

		if(state < 3)
		{
			mover.time(2);
			mover.setKey("state", 5);

			rotator.rotateOnce('-10 0 0');
			mover.move(180, 208);

			sys.wait(1.5);
			rotator.rotateOnce('10 0 0');

			sys.waitFor(rotator);

			sys.wait(1);

			mover.setKey("state", state++);
		}
		else if(state == 3)
		{
			mover.setKey("state", 5);

			sys.wait(1);

			entity dmg = sys.getEntity("manposter_" + num + "_x");
			entity light = sys.getEntity("manposter_" + num + "_light");
			entity terminal = sys.getEntity("manposter_" + num + "_terminal");
			entity poster = sys.getEntity("manposter_" + num);

			dmg.hide();						

			terminal.startSoundShader("sound/shav/e1m5_4/clear.ogg", SND_CHANNEL_ANY);

			light.setKey("hits", 0);
			vector c = light.getColor();

			if(poster.getShaderParm(7) == 1)
			{
				poster.setShaderParm(7, 0);
				light.setColor(c_x - 0.25, 0, 0);
				sys.wait(.125);
			}
			if(poster.getShaderParm(8) == 1)
			{
				poster.setShaderParm(8, 0);
				light.setColor(c_x - 0.25, 0, 0);
				sys.wait(.125);
			}
			if(poster.getShaderParm(9) == 1)
			{
				poster.setShaderParm(9, 0);
				light.setColor(c_x - 0.25, 0, 0);
				sys.wait(.125);
			}
			if(poster.getShaderParm(10) == 1)
			{
				poster.setShaderParm(10, 0);
				light.setColor(c_x - 0.25, 0, 0);
				sys.wait(.125);
			}

			mover.time(6);			
						
			rotator.rotateOnce('10 0 0');
			mover.move(0, 624);

			sys.wait(5.5);
			rotator.rotateOnce('-10 0 0');

			sys.waitFor(rotator);
			
			sys.wait(1);

			mover.setKey("state", 0);

			dmg.show();
		}
	}

	void HitManPoster(float num)
	{
		entity terminal = sys.getEntity("manposter_" + num + "_terminal");
		entity poster = sys.getEntity("manposter_" + num);
		entity dmg = sys.getEntity("manposter_" + num + "_x");
		entity light = sys.getEntity("manposter_" + num + "_light");
		
		dmg.hide();

		vector worldOrigin = dmg.getWorldOrigin();
		vector collisionOrigin = dmg.getVectorKey("collisionOrigin");
		collisionOrigin -= worldOrigin;
		collisionOrigin_z *= 0.64;
		float dis = sys.vecLength(collisionOrigin);

		float hits = poster.getFloatKey("hits");		
		
		if(dis > 8)
		{
			if(poster.getShaderParm(7) == 0)
			{
				poster.setShaderParm(7, 1);
				terminal.startSoundShader("sound/shav/e1m5_4/hit_7.ogg", SND_CHANNEL_ANY);
				hits++;
			}
		}
		else if(dis > 5.5)
		{
			if(poster.getShaderParm(8) == 0)
			{
				poster.setShaderParm(8, 1);
				terminal.startSoundShader("sound/shav/e1m5_4/hit_8.ogg", SND_CHANNEL_ANY);
				hits++;
			}
		}
		else if(dis > 3)
		{
			if(poster.getShaderParm(9) == 0)
			{
				poster.setShaderParm(9, 1);
				terminal.startSoundShader("sound/shav/e1m5_4/hit_9.ogg", SND_CHANNEL_ANY);
				hits++;
			}
		}
		else
		{
			if(poster.getShaderParm(10) == 0)
			{
				poster.setShaderParm(10, 1);
				terminal.startSoundShader("sound/shav/e1m5_4/hit_x.ogg", SND_CHANNEL_ANY);
				hits++;
			}
		}

		if(hits > 4)
			hits = 4;
		
		light.setColor(1 * (hits / 4), 0, 0);
		poster.setKey("hits", hits);

		sys.wait(.25);

		dmg.show();
	}

	void CallManPoster1() { CallManPoster(1); }
	//void CallManPoster2() { CallManPoster(2); }
	void CallManPoster3() { CallManPoster(3); }
	void CallManPoster4() { CallManPoster(4); }
	void CallManPoster5() { CallManPoster(5); }
	void HitManPoster1_X() { HitManPoster(1); }
	void HitManPoster2_X() { HitManPoster(2); }
	void HitManPoster3_X() { HitManPoster(3); }
	void HitManPoster4_X() { HitManPoster(4); }
	void HitManPoster5_X() { HitManPoster(5); }

