	void OpenSomaDoor(string name)
	{
		entity door = sys.getEntity("somadoor_round_" + name);
		entity portal = sys.getEntity("somadoor_portal_" + name);
		
		entity aas_obstacle = sys.getEntity("somadoor_aas_" + name);
		
		entity somaparm_green = sys.getEntity("somaguis_" + name + "_green");
		entity somaparm_blue = sys.getEntity("somaguis_" + name + "_blue");
		
		float state = door.getFloatKey("state");
		float openDir = door.getFloatKey("openDir");
		float closeDir = door.getFloatKey("closeDir");
		vector rv = door.getVectorKey("rotateVector");

		if( state == 0)
		{
			door.setKey("state", 2);

			sys.trigger(portal);
			
			sys.trigger(somaparm_blue);
			
			door.accelTime(1);
			door.decelTime(1);
			door.time(2.5);

			door.startSoundShader ("al4_openslats_2s", SND_CHANNEL_VOICE);
			door.rotateOnce(rv * 135);
			sys.waitFor(door);
			
			door.accelTime(1);
			door.decelTime(.5);
			door.time(3.5);

			door.startSoundShader ("sound/doors/large/hugedoor_01_open.wav", SND_CHANNEL_VOICE);
			
			sys.trigger(aas_obstacle);
			
			door.move(openDir, 128);
			door.rotateOnce(rv * 90);
		
			sys.waitFor(door);
			

			door.setKey("state", 1);

			sys.wait(5);

			door.setKey("state", 2);
			
			sys.trigger(aas_obstacle);

			door.startSoundShader ("sound/doors/large/hugedoor_01_close.wav", SND_CHANNEL_VOICE);
			door.move(closeDir, 128);
			door.rotateOnce(rv * -90);

			sys.waitFor(door);

			door.accelTime(1);
			door.decelTime(1);
			door.time(2.5);

			door.startSoundShader ("al4_openslats_2s", SND_CHANNEL_VOICE);
			door.rotateOnce(rv * -135);
			sys.waitFor(door);

			sys.trigger(portal);
			
			sys.trigger(somaparm_green);
			
			door.setKey("state", 0);
		}
	}
	
	void OpenSomaDoorDetention()
	{
		OpenSomaDoor("detention");
	}
	
	float blueKeyFound = 0;
	float greenKeyFound = 0;
	float yellowKeyFound = 0;

	float ScanSomaDoor(entity panel, entity key_relay, entity scanner, entity clicker, float state, entity enable_somaguis, string name)
	{		

		if(state == 2)
		{
			OpenSomaDoor(name);
			sys.wait(1);
			sys.trigger(enable_somaguis);
			
			return state;
		}

		sys.trigger(scanner);
		scanner.startSoundShader( "sound/shav/e1m5_4/scanner.ogg", SND_CHANNEL_VOICE );

		sys.wait(1);

		if(state == 0)
		{
			sys.trigger(scanner);
			
			//sys.trigger(panel);
			panel.startSoundShader("shav_general_alarm5", SND_CHANNEL_ANY);
			
			sys.wait(3.5);
			
			sys.trigger(enable_somaguis);
			
			return 0;
		}
		else
		{
			sys.trigger(key_relay);
			
			sys.wait(1);
			
			sys.trigger(scanner);
			
			sys.trigger(panel);
			panel.startSoundShader("shav_general_accepted", SND_CHANNEL_ANY);

			OpenSomaDoor(name);
			sys.wait(1);
			sys.trigger(enable_somaguis);
			
			return 2;
		}
	}
	
	float ScanSomaDoorInner(entity clicker, float state, entity enable_somaguis, string name)
	{		

		if(state == 2)
		{
			OpenSomaDoor(name);
			sys.wait(1);
			sys.trigger(enable_somaguis);
			
			return state;
		}

		if(state == 0)
		{	
			sys.wait(3.5);
			
			sys.trigger(enable_somaguis);
			
			return 0;
		}
		else
		{
			sys.wait(1);
			
			OpenSomaDoor(name);
			sys.wait(1);
			sys.trigger(enable_somaguis);
			
			return 2;
		}
	}

	void ScanSomaDoorArmory()
	{
		blueKeyFound = ScanSomaDoor($somadoor_keypanel_armory, $bluekey_relay, $somadoor_keypanelscanner_armory, $somadoor_keypanelclicker_armory, blueKeyFound, $enable_somaguis_armory, "armory");
	}

