	void main()
	{
		$ArchTrig1b.disable();
		$ArchTrig1c.disable();
		$ArchTrig2b.disable();
		$ArchTrig3b.disable();
		$ArchTrig4b.disable();
		$ArchTrig5b.disable();
		thread trig_selection1();
		
		thread select_monsterconfig1();
		sys.wait(1);
		thread select_monsterconfig2();
		sys.wait(2);
		thread select_monsterconfig3();
		sys.wait(3);
		thread select_monsterconfig4();
		
		sys.trigger($trigger_relay_1037);
		sys.trigger($trigger_relay_1041);
		sys.trigger($trigger_relay_645);
		sys.trigger($trigger_relay_955);
		
		sys.trigger($func_static_101395);
		sys.trigger($func_static_101315);
		
		sys.trigger($trigger_count_27);
		sys.trigger($trigger_count_28);
		sys.trigger($func_door_188592);

		// Move elec rods back in
		$elec_west_rod.move(180, 128);
		$elec_east_rod.move(0, 128);

		// Move them back to their initial positions
		$elec_west.move(DOWN, 624);
		$elec_east.move(UP, 624);
		sys.trigger($elec_east_down_aas);
		sys.trigger($elec_east_up_aas);
		sys.trigger($elec_west_down_aas);
		sys.trigger($elec_west_up_aas);

		sys.waitFor($elec_east);
		sys.waitFor($elec_east_rod);

		sys.wait(1);

		thread RunElecs();
		thread activate_crushers();
		thread activate_crushers_nb();
		
		$barrel_conv_2.move(UP, 128);
		$barrel_conv_3.move(UP, 256);
		$barrel_conv_4.move(UP, 384);
		$barrel_conv_5.move(UP, 512);
		$barrel_conv_6.move(UP, 640);
		$barrel_conv_7.move(UP, 768);
		sys.waitFor($barrel_conv_7);
		
		thread BarrelProcessing(1);
		thread BarrelProcessing(2);
		thread BarrelProcessing(3);
		thread BarrelProcessing(4);
		thread BarrelProcessing(5);
		thread BarrelProcessing(6);
		thread BarrelProcessing(7);
	}

